				<Item class="Folder" referent="RBX24">
					<Properties>
						<string name="Name">Core</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX25">
						<Properties>
							<string name="Name">PlayerHooks</string>
							<ProtectedString name="Source"><![CDATA[local PlayerHooks = {}

local playerHandlers = {}
local characterHandlers = {}
local removingHandlers = {}
local tracked = setmetatable({}, { __mode = "k" })
local connected = false

local function run(handler, ...)
	task.spawn(function(...)
		local ok, err = pcall(handler, ...)
		if not ok then
			warn("[PlayerHooks] handler error: " .. tostring(err))
		end
	end, ...)
end

local function trackPlayer(player)
	if tracked[player] then
		return
	end
	tracked[player] = true
	player.CharacterAdded:Connect(function(character)
		for _, handler in ipairs(characterHandlers) do
			run(handler, player, character)
		end
	end)
end

local function connect()
	if connected then
		return
	end
	connected = true
	local Players = game:GetService("Players")
	Players.PlayerAdded:Connect(function(player)
		trackPlayer(player)
		for _, handler in ipairs(playerHandlers) do
			run(handler, player)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		for _, handler in ipairs(removingHandlers) do
			run(handler, player)
		end
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		trackPlayer(player)
	end
end

function PlayerHooks.OnPlayer(handler)
	connect()
	table.insert(playerHandlers, handler)
	for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
		run(handler, player)
	end
end

function PlayerHooks.OnCharacter(handler)
	connect()
	table.insert(characterHandlers, handler)
	for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
		if player.Character then
			run(handler, player, player.Character)
		end
	end
end

function PlayerHooks.OnRemoving(handler)
	connect()
	table.insert(removingHandlers, handler)
end

return PlayerHooks
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX26">
						<Properties>
							<string name="Name">Util</string>
							<ProtectedString name="Source"><![CDATA[local Util = {}

function Util.getOrCreate(parent, className, name)
	local object = parent:FindFirstChild(name)
	if object and not object:IsA(className) then
		object:Destroy()
		object = nil
	end
	if not object then
		object = Instance.new(className)
		object.Name = name
		object.Parent = parent
	end
	return object
end

function Util.lowerSet(list)
	local set = {}
	for _, value in ipairs(list) do
		set[string.lower(tostring(value))] = true
	end
	return set
end

function Util.retry(fn, attempts, delaySeconds, waitFn)
	waitFn = waitFn or task.wait
	local lastError
	for attempt = 1, attempts do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastError = result
		if attempt < attempts then
			waitFn(delaySeconds * attempt)
		end
	end
	return false, lastError
end

return Util
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="Folder" referent="RBX27">
					<Properties>
						<string name="Name">Services</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX28">
						<Properties>
							<string name="Name">CandyService</string>
							<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")

local CandyConfig = require(ReplicatedStorage:WaitForChild("CandyConfig"))

local STORE_NAME = "Candy_v1"
local ATTRIBUTE = "Candy"
local AUTOSAVE_INTERVAL = 120
local RETRIES = 3

local CandyService = { Name = "Candy" }

local store
local loaded = {}
local busy = {}

local function storeKey(player)
	return "Player_" .. player.UserId
end

local function balance(player)
	return math.max(math.floor(tonumber(player:GetAttribute(ATTRIBUTE)) or 0), 0)
end

local function load(player)
	if not store then
		return
	end
	local value
	for attempt = 1, RETRIES do
		local ok, result = pcall(store.GetAsync, store, storeKey(player))
		if ok then
			value = math.max(math.floor(tonumber(result) or 0), 0)
			break
		end
		task.wait(attempt)
	end
	if value == nil or not player.Parent then
		return
	end
	player:SetAttribute(ATTRIBUTE, value)
	loaded[player] = true
end

local function save(player)
	if not store or not loaded[player] or busy[player] then
		return
	end
	busy[player] = true
	local amount = balance(player)
	for attempt = 1, RETRIES do
		if pcall(store.SetAsync, store, storeKey(player), amount) then
			break
		end
		task.wait(attempt)
	end
	busy[player] = nil
end

local function saveNow(player)
	while busy[player] do
		task.wait(0.1)
	end
	save(player)
end

function CandyService:Init()
	local ok, result = pcall(DataStoreService.GetDataStore, DataStoreService, STORE_NAME)
	if ok then
		store = result
	end

	_G.GetCandy = function(player)
		if typeof(player) ~= "Instance" or not player:IsA("Player") then
			return 0
		end
		return balance(player)
	end

	_G.AwardCandy = function(player, maxHealth, at)
		if typeof(player) ~= "Instance" or not player:IsA("Player") then
			return 0
		end
		if not loaded[player] or not CandyConfig.isSeason() then
			return 0
		end
		local amount = CandyConfig.candyForHealth(maxHealth)
		if amount <= 0 then
			return 0
		end
		player:SetAttribute(ATTRIBUTE, balance(player) + amount)
		if _G.ShowIndicator then
			_G.ShowIndicator(player, 0, 0, 0, at, amount)
		end
		return amount
	end

	_G.SpendCandy = function(player, amount)
		if typeof(player) ~= "Instance" or not player:IsA("Player") then
			return false
		end
		amount = math.floor(tonumber(amount) or -1)
		if amount < 0 or not loaded[player] then
			return false
		end
		if amount == 0 then
			return true
		end
		local current = balance(player)
		if current < amount then
			return false
		end
		player:SetAttribute(ATTRIBUTE, current - amount)
		task.spawn(save, player)
		return true
	end

	Players.PlayerAdded:Connect(function(player)
		task.spawn(load, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		saveNow(player)
		loaded[player] = nil
		busy[player] = nil
	end)
end

function CandyService:Start()
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for _, player in Players:GetPlayers() do
				task.spawn(save, player)
			end
		end
	end)

	game:BindToClose(function()
		local remaining = 0
		for _, player in Players:GetPlayers() do
			remaining += 1
			task.spawn(function()
				saveNow(player)
				remaining -= 1
			end)
		end
		local deadline = os.clock() + 25
		while remaining > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)
end

return CandyService
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX29">
						<Properties>
							<string name="Name">EliminatorService</string>
							<ProtectedString name="Source"><![CDATA[local EliminatorService = { Name = "Eliminator" }

function EliminatorService.entryMatches(entry, playerName, userId)
	if type(entry) == "string" and entry ~= "" then
		return string.lower(playerName) == string.lower(entry)
	elseif type(entry) == "number" and entry > 0 then
		return userId == entry
	end
	return false
end

function EliminatorService:Init()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local framework = script:FindFirstAncestor("Server")
	local PlayerHooks = require(framework.Core.PlayerHooks)
	local Logger = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Logger"))
	local cfg = require(framework.Config).Eliminator
	local log = Logger.new("Eliminator")

	local adminRankNames = {}
	for _, name in ipairs(cfg.AdminRankNames) do
		adminRankNames[name] = true
	end

	local function isAdmin(player)
		local main = _G.HDAdminMain
		if not main then
			return false
		end

		if type(main.GetRank) == "function" then
			local success, rank = pcall(main.GetRank, main, player)
			if success and type(rank) == "number" then
				return rank >= cfg.MinAdminRank
			end
		end

		local settings = main.settings
		if not (settings and settings.Ranks) then
			return false
		end

		for _, rankData in ipairs(settings.Ranks) do
			local rankLevel = rankData[1]
			if rankLevel >= cfg.MinAdminRank and rankData[3] then
				for i = 1, #rankData[3], 2 do
					if EliminatorService.entryMatches(rankData[3][i], player.Name, player.UserId) then
						return true
					end
				end
			end
		end

		if settings.Groups then
			for groupId, ranks in pairs(settings.Groups) do
				if type(groupId) == "number" and groupId > 0 then
					local okIn, inGroup = pcall(player.IsInGroupAsync, player, groupId)
					if okIn and inGroup then
						local playerRank
						for groupRank, rankName in pairs(ranks) do
							if adminRankNames[rankName] and type(groupRank) == "number" and groupRank > 0 then
								if playerRank == nil then
									local okRank, value = pcall(player.GetRankInGroupAsync, player, groupId)
									playerRank = okRank and value or false
								end
								if playerRank and playerRank >= groupRank then
									return true
								end
							end
						end
					end
				end
			end
		end

		return false
	end

	PlayerHooks.OnPlayer(function(player)
		if not _G.PlayerEliminatorActive then
			return
		end
		task.wait(cfg.JoinCheckDelay)
		if not player or not player.Parent then
			return
		end
		if not isAdmin(player) then
			player:Kick("Server is in Player Eliminator mode. Only Admin+ can join.")
		end
	end)

	PlayerHooks.OnCharacter(function(player, character)
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
		if not humanoid then
			return
		end
		humanoid.Died:Connect(function()
			if not _G.PlayerEliminatorActive then
				return
			end
			if not character:FindFirstChild("Kaiju") then
				return
			end
			task.wait(cfg.DeathKickDelay)
			if player and player.Parent then
				local popup = ReplicatedStorage:FindFirstChild("EliminatorPopup")
				if popup then
					popup:FireAllClients(player.Name .. " Has been eliminated.", "red")
				end
				player:Kick("You were eliminated! Better luck next time.")
			end
		end)
	end)

	log:info("Monitoring")
end

return EliminatorService
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX30">
						<Properties>
							<string name="Name">GCellGuardService</string>
							<ProtectedString name="Source"><![CDATA[local GCellGuardService = { Name = "GCellGuard" }

function GCellGuardService.isIncreaseAllowed(delta, allowed, tolerance)
	return allowed + tolerance >= delta
end

function GCellGuardService:Init()
	local framework = script:FindFirstAncestor("Server")
	local PlayerHooks = require(framework.Core.PlayerHooks)
	local Logger = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Logger"))
	local cfg = require(framework.Config).GCellGuard
	local log = Logger.new("GCellGuard")

	local watchedNames = {}
	for _, name in ipairs(cfg.ValueNames) do
		watchedNames[name] = true
	end

	local pendingAllowances = setmetatable({}, { __mode = "k" })
	local hookedValues = setmetatable({}, { __mode = "k" })

	_G.GCellGuardAllow = function(value, amount)
		if typeof(value) ~= "Instance" or not value:IsA("IntValue") then
			return
		end
		local numericAmount = tonumber(amount)
		if not numericAmount or numericAmount <= 0 then
			return
		end
		pendingAllowances[value] = (pendingAllowances[value] or 0) + numericAmount
		task.delay(cfg.AllowanceTtl, function()
			pendingAllowances[value] = nil
		end)
	end

	local function hookValue(value)
		if not value:IsA("IntValue") or not watchedNames[value.Name] then
			return
		end
		if hookedValues[value] then
			return
		end
		hookedValues[value] = true

		local state = { ready = false, repairing = false, last = value.Value }

		task.delay(cfg.ReadyDelay, function()
			if value.Parent then
				state.last = value.Value
				state.ready = true
			end
		end)

		value:GetPropertyChangedSignal("Value"):Connect(function()
			local current = value.Value
			if state.repairing or not state.ready then
				state.last = current
				return
			end

			local previous = state.last or current
			if current > previous then
				local delta = current - previous
				local allowed = pendingAllowances[value] or 0
				pendingAllowances[value] = nil
				if not GCellGuardService.isIncreaseAllowed(delta, allowed, cfg.Tolerance) then
					state.repairing = true
					value.Value = previous
					state.repairing = false
					state.last = previous
					log:warn("Rejected unauthorized GCells increase for " .. value:GetFullName())
					return
				end
			else
				pendingAllowances[value] = nil
			end
			state.last = current
		end)
	end

	local function hookLeaderstats(leaderstats)
		for _, child in ipairs(leaderstats:GetChildren()) do
			hookValue(child)
		end
		leaderstats.ChildAdded:Connect(function(child)
			task.defer(hookValue, child)
		end)
	end

	PlayerHooks.OnPlayer(function(player)
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			hookLeaderstats(leaderstats)
		end
		player.ChildAdded:Connect(function(child)
			if child.Name == "leaderstats" and child:IsA("Folder") then
				hookLeaderstats(child)
			end
		end)
	end)

end

return GCellGuardService
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX31">
						<Properties>
							<string name="Name">HealthService</string>
							<ProtectedString name="Source"><![CDATA[local HealthService = { Name = "Health" }

function HealthService.regenAmount(maxHealth, regenPoints, cfg)
	local multiplier = 1 + ((regenPoints or 0) * cfg.RegenPerPoint)
	return maxHealth * cfg.RegenBasePercent * multiplier
end

function HealthService.canRegen(health, maxHealth, bossMode, lastDamage, now, delay)
	if health >= maxHealth or bossMode then
		return false
	end
	if lastDamage == nil then
		return true
	end
	return (now - lastDamage) >= delay
end

function HealthService:Init()
	local framework = script:FindFirstAncestor("Server")
	local PlayerHooks = require(framework.Core.PlayerHooks)
	local cfg = require(framework.Config).Health

	local function enforceMaxHealth(character, humanoid)
		local enforcing = false
		humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
			local customMax = character:GetAttribute("CustomMaxHealth")
			if customMax and not enforcing and humanoid.MaxHealth ~= customMax then
				enforcing = true
				humanoid.MaxHealth = customMax
				if humanoid.Health > customMax then
					humanoid.Health = customMax
				end
				enforcing = false
			end
		end)
	end

	local function startRegen(character, humanoid)
		local lastDamage = nil
		local previousHealth = humanoid.Health

		humanoid.HealthChanged:Connect(function(newHealth)
			if previousHealth and newHealth < previousHealth then
				lastDamage = os.clock()
			end
			previousHealth = newHealth
		end)

		task.spawn(function()
			local waited = 0
			while character and not character.Parent and waited < cfg.CharacterParentTimeout do
				task.wait(0.5)
				waited += 0.5
			end

			while character and character.Parent and humanoid and humanoid.Health > 0 do
				task.wait(cfg.RegenInterval)
				if
					HealthService.canRegen(
						humanoid.Health,
						humanoid.MaxHealth,
						character:GetAttribute("BossMode"),
						lastDamage,
						os.clock(),
						cfg.RegenDelay
					)
				then
					local heal = HealthService.regenAmount(humanoid.MaxHealth, character:GetAttribute("RegenModifier"), cfg)
					humanoid.Health = math.min(humanoid.Health + heal, humanoid.MaxHealth)
				end
			end
		end)
	end

	PlayerHooks.OnCharacter(function(_, character)
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end
		enforceMaxHealth(character, humanoid)
		startRegen(character, humanoid)
	end)
end

return HealthService
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX32">
						<Properties>
							<string name="Name">IndicatorService</string>
							<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local REMOTE_NAME = "RewardIndicator"
local FLUSH_INTERVAL = 0.25

local IndicatorService = { Name = "Indicators" }

local pending = {}
local remote

local function ownHead(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root and (root.Position + Vector3.new(0, 4, 0)) or nil
end

local function resolve(at, player)
	if typeof(at) == "Vector3" then
		return at
	end
	if typeof(at) == "Instance" then
		if at:IsA("Humanoid") then
			at = at.Parent
		end
		if at and at:IsA("BasePart") then
			return at.Position
		end
		if at and at:IsA("Model") then
			local ok, cframe, size = pcall(at.GetBoundingBox, at)
			if ok then
				return cframe.Position + Vector3.new(0, size.Y * 0.35, 0)
			end
		end
	end
	return ownHead(player)
end

local function flush()
	for player, bucket in pending do
		pending[player] = nil
		if player.Parent and remote then
			for _, entry in bucket do
				local position = resolve(entry.at, player)
				if position then
					remote:FireClient(player, position, entry.damage, entry.gcells, entry.xp, entry.candy)
				end
			end
		end
	end
end

function IndicatorService:Init()
	remote = ReplicatedStorage:FindFirstChild(REMOTE_NAME)
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = REMOTE_NAME
		remote.Parent = ReplicatedStorage
	end

	_G.ShowIndicator = function(player, damage, gcells, xp, at, candy)
		if typeof(player) ~= "Instance" or not player:IsA("Player") then
			return
		end
		damage = math.max(tonumber(damage) or 0, 0)
		gcells = math.max(tonumber(gcells) or 0, 0)
		xp = math.max(tonumber(xp) or 0, 0)
		candy = math.max(tonumber(candy) or 0, 0)
		if damage + gcells + xp + candy <= 0 then
			return
		end
		local key = at
		if key == nil then
			key = "self"
		end
		local bucket = pending[player]
		if not bucket then
			bucket = {}
			pending[player] = bucket
		end
		local entry = bucket[key]
		if not entry then
			entry = { at = at, damage = 0, gcells = 0, xp = 0, candy = 0 }
			bucket[key] = entry
		end
		entry.damage += damage
		entry.gcells += gcells
		entry.xp += xp
		entry.candy += candy
	end

	Players.PlayerRemoving:Connect(function(player)
		pending[player] = nil
	end)
end

function IndicatorService:Start()
	task.spawn(function()
		while true do
			task.wait(FLUSH_INTERVAL)
			flush()
		end
	end)
end

return IndicatorService
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX33">
						<Properties>
							<string name="Name">KnitService</string>
							<ProtectedString name="Source"><![CDATA[local KnitService = { Name = "Knit" }

function KnitService:Start()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local ServerScriptService = game:GetService("ServerScriptService")
	local Knit = require(ReplicatedStorage:WaitForChild("Knit"):WaitForChild("Knit"))
	Knit.AddServices(ServerScriptService:WaitForChild("KnitServices"))
	Knit.Start():andThen(function()
		print("[Knit] Server started successfully")
	end):catch(function(err)
		warn("[Knit] Server failed to start: " .. tostring(err))
	end)
end

return KnitService
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX34">
						<Properties>
							<string name="Name">LegacyService</string>
							<ProtectedString name="Source"><![CDATA[local LegacyService = {}

function LegacyService.Create(moduleName)
	return {
		Name = moduleName,
		Async = true,
		Init = function()
			local ServerScriptService = game:GetService("ServerScriptService")
			local folder = ServerScriptService:WaitForChild("framework", 30)
			local modules = folder and folder:WaitForChild("modules", 30)
			local moduleScript = modules and modules:FindFirstChild(moduleName)
			if not moduleScript then
				error("module not found: ServerScriptService.framework.modules." .. moduleName)
			end
			local system = require(moduleScript)
			if type(system) ~= "table" or type(system.Init) ~= "function" then
				error("module has no Init function")
			end
			system.Init()
		end,
	}
end

return LegacyService
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX35">
						<Properties>
							<string name="Name">MorphService</string>
							<ProtectedString name="Source"><![CDATA[local MorphService = { Name = "Morph" }

function MorphService:Init()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local ServerScriptService = game:GetService("ServerScriptService")
	local Workspace = game:GetService("Workspace")

	local framework = script:FindFirstAncestor("Server")
	local Util = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Util"))
	local Logger = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Logger"))
	local cfg = require(framework.Config).Morph
	local log = Logger.new("Morph")

	if ServerScriptService:GetAttribute("MorphBootstrapActive") then
		error("MorphBootstrapActive already set by another script; not registering a second morph handler")
	end
	ServerScriptService:SetAttribute("MorphBootstrapActive", true)

	local morphReady = Util.getOrCreate(ReplicatedStorage, "BoolValue", "MorphReady")
	morphReady.Value = false
	morphReady:SetAttribute("Error", nil)

	local morphSupplies = Util.getOrCreate(ReplicatedStorage, "Folder", "MorphSupplies")
	local events = Util.getOrCreate(morphSupplies, "Folder", "Events")
	local fireEvent = Util.getOrCreate(events, "RemoteEvent", "Fire")
	local morphResult = Util.getOrCreate(ReplicatedStorage, "RemoteEvent", "MorphResult")

	local securityOk, SecurityPolicy = pcall(function()
		return require(ServerScriptService:WaitForChild("SecurityPolicy", 10))
	end)
	if not securityOk or type(SecurityPolicy) ~= "table" or type(SecurityPolicy.CanUseMorph) ~= "function" then
		local reason = securityOk and "SecurityPolicy.CanUseMorph is missing" or tostring(SecurityPolicy)
		morphReady:SetAttribute("Error", reason)
		error(reason)
	end

	local tankSpawnMorphs = {}
	for _, name in ipairs(cfg.TankSpawnMorphs) do
		tankSpawnMorphs[name] = true
	end
	local restrictedKaiju = Util.lowerSet(cfg.RestrictedKaiju)
	local allowedPlayers = Util.lowerSet(cfg.AllowedPlayers)
	local allowedUserIds = {}
	for _, id in ipairs(cfg.AllowedUserIds) do
		allowedUserIds[id] = true
	end

	local function fail(player, message)
		morphResult:FireClient(player, false, nil, message)
	end

	local function pickSpawnCFrame(morphName)
		local isTank = tankSpawnMorphs[morphName] == true
		local folder = Workspace:FindFirstChild(isTank and "TankSpawns" or "SpawnPoints")
		if not folder then
			return nil
		end
		local points = folder:GetChildren()
		local point = #points > 0 and points[math.random(1, #points)] or nil
		if point and point:IsA("BasePart") then
			return point.CFrame + Vector3.new(0, isTank and cfg.TankSpawnHeight or cfg.SpawnHeight, 0)
		end
		return nil
	end

	fireEvent.OnServerEvent:Connect(function(player, selectedCreature)
		local ok, err = pcall(function()
			local morphs = morphSupplies:FindFirstChild("Morphs")
			if type(selectedCreature) == "string" and morphs then
				selectedCreature = morphs:FindFirstChild(selectedCreature, true)
			end
			if typeof(selectedCreature) ~= "Instance" or not selectedCreature:IsA("Model") then
				fail(player, "Invalid morph")
				return
			end
			if not SecurityPolicy.CanUseMorph(player, selectedCreature) then
				fail(player, "You do not own this kaiju")
				return
			end
			if
				restrictedKaiju[string.lower(selectedCreature.Name)]
				and not (allowedPlayers[string.lower(player.Name)] or allowedUserIds[player.UserId])
			then
				player:Kick("You cannot use this kaiju.")
				return
			end

			local controlTemplate = ReplicatedStorage:FindFirstChild("PlayerScripts")
			controlTemplate = controlTemplate and controlTemplate:FindFirstChild("Control")
			if not controlTemplate then
				fail(player, "Control script missing")
				return
			end

			local newModel = selectedCreature:Clone()
			local oldCharacter = player.Character
			for _, descendant in ipairs(newModel:GetDescendants()) do
				if descendant:IsA("BasePart") then
					descendant:SetAttribute("OriginalColor", descendant.Color)
					descendant:SetAttribute("OriginalMaterial", descendant.Material.Name)
				end
			end
			newModel.Name = player.Name
			if not newModel.PrimaryPart then
				local root = newModel:FindFirstChild("HumanoidRootPart")
				if root then
					newModel.PrimaryPart = root
				end
			end

			local control = controlTemplate:Clone()
			control.Disabled = true
			control.Parent = newModel

			local kaijuName = Instance.new("StringValue")
			kaijuName.Name = "Kaiju"
			kaijuName.Value = selectedCreature.Name
			kaijuName.Parent = newModel

			local levelsFolder = ServerScriptService:FindFirstChild("Levels")
			local levelsTemplate = levelsFolder and levelsFolder:FindFirstChild("Levels")
			local levelsScript
			if levelsTemplate then
				levelsScript = levelsTemplate:Clone()
				levelsScript.Disabled = true
				levelsScript.Parent = newModel
			end

			local spawnCFrame = pickSpawnCFrame(selectedCreature.Name)
			if spawnCFrame then
				newModel:PivotTo(spawnCFrame)
			end

			newModel.Parent = Workspace
			player.Character = newModel
			if oldCharacter and oldCharacter.Parent then
				oldCharacter:Destroy()
			end
			control.Disabled = false
			if levelsScript then
				levelsScript.Disabled = false
			end

			local humanoid = newModel:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
				humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			end
			morphResult:FireClient(player, true, selectedCreature.Name, nil)
			log:info("Morphed " .. player.Name .. " into " .. selectedCreature.Name)
		end)
		if not ok then
			log:warn("Morph failed: " .. tostring(err))
			fail(player, "Server morph error: " .. tostring(err))
		end
	end)

	morphReady.Value = true
	log:info("Morph server ready")
end

return MorphService
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX36">
						<Properties>
							<string name="Name">OceanDepthService</string>
							<ProtectedString name="Source"><![CDATA[local OceanDepthService = { Name = "OceanDepth", Async = true }

local function sameColor(a, b, tolerance)
	return math.abs(a.R - b.R) <= tolerance and math.abs(a.G - b.G) <= tolerance and math.abs(a.B - b.B) <= tolerance
end

function OceanDepthService.Init()
	local cfg = require(script:FindFirstAncestor("Server").Config).OceanDepth
	if not cfg.Enabled or workspace:GetAttribute("OceanDeepened") then
		return
	end

	local floors = {}
	local wedges = {}

	for index, inst in ipairs(game:GetDescendants()) do
		if inst:IsA("WedgePart") then
			table.insert(wedges, inst)
		elseif table.find(cfg.FloorNames, inst.Name) and inst:IsA("BasePart") and inst:IsDescendantOf(workspace) then
			table.insert(floors, inst)
		end
		if index % cfg.YieldEvery == 0 then
			task.wait()
		end
	end

	if #floors == 0 then
		return
	end

	workspace:SetAttribute("OceanDeepened", true)

	local signatures = {}
	for _, floor in ipairs(floors) do
		table.insert(signatures, { Material = floor.Material, Color = floor.Color })
		floor.CFrame = floor.CFrame - Vector3.new(0, cfg.DepthDrop, 0)
	end

	for _, wedge in ipairs(wedges) do
		if wedge.CFrame.UpVector.Y >= cfg.MinUpright then
			for _, signature in ipairs(signatures) do
				if wedge.Material == signature.Material and sameColor(wedge.Color, signature.Color, cfg.ColorTolerance) then
					local cf = wedge.CFrame
					local size = wedge.Size
					wedge.Size = Vector3.new(size.X, size.Y + cfg.WedgeGrow, size.Z)
					wedge.CFrame = cf * CFrame.new(0, -cfg.WedgeGrow / 2, 0)
					break
				end
			end
		end
	end
end

return OceanDepthService
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX37">
						<Properties>
							<string name="Name">SettingsService</string>
							<ProtectedString name="Source"><![CDATA[local SettingsService = { Name = "Settings", Async = true }

function SettingsService.normalizeFov(value, cfg)
	if type(value) ~= "number" or value ~= value then
		return nil
	end
	return math.clamp(value, cfg.MinFov, cfg.MaxFov)
end

function SettingsService:Init()
	local DataStoreService = game:GetService("DataStoreService")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local framework = script:FindFirstAncestor("Server")
	local PlayerHooks = require(framework.Core.PlayerHooks)
	local Util = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Util"))
	local Logger = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Logger"))
	local cfg = require(framework.Config).Settings
	local log = Logger.new("Settings")

	local okStore, store = pcall(function()
		return DataStoreService:GetDataStore(cfg.StoreName)
	end)
	if not okStore then
		log:warn("DataStore unavailable, settings will not persist: " .. tostring(store))
		store = nil
	end

	local values, dirty, saving = {}, {}, {}

	local function keyFor(userId)
		return cfg.KeyPrefix .. userId
	end

	local function save(userId)
		if not store or not dirty[userId] or saving[userId] then
			return
		end
		local fov = values[userId]
		if not fov then
			return
		end
		saving[userId] = true
		local ok, err = Util.retry(function()
			store:SetAsync(keyFor(userId), { fov = fov })
		end, cfg.DataStoreAttempts, 1)
		saving[userId] = nil
		if ok then
			if values[userId] == fov then
				dirty[userId] = nil
			end
		else
			log:warn("Failed to save settings for " .. tostring(userId) .. ": " .. tostring(err))
		end
	end

	PlayerHooks.OnPlayer(function(player)
		local userId = player.UserId
		if not store then
			values[userId] = values[userId] or cfg.DefaultFov
			return
		end
		local ok, data = Util.retry(function()
			return store:GetAsync(keyFor(userId))
		end, cfg.DataStoreAttempts, 1)

		if not player.Parent then
			return
		end
		if dirty[userId] then
			return
		end
		local loaded = ok and type(data) == "table" and SettingsService.normalizeFov(data.fov, cfg)
		values[userId] = loaded or cfg.DefaultFov
		if loaded then
			log:info(("Loaded FOV for %s: %s"):format(player.Name, tostring(loaded)))
		end
	end)

	PlayerHooks.OnRemoving(function(player)
		local userId = player.UserId
		save(userId)
		values[userId] = nil
		dirty[userId] = nil
		saving[userId] = nil
	end)

	game:BindToClose(function()
		for userId in pairs(dirty) do
			save(userId)
		end
	end)

	local remote = ReplicatedStorage:WaitForChild(cfg.RemoteName, cfg.RemoteWaitTimeout)
	if not remote then
		error("remote '" .. cfg.RemoteName .. "' not found in ReplicatedStorage")
	end
	remote.OnServerInvoke = function(player, newFov)
		local normalized = SettingsService.normalizeFov(newFov, cfg)
		if normalized then
			values[player.UserId] = normalized
			dirty[player.UserId] = true
			return true
		end
		return values[player.UserId] or cfg.DefaultFov
	end
end

return SettingsService
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX38">
			<Properties>
				<string name="Name">StarterGui</string>
			</Properties>
			<Item class="LocalScript" referent="RBX39">
				<Properties>
					<string name="Name">ClientHandler</string>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local GuiService = game:GetService("GuiService")
local StarterGui = game:GetService("StarterGui")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local function getCamera()
	return Workspace.CurrentCamera
end

local function waitForLocalPlayer()
	if player then return player end
	return Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
end

player = waitForLocalPlayer()

local function initDisableResetButton()
	task.wait(1)
	local success, err = pcall(function()
		StarterGui:SetCore("ResetButtonCallback", false)
	end)
	if not success then
		warn("Failed to disable reset button: " .. tostring(err))
	end
end

local function initOldCursor()
	local mouse = player:GetMouse()
	mouse.Icon = "http://www.roblox.com/asset/?id=7025168168"
end

local function initGamepassFriends()
	
end

local function initUnderwaterEffect()
	local blur = Lighting:FindFirstChild("UnderwaterBlur")
	local correction = Lighting:FindFirstChild("UnderwaterCorrection")

	if not blur or not correction then
		warn("UnderwaterEffect: UnderwaterBlur or UnderwaterCorrection not found in Lighting")
		return
	end

	local cachedOcean = nil
	RunService.RenderStepped:Connect(function()
		if not cachedOcean or not cachedOcean.Parent or cachedOcean.Parent ~= Workspace then
			cachedOcean = Workspace:FindFirstChild("Ocean")
		end
		local ocean = cachedOcean
		if ocean and ocean:IsA("BasePart") then
			local below = camera.CFrame.Position.Y < ocean.Position.Y
			if blur.Enabled ~= below then blur.Enabled = below end
			if correction.Enabled ~= below then correction.Enabled = below end
		end
	end)
end

local function initCameraToggle()
	local isConsole = GuiService:IsTenFootInterface()
	local maxZoomDistance = isConsole and 200 or 100
	local isHeadMode = false
	local currentHeadPart = nil
	local connections = {}

	local function findHeadPart(character)
		if not character then return nil end
		local fakeHead = character:FindFirstChild("FakeHead")
		if fakeHead and fakeHead:IsA("BasePart") then
			return fakeHead
		end
		local head = character:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			return head
		end
		local headPart = character:FindFirstChild("HeadPart")
		if headPart and headPart:IsA("BasePart") then
			return headPart
		end
		return nil
	end

	local function enforceMaxZoom()
		player.CameraMaxZoomDistance = maxZoomDistance
		player.CameraMinZoomDistance = 0.5
	end

	local function updateCameraSubject()
		if player:GetAttribute("MenuCameraActive") then return end
		local character = player.Character
		if not character then return end
		local cam = getCamera()
		if not cam then return end

		if isHeadMode then
			local headPart = findHeadPart(character)
			if headPart then
				currentHeadPart = headPart
				cam.CameraSubject = headPart
			else
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					cam.CameraSubject = humanoid
				end
				currentHeadPart = nil
			end
		else
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				cam.CameraSubject = humanoid
			end
			currentHeadPart = nil
		end
	end

	local function startHeadMonitor(character)
		if connections.headMonitor then
			connections.headMonitor:Disconnect()
		end
		connections.headMonitor = RunService.Heartbeat:Connect(function()
			if not isHeadMode then return end
			if player:GetAttribute("MenuCameraActive") then return end
			if not character or not character.Parent then return end
			if currentHeadPart and currentHeadPart.Parent then return end
			local newHeadPart = findHeadPart(character)
			if newHeadPart and newHeadPart ~= currentHeadPart then
				currentHeadPart = newHeadPart
				local cam = getCamera()
				if cam then
					cam.CameraSubject = newHeadPart
				end
			end
		end)
	end

	local function onCharacterAdded(character)
		enforceMaxZoom()
		updateCameraSubject()
		startHeadMonitor(character)
		character.ChildAdded:Connect(function(child)
			if isHeadMode and (child.Name == "FakeHead" or child.Name == "Head" or child.Name == "HeadPart") then
				if child:IsA("BasePart") and not player:GetAttribute("MenuCameraActive") then
					currentHeadPart = child
					local cam = getCamera()
					if cam then
						cam.CameraSubject = child
					end
				end
			end
			if child:IsA("Humanoid") then
				enforceMaxZoom()
			end
		end)
		character.ChildRemoved:Connect(function(child)
			if isHeadMode and child == currentHeadPart then
				task.wait(0.1)
				updateCameraSubject()
			end
		end)
	end


	player.CharacterAdded:Connect(onCharacterAdded)
	if player.Character then
		onCharacterAdded(player.Character)
	end

	RunService.Heartbeat:Connect(function()
		local detectedConsole = GuiService:IsTenFootInterface()
		if detectedConsole ~= isConsole then
			isConsole = detectedConsole
			maxZoomDistance = isConsole and 200 or 100
		end
		if player.CameraMaxZoomDistance ~= maxZoomDistance then
			player.CameraMaxZoomDistance = maxZoomDistance
		end
		if player.CameraMinZoomDistance ~= 0.5 then
			player.CameraMinZoomDistance = 0.5
		end
	end)
end

local function initShiftLock()
	local isMobile = UserInputService.TouchEnabled
	local isShiftLocked = false
	local renderConnection = nil
	local TARGET_OFFSET = Vector3.new(9.5, 1.5, 3.5)
	local OFFSET_RATE = 9
	local currentOffset = Vector3.new(0, 0, 0)
	local toggleTime = 0
	local function lerpAngle(a, b, t)
		local diff = (b - a + math.pi) % (2 * math.pi) - math.pi
		return a + diff * t
	end
	

	player:SetAttribute("ShiftLockEnabled", false)
	if not isMobile then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end

	local function getShiftLockButton()
		local gui = player:FindFirstChild("PlayerGui")
		if not gui then return nil end
		local gameGui = gui:FindFirstChild("GameGui")
		if not gameGui then return nil end
		local mainFrame = gameGui:FindFirstChild("MainFrame")
		if not mainFrame then return nil end
		local interface = mainFrame:FindFirstChild("Interface")
		if not interface then return nil end
		local mobile = interface:FindFirstChild("Mobile")
		if not mobile then return nil end
		return mobile:FindFirstChild("ShiftLock")
	end

	local function getCtrlLockButton()
		local gui = player:FindFirstChild("PlayerGui")
		if not gui then return nil end
		local gameGui = gui:FindFirstChild("GameGui")
		if not gameGui then return nil end
		local mainFrame = gameGui:FindFirstChild("MainFrame")
		if not mainFrame then return nil end
		local interface = mainFrame:FindFirstChild("Interface")
		if not interface then return nil end
		local buttons = interface:FindFirstChild("Buttons")
		if not buttons then return nil end
		return buttons:FindFirstChild("CtrlLock")
	end

	local function ensureRender()
		if renderConnection then return end
		renderConnection = RunService.RenderStepped:Connect(function(dt)
			dt = math.clamp(dt, 0, 0.1)
			local target = isShiftLocked and TARGET_OFFSET or Vector3.new(0, 0, 0)
			currentOffset = currentOffset:Lerp(target, 1 - math.exp(-OFFSET_RATE * dt))
			if isShiftLocked then
				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local hrp = character and character:FindFirstChild("HumanoidRootPart")
				if humanoid and hrp then
					humanoid.AutoRotate = false
					local lookVector = camera.CFrame.LookVector
					local targetYaw = math.atan2(-lookVector.X, -lookVector.Z)
					local currentLook = hrp.CFrame.LookVector
					local currentYaw = math.atan2(-currentLook.X, -currentLook.Z)
					local t = math.clamp((tick() - toggleTime) / 0.35, 0, 1)
					local rate = 8 + 72 * t * t
					local yaw = lerpAngle(currentYaw, targetYaw, 1 - math.exp(-rate * dt))
					hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, yaw, 0)
				end
			end
			if currentOffset.Magnitude > 0.01 then
				camera.CFrame = camera.CFrame * CFrame.new(currentOffset)
			elseif not isShiftLocked then
				currentOffset = Vector3.new(0, 0, 0)
				if renderConnection then
					renderConnection:Disconnect()
					renderConnection = nil
				end
			end
		end)
	end

	local function stopRotation()
		local character = player.Character
		if character then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.AutoRotate = true
			end
		end
	end

	local function startRotation()
		ensureRender()
	end

	local ctrlLockNormalImage = "rbxassetid://5044539836"
	local ctrlLockHoverImage = "rbxassetid://5044539486"

	local function updateCtrlLockVisuals()
		local button = getCtrlLockButton()
		if button then
			button.Image = isShiftLocked and ctrlLockHoverImage or ctrlLockNormalImage
		end
	end

	local function setShiftLock(enabled)
		isShiftLocked = enabled
		toggleTime = tick()
		player:SetAttribute("ShiftLockEnabled", enabled)
		if enabled then
			if not isMobile then
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			end
			startRotation()
		else
			if not isMobile then
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			end
			stopRotation()
		end
		updateCtrlLockVisuals()
	end

	local function connectMobileButton()
		local button = getShiftLockButton()
		if button then
			button.MouseButton1Click:Connect(function()
				setShiftLock(not isShiftLocked)
			end)
			return true
		end
		return false
	end

	local function connectCtrlLockButton()
		local button = getCtrlLockButton()
		if button then
			button.MouseButton1Click:Connect(function()
				setShiftLock(not isShiftLocked)
			end)
			return true
		end
		return false
	end

	if not isMobile then
		UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end
			if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
				setShiftLock(not isShiftLocked)
			end
		end)
	end

	player.CharacterAdded:Connect(function(character)
		task.wait(0.1)
		if isShiftLocked then
			startRotation()
		else
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.AutoRotate = true
			end
		end
	end)

	task.spawn(function()
		for i = 1, 20 do
			if connectMobileButton() then break end
			task.wait(0.5)
		end
	end)

	task.spawn(function()
		for i = 1, 20 do
			if connectCtrlLockButton() then break end
			task.wait(0.5)
		end
	end)

	if player.Character and isShiftLocked then
		startRotation()
	end
end

local function safeInit(name, func)
	local success, err = pcall(func)
	if not success then
		warn("ClientHandler: " .. name .. " failed: " .. tostring(err))
	end
end

task.spawn(function()
	safeInit("DisableResetButton", initDisableResetButton)
end)

task.spawn(function()
	safeInit("OldCursor", initOldCursor)
end)

task.spawn(function()
	safeInit("GamepassFriends", initGamepassFriends)
end)

task.spawn(function()
	safeInit("UnderwaterEffect", initUnderwaterEffect)
end)

task.spawn(function()
	safeInit("CameraToggle", initCameraToggle)
end)

task.spawn(function()
	safeInit("ShiftLock", initShiftLock)
end)

task.spawn(function()
	local CollectionService = game:GetService("CollectionService")
	local UserInputService = game:GetService("UserInputService")
	local okQuality, quality = pcall(function()
		return UserSettings().GameSettings.SavedQualityLevel.Value
	end)
	local lowEnd = UserInputService.TouchEnabled or (okQuality and quality > 0 and quality <= 4)
	local MAX_LIGHTS = lowEnd and 20 or 60
	local MAX_DISTANCE = lowEnd and 160 or 300
	local TAG = "BuildingGlowLight"
	local lights = {}
	local entries = {}

	local function add(light)
		if light:IsA("PointLight") then lights[light] = true end
	end

	for _, light in CollectionService:GetTagged(TAG) do add(light) end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(add)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(light)
		lights[light] = nil
	end)

	while true do
		task.wait(0.5)
		local cam = workspace.CurrentCamera
		if cam then
			local origin = cam.CFrame.Position
			table.clear(entries)
			for light in lights do
				local part = light.Parent
				if part and part:IsA("BasePart") then
					local d = (part.Position - origin).Magnitude
					if d <= MAX_DISTANCE then
						table.insert(entries, { light, d })
					elseif light.Enabled then
						light.Enabled = false
					end
				else
					lights[light] = nil
				end
			end
			table.sort(entries, function(a, b) return a[2] < b[2] end)
			for i, entry in entries do
				local on = i <= MAX_LIGHTS
				if entry[1].Enabled ~= on then entry[1].Enabled = on end
			end
		end
	end
end)
