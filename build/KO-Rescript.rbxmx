<roblox version="4">
	<Item class="Folder" referent="RBX1">
		<Properties>
			<string name="Name">KO-Rescript</string>
		</Properties>
		<Item class="Folder" referent="RBX2">
			<Properties>
				<string name="Name">ReplicatedStorage</string>
			</Properties>
			<Item class="Script" referent="RBX3">
				<Properties>
					<string name="Name">DPSTemplate</string>
					<token name="RunContext">0</token>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local attackerName = script:GetAttribute("Attacker")
local BeamSystem = nil
task.spawn(function()
	local module = ReplicatedStorage:WaitForChild("BeamSystem", 10)
	if module then
		local ok, result = pcall(require, module)
		if ok then BeamSystem = result end
	end
end)
local Knockback = nil
task.spawn(function()
	local module = ReplicatedStorage:WaitForChild("Knockback", 10)
	if module then
		local ok, result = pcall(require, module)
		if ok then Knockback = result end
	end
end)
local hitDebounce = {}


local charRadiusCache = {}
local function getCharRadius(char)
	local cached = charRadiusCache[char]
	if cached then return cached end
	local ok, size = pcall(function()
		local _, s = char:GetBoundingBox()
		return s
	end)
	local radius = (ok and size) and math.max(size.X, size.Y, size.Z) / 2 or 30
	charRadiusCache[char] = radius
	return radius
end

local function characterTouchesHitbox(char, hitbox)
	local cf = hitbox.CFrame
	local half = hitbox.Size / 2
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			local lp = cf:PointToObjectSpace(part.Position)
			local r = part.Size.Magnitude / 2
			if math.abs(lp.X) <= half.X + r and math.abs(lp.Y) <= half.Y + r and math.abs(lp.Z) <= half.Z + r then
				return true
			end
		end
	end
	return false
end

local function awardGCells(attacker, at)
	local leaderstats = attacker:FindFirstChild("leaderstats")
	if leaderstats then
		local gcells = leaderstats:FindFirstChild("GCells") or leaderstats:FindFirstChild("gcells")
		if gcells and gcells:IsA("IntValue") then
			local amount = math.floor(2 * (_G.RewardScale and _G.RewardScale(attacker, at, false) or 1) + math.random())
			if amount <= 0 then return end
			if _G.GCellGuardAllow then _G.GCellGuardAllow(gcells, amount) end
			gcells.Value = gcells.Value + amount
			if _G.ShowIndicator then _G.ShowIndicator(attacker, 0, amount, 0, at) end
		end
	end
end

local DAMAGE_INTERVAL = 0.1

local beamDuration = script:GetAttribute("BeamDuration") or 6
local beamDamage = script:GetAttribute("BeamDamage") or 0

local DAMAGE_AMOUNT
if beamDamage > 0 then
	local numTicks = beamDuration / DAMAGE_INTERVAL
	DAMAGE_AMOUNT = beamDamage / numTicks
else
	DAMAGE_AMOUNT = 6
end

local MAX_LIFETIME = beamDuration + 5
task.delay(MAX_LIFETIME, function()
	if script.Parent and script.Parent.Parent then
		script.Parent:Destroy()
	end
end)

task.spawn(function()
	while script.Parent and script.Parent.Parent do
		local hitbox = script.Parent
		if not hitbox:IsA("BasePart") then break end

		local attacker = Players:FindFirstChild(attackerName)
		if attacker then
			local attackerChar = attacker.Character
			local hitboxPos = hitbox.Position
			local hitRadius = hitbox.Size.Magnitude / 2

			
			
			for _, player in ipairs(Players:GetPlayers()) do
				local char = player.Character
				if char and char ~= attackerChar then
					if not hitDebounce[char] then
						local humanoid = char:FindFirstChildOfClass("Humanoid")
						if humanoid and humanoid.Health > 0 then
							local hrp = char:FindFirstChild("HumanoidRootPart")
							if hrp then
								if characterTouchesHitbox(char, hitbox) then
									hitDebounce[char] = true

									humanoid:SetAttribute("LastDPSAttacker", attacker.UserId)
									humanoid.Health = humanoid.Health - DAMAGE_AMOUNT
									if _G.ShowIndicator then _G.ShowIndicator(attacker, DAMAGE_AMOUNT, 0, 0, char) end
									awardGCells(attacker, char)
									if Knockback and attackerChar then
										Knockback.push(char, attackerChar, "beam")
									end
									if BeamSystem and BeamSystem.ApplyBeamSlow then
										BeamSystem.ApplyBeamSlow(humanoid)
									end

									task.spawn(function()
										task.wait(DAMAGE_INTERVAL)
										hitDebounce[char] = nil
									end)
								end
							end
						end
					end
				end
				end
			end

		
		for char in pairs(charRadiusCache) do
			if not char.Parent then
				charRadiusCache[char] = nil
			end
		end

		task.wait(0.1)
	end
end)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX4">
				<Properties>
					<string name="Name">Knockback</string>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Knockback = {}

local SETTINGS = {
	attack = { speed = 95, lift = 14 },
	beam = { speed = 6, lift = 0 },
}
if RunService:IsServer() then
	local remote = ReplicatedStorage:FindFirstChild("KnockbackEvent")
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = "KnockbackEvent"
		remote.Parent = ReplicatedStorage
	end

	function Knockback.push(targetChar, sourceChar, kind)
		local setting = SETTINGS[kind]
		local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
		local sourceRoot = sourceChar and sourceChar:FindFirstChild("HumanoidRootPart")
		if not setting or not targetRoot or not sourceRoot then return end
		local flat = Vector3.new(targetRoot.Position.X - sourceRoot.Position.X, 0, targetRoot.Position.Z - sourceRoot.Position.Z)
		if flat.Magnitude < 0.01 then return end
		local vec = flat.Unit * setting.speed + Vector3.new(0, setting.lift, 0)
		local player = Players:GetPlayerFromCharacter(targetChar)
		if player then
			remote:FireClient(player, vec)
		else
			targetRoot.AssemblyLinearVelocity = targetRoot.AssemblyLinearVelocity + vec
		end
	end
else
	local remote = ReplicatedStorage:WaitForChild("KnockbackEvent")
	local MAX_FLAT_SPEED = 140
	local active = nil
	local mover = nil

	local function getMover(root)
		if mover and mover.Parent == root then
			return mover
		end
		local attachment = root:FindFirstChild("RootAttachment") or root:FindFirstChildOfClass("Attachment")
		if not attachment then
			attachment = Instance.new("Attachment")
			attachment.Name = "KnockbackAttachment"
			attachment.Parent = root
		end
		mover = Instance.new("LinearVelocity")
		mover.Name = "KnockbackMover"
		mover.Attachment0 = attachment
		mover.RelativeTo = Enum.ActuatorRelativeTo.World
		mover.ForceLimitMode = Enum.ForceLimitMode.PerAxis
		mover.MaxAxesForce = Vector3.new(math.huge, 0, math.huge)
		mover.Enabled = false
		mover.Parent = root
		return mover
	end

	local function clearActive()
		active = nil
		if mover then
			mover.Enabled = false
		end
	end

	remote.OnClientEvent:Connect(function(vec)
		local player = Players.LocalPlayer
		local character = player and player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid or humanoid.Health <= 0 or humanoid.PlatformStand or typeof(vec) ~= "Vector3" then
			return
		end
		local now = os.clock()
		local flat = Vector3.new(vec.X, 0, vec.Z)
		local duration = flat.Magnitude > 20 and 0.45 or 0.15
		local carried = Vector3.zero
		if active then
			carried = active.vel * math.clamp((active.untilT - now) / active.duration, 0, 1)
		end
		local total = carried + flat
		if total.Magnitude > MAX_FLAT_SPEED then
			total = total.Unit * MAX_FLAT_SPEED
		end
		active = { vel = total, untilT = now + duration, duration = duration }
		if vec.Y > 0 then
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v.X, math.max(v.Y, vec.Y), v.Z)
		end
	end)

	RunService.Heartbeat:Connect(function()
		if not active then return end
		local player = Players.LocalPlayer
		local character = player and player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local now = os.clock()
		if not root or not humanoid or humanoid.PlatformStand or now >= active.untilT then
			clearActive()
			return
		end
		local frac = (active.untilT - now) / active.duration
		local walk = humanoid.MoveDirection * humanoid.WalkSpeed
		local m = getMover(root)
		m.VectorVelocity = Vector3.new(walk.X, 0, walk.Z) + active.vel * frac
		m.Enabled = true
	end)
end

return Knockback
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
</roblox>
