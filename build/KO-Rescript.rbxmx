		SplashPerSpeed = 1.5,
		SplashMinCount = 6,
		SplashMaxCount = 80,
		SplashCooldown = 0.5,
		WakeLifetime = 1.6,
		FoamColor = Color3.fromRGB(235, 248, 255),
		SprayColor = Color3.fromRGB(190, 225, 245),
	},
}
]]></ProtectedString>
