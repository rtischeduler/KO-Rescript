		MaxFov = 120,
		DataStoreAttempts = 3,
		RemoteWaitTimeout = 60,
	},

	LegacyModules = { "Character", "Combat", "Data", "World" },

	OceanDepth = {
		Enabled = true,
		FloorName = "Bottom",
		DepthDrop = 120,
		WedgeGrow = 120,
		ColorTolerance = 0.02,
