				<Item class="ModuleScript" referent="RBX11">
					<Properties>
						<string name="Name">Lifecycle</string>
						<ProtectedString name="Source"><![CDATA[local Lifecycle = {}
Lifecycle.__index = Lifecycle

function Lifecycle.new(log, options)
	options = options or {}
	return setmetatable({
		_entries = {},
		_byName = {},
		_failed = {},
		_ordered = {},
		_log = log,
		_spawn = options.spawn,
		status = {},
	}, Lifecycle)
end

function Lifecycle:Register(def)
	assert(type(def) == "table" and type(def.Name) == "string", "service definition needs a string Name")
	assert(not self._byName[def.Name], "duplicate service: " .. def.Name)
	table.insert(self._entries, def)
	self._byName[def.Name] = def
	self.status[def.Name] = "registered"
	return def
end

function Lifecycle:_order()
	local ordered, state = {}, {}

	local function fail(def, reason)
		if self._failed[def.Name] then
			return false
		end
		state[def.Name] = "failed"
		self._failed[def.Name] = true
		self.status[def.Name] = "failed: " .. reason
		self._log:warn(def.Name .. " not started (" .. reason .. ")")
		return false
	end

	local function visit(def)
		local current = state[def.Name]
		if current == "done" then
			return true
		end
		if current == "failed" then
			return false
		end
		if current == "visiting" then
			return fail(def, "dependency cycle")
		end
		state[def.Name] = "visiting"
		for _, depName in ipairs(def.Requires or {}) do
			local dep = self._byName[depName]
			if not dep then
				return fail(def, "missing dependency " .. depName)
			end
			if not visit(dep) then
				return fail(def, "dependency " .. depName .. " unavailable")
			end
		end
		state[def.Name] = "done"
		table.insert(ordered, def)
		return true
	end

	for _, def in ipairs(self._entries) do
		visit(def)
	end
	return ordered
end

function Lifecycle:_initOne(def)
	for _, depName in ipairs(def.Requires or {}) do
		if self._failed[depName] then
			self._failed[def.Name] = true
			self.status[def.Name] = "skipped: " .. depName .. " failed"
			self._log:warn(def.Name .. " skipped because " .. depName .. " failed")
			return
		end
	end

	if type(def.Init) ~= "function" then
		self.status[def.Name] = "initialised"
		return
	end

	local function run()
		self.status[def.Name] = "initialising"
		local ok, err = pcall(def.Init, def)
		if ok then
			self.status[def.Name] = "initialised"
		else
			self._failed[def.Name] = true
			self.status[def.Name] = "failed: " .. tostring(err)
			self._log:warn(def.Name .. " failed to initialise: " .. tostring(err))
		end
	end

	if def.Async then
		(self._spawn or task.spawn)(run)
	else
		run()
	end
end

function Lifecycle:InitAll()
	self._ordered = self:_order()
	for _, def in ipairs(self._ordered) do
		self:_initOne(def)
	end
end

function Lifecycle:StartAll()
	for _, def in ipairs(self._ordered) do
		if type(def.Start) == "function" and not self._failed[def.Name] then
			(self._spawn or task.spawn)(function()
				local ok, err = pcall(def.Start, def)
				if not ok then
					self.status[def.Name] = "start failed: " .. tostring(err)
					self._log:warn(def.Name .. " failed to start: " .. tostring(err))
				end
			end)
		end
	end
end

function Lifecycle:Report()
	local lines = {}
	for _, def in ipairs(self._entries) do
		table.insert(lines, ("  %-12s %s"):format(def.Name, self.status[def.Name] or "unknown"))
	end
	return table.concat(lines, "\n")
end

return Lifecycle
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX12">
					<Properties>
						<string name="Name">Logger</string>
						<ProtectedString name="Source"><![CDATA[local Logger = {}
Logger.__index = Logger

function Logger.new(tag)
	return setmetatable({ tag = tag }, Logger)
end

function Logger:info(message)
	print(("[%s] %s"):format(self.tag, tostring(message)))
end

function Logger:warn(message)
	warn(("[%s] %s"):format(self.tag, tostring(message)))
end

return Logger
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX13">
					<Properties>
						<string name="Name">Util</string>
						<ProtectedString name="Source"><![CDATA[local Util = {}

function Util.getOrCreate(parent, className, name)
	local object = parent:FindFirstChild(name)
	if object and not object:IsA(className) then
		object:Destroy()
		object = nil
	end
	if not object then
		object = Instance.new(className)
		object.Name = name
		object.Parent = parent
	end
	return object
end

function Util.lowerSet(list)
	local set = {}
	for _, value in ipairs(list) do
		set[string.lower(tostring(value))] = true
	end
	return set
end

function Util.retry(fn, attempts, delaySeconds, waitFn)
	waitFn = waitFn or task.wait
	local lastError
	for attempt = 1, attempts do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastError = result
		if attempt < attempts then
			waitFn(delaySeconds * attempt)
		end
	end
	return false, lastError
end

function Util.spawn(log, name, fn, ...)
	task.spawn(function(...)
		local ok, err = pcall(fn, ...)
		if not ok then
			log:warn(name .. " failed: " .. tostring(err))
		end
	end, ...)
end

return Util
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX14">
			<Properties>
				<string name="Name">ServerScriptService</string>
			</Properties>
			<Item class="Folder" referent="RBX15">
				<Properties>
					<string name="Name">framework</string>
				</Properties>
				<Item class="Folder" referent="RBX16">
					<Properties>
						<string name="Name">modules</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX17">
						<Properties>
							<string name="Name">Character</string>
							<ProtectedString name="Source"><![CDATA[
local Character = {}

function Character.Init()
	
	local GamepassWhitelist = {
		[274893778] = true
	}

	local function initLoad()
		local Players = game:GetService("Players")
		Players.CharacterAutoLoads = false
	end


	local function initMorph()
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local ServerScriptService = game:GetService("ServerScriptService")
		if ServerScriptService:FindFirstChild("MorphBootstrap") or ServerScriptService:GetAttribute("MorphBootstrapActive") then return end


		local morphReady = ReplicatedStorage:FindFirstChild("MorphReady")
		if morphReady and not morphReady:IsA("BoolValue") then
			morphReady:Destroy()
			morphReady = nil
		end
		if not morphReady then
			morphReady = Instance.new("BoolValue")
			morphReady.Name = "MorphReady"
			morphReady.Parent = ReplicatedStorage
		end
		morphReady.Value = false
		morphReady:SetAttribute("Error", nil)

		local morphSupplies = ReplicatedStorage:FindFirstChild("MorphSupplies")
		if not morphSupplies then
			morphSupplies = Instance.new("Folder")
			morphSupplies.Name = "MorphSupplies"
			morphSupplies.Parent = ReplicatedStorage
		end
		local eventsFolder = morphSupplies:FindFirstChild("Events")
		if not eventsFolder then
			eventsFolder = Instance.new("Folder")
			eventsFolder.Name = "Events"
			eventsFolder.Parent = morphSupplies
		end
		local event = eventsFolder:FindFirstChild("Fire")
		if event and not event:IsA("RemoteEvent") then
			event:Destroy()
			event = nil
		end
		if not event then
			event = Instance.new("RemoteEvent")
			event.Name = "Fire"
			event.Parent = eventsFolder
		end

		local securityOk, SecurityPolicy = pcall(function()
			return require(ServerScriptService:WaitForChild("SecurityPolicy", 10))
		end)
		if not securityOk or type(SecurityPolicy) ~= "table" or type(SecurityPolicy.CanUseMorph) ~= "function" then
			local errorText = "SecurityPolicy could not be loaded"
			if not securityOk then errorText = tostring(SecurityPolicy) end
			morphReady:SetAttribute("Error", errorText)
			warn("[Character] " .. errorText)
			return
		end

		local morphResultEvent = ReplicatedStorage:FindFirstChild("MorphResult")
		if morphResultEvent and not morphResultEvent:IsA("RemoteEvent") then
			morphResultEvent:Destroy()
			morphResultEvent = nil
		end
		if not morphResultEvent then
			morphResultEvent = Instance.new("RemoteEvent")
			morphResultEvent.Name = "MorphResult"
			morphResultEvent.Parent = ReplicatedStorage
		end

		local TANK_SPAWN_MORPHS = {
			["MILITARY TANK [FREE]"] = true,
			["F16C [FREE]"] = true,
		}

		local RESTRICTED_KAIJU = {
			[string.lower("EVOLVED GOJIRA")] = true,
			[string.lower("D.E.M.O.N")] = true,
			[string.lower("Homelander")] = true,
			[string.lower("d")] = true,
			[string.lower("A-train")] = true,
			[string.lower("e")] = true,
			[string.lower("MG21")] = true,
		}

		local ALLOWED_PLAYERS = {
			[string.lower("AthosGame2023")] = true,
			[string.lower("mr_bolde2")] = true,
			[string.lower("DenisTheCheeseKing")] = true,
			[string.lower("BlueEnderCookie_2")] = true,
		}

		event.OnServerEvent:Connect(function(player, selectedCreature)
			local ok, err = pcall(function()
				local morphFolder = ReplicatedStorage:FindFirstChild("MorphSupplies")
				morphFolder = morphFolder and morphFolder:FindFirstChild("Morphs")
				if type(selectedCreature) == "string" and morphFolder then
					selectedCreature = morphFolder:FindFirstChild(selectedCreature, true)
				end
				if typeof(selectedCreature) ~= "Instance" or not selectedCreature:IsA("Model") then
					morphResultEvent:FireClient(player, false, "Invalid morph")
					return
				end
				if not SecurityPolicy.CanUseMorph(player, selectedCreature) then
					warn("[SecurityPolicy] Rejected unauthorized morph request from " .. player.Name)
					morphResultEvent:FireClient(player, false, "You do not own this kaiju")
					return
				end
				local controlTemplate = ReplicatedStorage:FindFirstChild("PlayerScripts")
				controlTemplate = controlTemplate and controlTemplate:FindFirstChild("Control")
				if not controlTemplate then
					morphResultEvent:FireClient(player, false, "Control script missing")
					return
				end

				if selectedCreature and RESTRICTED_KAIJU[string.lower(selectedCreature.Name)] then
					if not ALLOWED_PLAYERS[string.lower(player.Name)] then
						player:Kick("You cannot use this kaiju.")
						return
					end
				end

				local newModel = selectedCreature:Clone()
				local oldCharacter = player.Character

				for _, desc in ipairs(newModel:GetDescendants()) do
					if desc:IsA("BasePart") then
						desc:SetAttribute("OriginalColor", desc.Color)
						desc:SetAttribute("OriginalMaterial", desc.Material.Name)
					end
				end

				newModel.Name = player.Name

				if not newModel.PrimaryPart then
					local hrp = newModel:FindFirstChild("HumanoidRootPart")
					if hrp then
						newModel.PrimaryPart = hrp
					end
				end

				local Control = controlTemplate:Clone()
				Control.Disabled = true
				Control.Parent = newModel

				local KaijuName = Instance.new("StringValue")
				KaijuName.Parent = newModel
				KaijuName.Name = "Kaiju"
				KaijuName.Value = selectedCreature.Name

				local clonedLevelsScript
				local LevelsScript = ServerScriptService:FindFirstChild("Levels") and ServerScriptService.Levels:FindFirstChild("Levels")
				if LevelsScript then
					clonedLevelsScript = LevelsScript:Clone()
					clonedLevelsScript.Disabled = true
					clonedLevelsScript.Parent = newModel
				end

				local spawnCFrame = nil
				local morphName = selectedCreature.Name

				if TANK_SPAWN_MORPHS[morphName] then
					local tankSpawns = workspace:FindFirstChild("TankSpawns")
					if tankSpawns then
						local spawns = tankSpawns:GetChildren()
						if #spawns > 0 then
							local randomSpawn = spawns[math.random(1, #spawns)]
							if randomSpawn:IsA("BasePart") then
								spawnCFrame = randomSpawn.CFrame + Vector3.new(0, 10, 0)
							end
						end
					end
				end

				if not spawnCFrame then
					local spawnPoints = workspace:FindFirstChild("SpawnPoints")
					if spawnPoints then
						local spawns = spawnPoints:GetChildren()
						if #spawns > 0 then
							local randomSpawn = spawns[math.random(1, #spawns)]
							if randomSpawn:IsA("BasePart") then
								spawnCFrame = randomSpawn.CFrame + Vector3.new(0, 50, 0)
							end
						end
					end
				end

				if spawnCFrame then
					newModel:PivotTo(spawnCFrame)
				end

				newModel.Parent = game.Workspace
				player.Character = newModel
				if oldCharacter and oldCharacter.Parent then
					oldCharacter:Destroy()
				end
				Control.Disabled = false
				if clonedLevelsScript then
					clonedLevelsScript.Disabled = false
				end

				local humanoid = newModel:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
					humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				end

				morphResultEvent:FireClient(player, true, selectedCreature.Name)
				print("Successfully morphed the player!")
			end)
			if not ok then
				warn("[Character] Morph failed: " .. tostring(err))
				morphResultEvent:FireClient(player, false, "Server morph error: " .. tostring(err))
			end
		end)
	end



	local function initCleanup()
		local Players = game:GetService("Players")

		local function onCharacterAdded(character)
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if not humanoid then
				humanoid = character:WaitForChild("Humanoid", 5)
				if not humanoid then return end
			end

			humanoid.Died:Connect(function()
				task.wait(4)
				if character and character.Parent then
					for _, desc in ipairs(character:GetDescendants()) do
						if desc:IsA("BasePart") then
							desc.CanTouch = false
							desc.CanQuery = false
							desc.Transparency = 1
						elseif desc:IsA("ParticleEmitter") or desc:IsA("Fire") or desc:IsA("Smoke") or desc:IsA("Trail") or desc:IsA("Beam") then
							desc.Enabled = false
						end
					end
				end
			end)
		end

		local function onPlayerAdded(player)
			player.CharacterAdded:Connect(onCharacterAdded)
		end

		Players.PlayerAdded:Connect(onPlayerAdded)

		for _, player in Players:GetPlayers() do
			onPlayerAdded(player)
		end
	end


	local function initBlood()
		local Players = game:GetService("Players")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local Workspace = game:GetService("Workspace")

		Workspace.DescendantAdded:Connect(function(descendant)
			if descendant:IsA("BasePart") and descendant.Name == "AttackHitbox" and descendant:GetAttribute("MeleeHit") then
				local attackerChar = descendant.Parent
				if attackerChar then
					attackerChar:SetAttribute("MeleeHit", true)
					task.delay(0.6, function()
						if attackerChar and attackerChar.Parent then
							attackerChar:SetAttribute("MeleeHit", nil)
						end
					end)
				end
			end
		end)

		for _, descendant in ipairs(Workspace:GetDescendants()) do
			if descendant:IsA("BasePart") and descendant.Name == "AttackHitbox" and descendant:GetAttribute("MeleeHit") then
				local attackerChar = descendant.Parent
				if attackerChar then
					attackerChar:SetAttribute("MeleeHit", true)
					task.delay(0.6, function()
						if attackerChar and attackerChar.Parent then
							attackerChar:SetAttribute("MeleeHit", nil)
						end
					end)
				end
			end
		end

		local function spawnBlood(character)
			local bloodTemplate = ReplicatedStorage:FindFirstChild("Blood")
			if not bloodTemplate then return end

			local targetPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
			if not targetPart then return end

			local bloodClone = bloodTemplate:Clone()
			bloodClone.CFrame = CFrame.new(0, 0, 0)
			bloodClone.Visible = true
			bloodClone.Parent = targetPart
			for _, child in ipairs(bloodClone:GetChildren()) do
				if child:IsA("ParticleEmitter") then
					child.Enabled = true
				end
			end
			task.delay(0.7, function()
				if bloodClone and bloodClone.Parent then
					for _, child in ipairs(bloodClone:GetChildren()) do
						if child:IsA("ParticleEmitter") then
							child.Rate = 0
						end
					end
					task.delay(1, function()
						if bloodClone and bloodClone.Parent then
							bloodClone.Parent = nil
						end
					end)
				end
			end)
		end

		local function monitorCharacter(character)
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if not humanoid then return end

			local prevHealth = humanoid.Health

			humanoid.HealthChanged:Connect(function(newHealth)
				if newHealth >= prevHealth then
					prevHealth = newHealth
					return
				end

				prevHealth = newHealth

				local creator = humanoid:FindFirstChild("creator")
				if not creator or not creator.Value then return end

				local attackerPlayer = creator.Value
				if not attackerPlayer or not attackerPlayer:IsA("Player") then return end

				local attackerChar = attackerPlayer.Character
				if not attackerChar then return end

				if attackerChar:GetAttribute("MeleeHit") then
					spawnBlood(character)
				end
			end)
		end

		local function onPlayerAdded(player)
			player.CharacterAdded:Connect(monitorCharacter)
			if player.Character then
				monitorCharacter(player.Character)
			end
		end

		Players.PlayerAdded:Connect(onPlayerAdded)
		for _, player in ipairs(Players:GetPlayers()) do
			onPlayerAdded(player)
		end
	end





	local function initTags()
		local Players = game:GetService("Players")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")

		local TAG_TEMPLATE = ReplicatedStorage:FindFirstChild("Tag")

		local function getLevelValue(player, character)
			local leaderstats = player:FindFirstChild("leaderstats")
			if leaderstats then
				local lvl = leaderstats:FindFirstChild("Level")
				if lvl then return lvl end
			end
			if character then
				local lvl = character:FindFirstChild("Level")
				if lvl then return lvl end
			end
			return nil
		end

		local function giveTag(player)
			local character = player.Character
			if not character then return end

			local head = character:FindFirstChild("Head")
			if not head then return end

			local existingTag = head:FindFirstChild("Tag")
			if existingTag then existingTag.Parent = nil end

			if not TAG_TEMPLATE then return end

			local tag = TAG_TEMPLATE:Clone()
			tag.Name = "Tag"
			tag.Parent = head

			local nameLabel = tag:FindFirstChild("Name")
			if nameLabel then
				nameLabel.Text = player.DisplayName
			end

			local levelLabel = tag:FindFirstChild("Level")
			if levelLabel then
				local levelVal = getLevelValue(player, character)
				levelLabel.Text = "Level " .. tostring(levelVal and levelVal.Value or 1)

				if levelVal then
					levelVal.Changed:Connect(function(newVal)
						if tag.Parent then
							levelLabel.Text = "Level " .. tostring(newVal)
						end
					end)
				end

				character.ChildAdded:Connect(function(child)
					if child.Name == "Level" and child:IsA("IntValue") then
						levelLabel.Text = "Level " .. tostring(child.Value)
						child.Changed:Connect(function(newVal)
							if tag.Parent then
								levelLabel.Text = "Level " .. tostring(newVal)
							end
						end)
					end

					local leaderstats = player:FindFirstChild("leaderstats")
					if leaderstats and child.Parent == leaderstats and child.Name == "Level" then
						levelLabel.Text = "Level " .. tostring(child.Value)
						child.Changed:Connect(function(newVal)
							if tag.Parent then
								levelLabel.Text = "Level " .. tostring(newVal)
							end
						end)
					end
				end)
			end

			local hpLabel = tag:FindFirstChild("HP")
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if hpLabel and humanoid then
				hpLabel.Text = "HP - " .. tostring(math.floor(humanoid.Health))
				humanoid.HealthChanged:Connect(function(newHealth)
					if tag.Parent then
						hpLabel.Text = "HP - " .. tostring(math.floor(newHealth))
					end
				end)
			end

			if humanoid then
				humanoid.Died:Connect(function()
					tag.Parent = nil
				end)
			end
		end

		local function onPlayerAdded(player)
			player.CharacterAdded:Connect(function()
				task.wait(0.1)
				giveTag(player)
			end)

			if player.Character then
				task.wait(0.1)
				giveTag(player)
			end
		end

		Players.PlayerAdded:Connect(onPlayerAdded)

		for _, player in ipairs(Players:GetPlayers()) do
			onPlayerAdded(player)
		end
	end


	local function initHealthDisplay()
		local Players = game:GetService("Players")

		local setHumanoids = {}
		local teleportedPlayers = {}

		local healthTemplate = game.ReplicatedStorage.MorphSupplies.Morphs:FindFirstChild("GOJIRA [FREE]")
		if healthTemplate then
			local characterScripts = healthTemplate:FindFirstChild("CharacterScripts")
			if characterScripts then
				local sounds = characterScripts:FindFirstChild("Sounds")
				if sounds then
					healthTemplate = sounds:FindFirstChild("Health")
				end
			end
		end

		local function createHealthGui()
			local billboardGui = Instance.new("BillboardGui")
			billboardGui.Name = "Health"
			billboardGui.Size = UDim2.new(0, 100, 0, 50)
			billboardGui.StudsOffset = Vector3.new(0, 3, 0)
			billboardGui.AlwaysOnTop = true
			billboardGui.MaxDistance = 150

			local label = Instance.new("TextLabel")
			label.Name = "Label"
			label.Size = UDim2.new(1, 0, 1, 0)
			label.BackgroundTransparency = 0.8
			label.BackgroundColor3 = Color3.fromRGB(115, 115, 115)
			label.TextColor3 = Color3.new(1, 1, 1)
			label.TextScaled = true
			label.TextStrokeTransparency = 0
			label.TextStrokeColor3 = Color3.new(0, 0, 0)
			label.Text = "HP - 100"
			label.Parent = billboardGui

			return billboardGui
		end

		local function updateHealthDisplay(character)
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if not humanoid then return end

			local head = character:FindFirstChild("FakeHead") or character:FindFirstChild("Fakehead") or character:FindFirstChild("Head")
			if not head then return end

			local healthGui = head:FindFirstChild("Health")
			if not healthGui then
				if healthTemplate then
					healthGui = healthTemplate:Clone()
					healthGui.Parent = head
				else
					healthGui = createHealthGui()
					healthGui.Parent = head
				end

				local player = Players:GetPlayerFromCharacter(character)
				if player and not teleportedPlayers[player] then
					teleportedPlayers[player] = true

					local spawnPoints = game.Workspace:FindFirstChild("SpawnPoints")
					if spawnPoints then
						local spawns = spawnPoints:GetChildren()
						if #spawns > 0 then
							local randomSpawn = spawns[math.random(1, #spawns)]
							if randomSpawn:IsA("BasePart") then
								character:PivotTo(randomSpawn.CFrame + Vector3.new(0, 3, 0))
							end
						end
					end
				end
			end

			local label = healthGui:FindFirstChild("Label")
			if label then
				label.Text = "HP - " .. math.floor(humanoid.Health)
			end
		end

		local function setupCharacter(character)
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if not humanoid then return end

			if not setHumanoids[humanoid] then
				local stats = character:FindFirstChild("Stats")
				if stats then
					local maxHP = stats:FindFirstChild("MaxHP")
					if maxHP and maxHP:IsA("ValueBase") then
						humanoid.MaxHealth = maxHP.Value
						humanoid.Health = maxHP.Value
						setHumanoids[humanoid] = true
					end
				end
			end

			updateHealthDisplay(character)

			humanoid.HealthChanged:Connect(function()
				updateHealthDisplay(character)
			end)

			task.spawn(function()
				while character and character.Parent do
					task.wait(0.5)
					updateHealthDisplay(character)
				end
			end)
		end

		local function onPlayerAdded(player)
			player.CharacterAdded:Connect(function(character)
				setupCharacter(character)
			end)

			if player.Character then
				setupCharacter(player.Character)
			end
		end

		for _, player in Players:GetPlayers() do
			onPlayerAdded(player)
		end

		Players.PlayerAdded:Connect(onPlayerAdded)
	end


	task.spawn(initLoad)
	task.spawn(initMorph)
	task.spawn(initCleanup)
	task.spawn(initBlood)
	task.spawn(initTags)
	task.spawn(initHealthDisplay)
end

return Character]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX18">
						<Properties>
							<string name="Name">Combat</string>
							<ProtectedString name="Source"><![CDATA[local Combat = {}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local function safeRequire(name)
	local module = ReplicatedStorage:FindFirstChild(name)
	if not module then return nil end
	local ok, result = pcall(require, module)
	if not ok then
		warn("[Combat] Failed to require " .. name .. ": " .. tostring(result))
		return nil
	end
	return result
end

safeRequire("LevelGuard")
safeRequire("ChargeManager")

local function getOrCreateRemote(name)
	local remote = ReplicatedStorage:FindFirstChild(name)
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = ReplicatedStorage
	end
	return remote
end

local function getGCells(player)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then return nil end
	local gcells = leaderstats:FindFirstChild("GCells") or leaderstats:FindFirstChild("gcells")
	if gcells and gcells:IsA("IntValue") then return gcells end
	return nil
end

local function giveGCells(player, amount, isKillReward, at)
	local gcells = getGCells(player)
	if not gcells then return end
	if isKillReward and _G.SetKillRewardFlag then _G.SetKillRewardFlag(player) end
	if _G.GCellGuardAllow then _G.GCellGuardAllow(gcells, amount) end
	gcells.Value += amount
	if _G.ShowIndicator then _G.ShowIndicator(player, 0, amount, 0, at) end
	if isKillReward and _G.ClearKillRewardFlag then _G.ClearKillRewardFlag(player) end
end

local function giveXP(player, minXP, maxXP, at)
	local character = player.Character
	local addXP = character and character:FindFirstChild("AddXP")
	if addXP and addXP:IsA("BindableEvent") then
		if _G.SetKillRewardFlag then _G.SetKillRewardFlag(player) end
		local xpAmount = math.random(minXP, maxXP)
		addXP:Fire(xpAmount)
		if _G.ShowIndicator then _G.ShowIndicator(player, 0, 0, xpAmount, at) end
		if _G.ClearKillRewardFlag then _G.ClearKillRewardFlag(player) end
	end
end

local function setCreator(humanoid, player)
	local creator = humanoid:FindFirstChild("creator")
	if not creator then
		creator = Instance.new("ObjectValue")
		creator.Name = "creator"
		creator.Parent = humanoid
	end
	creator.Value = player
end

local function resolveAttackers(damages)
	local topKiller, topDamage = nil, 0
	local others = {}
	for attacker, damage in pairs(damages) do
		if damage > topDamage then
			if topKiller then table.insert(others, topKiller) end
			topKiller, topDamage = attacker, damage
		else
			table.insert(others, attacker)
		end
	end
	return topKiller, others
end

local initialized = false

local function initCombat()
	local HEALTH_THRESHOLD = 0.50
	local SLOW_PERCENT = 0.65
	local KILL_REWARD = 300
	local ASSIST_REWARD = 100
	local HEAL_PERCENT_ON_KILL = 0.80
	local KILL_XP_MIN, KILL_XP_MAX = 200, 300
	local ASSIST_XP_MIN, ASSIST_XP_MAX = 50, 100

	local damageLog = {}
	_G.CombatDamageLog = damageLog
	local lastHealth = {}
	local applyingBossBonus = {}
	local restoringHealth = {}
	local setupDone = {}

	local KILL_MESSAGES = {
		"{killer} slimed {victim}",
		"{killer} obliterated {victim}",
		"{killer} sent {victim} to Destoroyah",
		"{killer} cooked {victim}",
		"{killer} absolutely demolished {victim}",
		"{killer} made {victim} rage quit",
		"{killer} blasted {victim} into oblivion",
		"{killer} said goodnight to {victim}",
		"{killer} gave {victim} Ghidorah treatment",
		"{killer} turned {victim} into dust",
		"{killer} showed {victim} no mercy",
		"{killer} made {victim} reconsider their life choices",
		"{victim} got folded by {killer}",
		"{victim} was no match for {killer}",
		"{killer} ended {victim}'s career",
		"{killer} uhh gave laxatives to {victim} and self imploded",
		"{victim} somehow died to {killer}",
		"{victim} did something evil to {killer}",
		"{killer} transmitted a message to {victim} and told them the next kaiju added is going to be Gorosaurus",
		"{victim} used the Mechagodzilla method on {killer} and failed miserabely",
		"{killer} transformed into Lotszilla and took care of  {victim}. ",
		"{killer} found {victim}",
		"{killer} turned {victim} into a burger",
	}

	local function sendKillMessage(killerName, victimName)
		local event = ReplicatedStorage:FindFirstChild("KillMessage")
		if not event then return end
		local template = KILL_MESSAGES[math.random(1, #KILL_MESSAGES)]
		local message = (string.gsub(template, "{(%w+)}", { killer = killerName, victim = victimName }))
		event:FireAllClients(message)
	end

	local function healPlayer(player, percent)
		local character = player.Character
		if not character or character:GetAttribute("BossMode") then return end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then return end
		humanoid.Health = math.min(humanoid.Health + humanoid.MaxHealth * percent, humanoid.MaxHealth)
	end

	local function clearCharacter(character)
		damageLog[character] = nil
		lastHealth[character] = nil
		applyingBossBonus[character] = nil
		restoringHealth[character] = nil
		setupDone[character] = nil
	end

	local function setupCharacter(character)
		if setupDone[character] then return end
		setupDone[character] = true

		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid then
			setupDone[character] = nil
			return
		end

		local isLowHealth = false
		local isApplyingSlow = false
		local baseWalkSpeed = nil
		lastHealth[character] = humanoid.Health
		damageLog[character] = {}

		humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
			if isApplyingSlow or not isLowHealth or not baseWalkSpeed then return end
			local maxAllowed = baseWalkSpeed * (1 - SLOW_PERCENT)
			if humanoid.WalkSpeed > maxAllowed then
				isApplyingSlow = true
				humanoid.WalkSpeed = maxAllowed
				isApplyingSlow = false
			end
		end)

		humanoid.HealthChanged:Connect(function(newHealth)
			if applyingBossBonus[character] or restoringHealth[character] then
				lastHealth[character] = newHealth
				return
			end
			if newHealth <= 0 then return end

			local healthPercent = newHealth / humanoid.MaxHealth
			if healthPercent <= HEALTH_THRESHOLD then
				if not isLowHealth then
					isLowHealth = true
					local beamFactor = humanoid:GetAttribute("BeamSlowFactor") or 1
					baseWalkSpeed = humanoid.WalkSpeed / beamFactor
					humanoid:SetAttribute("Slowed", true)
					isApplyingSlow = true
					humanoid.WalkSpeed = baseWalkSpeed * (1 - SLOW_PERCENT) * beamFactor
					isApplyingSlow = false
				end
			elseif isLowHealth then
				isLowHealth = false
				humanoid:SetAttribute("Slowed", false)
				isApplyingSlow = true
				local beamFactor = humanoid:GetAttribute("BeamSlowFactor") or 1
				humanoid.WalkSpeed = baseWalkSpeed and (baseWalkSpeed * beamFactor) or humanoid.WalkSpeed / (1 - SLOW_PERCENT)
				isApplyingSlow = false
				baseWalkSpeed = nil
			end

			local oldHealth = lastHealth[character] or humanoid.MaxHealth
			if newHealth < oldHealth then
				local damageDealt = oldHealth - newHealth
				local creator = humanoid:FindFirstChild("creator")
				local attacker = creator and creator.Value
				if attacker and attacker:IsA("Player") then
					local bossSystem = _G.BossSystem
					if bossSystem and bossSystem.active then
						local attackerChar = attacker.Character
						local attackerIsBoss = attackerChar and attackerChar:GetAttribute("BossMode")
						local victimIsBoss = character:GetAttribute("BossMode")
						if not victimIsBoss and not attackerIsBoss then
							restoringHealth[character] = true
							humanoid.Health = oldHealth
							restoringHealth[character] = nil
							lastHealth[character] = oldHealth
							return
						end
					end

					local log = damageLog[character]
					if not log then
						log = {}
						damageLog[character] = log
					end
					log[attacker] = (log[attacker] or 0) + damageDealt

					local attackerChar = attacker.Character
					if attackerChar and attackerChar:GetAttribute("BossMode") then
						local bonus = math.floor(damageDealt * 0.5)
						if bonus > 0 then
							task.defer(function()
								if humanoid.Parent and humanoid.Health > 0 then
									applyingBossBonus[character] = true
									humanoid:TakeDamage(bonus)
									applyingBossBonus[character] = nil
									local current = damageLog[character]
									if current then
										current[attacker] = (current[attacker] or 0) + bonus
									end
								end
							end)
						end
					end
				end
			end
			lastHealth[character] = newHealth
		end)

		humanoid.Died:Connect(function()
			local charDamages = damageLog[character]
			if charDamages then
				local topKiller, others = resolveAttackers(charDamages)
				local victimPlayer = Players:GetPlayerFromCharacter(character)
				local victimName = victimPlayer and victimPlayer.Name or character.Name

				if topKiller and topKiller:IsA("Player") then
					sendKillMessage(topKiller.Name, victimName)
					giveGCells(topKiller, KILL_REWARD, true, character)
					if _G.AwardCandy then
						_G.AwardCandy(topKiller, humanoid.MaxHealth, character)
					end
					local stats = topKiller:FindFirstChild("leaderstats")
					local kills = stats and stats:FindFirstChild("Kills")
					if kills and kills:IsA("IntValue") then kills.Value += 1 end
					giveXP(topKiller, KILL_XP_MIN, KILL_XP_MAX, character)
					healPlayer(topKiller, HEAL_PERCENT_ON_KILL)
				end
				for _, attacker in ipairs(others) do
					if attacker ~= topKiller and attacker:IsA("Player") then
						giveGCells(attacker, ASSIST_REWARD, true, character)
						giveXP(attacker, ASSIST_XP_MIN, ASSIST_XP_MAX, character)
					end
				end
			end
			damageLog[character] = nil
			lastHealth[character] = nil
		end)

		character.AncestryChanged:Connect(function(_, parent)
			if not parent then clearCharacter(character) end
		end)
	end

	local function setupPlayer(player)
		player.CharacterAdded:Connect(setupCharacter)
		if player.Character then task.spawn(setupCharacter, player.Character) end
	end

	for _, player in ipairs(Players:GetPlayers()) do setupPlayer(player) end
	Players.PlayerAdded:Connect(setupPlayer)

	Players.PlayerRemoving:Connect(function(player)
		local character = player.Character
		if not character then return end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then return end
		local charDamages = damageLog[character]
		if not charDamages or next(charDamages) == nil then return end

		local damagePercent = 1 - humanoid.Health / humanoid.MaxHealth
		if damagePercent <= 0 then return end

		local topKiller, others = resolveAttackers(charDamages)
		if topKiller and topKiller:IsA("Player") then
			local reward = math.floor(damagePercent * KILL_REWARD)
			if reward > 0 then
				sendKillMessage(topKiller.Name, player.Name)
				giveGCells(topKiller, reward, true, character)
				giveXP(topKiller, KILL_XP_MIN, KILL_XP_MAX, character)
			end
		end
		for _, attacker in ipairs(others) do
			if attacker ~= topKiller and attacker:IsA("Player") then
				local reward = math.floor(damagePercent * ASSIST_REWARD)
				if reward > 0 then
					giveGCells(attacker, reward, true, character)
					giveXP(attacker, ASSIST_XP_MIN, ASSIST_XP_MAX, character)
				end
			end
		end
		damageLog[character] = nil
		lastHealth[character] = nil
	end)
end

local function initAtomicBreath()
	local gojiraModel = workspace:FindFirstChild("GVK GOJIRA", true)
	local model = gojiraModel and gojiraModel:FindFirstChild("AtomicBreath", true)
	if not model then
		warn("[Combat] AtomicBreath model is missing; atomic breath effects disabled")
		return
	end

	local ELECTRIC_BLUE = Color3.fromRGB(0, 191, 255)
	local original = {}
	local sequence = {}

	local function collect(prefix, from, to)
		for i = from, to do
			local spike = model:FindFirstChild(prefix .. i)
			if spike and spike:IsA("BasePart") then
				table.insert(sequence, spike)
				original[spike] = { Color = spike.Color, Material = spike.Material }
			end
		end
	end
	collect("TailSpikes", 1, 11)
	collect("Spikes", 12, 19)

	local function restore(spike)
		local props = original[spike]
		if props and spike.Parent then
			spike.Color, spike.Material = props.Color, props.Material
		end
	end

	_G.AtomicBreathCharge = {
		ChargeUp = function()
			for _, spike in ipairs(sequence) do
				if spike.Parent then
					spike.Color = ELECTRIC_BLUE
					spike.Material = Enum.Material.Neon
				end
				task.wait(0.5)
			end
		end,
		Reset = function()
			for spike in pairs(original) do restore(spike) end
		end,
		Discharge = function()
			for i = #sequence, 1, -1 do
				restore(sequence[i])
				task.wait(0.3)
			end
		end,
	}
end

local function initPulse()
	local pulseHitEvent = getOrCreateRemote("PulseHit")
	local pulseFireEvent = getOrCreateRemote("PulseFire")

	local function getHumanoidAndPlayer(part)
		local current = part.Parent
		while current and current ~= workspace do
			local humanoid = current:FindFirstChildOfClass("Humanoid")
			if humanoid then
				return humanoid, Players:GetPlayerFromCharacter(current)
			end
			current = current.Parent
		end
		return nil, nil
	end

	_G.FirePulse = function(player, color, maxSize, duration, damage)
		local character = player and player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		pulseFireEvent:FireAllClients(player, color, maxSize, duration)

		local hitbox = Instance.new("Part")
		hitbox.Name = "PulseHitbox"
		hitbox.Shape = Enum.PartType.Ball
		hitbox.Size = Vector3.new(5, 5, 5)
		hitbox.CFrame = hrp.CFrame
		hitbox.Anchored = true
		hitbox.CanCollide = false
		hitbox.CanTouch = false
		hitbox.CanQuery = true
		hitbox.Transparency = 1
		hitbox:SetAttribute("BlastActive", true)
		hitbox:SetAttribute("Attacker", player.Name)

		local pn = Instance.new("StringValue")
		pn.Name = "PlayerName"
		pn.Value = player.Name
		pn.Parent = hitbox

		hitbox.Parent = workspace
		Debris:AddItem(hitbox, duration + 2)

		local damagePerTick = damage / 10
		local gcellsPerTick = 25
		local startSize = 50
		maxSize = math.max(maxSize, 300)
		local tickInterval = 0.5

		local overlapParams = OverlapParams.new()
		overlapParams.FilterDescendantsInstances = { character }
		overlapParams.FilterType = Enum.RaycastFilterType.Exclude

		local startTime = os.clock()
		while os.clock() - startTime < duration do
			if not hitbox.Parent or not hrp.Parent then break end

			local progress = math.clamp((os.clock() - startTime) / duration, 0, 1)
			local size = startSize + (maxSize - startSize) * progress
			hitbox.Size = Vector3.new(size, size, size)
			hitbox.CFrame = hrp.CFrame

			local hitThisTick = {}
			for _, part in ipairs(workspace:GetPartsInPart(hitbox, overlapParams)) do
				local hitHumanoid, hitPlayer = getHumanoidAndPlayer(part)
				if hitHumanoid and hitPlayer and hitPlayer ~= player and not hitThisTick[hitPlayer] then
					hitThisTick[hitPlayer] = true
					setCreator(hitHumanoid, player)
					hitHumanoid:TakeDamage(damagePerTick)
					if _G.ShowIndicator then _G.ShowIndicator(player, damagePerTick, 0, 0, hitHumanoid.Parent) end
					pulseHitEvent:FireClient(hitPlayer)
					giveGCells(player, gcellsPerTick, false, hitHumanoid.Parent)
				end
			end

			if _G.DamageBuildingsInRadius then
				_G.DamageBuildingsInRadius(hrp.Position, size / 2, player)
			end
			task.wait(tickInterval)
		end

		if hitbox.Parent then
			hitbox:SetAttribute("BlastActive", false)
			hitbox:Destroy()
		end
	end
end

local function initLevelGuard()
	local LEVEL_THRESHOLD = 10
	local BLOCK_DURATION = 3

	local blockTimers = {}
	local killRewardFlags = {}
	local previousGCells = {}
	local changing = {}
	local hookedGCells = {}

	local function getLevel(character)
		local levelVal = character and character:FindFirstChild("Level")
		if levelVal and levelVal:IsA("IntValue") then return levelVal.Value end
		return nil
	end

	local function isBlocked(player)
		if not player or not player.Parent then return false end
		local expires = blockTimers[player]
		if not expires then return false end
		if os.clock() > expires then
			blockTimers[player] = nil
			return false
		end
		return true
	end

	_G.IsRewardBlocked = isBlocked
	_G.SetKillRewardFlag = function(player)
		if player then killRewardFlags[player] = true end
	end
	_G.ClearKillRewardFlag = function(player)
		if player then killRewardFlags[player] = nil end
	end

	local function checkAttack(attacker, targetCharacter)
		if not attacker or not attacker:IsA("Player") or not targetCharacter then return end
		local attackerLevel = getLevel(attacker.Character)
		local targetLevel = getLevel(targetCharacter)
		if not attackerLevel or not targetLevel then return end
		if attackerLevel > LEVEL_THRESHOLD and targetLevel < LEVEL_THRESHOLD then
			blockTimers[attacker] = os.clock() + BLOCK_DURATION
		end
	end

	local function hookCreator(humanoid, targetCharacter)
		local function check(creator)
			local value = creator.Value
			if value and value:IsA("Player") then checkAttack(value, targetCharacter) end
		end
		local function watch(creator)
			if not creator:IsA("ObjectValue") then return end
			creator.Changed:Connect(function() check(creator) end)
			check(creator)
		end
		local existing = humanoid:FindFirstChild("creator")
		if existing then watch(existing) end
		humanoid.ChildAdded:Connect(function(child)
			if child.Name == "creator" then watch(child) end
		end)
	end

	local function hookDPSAttacker(humanoid, targetCharacter)
		local function check()
			local attackerId = humanoid:GetAttribute("LastDPSAttacker")
			if attackerId then
				local attacker = Players:GetPlayerByUserId(attackerId)
				if attacker then checkAttack(attacker, targetCharacter) end
			end
		end
		humanoid:GetAttributeChangedSignal("LastDPSAttacker"):Connect(check)
		check()
	end

	local function hookGCells(player)
		local function setup()
			local gcells = getGCells(player)
			if not gcells or hookedGCells[gcells] then return end
			hookedGCells[gcells] = true
			previousGCells[player] = gcells.Value
			gcells.Changed:Connect(function(newValue)
				if changing[player] then return end
				if killRewardFlags[player] then
					previousGCells[player] = newValue
					return
				end
				if isBlocked(player) then
					local prev = previousGCells[player] or 0
					if newValue > prev then
						changing[player] = true
						gcells.Value = prev
						changing[player] = nil
						return
					end
				end
				previousGCells[player] = newValue
			end)
			gcells.AncestryChanged:Connect(function(_, parent)
				if not parent then hookedGCells[gcells] = nil end
			end)
		end

		setup()
		player.ChildAdded:Connect(function(child)
			if child.Name == "leaderstats" then
				task.wait(0.1)
				setup()
			end
		end)
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			leaderstats.ChildAdded:Connect(function() task.defer(setup) end)
		end
	end

	local function hookCharacter(character)
		local humanoid = character:WaitForChild("Humanoid", 5)
		if not humanoid then return end
		hookCreator(humanoid, character)
		hookDPSAttacker(humanoid, character)
	end

	local function hookPlayer(player)
		hookGCells(player)
		player.CharacterAdded:Connect(function(character)
			task.spawn(hookCharacter, character)
		end)
		if player.Character then task.spawn(hookCharacter, player.Character) end
	end

	for _, player in ipairs(Players:GetPlayers()) do hookPlayer(player) end
	Players.PlayerAdded:Connect(hookPlayer)
	Players.PlayerRemoving:Connect(function(player)
		blockTimers[player] = nil
		killRewardFlags[player] = nil
		previousGCells[player] = nil
		changing[player] = nil
	end)
end

local function initWaterBubbles()
	local bubblesTemplate = ReplicatedStorage:FindFirstChild("bubbles")
	if not bubblesTemplate then
		warn("[WaterBubbles] Could not find bubbles template in ReplicatedStorage")
		return
	end
	local waterStateEvent = ReplicatedStorage:FindFirstChild("WaterState")
	if not waterStateEvent then
		warn("[WaterBubbles] Could not find WaterState RemoteEvent")
		return
	end

	local BUBBLES_NAME = "bubbles"
	local HEAD_NAMES = { "FakeHead", "Fakehead", "Head" }

	local function getHead(character)
		for _, name in ipairs(HEAD_NAMES) do
			local head = character:FindFirstChild(name)
			if head and head:IsA("BasePart") then return head end
		end
		return nil
	end

	waterStateEvent.OnServerEvent:Connect(function(player, inWater)
		if type(inWater) ~= "boolean" then return end
		local character = player.Character
		if not character then return end
		local head = getHead(character)
		if not head then return end
		local existing = head:FindFirstChild(BUBBLES_NAME)
		if inWater then
			if not existing then
				local bubbles = bubblesTemplate:Clone()
				bubbles.Name = BUBBLES_NAME
				bubbles.Parent = head
			end
		elseif existing then
			existing:Destroy()
		end
	end)
end

local function initAttackHandler()
	local BeamSystem = safeRequire("BeamSystem")

	local playerDebounces = {}
	local connectedRemotes = {}

	local VALID_ATTACK_TYPES = {
		Melee = true, Pulse = true, Beam = true, FirePulse = true, BackBeam = true,
	}

	local function getHumanoidAndPlayer(part)
		if part.Name == "AttackHitbox" or part.Name == "BeamHitbox" or part.Name == "PulseHitbox" or part:GetAttribute("MeleeHit") then
			return nil, nil
		end
		local character = part.Parent
		if not character then return nil, nil end
		return character:FindFirstChildOfClass("Humanoid"), Players:GetPlayerFromCharacter(character)
	end

	local function findSounds(character)
		local sounds = character:FindFirstChild("Sounds")
		if sounds then return sounds end
		local scripts = character:FindFirstChild("CharacterScripts")
		return scripts and scripts:FindFirstChild("Sounds") or nil
	end

	local function getGlowManager(character)
		local scripts = character:FindFirstChild("CharacterScripts")
		local module = scripts and scripts:FindFirstChild("GlowManager")
		if not module then return nil end
		local ok, gm = pcall(require, module)
		return ok and gm or nil
	end

	local function playSoundFrom(character, soundName, parent)
		local sounds = findSounds(character)
		local template = sounds and sounds:FindFirstChild(soundName)
		if not template or not parent then return end
		local clone = template:Clone()
		clone.Parent = parent
		clone.Looped = false
		clone.Ended:Connect(function() clone:Destroy() end)
		clone:Play()
		Debris:AddItem(clone, 15)
	end

	local function playHitSound(character)
		playSoundFrom(character, "HitSound", character:FindFirstChild("HumanoidRootPart"))
	end

	local function playAttackAnimation(character, animName)
		local animations = character:FindFirstChild("Animations")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local animator = humanoid and humanoid:FindFirstChild("Animator")
		local anim = animations and animations:FindFirstChild(animName)
		if animator and anim then
			local track = animator:LoadAnimation(anim)
			track.Looped = false
			track:Play()
		end
	end

	local function getAnimName(remoteName)
		if remoteName == "Attack" then return "Attack1" end
		if remoteName == "Beam" then return "Attack2" end
		return remoteName
	end

	local function getDamage(character, damageStat)
		local stats = character:FindFirstChild("Stats")
		local value = stats and stats:FindFirstChild(damageStat)
		return value and value.Value or 10
	end

	local function registerHit(attacker, attackerChar, humanoid, damage, gcells)
		setCreator(humanoid, attacker)
		humanoid:TakeDamage(damage)
		if _G.ShowIndicator then _G.ShowIndicator(attacker, damage, 0, 0, humanoid.Parent) end
		playHitSound(attackerChar)
		giveGCells(attacker, gcells, false, humanoid.Parent)
	end

	local function enableHitParts(character, hitPlayers, player, damage)
		local connections, enabled = {}, {}
		for _, folder in ipairs({ character:FindFirstChild("HitParts"), character:FindFirstChild("HitParts2") }) do
			if folder then
				for _, part in ipairs(folder:GetDescendants()) do
					if part:IsA("BasePart") and not part:FindFirstChildWhichIsA("Script") then
						part.CanTouch = true
						table.insert(enabled, part)
						table.insert(connections, part.Touched:Connect(function(hit)
							local hitHumanoid, hitPlayer = getHumanoidAndPlayer(hit)
							if hitHumanoid and hitPlayer and hitPlayer ~= player and not hitPlayers[hitPlayer] then
								hitPlayers[hitPlayer] = true
								registerHit(player, character, hitHumanoid, damage, 25)
							end
						end))
					end
				end
			end
		end
		return connections, enabled
	end

	local function disableHitParts(connections, enabled)
		for _, conn in ipairs(connections) do conn:Disconnect() end
		for _, part in ipairs(enabled) do
			if part.Parent then part.CanTouch = false end
		end
	end

	local function executeMeleeAttack(player, character, remote, remoteName, durationOverride)
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local size = Vector3.new(
			remote:GetAttribute("HitboxSizeX") or 15,
			remote:GetAttribute("HitboxSizeY") or 15,
			remote:GetAttribute("HitboxSizeZ") or 15
		)
		local offset = CFrame.new(
			remote:GetAttribute("HitboxOffsetX") or 0,
			remote:GetAttribute("HitboxOffsetY") or 0,
			remote:GetAttribute("HitboxOffsetZ") or -10
		)
		local duration = durationOverride or remote:GetAttribute("HitboxDuration") or 0.5
		local damage = getDamage(character, remote:GetAttribute("DamageStat") or "DMG1")

		playAttackAnimation(character, getAnimName(remoteName))

		local hitbox = Instance.new("Part")
		hitbox.Name = "AttackHitbox"
		hitbox:SetAttribute("MeleeHit", true)
		hitbox.Size = size
		hitbox.Anchored = true
		hitbox.CanCollide = false
		hitbox.CanTouch = true
		hitbox.Transparency = 1
		hitbox.Color = Color3.fromRGB(255, 0, 0)
		hitbox.Material = Enum.Material.Neon
		hitbox.Parent = character
		hitbox.CFrame = hrp.CFrame * offset
		Debris:AddItem(hitbox, duration + 2)

		local hitPlayers = {}
		local partConns, partsEnabled = enableHitParts(character, hitPlayers, player, damage)

		local connection = hitbox.Touched:Connect(function(hit)
			local hitHumanoid, hitPlayer = getHumanoidAndPlayer(hit)
			if hitHumanoid and hitPlayer and hitPlayer ~= player and not hitPlayers[hitPlayer] then
				hitPlayers[hitPlayer] = true
				registerHit(player, character, hitHumanoid, damage, 25)
			end
		end)

		local overlapParams = OverlapParams.new()
		overlapParams.FilterDescendantsInstances = { character }
		overlapParams.FilterType = Enum.RaycastFilterType.Exclude

		local startTime = os.clock()
		while os.clock() - startTime < duration do
			if not character.Parent or not hrp.Parent or not hitbox.Parent then break end
			for _, part in ipairs(workspace:GetPartsInPart(hitbox, overlapParams)) do
				local hitHumanoid, hitPlayer = getHumanoidAndPlayer(part)
				if hitHumanoid and hitPlayer and hitPlayer ~= player and not hitPlayers[hitPlayer] then
					hitPlayers[hitPlayer] = true
					registerHit(player, character, hitHumanoid, damage, 25)
				end
			end
			task.wait(0.05)
		end

		connection:Disconnect()
		hitbox:Destroy()
		disableHitParts(partConns, partsEnabled)
	end

	local function executePulseAttack(player, character, remote, remoteName)
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local sizeX = remote:GetAttribute("HitboxSizeX") or 50
		local sizeY = remote:GetAttribute("HitboxSizeY") or 50
		local sizeZ = remote:GetAttribute("HitboxSizeZ") or 50
		local duration = remote:GetAttribute("HitboxDuration") or 2
		local maxSize = remote:GetAttribute("PulseMaxSize") or 500
		local tickInterval = remote:GetAttribute("PulseTickInterval") or 0.3
		local damage = getDamage(character, remote:GetAttribute("DamageStat") or "DMG3")

		playAttackAnimation(character, getAnimName(remoteName))
		playSoundFrom(character, "Beam", hrp)

		local pulsePart = Instance.new("Part")
		pulsePart.Name = "PulseHitbox"
		pulsePart.Shape = Enum.PartType.Ball
		pulsePart.Material = Enum.Material.Neon
		pulsePart.Color = Color3.fromRGB(0, 0, 0)
		pulsePart.Anchored = true
		pulsePart.CanCollide = false
		pulsePart.CanTouch = false
		pulsePart.Transparency = 0
		pulsePart.Size = Vector3.new(sizeX, sizeY, sizeZ)
		pulsePart.CFrame = hrp.CFrame
		pulsePart.Parent = workspace
		Debris:AddItem(pulsePart, duration + 2)

		local oneShotHit = {}
		local partConns, partsEnabled = enableHitParts(character, oneShotHit, player, damage)

		local numTicks = math.max(duration / tickInterval, 1)
		local damagePerTick = damage / numTicks
		local gcellsPerTick = 25 / numTicks
		local startSize = math.max(sizeX, sizeY, sizeZ)

		local overlapParams = OverlapParams.new()
		overlapParams.FilterDescendantsInstances = { character }
		overlapParams.FilterType = Enum.RaycastFilterType.Exclude

		local startTime = os.clock()
		while os.clock() - startTime < duration do
			if not character.Parent or not hrp.Parent or not pulsePart.Parent then break end

			local progress = math.clamp((os.clock() - startTime) / duration, 0, 1)
			local currentSize = startSize + (maxSize - startSize) * progress
			pulsePart.Size = Vector3.new(currentSize, currentSize, currentSize)
			pulsePart.Transparency = progress
			pulsePart.CFrame = hrp.CFrame

			local hitThisTick = {}
			for _, part in ipairs(workspace:GetPartsInPart(pulsePart, overlapParams)) do
				local hitHumanoid, hitPlayer = getHumanoidAndPlayer(part)
				if hitHumanoid and hitPlayer and hitPlayer ~= player and not hitThisTick[hitPlayer] then
					hitThisTick[hitPlayer] = true
					registerHit(player, character, hitHumanoid, damagePerTick, gcellsPerTick)
				end
			end
			task.wait(tickInterval)
		end

		if pulsePart.Parent then pulsePart:Destroy() end
		disableHitParts(partConns, partsEnabled)
	end

	local function executeFirePulse(player, character, remote, remoteName)
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local damage = getDamage(character, remote:GetAttribute("DamageStat") or "DMG3")
		local windup = remote:GetAttribute("PulseWindup") or 0
		local pulseColor = remote:GetAttribute("PulseColor") or Color3.fromRGB(255, 120, 0)
		local pulseMaxSize = remote:GetAttribute("PulseMaxSize") or 300
		local pulseDuration = remote:GetAttribute("HitboxDuration") or 4

		playAttackAnimation(character, getAnimName(remoteName))
		playSoundFrom(character, "Pulse", hrp)

		if windup > 0 then task.wait(windup) end
		if _G.FirePulse then
			_G.FirePulse(player, pulseColor, pulseMaxSize, pulseDuration, damage)
		end
	end

	local function executeBeamAttack(player, character, remote, remoteName, targetPos)
		if not BeamSystem then return end
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		if typeof(targetPos) ~= "Vector3" then targetPos = nil end

		local duration = remote:GetAttribute("BeamDuration") or remote:GetAttribute("HitboxDuration") or 4.7
		local chargeTime = remote:GetAttribute("BeamChargeTime") or 0

		playAttackAnimation(character, getAnimName(remoteName))

		local glowManager = getGlowManager(character)
		if glowManager then glowManager.StartGlow(chargeTime) end

		playSoundFrom(character, "Beam", hrp)

		local sortedSpikes = {}
		local originalProps = {}
		local spikesFolder = character:FindFirstChild("Spikes")
		if spikesFolder then
			for _, child in ipairs(spikesFolder:GetChildren()) do
				if child:IsA("BasePart") then
					local number = tonumber(string.match(child.Name, "%d+"))
					if number then
						table.insert(sortedSpikes, { part = child, number = number })
						originalProps[child] = { Material = child.Material, UsePartColor = child.UsePartColor }
					end
				end
			end
			table.sort(sortedSpikes, function(a, b) return a.number < b.number end)
		end

		local function resetEffects()
			task.spawn(function()
				for i = #sortedSpikes, 1, -1 do
					local spike = sortedSpikes[i].part
					local props = originalProps[spike]
					if props and spike.Parent then
						spike.Material = props.Material
						spike.UsePartColor = props.UsePartColor
					end
					task.wait(0.1)
				end
				if glowManager then glowManager.EndGlow() end
			end)
		end

		if #sortedSpikes > 0 then
			local perSpikeDelay = chargeTime > 0 and chargeTime / #sortedSpikes or 0.21
			for _, data in ipairs(sortedSpikes) do
				data.part.Material = Enum.Material.Neon
				data.part.UsePartColor = true
				task.wait(perSpikeDelay)
			end
		elseif chargeTime > 0 then
			task.wait(chargeTime)
		end

		local ok, err = pcall(BeamSystem.ActivateBeam, {
			character = character,
			player = player,
			initialTargetPosition = targetPos,
			duration = duration,
		})
		if not ok then warn("[AttackHandler] ActivateBeam failed: " .. tostring(err)) end

		resetEffects()
	end

	local function executeBackBeam(player, character, remote, remoteName)
		local glowManager = getGlowManager(character)
		if glowManager then glowManager.StartGlow() end

		local windup = remote:GetAttribute("BackBeamWindup") or 0
		if windup > 0 then task.wait(windup) end

		local activeDuration = remote:GetAttribute("BackBeamActive") or remote:GetAttribute("HitboxDuration") or 0.5
		local ok, err = pcall(executeMeleeAttack, player, character, remote, remoteName, activeDuration)
		if not ok then warn("[AttackHandler] BackBeam failed: " .. tostring(err)) end

		if glowManager then glowManager.EndGlow() end
	end

	local function connectRemote(remote)
		if connectedRemotes[remote] then return end
		local attackType = remote:GetAttribute("AttackType")
		if not attackType or not VALID_ATTACK_TYPES[attackType] then return end
		connectedRemotes[remote] = true

		remote.AncestryChanged:Connect(function(_, parent)
			if not parent then connectedRemotes[remote] = nil end
		end)

		local remoteName = remote.Name
		remote.OnServerEvent:Connect(function(player, ...)
			local debounces = playerDebounces[player]
			if not debounces then
				debounces = {}
				playerDebounces[player] = debounces
			end
			if debounces[remote] then return end

			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			if not hrp or not humanoid or humanoid.Health <= 0 then return end

			debounces[remote] = true

			local args = table.pack(...)
			local ok, err = pcall(function()
				if attackType == "Melee" then
					executeMeleeAttack(player, char, remote, remoteName)
				elseif attackType == "Pulse" then
					executePulseAttack(player, char, remote, remoteName)
				elseif attackType == "Beam" then
					executeBeamAttack(player, char, remote, remoteName, args[1])
				elseif attackType == "FirePulse" then
					executeFirePulse(player, char, remote, remoteName)
				elseif attackType == "BackBeam" then
					executeBackBeam(player, char, remote, remoteName)
				end
			end)
			if not ok then warn("[AttackHandler] " .. attackType .. " failed: " .. tostring(err)) end

			if playerDebounces[player] then
				playerDebounces[player][remote] = nil
			end
		end)
	end

	local function scanCharacter(character)
		for _, descendant in ipairs(character:GetDescendants()) do
			if descendant:IsA("RemoteEvent") then connectRemote(descendant) end
		end
	end

	local function setupPlayer(player)
		player.CharacterAdded:Connect(function(character)
			scanCharacter(character)
			character.DescendantAdded:Connect(function(descendant)
				if descendant:IsA("RemoteEvent") then
					task.defer(connectRemote, descendant)
				end
			end)
		end)
		local character = player.Character
		if character then
			scanCharacter(character)
			character.DescendantAdded:Connect(function(descendant)
				if descendant:IsA("RemoteEvent") then
					task.defer(connectRemote, descendant)
				end
			end)
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do setupPlayer(player) end
	Players.PlayerAdded:Connect(setupPlayer)
	Players.PlayerRemoving:Connect(function(player)
		playerDebounces[player] = nil
	end)
end

local function initDPS()
	local CollectionService = game:GetService("CollectionService")
	local connected = setmetatable({}, { __mode = "k" })

	local function findAttacker(part)
		local model = part:FindFirstAncestorOfClass("Model")
		while model do
			local player = Players:GetPlayerFromCharacter(model)
			if player then return player end
			model = model:FindFirstAncestorOfClass("Model")
		end
		local nameValue = part:FindFirstChild("PlayerName")
		if nameValue and nameValue:IsA("StringValue") then
			return Players:FindFirstChild(nameValue.Value)
		end
		return nil
	end

	local function levelScale(attacker)
		local perLevel = ReplicatedStorage:FindFirstChild("DamageMultiplierPerLevel")
		if not perLevel then return 1 end
		local character = attacker and attacker.Character
		local levelValue = character and character:FindFirstChild("Level")
		local level = levelValue and levelValue.Value or 1
		return perLevel.Value ^ (level - 1)
	end

	local function payGCells(attacker, amount, at)
		local leaderstats = attacker:FindFirstChild("leaderstats")
		if not leaderstats then return end
		local gcells = leaderstats:FindFirstChild("GCells") or leaderstats:FindFirstChild("gcells")
		if gcells and gcells:IsA("IntValue") then
			if _G.GCellGuardAllow then _G.GCellGuardAllow(gcells, amount) end
			gcells.Value = gcells.Value + amount
			if _G.ShowIndicator and amount >= 1 then _G.ShowIndicator(attacker, 0, amount, 0, at) end
		end
	end

	local function hook(part)
		if connected[part] or not part:IsA("BasePart") then return end
		connected[part] = true
		local lastHit = setmetatable({}, { __mode = "k" })
		part.Touched:Connect(function(other)
			if part:GetAttribute("RequireBlastActive") and not part:GetAttribute("BlastActive") then return end
			local character = other.Parent
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if not humanoid or humanoid.Health <= 0 then return end
			local attacker = findAttacker(part)
			if attacker and attacker.Character == character then return end
			local cooldown = part:GetAttribute("Cooldown") or 0.5
			local now = os.clock()
			if cooldown > 0 and lastHit[character] and now - lastHit[character] < cooldown then return end
			lastHit[character] = now
			local multiplier = part:GetAttribute("DamageMultiplier") or 1
			if part:GetAttribute("LevelScaled") then
				multiplier = multiplier * levelScale(attacker)
			end
			humanoid.Health = humanoid.Health - (part:GetAttribute("Damage") or 0.9) * multiplier
			if attacker then
				humanoid:SetAttribute("LastDPSAttacker", attacker.UserId)
				payGCells(attacker, part:GetAttribute("GCellRate") or 0.2, character)
				if _G.ShowIndicator then _G.ShowIndicator(attacker, (part:GetAttribute("Damage") or 0.9) * multiplier, 0, 0, character) end
			end
		end)
	end

	for _, part in ipairs(CollectionService:GetTagged("DPSPart")) do
		hook(part)
	end
	CollectionService:GetInstanceAddedSignal("DPSPart"):Connect(hook)
end

local function initRoar()
	local connected = setmetatable({}, { __mode = "k" })

	local function hook(event)
		if not event:IsA("RemoteEvent") or connected[event] then return end
		local scripts = event.Parent
		if not scripts or scripts.Name ~= "CharacterScripts" then return end
		local roarName = event.Name
		if not roarName:match("^Roar%d*$") then return end
		connected[event] = true
		event.OnServerEvent:Connect(function(player)
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if not humanoid then return end
			local debounce = scripts:FindFirstChild("Debounce")
			if not debounce or debounce.Value then return end
			debounce.Value = true
			local animations = scripts.Parent and scripts.Parent:FindFirstChild("Animations")
			local roarAnim = animations and animations:FindFirstChild(roarName)
			local animator = roarAnim and humanoid:FindFirstChild("Animator")
			if animator then
				local track = animator:LoadAnimation(roarAnim)
				track.Looped = false
				track.Priority = Enum.AnimationPriority.Action
				track:Play(0.1, 10)
			end
			local sounds = scripts:FindFirstChild("Sounds")
			local roarSound = sounds and sounds:FindFirstChild(roarName)
			if roarSound then
				local clone = roarSound:Clone()
				clone.Parent = character:FindFirstChild("Head") or character:FindFirstChild("Torso") or character
				clone.Looped = false
				clone:Play()
				task.wait(clone.TimeLength / math.max(clone.PlaybackSpeed, 0.01))
				clone:Destroy()
			end
			debounce.Value = false
		end)
	end

	for _, inst in ipairs(workspace:GetDescendants()) do
		hook(inst)
	end
	workspace.DescendantAdded:Connect(hook)
end

function Combat.Init()
	if initialized then return end
	initialized = true
	task.spawn(initCombat)
	task.spawn(initAtomicBreath)
	task.spawn(initLevelGuard)
	task.spawn(initWaterBubbles)
	task.spawn(initPulse)
	task.spawn(initAttackHandler)
	task.spawn(initDPS)
	task.spawn(initRoar)
end

return Combat]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX19">
						<Properties>
							<string name="Name">Data</string>
							<ProtectedString name="Source"><![CDATA[
local Data = {}

function Data.Init()
	
	local GamepassWhitelist = {
		[274893778] = true
	}
	
	local function initOwnership()
		local DataStoreService = game:GetService("DataStoreService")
		local Players = game:GetService("Players")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local Lighting = game:GetService("Lighting")
		local MarketplaceService = game:GetService("MarketplaceService")

		local KaijuDataStore = DataStoreService:GetDataStore("Ownership")
		local LevelDataStore = DataStoreService:GetDataStore("PlayerLevels_v3")
		local KaijusUnused = Lighting:FindFirstChild("KaijusUnused")
		if not KaijusUnused then
			warn("KaijusUnused not found in Lighting at script start - will retry on demand")
		end
		local Morphs = ReplicatedStorage:FindFirstChild("MorphSupplies")
		if Morphs then Morphs = Morphs:FindFirstChild("Morphs") end
		local CandyConfig = require(ReplicatedStorage:WaitForChild("CandyConfig"))

		local playerKaijus = {}

		local getOwnershipEvent = Instance.new("RemoteFunction")
		getOwnershipEvent.Name = "GetKaijuOwnership"
		getOwnershipEvent.Parent = ReplicatedStorage

		local buyKaijuEvent = Instance.new("RemoteEvent")
		buyKaijuEvent.Name = "BuyKaiju"
		buyKaijuEvent.Parent = ReplicatedStorage

		local nameMapping = {
			["Godzilla2014"] = "GODZILLA 2014",
			["TitanusGhidorah"] = "TITANUS GHIDORAH",
			["Godzilla2019"] = "TITANUS GOJIRA",
			["F16C"] = "F16C [FREE]",
			["Mosura"] = "TITANUS MOSURA",
			["Behemoth"] = "TITANUS BEHEMOTH",
			["Gigan"] = "GIGAN",
			["Anguirus"] = "ANGUIRUS [FREE]",
			["Biollante"] = "BIOLLANTE",
			["Burning"] = "BURNING GODZILLA",
			["FinalWars"] = "FINAL WARS GODZILLA",
			["Heisei"] = "HEISEI GODZILLA",
			["KamataKun"] = "SHIN FORM 2 [FREE]",
			["KingGhidorah"] = "KING GHIDORAH",
			["MaleMuto"] = "MALE MUTO",
			["Mothra"] = "MOTHRA",
			["Rodan"] = "TITANUS RODAN",
			["Shin"] = "SHIN GOJIRA",
			["ShinagawaKun"] = "SHIN FORM 3",
			["Tank"] = "MILITARY TANK [FREE]",
			["Human"] = "CIVILIAN [FREE]",
			["Godzilla1954"] = "GOJIRA [FREE]",
			["Kiryu"] = "KIRYU",
			["Mecha King Ghidorah"] = "MECHA KING GHIDORAH",
		}

		local reverseNameMapping = {}
		for kaijusUnusedName, morphName in pairs(nameMapping) do
			reverseNameMapping[morphName] = kaijusUnusedName
		end

		local SelectedKaijuStore = DataStoreService:GetDataStore("SelectedKaiju")
		local playerSelectedKaiju = {}

		local getSelectedKaijuFunc = Instance.new("RemoteFunction")
		getSelectedKaijuFunc.Name = "GetSelectedKaiju"
		getSelectedKaijuFunc.Parent = ReplicatedStorage

		local setSelectedKaijuEvent = Instance.new("RemoteEvent")
		setSelectedKaijuEvent.Name = "SetSelectedKaiju"
		setSelectedKaijuEvent.Parent = ReplicatedStorage

		local gamepassKaijus = {
			["BURNING GODZILLA"] = 1891042639,
			["THERMONUCLEAR GODZILLA"] = 1818653788,
			["VOLCANIC BIOLLANTE"] = 1893256558,
			["FROSTBITE GODZILLA"] = 1822212269,
			["MINILLA"] = 1928197563,
		}

		local getGamepassKaijusFunc = Instance.new("RemoteFunction")
		getGamepassKaijusFunc.Name = "GetGamepassKaijus"
		getGamepassKaijusFunc.Parent = ReplicatedStorage

		local playerGamepassCache = {}

		local function ownsGamepass(player, morphName)
			local gamepassId = gamepassKaijus[morphName]
			if not gamepassId then return false end
			
			if GamepassWhitelist[player.UserId] then
				return true
			end

			local cache = playerGamepassCache[player.UserId]
			if cache and cache[morphName] == true then
				return true
			end

			local success, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gamepassId)
			end)

			local result = success and owns or false

			if result then
				if not cache then
					cache = {}
					playerGamepassCache[player.UserId] = cache
				end
				cache[morphName] = true
			end

			return result
		end

		local function getAllMorphModels()
			local list = {}
			if not Morphs then return list end
			for _, child in ipairs(Morphs:GetChildren()) do
				if child:IsA("Model") then
					table.insert(list, child)
				elseif child:IsA("Folder") then
					for _, nested in ipairs(child:GetChildren()) do
						if nested:IsA("Model") then
							table.insert(list, nested)
						end
					end
				end
			end
			return list
		end
		local function isCandyKaiju(kaijuName)
			local morph = Morphs and Morphs:FindFirstChild(kaijuName, true)
			return morph ~= nil and CandyConfig.isCandyMorph(morph)
		end

		local function getKaijuPrice(kaijuName)
			if Morphs then
				local morph = Morphs:FindFirstChild(kaijuName, true)
				if morph then
					local stats = morph:FindFirstChild("Stats")
					if stats then
						local price = stats:FindFirstChild("Price")
						if price then
							return price.Value
						end
					end
				end
			end

			if KaijusUnused then
				local kaiju = KaijusUnused:FindFirstChild(kaijuName)
				if kaiju then
					local stats = kaiju:FindFirstChild("Stats")
					if stats then
						local price = stats:FindFirstChild("Price")
						if price and price.Value > 0 then
							return price.Value
						end
					end
				end
			end

			local morphName = nameMapping[kaijuName]
			if morphName and Morphs then
				local morph = Morphs:FindFirstChild(morphName, true)
				if morph then
					local stats = morph:FindFirstChild("Stats")
					if stats then
						local price = stats:FindFirstChild("Price")
						if price then
							return price.Value
						end
					end
				end
			end

			return 0
		end

		local function loadPlayerKaijus(player)
			local success, data = pcall(function()
				return KaijuDataStore:GetAsync(tostring(player.UserId))
			end)

			if success and data then
				playerKaijus[player.UserId] = data
			else
				playerKaijus[player.UserId] = {}
			end

			return playerKaijus[player.UserId]
		end

		local function savePlayerKaijus(player)
			local data = playerKaijus[player.UserId]
			if not data then return end

			local success, err = pcall(function()
				KaijuDataStore:SetAsync(tostring(player.UserId), data)
			end)

			if not success then
				warn("Error saving Kaiju data for " .. player.Name .. ": " .. err)
			end
		end

		local function isGamepassKaiju(kaijuName)
			return gamepassKaijus[kaijuName] ~= nil
		end

		local function ownsKaiju(player, kaijuName)
			if isGamepassKaiju(kaijuName) or GamepassWhitelist[player.UserId] then
				return ownsGamepass(player, kaijuName)
			end

			local canonicalName = nameMapping[kaijuName] or kaijuName
			local morphForOwnership = Morphs and Morphs:FindFirstChild(canonicalName, true)
			local morphStats = morphForOwnership and morphForOwnership:FindFirstChild("Stats")
			local freePrice = morphStats and morphStats:FindFirstChild("Price")
			if freePrice and tonumber(freePrice.Value) and tonumber(freePrice.Value) <= 0 then
				return true
			end

			local data = playerKaijus[player.UserId]
			if not data then
				loadPlayerKaijus(player)
				data = playerKaijus[player.UserId]
			end
			if not data then return false end

			if data[kaijuName] then return true end

			local oldName = reverseNameMapping[kaijuName]
			if oldName and data[oldName] then return true end
			return false
		end

		_G.KUNOwnsKaiju = ownsKaiju

		local function checkSingleRequirement(player, reqKaiju, reqLevel)
			if not ownsKaiju(player, reqKaiju) then
				return false, "Requires " .. reqKaiju
			end

			local success, levelData = pcall(function()
				return LevelDataStore:GetAsync("Player_" .. player.UserId)
			end)

			if not success or not levelData or type(levelData) ~= "table" then
				return false, "Requires Level " .. reqLevel .. " " .. reqKaiju
			end

			local kaijuLevelData = levelData[reqKaiju]
			if not kaijuLevelData or type(kaijuLevelData) ~= "table" then
				local oldName = reverseNameMapping[reqKaiju]
				if oldName then
					kaijuLevelData = levelData[oldName]
				end
			end

			if not kaijuLevelData or type(kaijuLevelData) ~= "table" then
				return false, "Requires Level " .. reqLevel .. " " .. reqKaiju
			end

			local playerLevel = kaijuLevelData.level or 1
			if playerLevel < reqLevel then
				return false, "Requires Level " .. reqLevel .. " " .. reqKaiju
			end

			return true, nil
		end

		local function checkRequirement(player, kaijuName)
			if not Morphs then return true, nil end
			local morph = Morphs:FindFirstChild(kaijuName, true)
			if not morph then return true, nil end

			local requirement = morph:GetAttribute("Requirement")
			if not requirement or requirement == "" then return true, nil end

			
			for reqPart in requirement:gmatch("[^,]+") do
				reqPart = reqPart:match("^%s*(.-)%s*$")
				local reqKaiju, reqLevel = reqPart:match("^(.+):(%d+)$")
				if reqKaiju and reqLevel then
					reqLevel = tonumber(reqLevel)
					if reqLevel then
						local met, msg = checkSingleRequirement(player, reqKaiju, reqLevel)
						if not met then
							return false, msg
						end
					end
				end
			end

			return true, nil
		end

		local function buyKaiju(player, kaijuName)
			if type(kaijuName) ~= "string" then
				return false, "Invalid kaiju"
			end
			local canonicalName = nameMapping[kaijuName] or kaijuName
			if not Morphs or not Morphs:FindFirstChild(canonicalName, true) then
				return false, "Unknown kaiju"
			end
			kaijuName = canonicalName
			if isGamepassKaiju(kaijuName) then
				return false, "Gamepass required"
			end

			if not playerKaijus[player.UserId] then
				loadPlayerKaijus(player)
			end
			if not playerKaijus[player.UserId] then
				return false, "Data still loading, try again"
			end

			if ownsKaiju(player, kaijuName) then
				return false, "Already owned"
			end

			local reqMet, reqMessage = checkRequirement(player, kaijuName)
			if not reqMet then
				return false, reqMessage
			end

			local price = getKaijuPrice(kaijuName)
			if isCandyKaiju(kaijuName) then
				if not CandyConfig.isSeason() then
					return false, "Offsale until halloween"
				end
				if type(_G.SpendCandy) ~= "function" or not _G.SpendCandy(player, price) then
					return false, "Not enough Candy"
				end
				playerKaijus[player.UserId][kaijuName] = true
				local oldName = reverseNameMapping[kaijuName]
				if oldName then
					playerKaijus[player.UserId][oldName] = true
				end
				savePlayerKaijus(player)
				return true, "Success"
			end

			local leaderstats = player:FindFirstChild("leaderstats")
			if not leaderstats then
				return false, "No leaderstats found"
			end

			local gcells = leaderstats:FindFirstChild("GCells") or leaderstats:FindFirstChild("gcells")
			if not gcells then
				return false, "No GCells found"
			end

			if gcells.Value < price then
				return false, "Not enough GCells"
			end

			gcells.Value = gcells.Value - price

			playerKaijus[player.UserId][kaijuName] = true

			local oldName = reverseNameMapping[kaijuName]
			if oldName then
				playerKaijus[player.UserId][oldName] = true
			end

			savePlayerKaijus(player)

			return true, "Success"
		end

		getOwnershipEvent.OnServerInvoke = function(player, kaijuName)
			if not playerKaijus[player.UserId] then
				loadPlayerKaijus(player)
			end
			if kaijuName then
				return ownsKaiju(player, kaijuName)
			else
				local result = {}
				if Morphs then
					for _, morph in ipairs(getAllMorphModels()) do
						local stats = morph:FindFirstChild("Stats")
						local price = stats and stats:FindFirstChild("Price")
						if price and tonumber(price.Value) and tonumber(price.Value) <= 0 then
							result[morph.Name] = true
						end
					end
				end


				local data = playerKaijus[player.UserId]
				if data then
					for k, v in pairs(data) do
						
						if not isGamepassKaiju(k) then
							local mappedName = nameMapping[k]
							if mappedName and isGamepassKaiju(mappedName) then
								
							else
								result[k] = v
								if mappedName then
									result[mappedName] = v
								end
							end
						end
					end
				end

				for morphName, _ in pairs(gamepassKaijus) do
					if ownsGamepass(player, morphName) or GamepassWhitelist[player.UserId] then
						result[morphName] = true
					end
				end
				return result
			end
		end

		buyKaijuEvent.OnServerEvent:Connect(function(player, kaijuName)
			local ok, buySuccess, buyMessage = pcall(buyKaiju, player, kaijuName)
			if not ok then
				warn("Error in buyKaiju: " .. tostring(buySuccess))
				buyKaijuEvent:FireClient(player, kaijuName, false, "Server error")
			else
				buyKaijuEvent:FireClient(player, kaijuName, buySuccess, buyMessage)
			end
		end)

		getGamepassKaijusFunc.OnServerInvoke = function(player)
			return gamepassKaijus
		end

		getSelectedKaijuFunc.OnServerInvoke = function(player)
			local selected = playerSelectedKaiju[player.UserId]
			return nameMapping[selected] or selected
		end

		setSelectedKaijuEvent.OnServerEvent:Connect(function(player, morphName)
			if type(morphName) ~= "string" then return end
			morphName = nameMapping[morphName] or morphName
			if not Morphs or not Morphs:FindFirstChild(morphName, true) then return end
			if not ownsKaiju(player, morphName) then
				warn("[Data] SetSelectedKaiju blocked: " .. player.Name .. " does not own " .. morphName)
				return
			end
			playerSelectedKaiju[player.UserId] = morphName
		end)

		local function loadSelectedKaiju(player)
			local success, data = pcall(function()
				return SelectedKaijuStore:GetAsync(tostring(player.UserId))
			end)
			local canonicalName = nameMapping[data] or data
			if success and type(data) == "string" and ownsKaiju(player, canonicalName) then
				playerSelectedKaiju[player.UserId] = canonicalName
			else
				playerSelectedKaiju[player.UserId] = nil
			end
		end

		local function saveSelectedKaiju(player)
			local data = playerSelectedKaiju[player.UserId]
			if data == nil then
				pcall(function()
					SelectedKaijuStore:RemoveAsync(tostring(player.UserId))
				end)
				return
			end
			local success, err = pcall(function()
				SelectedKaijuStore:SetAsync(tostring(player.UserId), data)
			end)
			if not success then
				warn("Error saving selected kaiju for " .. player.Name .. ": " .. err)
			end
		end

		local function removeUnmetRequirements(player)
			local data = playerKaijus[player.UserId]
			if not data then return end

			local didRemove = false
			local anyRemoved = true
			while anyRemoved do
				anyRemoved = false

				local ownedKaijus = {}
				for kaijuName, owned in pairs(data) do
					if owned then
						table.insert(ownedKaijus, kaijuName)
					end
				end

				for _, kaijuName in ipairs(ownedKaijus) do
					local reqMet, _ = checkRequirement(player, kaijuName)
					if not reqMet then
						data[kaijuName] = nil
						local morphName = nameMapping[kaijuName]
						if morphName then
							data[morphName] = nil
						end
						local oldName = reverseNameMapping[kaijuName]
						if oldName then
							data[oldName] = nil
						end
						anyRemoved = true
						didRemove = true
					end
				end
			end

			if didRemove then
				savePlayerKaijus(player)

				local selected = playerSelectedKaiju[player.UserId]
				if selected and not ownsKaiju(player, selected) then
					local stillOwned = false
					local mappedName = nameMapping[selected]
					if mappedName and data[mappedName] then stillOwned = true end
					local oldName = reverseNameMapping[selected]
					if oldName and data[oldName] then stillOwned = true end
					if not stillOwned then
						playerSelectedKaiju[player.UserId] = nil
						saveSelectedKaiju(player)
					end
				end
			end
		end

		local function removeGamepassKaijusFromData(player)
			if GamepassWhitelist[player.UserId] then return end
			
			local data = playerKaijus[player.UserId]
			if not data then return end

			local didRemove = false
			for kaijuName, _ in pairs(data) do
				if isGamepassKaiju(kaijuName) then
					data[kaijuName] = nil
					didRemove = true
				end
				local mappedName = nameMapping[kaijuName]
				if mappedName and isGamepassKaiju(mappedName) then
					data[kaijuName] = nil
					didRemove = true
				end
			end

			
			for kaijuName, _ in pairs(data) do
				local oldName = reverseNameMapping[kaijuName]
				if oldName and isGamepassKaiju(kaijuName) then
					data[kaijuName] = nil
					didRemove = true
				end
			end

			if didRemove then
				savePlayerKaijus(player)
			end
		end

		local function onPlayerAdded(player)
			loadPlayerKaijus(player)
			removeGamepassKaijusFromData(player)
			loadSelectedKaiju(player)
			removeUnmetRequirements(player)
		end

		local function onPlayerRemoving(player)
			savePlayerKaijus(player)
			saveSelectedKaiju(player)
			playerKaijus[player.UserId] = nil
			playerSelectedKaiju[player.UserId] = nil
			playerGamepassCache[player.UserId] = nil
		end

		Players.PlayerAdded:Connect(onPlayerAdded)
		Players.PlayerRemoving:Connect(onPlayerRemoving)

		for _, player in Players:GetPlayers() do
			task.spawn(function()
				loadPlayerKaijus(player)
				removeGamepassKaijusFromData(player)
				loadSelectedKaiju(player)
				removeUnmetRequirements(player)
			end)
		end

		task.spawn(function()
			while true do
				task.wait(60)
				for _, player in Players:GetPlayers() do
					savePlayerKaijus(player)
					saveSelectedKaiju(player)
				end
			end
		end)

		game:BindToClose(function()
			for _, player in Players:GetPlayers() do
				savePlayerKaijus(player)
				saveSelectedKaiju(player)
			end
		end)
	end
	
	local function initKaijuData()
		local DataStoreService = game:GetService("DataStoreService")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")

		local LevelDataStore = DataStoreService:GetDataStore("PlayerLevels_v3")
		local ModifierDataStore = DataStoreService:GetDataStore("PlayerModifiers_v1")
		local levelNameMapping = {
			["Godzilla1954"] = "GOJIRA [FREE]",
			["Anguirus"] = "ANGUIRUS [FREE]",
			["KamataKun"] = "SHIN FORM 2 [FREE]",
			["Godzilla2014"] = "GODZILLA 2014",
			["F16C"] = "F16C [FREE]",
			["Human"] = "CIVILIAN [FREE]",
			["Tank"] = "MILITARY TANK [FREE]",
		}

		local getKaijuDataFunc = ReplicatedStorage:FindFirstChild("GetKaijuData")
		if not getKaijuDataFunc then
			getKaijuDataFunc = Instance.new("RemoteFunction")
			getKaijuDataFunc.Name = "GetKaijuData"
			getKaijuDataFunc.Parent = ReplicatedStorage
		end

		getKaijuDataFunc.OnServerInvoke = function(player)
			local success, data = pcall(function()
				return LevelDataStore:GetAsync("Player_" .. player.UserId)
			end)

			local modSuccess, modData = pcall(function()
				return ModifierDataStore:GetAsync("Player_" .. player.UserId)
			end)

			local result = {}
			if success and data and type(data) == "table" then
				for kaijuName, kaijuData in pairs(data) do
					if type(kaijuData) == "table" then
						local canonicalName = levelNameMapping[kaijuName] or kaijuName
						local level = kaijuData.level or 1
						local totalSkillPoints = (kaijuName == "MINILLA") and math.floor(level / 25) or math.floor(level / 5)

						local modifiers = {Damage = 0, Health = 0, Regen = 0, Speed = 0}
						if modSuccess and modData and type(modData) == "table" and (modData[kaijuName] or modData[canonicalName]) then
							modifiers = modData[kaijuName] or modData[canonicalName]
							modifiers.Damage = modifiers.Damage or 0
							modifiers.Health = modifiers.Health or 0
							modifiers.Regen = modifiers.Regen or 0
							modifiers.Speed = modifiers.Speed or 0
						end
						local usedSkillPoints = modifiers.Damage + modifiers.Health + modifiers.Regen + modifiers.Speed
						local availableSkillPoints = math.max(0, totalSkillPoints - usedSkillPoints)

						result[canonicalName] = {
							level = level,
							xp = kaijuData.xp or 0,
							usedSkillPoints = usedSkillPoints,
							availableSkillPoints = availableSkillPoints,
							modifiers = modifiers,
						}
					end
				end
			end

			return result
		end
	end

	
	local function initModifiers()
		local DataStoreService = game:GetService("DataStoreService")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local Players = game:GetService("Players")
		local ServerStorage = game:GetService("ServerStorage")

		local ModifierDataStore = DataStoreService:GetDataStore("PlayerModifiers_v1")
		local LevelDataStore = DataStoreService:GetDataStore("PlayerLevels_v3")

		local DEFAULT_MAX_POINTS_PER_MODIFIER = 10
		local MODIFIER_NAMES = {"Damage", "Health", "Regen", "Speed"}

		local KAIJU_MAX_POINTS_PER_MODIFIER = {
			["CIVILIAN [FREE]"] = 50,
		}

		local function getMaxPointsPerModifier(kaijuName)
			if kaijuName and KAIJU_MAX_POINTS_PER_MODIFIER[kaijuName] then
				return KAIJU_MAX_POINTS_PER_MODIFIER[kaijuName]
			end
			return DEFAULT_MAX_POINTS_PER_MODIFIER
		end

		local modifyStatEvent = ReplicatedStorage:FindFirstChild("ModifyStat")
		if not modifyStatEvent then
			modifyStatEvent = Instance.new("RemoteEvent")
			modifyStatEvent.Name = "ModifyStat"
			modifyStatEvent.Parent = ReplicatedStorage
		end

		local getModifierDataFunc = ReplicatedStorage:FindFirstChild("GetModifierData")
		if not getModifierDataFunc then
			getModifierDataFunc = Instance.new("RemoteFunction")
			getModifierDataFunc.Name = "GetModifierData"
			getModifierDataFunc.Parent = ReplicatedStorage
		end

		local cache = {}
		local levelCache = {}

		local function loadCache(player)
			if cache[player.UserId] then return cache[player.UserId] end

			local success, data = pcall(function()
				return ModifierDataStore:GetAsync("Player_" .. player.UserId)
			end)
			

			if success and data and type(data) == "table" then
				if not data["_HasResetSkillPoints_v1"] then
					data = {
						["_HasResetSkillPoints_v1"] = true
					}
					cache[player.UserId] = data

					pcall(function()
						ModifierDataStore:SetAsync("Player_" .. player.UserId, data)
					end)

					warn("[SKILL RESET] Reset skill points one-time for: " .. player.Name)
				else
					cache[player.UserId] = data
				end
			else
				cache[player.UserId] = {
					["_HasResetSkillPoints_v1"] = true
				}
			end

			return cache[player.UserId]
		end

		local function loadLevelData(player)
			if levelCache[player.UserId] then return levelCache[player.UserId] end

			local success, data = pcall(function()
				return LevelDataStore:GetAsync("Player_" .. player.UserId)
			end)

			if success and data and type(data) == "table" then
				levelCache[player.UserId] = data
			else
				levelCache[player.UserId] = {}
			end
			return levelCache[player.UserId]
		end

		local function saveCache(player)
			local data = cache[player.UserId]
			if not data then return end
			pcall(function()
				ModifierDataStore:SetAsync("Player_" .. player.UserId, data)
			end)
		end

		local function getLevel(player, kaijuName)
			local levelData = loadLevelData(player)
			if levelData and levelData[kaijuName] then
				return levelData[kaijuName].level or 1
			end
			return 1
		end

		local function getTotalPoints(modifiers)
			return (modifiers.Damage or 0) + (modifiers.Health or 0) + (modifiers.Regen or 0) + (modifiers.Speed or 0)
		end

		getModifierDataFunc.OnServerInvoke = function(player)
			local data = loadCache(player)
			local result = {}
			local levelData = loadLevelData(player)

			for kaijuName, modifiers in pairs(data) do
				if type(modifiers) == "table" then
					local level = 1
					if levelData and type(levelData) == "table" and levelData[kaijuName] then
						level = levelData[kaijuName].level or 1
					end
					local total = (kaijuName == "MINILLA") and math.floor(level / 25) or math.floor(level / 5)
					local used = getTotalPoints(modifiers)
					result[kaijuName] = {
						Damage = modifiers.Damage or 0,
						Health = modifiers.Health or 0,
						Regen = modifiers.Regen or 0,
						Speed = modifiers.Speed or 0,
						usedSkillPoints = used,
						availableSkillPoints = math.max(0, total - used),
					}
				end
			end

			if levelData and type(levelData) == "table" then
				for kaijuName, kaijuInfo in pairs(levelData) do
					if type(kaijuInfo) == "table" and not result[kaijuName] then
						local level = kaijuInfo.level or 1
						local total = (kaijuName == "MINILLA") and math.floor(level / 25) or math.floor(level / 5)
						result[kaijuName] = {
							Damage = 0,
							Health = 0,
							Regen = 0,
							Speed = 0,
							usedSkillPoints = 0,
							availableSkillPoints = total,
						}
					end
				end
			end

			return result
		end

		modifyStatEvent.OnServerEvent:Connect(function(player, kaijuName, modifierName, action)
			if type(kaijuName) ~= "string" or type(modifierName) ~= "string" or type(action) ~= "string" then return end

			local valid = false
			for _, name in ipairs(MODIFIER_NAMES) do
				if name == modifierName then valid = true break end
			end
			if not valid then return end

			if not _G.KUNOwnsKaiju or not _G.KUNOwnsKaiju(player, kaijuName) then
				return
			end

			local data = loadCache(player)
			local modifiers = data[kaijuName]
			if not modifiers then
				modifiers = {Damage = 0, Health = 0, Regen = 0, Speed = 0}
				data[kaijuName] = modifiers
			end

			for _, name in ipairs(MODIFIER_NAMES) do
				if not modifiers[name] then modifiers[name] = 0 end
			end

			local current = modifiers[modifierName] or 0
			local used = getTotalPoints(modifiers)
			local level = getLevel(player, kaijuName)
			local total = (kaijuName == "MINILLA") and math.floor(level / 25) or math.floor(level / 5)
			local available = total - used

			
			if used > total then
				local excess = used - total
				local modified = false
				for _, name in ipairs(MODIFIER_NAMES) do
					if excess > 0 and modifiers[name] and modifiers[name] > 0 then
						local reduction = math.min(modifiers[name], excess)
						modifiers[name] = modifiers[name] - reduction
						excess = excess - reduction
						modified = true
					end
				end
				if modified then
					used = getTotalPoints(modifiers)
					current = modifiers[modifierName] or 0
					task.spawn(function()
						saveCache(player)
					end)
				end
			end

			if action == "Add" then
				local maxPerModifier = getMaxPointsPerModifier(kaijuName)
				if available > 0 and current < maxPerModifier then
					modifiers[modifierName] = current + 1
					used = used + 1
				end
			elseif action == "Subtract" then
				if current > 0 then
					modifiers[modifierName] = current - 1
					used = used - 1
				end
			end

			available = math.max(0, total - used)

			if modifierName == "Regen" and player.Character then
				player.Character:SetAttribute("RegenModifier", modifiers.Regen or 0)
			end

			modifyStatEvent:FireClient(player, {
				kaijuName = kaijuName,
				modifiers = {
					Damage = modifiers.Damage or 0,
					Health = modifiers.Health or 0,
					Regen = modifiers.Regen or 0,
					Speed = modifiers.Speed or 0,
				},
				usedSkillPoints = used,
				availableSkillPoints = available,
			})

			
			task.spawn(function()
				saveCache(player)
			end)
		end)

		local levelChangedEvent = ServerStorage:FindFirstChild("LevelChanged")
		if not levelChangedEvent then
			levelChangedEvent = Instance.new("BindableEvent")
			levelChangedEvent.Name = "LevelChanged"
			levelChangedEvent.Parent = ServerStorage
		end

		levelChangedEvent.Event:Connect(function(userId, kaijuName, newLevel)
			if not levelCache[userId] then
				levelCache[userId] = {}
			end
			if levelCache[userId][kaijuName] then
				levelCache[userId][kaijuName].level = newLevel
			else
				levelCache[userId][kaijuName] = { level = newLevel, xp = 0 }
			end

			local player = Players:GetPlayerByUserId(userId)
			if player then
				local data = loadCache(player)
				local modifiers = data[kaijuName] or { Damage = 0, Health = 0, Regen = 0, Speed = 0 }
				local used = getTotalPoints(modifiers)
				local total = math.floor(newLevel / 5)
				local available = math.max(0, total - used)
				modifyStatEvent:FireClient(player, {
					kaijuName = kaijuName,
					modifiers = {
						Damage = modifiers.Damage or 0,
						Health = modifiers.Health or 0,
						Regen = modifiers.Regen or 0,
						Speed = modifiers.Speed or 0,
					},
					usedSkillPoints = used,
					availableSkillPoints = available,
				})
			end
		end)

		Players.PlayerRemoving:Connect(function(player)
			saveCache(player)
			cache[player.UserId] = nil
			levelCache[player.UserId] = nil
		end)

		task.spawn(function()
			while true do
				task.wait(60)
				for _, player in ipairs(Players:GetPlayers()) do
					saveCache(player)
				end
			end
		end)

		game:BindToClose(function()
			for _, player in ipairs(Players:GetPlayers()) do
				saveCache(player)
			end
		end)
	end

	
	local function initRecolor()
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local Players = game:GetService("Players")
		local DataStoreService = game:GetService("DataStoreService")
		local MarketplaceService = game:GetService("MarketplaceService")

		local RECOLOR_GAMEPASS_ID = 1819433033
		local Recolors = require(ReplicatedStorage:WaitForChild("Recolors"))
		local GOLD_REQUIRED_LEVEL = Recolors.Unlock.Gold.level

		local setRecolorEvent = ReplicatedStorage:WaitForChild("SetRecolor", 10)

		local recolorStore = DataStoreService:GetDataStore("PlayerRecolors_v1")
		local levelStore = DataStoreService:GetDataStore("PlayerLevels_v3")
		local LevelManager = require(ReplicatedStorage:WaitForChild("LevelManager"))

		local getRecolorDataFunc = ReplicatedStorage:FindFirstChild("GetRecolorData")
		if not getRecolorDataFunc then
			getRecolorDataFunc = Instance.new("RemoteFunction")
			getRecolorDataFunc.Name = "GetRecolorData"
			getRecolorDataFunc.Parent = ReplicatedStorage
		end

		local playerRecolors = {}

		local function getRecolorData(recolorName)
			return Recolors.Get(recolorName)
		end

		local function parseMaterial(materialStr)
			if not materialStr then return nil end
			local success, material = pcall(function()
				return Enum.Material[materialStr]
			end)
			if success then return material end
			return nil
		end

		local function isKaijuMaxLevel(player, kaijuName)
			local maxLevel = LevelManager.GetMaxLevel(kaijuName)
			local playerLevel = 1
			local success, levelData = pcall(function()
				return levelStore:GetAsync("Player_" .. player.UserId)
			end)
			if success and levelData and type(levelData) == "table" and levelData[kaijuName] then
				playerLevel = levelData[kaijuName].level or 1
			end
			return playerLevel >= maxLevel
		end

		local function isKaijuLevel50(player, kaijuName)
			local playerLevel = 1
			local success, levelData = pcall(function()
				return levelStore:GetAsync("Player_" .. player.UserId)
			end)
			if success and levelData and type(levelData) == "table" and levelData[kaijuName] then
				playerLevel = levelData[kaijuName].level or 1
			end
			return playerLevel >= GOLD_REQUIRED_LEVEL
		end

		local function ownsRecolorGamepass(player)
			if GamepassWhitelist[player.UserId] then
				return true
			end
			local success, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, RECOLOR_GAMEPASS_ID)
			end)
			return success and owns == true
		end

		local function classifyPart(partName)
			local name = string.lower(partName)
			if string.find(name, "eye") then
				return "eye"
			elseif string.find(name, "spike") then
				return "spike"
			elseif string.find(name, "toe") or string.find(name, "finger") or string.find(name, "teeth") then
				return "secondary"
			else
				return "primary"
			end
		end

		local function restoreOriginalColors(character, kaijuName)
			for _, desc in ipairs(character:GetDescendants()) do
				if desc:IsA("BasePart") then
					local origColor = desc:GetAttribute("OriginalColor")
					local origMaterialName = desc:GetAttribute("OriginalMaterial")

					if desc:IsA("UnionOperation") then
					desc.UsePartColor = true
				end
					if origColor then
					desc.Color = origColor
				end
					if origMaterialName then
					local mat = Enum.Material[origMaterialName]
					if mat then
						desc.Material = mat
					end
				end
				end
			end
		end

		local function applyRecolor(character, recolorName, kaijuName)
			if not character or not recolorName then return end

			if recolorName == "NO SKIN" then
				if kaijuName then
					restoreOriginalColors(character, kaijuName)
				end
				return
			end

			local data = getRecolorData(recolorName)
			if not data then return end

			local keepColor = data.KeepColor or false

			local primaryMat = parseMaterial(data.PrimaryMaterial)
			local secondaryMat = parseMaterial(data.SecondaryMaterial) or primaryMat
			local tertiaryMat = parseMaterial(data.TertiaryMaterial) or primaryMat
			local eyeMat = parseMaterial(data.EyeMaterial) or primaryMat

			for _, descendant in ipairs(character:GetDescendants()) do
				if descendant:IsA("BasePart") or descendant:IsA("UnionOperation") or descendant:IsA("MeshPart") then
					local category = classifyPart(descendant.Name)

					local color, materialEnum
					if category == "eye" then
						color = data.EyeColor
						materialEnum = eyeMat
					elseif category == "spike" then
						color = data.Tertiary
						materialEnum = tertiaryMat
					elseif category == "secondary" then
						color = data.Secondary
						materialEnum = secondaryMat
					else
						color = data.Primary
						materialEnum = primaryMat
					end

					if descendant:IsA("UnionOperation") then
						descendant.UsePartColor = true
					end

					if not keepColor and color then
						descendant.Color = color
					end
					if materialEnum then
						descendant.Material = materialEnum
					end
				end
			end
		end

		local function loadPlayerRecolors(player)
			local success, data = pcall(function()
				return recolorStore:GetAsync("recolors_" .. player.UserId)
			end)
			if success and type(data) == "table" then
				playerRecolors[player] = data
			else
				playerRecolors[player] = {}
			end
		end

		local function savePlayerRecolors(player)
			local data = playerRecolors[player]
			if not data then return end
			local success, err = pcall(function()
				recolorStore:SetAsync("recolors_" .. player.UserId, data)
			end)
			if not success then
				warn("Recolor: Failed to save recolors for " .. player.Name .. ": " .. tostring(err))
			end
		end

		if setRecolorEvent then
			setRecolorEvent.OnServerEvent:Connect(function(player, kaijuName, recolorName)
				if typeof(kaijuName) ~= "string" or typeof(recolorName) ~= "string" then return end

				if recolorName == "Diamond" then
					if not isKaijuMaxLevel(player, kaijuName) then
						return
					end

				elseif recolorName == "Gold" then
					if not isKaijuLevel50(player, kaijuName) then
						return
					end

				elseif recolorName ~= "NO SKIN" then
					if not ownsRecolorGamepass(player) then
						return
					end
				end

				if not playerRecolors[player] then
					playerRecolors[player] = {}
				end
				playerRecolors[player][kaijuName] = recolorName

				if player.Character then
					local kaijuValue = player.Character:FindFirstChild("Kaiju")
					if kaijuValue and kaijuValue.Value == kaijuName then
						applyRecolor(player.Character, recolorName, kaijuName)
					end
				end
			end)
		end

		getRecolorDataFunc.OnServerInvoke = function(player)
			return playerRecolors[player] or {}
		end

		local function onCharacterAdded(player, character)
			task.wait(0.1)

			if not character.Parent then return end

			local kaijuValue = character:FindFirstChild("Kaiju")
			if not kaijuValue then return end

			local kaijuName = kaijuValue.Value
			local selections = playerRecolors[player]
			if not selections then return end

			local savedRecolor = selections[kaijuName]
			if savedRecolor == "NO SKIN" then
				return
			elseif savedRecolor then
				if savedRecolor == "Diamond" and not isKaijuMaxLevel(player, kaijuName) then
					return
				end

				if savedRecolor == "Gold" and not isKaijuLevel50(player, kaijuName) then
					return
				end

				if savedRecolor ~= "Diamond" and savedRecolor ~= "Gold" then
					if not ownsRecolorGamepass(player) then
						return
					end
				end
				applyRecolor(character, savedRecolor, kaijuName)
			end
		end

		local function onPlayerAdded(player)
			loadPlayerRecolors(player)

			player.CharacterAdded:Connect(function(character)
				onCharacterAdded(player, character)
			end)

			if player.Character then
				onCharacterAdded(player, player.Character)
			end
		end

		task.spawn(function()
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				if character then
					local kaijuValue = character:FindFirstChild("Kaiju")
					if kaijuValue then
						local kaijuName = kaijuValue.Value
						local selections = playerRecolors[player]
						if selections then
							local savedRecolor = selections[kaijuName]
							if savedRecolor and savedRecolor ~= "NO SKIN" then
								applyRecolor(character, savedRecolor, kaijuName)
							end
						end
					end
				end
			end
		end)

		for _, player in ipairs(Players:GetPlayers()) do
			onPlayerAdded(player)
		end

		Players.PlayerAdded:Connect(onPlayerAdded)

		task.spawn(function()
			while true do
				task.wait(60)
				for player in pairs(playerRecolors) do
					if player.Parent then
						savePlayerRecolors(player)
					end
				end
			end
		end)

		game:BindToClose(function()
			for player in pairs(playerRecolors) do
				savePlayerRecolors(player)
			end
		end)

		Players.PlayerRemoving:Connect(function(player)
			savePlayerRecolors(player)
			playerRecolors[player] = nil
		end)
	end

	
	local function initPerformance()
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local LocalizationService = game:GetService("LocalizationService")

		local perfRemote = ReplicatedStorage:FindFirstChild("PerformanceRemote")
		if not perfRemote then
			perfRemote = Instance.new("RemoteFunction")
			perfRemote.Name = "PerformanceRemote"
			perfRemote.Parent = ReplicatedStorage
		end

		local serverStartTime = os.time()

		perfRemote.OnServerInvoke = function(player)
			local region = "Unknown"

			pcall(function()
				local results = LocalizationService:GetCountryRegionForPlayersAsync({ player })
				if results and #results > 0 then
					region = results[1].code
				end
			end)

			local serverAge = os.time() - serverStartTime

			return {
				serverAge = serverAge,
				region = region,
			}
		end
	end

	
	task.spawn(initOwnership)
	task.spawn(initKaijuData)
	task.spawn(initModifiers)
	task.spawn(initRecolor)
	task.spawn(initPerformance)
end

return Data]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX20">
						<Properties>
							<string name="Name">World</string>
							<ProtectedString name="Source"><![CDATA[local World = {}

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")
local PhysicsService = game:GetService("PhysicsService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HolidayConfigs = require(ReplicatedStorage:WaitForChild("HolidayConfigs"))

local state = { IsRaining = false, IsSnowing = false }
local initialized = false
local windowApi = {}
local savedWindowState = setmetatable({}, { __mode = "k" })

local DEBRIS_GROUP = "CollapseDebris"
local CHARACTER_GROUP = "Characters"
local debrisReady = false

local function initDebrisCollision()
	local ok = pcall(function()
		for _, name in { DEBRIS_GROUP, CHARACTER_GROUP } do
			if not PhysicsService:IsCollisionGroupRegistered(name) then
				PhysicsService:RegisterCollisionGroup(name)
			end
		end
		PhysicsService:CollisionGroupSetCollidable(DEBRIS_GROUP, CHARACTER_GROUP, false)
	end)
	if not ok then return end
	debrisReady = true

	local function assign(character)
		local function mark(d)
			if d:IsA("BasePart") then d.CollisionGroup = CHARACTER_GROUP end
		end
		for _, d in character:GetDescendants() do mark(d) end
		character.DescendantAdded:Connect(mark)
	end

	local function hook(player)
		player.CharacterAdded:Connect(assign)
		if player.Character then assign(player.Character) end
	end

	for _, player in Players:GetPlayers() do hook(player) end
	Players.PlayerAdded:Connect(hook)
end

local function lerp(a, b, t) return a + (b - a) * t end

local function rand(a, b) return a + math.random() * (b - a) end

local function shuffle(list)
	local copy = table.clone(list)
	for i = #copy, 2, -1 do
		local j = math.random(1, i)
		copy[i], copy[j] = copy[j], copy[i]
	end
	return copy
end

local function maxAxis(part)
	return math.max(part.Size.X, part.Size.Y, part.Size.Z) / 2
end

local function easeLinear(p) return p end
local function easeInOut(p)
	if p < 0.5 then return 2 * p * p end
	return 1 - (-2 * p + 2) ^ 2 / 2
end
local function easeCollapse(p) return p ^ 1.7 end
local function easeTilt(p) return p ^ 1.6 end

local function initDayNight()
	local DAY_LENGTH_MIN = 30
	local WEATHER_FADE = 10
	local START_MINUTES = 720
	local timeRatio = (24 * 60) / (math.max(DAY_LENGTH_MIN, 1) * 60)
	local t0 = os.clock()

	local DAY = {
		Brightness = 2, Ambient = Color3.new(0.5, 0.5, 0.5),
		OutdoorAmbient = Color3.new(0.25, 0.28, 0.21),
		ColorShift_Top = Color3.new(1, 0.75, 0.57),
		ColorShift_Bottom = Color3.new(0.15, 0.15, 0.2),
		FogColor = Color3.new(0.61, 0.67, 0.77), FogEnd = 5500,
		Density = 0.3, AtmColor = Color3.new(0.7, 0.75, 0.85), Haze = 2,
		Cloud = Color3.new(1, 1, 1),
	}
	local NIGHT = {
		Brightness = 1.2, Ambient = Color3.new(0.28, 0.32, 0.45),
		OutdoorAmbient = Color3.new(0.15, 0.18, 0.3),
		ColorShift_Top = Color3.new(0.12, 0.15, 0.28),
		ColorShift_Bottom = Color3.new(0.06, 0.07, 0.14),
		FogColor = Color3.new(0.18, 0.21, 0.3), FogEnd = 3000,
		Density = 0.4, AtmColor = Color3.new(0.1, 0.1, 0.18), Haze = 3,
		Cloud = Color3.new(0.12, 0.12, 0.16),
	}
	local RAIN = {
		FogEndMul = 0.4, DensityAdd = 0.15, HazeAdd = 1,
		FogColor = Color3.new(0.35, 0.37, 0.4),
		AtmColor = Color3.new(0.4, 0.42, 0.45),
		Cloud = Color3.new(0.15, 0.15, 0.18),
	}

	local SNOW = RAIN
	local DEFAULT = { Day = DAY, Night = NIGHT, Rain = RAIN }
	local lastCheck = -math.huge
	local baseDecay = nil
	local wxLevel, wxTable = 0, nil
	local lastWx = os.clock()

	local fxBase = setmetatable({}, { __mode = "k" })

	local function setFx(inst, prop, value)
		local saved = fxBase[inst]
		if not saved then
			saved = {}
			fxBase[inst] = saved
		end
		if saved[prop] == nil then saved[prop] = inst[prop] end
		if value ~= nil then inst[prop] = value else inst[prop] = saved[prop] end
	end

	local function applyEffects(fx)
		fx = fx or {}
		local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
		if atmosphere then
			setFx(atmosphere, "Offset", fx.AtmOffset)
			setFx(atmosphere, "Glare", fx.AtmGlare)
		end
		for _, child in Lighting:GetChildren() do
			if child:IsA("BloomEffect") then
				setFx(child, "Intensity", fx.BloomIntensity)
				setFx(child, "Threshold", fx.BloomThreshold)
			elseif child:IsA("SunRaysEffect") then
				setFx(child, "Intensity", fx.SunRaysIntensity)
			end
		end
		setFx(Lighting, "ExposureCompensation", fx.Exposure)
	end

	local function rawDayFactor(m)
		if m >= 420 and m <= 1020 then return 1
		elseif m >= 1140 or m <= 300 then return 0
		elseif m < 420 then return (m - 300) / 120
		else return 1 - (m - 1020) / 120 end
	end

	local function dayFactor(m)
		local x = rawDayFactor(m)
		return x * x * (3 - 2 * x)
	end

	while true do
		local clock = os.clock()
		if clock - lastCheck >= 30 then
			lastCheck = clock
			local holiday = HolidayConfigs.getActive()
			local set = holiday and holiday.Lighting or DEFAULT
			DAY, NIGHT = set.Day or DEFAULT.Day, set.Night or DEFAULT.Night
			RAIN = set.Rain or DEFAULT.Rain
			SNOW = set.Snow or set.Rain or DEFAULT.Rain
			applyEffects(holiday and holiday.Effects or nil)
		end

		local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
		local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")

		local minutes = (START_MINUTES + (os.clock() - t0) * timeRatio) % 1440
		Lighting:SetMinutesAfterMidnight(minutes)
		local t = dayFactor(minutes)

		Lighting.Brightness = lerp(NIGHT.Brightness, DAY.Brightness, t)
		Lighting.Ambient = NIGHT.Ambient:Lerp(DAY.Ambient, t)
		Lighting.OutdoorAmbient = NIGHT.OutdoorAmbient:Lerp(DAY.OutdoorAmbient, t)
		Lighting.ColorShift_Top = NIGHT.ColorShift_Top:Lerp(DAY.ColorShift_Top, t)
		Lighting.ColorShift_Bottom = NIGHT.ColorShift_Bottom:Lerp(DAY.ColorShift_Bottom, t)

		local fogEnd = lerp(NIGHT.FogEnd, DAY.FogEnd, t)
		local density = lerp(NIGHT.Density, DAY.Density, t)
		local haze = lerp(NIGHT.Haze, DAY.Haze, t)

		local target = (state.IsRaining or state.IsSnowing) and 1 or 0
		local active = state.IsRaining and RAIN or state.IsSnowing and SNOW or nil
		if active then wxTable = active end
		local maxStep = math.max(clock - lastWx, 0) / WEATHER_FADE
		lastWx = clock
		wxLevel += math.clamp(target - wxLevel, -maxStep, maxStep)
		if wxLevel <= 0 then wxTable = nil end
		local k = wxLevel * wxLevel * (3 - 2 * wxLevel)

		local fogColor = NIGHT.FogColor:Lerp(DAY.FogColor, t)
		local atmColor = NIGHT.AtmColor:Lerp(DAY.AtmColor, t)
		local cloudColor = NIGHT.Cloud:Lerp(DAY.Cloud, t)
		if wxTable and k > 0 then
			fogColor = fogColor:Lerp(wxTable.FogColor, k)
			atmColor = atmColor:Lerp(wxTable.AtmColor, k)
			cloudColor = cloudColor:Lerp(wxTable.Cloud, k)
			fogEnd *= lerp(1, wxTable.FogEndMul, k)
			density += wxTable.DensityAdd * k
			haze += wxTable.HazeAdd * k
		end
		Lighting.FogColor = fogColor
		Lighting.FogEnd = fogEnd
		if atmosphere then
			atmosphere.Density = density
			atmosphere.Color = atmColor
			atmosphere.Haze = haze
		end
		if clouds then clouds.Color = cloudColor end

		if atmosphere then
			if baseDecay == nil then baseDecay = atmosphere.Decay end
			atmosphere.Decay = DAY.AtmDecay and NIGHT.AtmDecay and NIGHT.AtmDecay:Lerp(DAY.AtmDecay, t) or baseDecay
		end

		task.wait(1 / 15)
	end
end

local function initWindowLights()
	local LIT = Color3.fromRGB(197, 166, 89)
	local DARK = Color3.new(0, 0, 0)

	local windowsOn = false
	local epoch = 0
	local saved = savedWindowState
	local lights = {}
	local buildings = {}
	local pool = {}
	local winToken = setmetatable({}, { __mode = "k" })
	local LIGHT_BRIGHTNESS = 1.25
	local LIGHT_RANGE = 30
	local LIGHTS_PER_FRAME = 3
	local TURN_ON_SPREAD = 6
	local TURN_OFF_SPREAD = 5
	local jobs, jobHead, jobTail = {}, 1, 0
	local pending = {}
	local function enqueue(fn)
		jobTail += 1
		jobs[jobTail] = fn
	end
	task.spawn(function()
		while true do
			local n = 0
			while jobHead <= jobTail and n < LIGHTS_PER_FRAME do
				local fn = jobs[jobHead]
				jobs[jobHead] = nil
				jobHead += 1
				n += 1
				pcall(fn)
			end
			task.wait()
		end
	end)

	local function owningBuilding(inst)
		local p = inst.Parent
		while p do
			if p:IsA("Model") and p.Name:find("Building") then return p end
			p = p.Parent
		end
	end

	local function register(inst)
		if inst:IsA("UnionOperation") and inst.Name:find("Windows") then
			local b = owningBuilding(inst)
			if b then
				buildings[b] = buildings[b] or {}
				if not table.find(buildings[b], inst) then
					table.insert(buildings[b], inst)
				end
			end
		end
	end

	for _, d in workspace:GetDescendants() do register(d) end
	workspace.DescendantAdded:Connect(register)
	workspace.DescendantRemoving:Connect(function(inst)
		saved[inst] = nil
		for b, list in buildings do
			local i = table.find(list, inst)
			if i then
				table.remove(list, i)
				if #list == 0 then buildings[b] = nil end
				break
			end
		end
	end)

	local function isDestroyed(building)
		local base = building:FindFirstChild("BuildingBase")
		return base and base:IsA("BasePart") and base.Material == Enum.Material.CorrodedMetal or false
	end

	local function windowsOf(building)
		local list = {}
		for _, d in building:GetDescendants() do
			if d:IsA("BasePart") and d.Name:lower():find("window", 1, true) then
				table.insert(list, d)
			end
		end
		return list
	end

	local function capture(window)
		if not saved[window] then
			saved[window] = { Material = window.Material, Color = window.Color }
		end
	end

	local colorCache = setmetatable({}, { __mode = "k" })
	local winBuilding = setmetatable({}, { __mode = "k" })
	local palette = nil
	local dayLit = {}
	local dayLitAt = 0
	local dayLitOn = false

	local function buildingColor(building)
		if not palette or not building then return LIT end
		local c = colorCache[building]
		if not c then
			local base = building:FindFirstChild("BuildingBase")
			local p = base and base:IsA("BasePart") and base.Position or Vector3.zero
			local h = math.floor(math.abs(p.X * 7.13 + p.Z * 13.37 + p.Y * 3.1))
			c = palette[h % #palette + 1]
			colorCache[building] = c
		end
		return c
	end

	local function colorOf(window)
		local b = winBuilding[window]
		if not b then
			b = owningBuilding(window)
			winBuilding[window] = b
		end
		return buildingColor(b)
	end

	local function refreshPalette()
		local holiday = HolidayConfigs.getActive()
		local nextPalette = holiday and holiday.WindowColors or nil
		if nextPalette == palette then return end
		palette = nextPalette
		table.clear(colorCache)
		for base, light in lights do
			if light.Parent and base.Parent then light.Color = buildingColor(base.Parent) end
		end
	end

	local function setWindow(window, lit)
		if not window.Parent then return end
		capture(window)
		window.Material = Enum.Material.Neon
		window.Color = lit and colorOf(window) or DARK
	end

	local function restoreWindow(window)
		if not window.Parent then return end
		local s = saved[window]
		if s then
			window.Material, window.Color = s.Material, s.Color
		else
			window.Material, window.Color = Enum.Material.Glass, DARK
		end
	end

	local function flickerWindow(window, duration, final)
		if not window.Parent then return end
		capture(window)
		winToken[window] = (winToken[window] or 0) + 1
		local mine = winToken[window]
		task.spawn(function()
			local stop = os.clock() + duration
			local litColor = colorOf(window)
			while winToken[window] == mine and window.Parent and os.clock() < stop do
				window.Material = Enum.Material.Neon
				window.Color = math.random() < 0.5 and litColor or DARK
				task.wait(0.03 + math.random() * 0.09)
			end
			if winToken[window] ~= mine or not window.Parent then return end
			if final == "lit" then
				setWindow(window, true)
			elseif final == "dark" then
				setWindow(window, false)
			else
				restoreWindow(window)
			end
		end)
	end

	local function ensureLight(base)
		if lights[base] or pending[base] or not base.Parent then return end
		pending[base] = true
		enqueue(function()
			pending[base] = nil
			if lights[base] or not base.Parent or not windowsOn then return end
			local l = Instance.new("PointLight")
			l.Name = "BuildingGlowLight"
			l.Color = buildingColor(base.Parent)
			l.Brightness = LIGHT_BRIGHTNESS
			l.Range = LIGHT_RANGE
			l.Shadows = false
			CollectionService:AddTag(l, "BuildingGlowLight")
			l.Parent = base
			lights[base] = l
		end)
	end

	local function removeLight(base)
		local l = lights[base]
		if l then
			lights[base] = nil
			enqueue(function()
				if l.Parent then l:Destroy() end
			end)
		end
	end

	local function lightBuilding(building, windows, myEpoch)
		if epoch ~= myEpoch then return end
		local destroyed = isDestroyed(building)
		local base = building:FindFirstChild("BuildingBase")
		if not destroyed and base and base:IsA("BasePart") then ensureLight(base) end

		local function step(delay)
			task.wait(delay)
			return epoch == myEpoch
		end

		if not destroyed then
			for _, w in windows do
				if not step(math.random() * 0.3 + 0.8) then return end
				flickerWindow(w, 0.3 + math.random() * 0.6, "lit")
			end
		elseif #windows == 1 then
			if not step(math.random() * 0.3 + 8) then return end
			flickerWindow(windows[1], 0.3 + math.random() * 0.6, "dark")
		else
			for i, w in shuffle(windows) do
				if not step(math.random() * 0.3 + 0.8) then return end
				flickerWindow(w, 0.3 + math.random() * 0.6, i <= 2 and "lit" or "dark")
			end
		end
	end

	local function turnOn()
		if windowsOn then return end
		windowsOn = true
		dayLitOn = false
		table.clear(dayLit)
		refreshPalette()
		epoch += 1
		local myEpoch = epoch
		for building, windows in buildings do
			task.delay(math.random() * TURN_ON_SPREAD, lightBuilding, building, table.clone(windows), myEpoch)
		end
	end

	local function turnOff()
		if not windowsOn then return end
		windowsOn = false
		dayLitOn = false
		table.clear(dayLit)
		dayLitAt = os.clock() + TURN_OFF_SPREAD + 1
		epoch += 1
		local stale = {}
		for base in lights do table.insert(stale, base) end
		for _, base in stale do removeLight(base) end
		pool = {}
		for _, windows in buildings do
			for _, w in windows do
				winToken[w] = (winToken[w] or 0) + 1
				task.delay(math.random() * TURN_OFF_SPREAD + 0.2, restoreWindow, w)
			end
		end
	end

	local function syncLights()
		local newPool = {}
		for building, windows in buildings do
			local base = building:FindFirstChild("BuildingBase")
			if base and base:IsA("BasePart") then
				if isDestroyed(building) then
					removeLight(base)
				else
					ensureLight(base)
					for _, w in windows do table.insert(newPool, { w, building }) end
				end
			end
		end
		pool = newPool
		for base in lights do
			if not base.Parent then removeLight(base) end
		end
	end

	local function clearDayLights()
		for window in dayLit do
			if window.Parent then restoreWindow(window) end
		end
		table.clear(dayLit)
		dayLitOn = false
	end

	local function refreshDayLights()
		if windowsOn then return end
		local holiday = HolidayConfigs.getActive()
		local cfg = holiday and holiday.DayLights or nil
		if not cfg then
			if dayLitOn then clearDayLights() end
			return
		end
		if dayLitOn or os.clock() < dayLitAt or next(buildings) == nil then return end
		dayLitOn = true
		for building, windows in buildings do
			if not isDestroyed(building) and math.random() < cfg.Buildings then
				for _, window in windows do
					if window.Parent and math.random() < cfg.Windows then
						dayLit[window] = true
						task.delay(math.random() * cfg.Spread, function()
							if dayLitOn and dayLit[window] and not windowsOn then
								flickerWindow(window, 0.3 + math.random() * 0.6, "lit")
							end
						end)
					end
				end
			end
		end
	end

	windowApi.flickerBuilding = function(building, duration, ruined)
		local list = windowsOf(building)
		if #list == 0 then return end
		local darkCount = #list == 1 and 1 or math.random(1, math.min(#list, 3))
		for i, w in shuffle(list) do
			local final
			if ruined then
				if windowsOn then
					final = i <= 2 and "lit" or "dark"
				else
					final = i <= darkCount and "dark" or "restore"
				end
			else
				final = windowsOn and "lit" or "restore"
			end
			flickerWindow(w, duration * (0.7 + math.random() * 0.3), final)
		end
	end

	windowApi.resetBuilding = function(building)
		for _, w in windowsOf(building) do
			winToken[w] = (winToken[w] or 0) + 1
			if windowsOn then setWindow(w, true) else restoreWindow(w) end
		end
	end

	game:BindToClose(function()
		for _, windows in buildings do
			for _, w in windows do restoreWindow(w) end
		end
	end)

	refreshPalette()
	local lastNight, counter = nil, 0
	while true do
		refreshPalette()
		local m = Lighting:GetMinutesAfterMidnight()
		local night = m >= 1080 or m < 360
		if night ~= lastNight then
			lastNight = night
			if night then turnOn() else turnOff() end
		end
		refreshDayLights()
		if windowsOn then
			counter += 1
			if counter >= 3 then counter = 0 syncLights() end
			if #pool > 0 and math.random() < 0.6 then
				local pick = pool[math.random(1, #pool)]
				if pick[1].Parent and not isDestroyed(pick[2]) then
					flickerWindow(pick[1], 0.15 + math.random() * 0.45, "lit")
				end
			end
		end
		task.wait(1)
	end
end

local function initHolidayGround()
	local terrain = workspace.Terrain
	local terrainBase = terrain:GetMaterialColor(Enum.Material.Grass)
	local saved = setmetatable({}, { __mode = "k" })
	local activeColor, activeName = nil, nil

	local function tint(part)
		if activeColor and part ~= terrain and part:IsA("BasePart") and part.Material == Enum.Material.Grass and saved[part] == nil then
			saved[part] = part.Color
			part.Color = activeColor
		end
	end

	workspace.DescendantAdded:Connect(tint)

	local function sweep(color)
		local n = 0
		for _, d in workspace:GetDescendants() do
			if activeColor ~= color then return end
			tint(d)
			n += 1
			if n % 300 == 0 then task.wait() end
		end
	end

	local function clear()
		activeColor, activeName = nil, nil
		for part, c in saved do
			if part.Parent then part.Color = c end
			saved[part] = nil
		end
		terrain:SetMaterialColor(Enum.Material.Grass, terrainBase)
	end

	while true do
		local holiday = HolidayConfigs.getActive()
		local color = holiday and holiday.GroundColor or nil
		local name = color and holiday.Name or nil
		if name ~= activeName then
			if activeName then clear() end
			if color then
				activeColor, activeName = color, name
				terrain:SetMaterialColor(Enum.Material.Grass, color)
				task.spawn(sweep, color)
			end
		end
		task.wait(60)
	end
end

local function initSky()
	local skys = Lighting:WaitForChild("Skys", 30)
	if not skys then return end
	for _, child in Lighting:GetChildren() do
		if child:IsA("Sky") then child:Destroy() end
	end

	local active, activeName = nil, nil
	while true do
		local holiday = HolidayConfigs.getActive()
		local desired = holiday and holiday.Sky or (state.IsRaining and "Rainy" or "Sunny")
		if desired ~= activeName then
			local template = skys:FindFirstChild(desired)
			if template and template:IsA("Sky") then
				local sky = template:Clone()
				sky.Name = "ActiveSky"
				sky.Parent = Lighting
				if active then active:Destroy() end
				active, activeName = sky, desired
			end
		end
		task.wait(1)
	end
end

local function initRain()
	local toggleRain = ReplicatedStorage:FindFirstChild("ToggleRain")
	local toggleSnow = ReplicatedStorage:FindFirstChild("ToggleSnow")

	while true do
		local weather = HolidayConfigs.getWeather()
		task.wait(math.random(weather.Gap[1], weather.Gap[2]))

		weather = HolidayConfigs.getWeather()
		local snow = weather.Kind == "Snow"
		if snow then
			state.IsSnowing = true
			if toggleSnow then toggleSnow:FireAllClients(true) end
		else
			state.IsRaining = true
			if toggleRain then toggleRain:FireAllClients(true) end
		end

		task.wait(math.random(weather.Duration[1], weather.Duration[2]))

		if snow then
			state.IsSnowing = false
			if toggleSnow then toggleSnow:FireAllClients(false) end
		else
			state.IsRaining = false
			if toggleRain then toggleRain:FireAllClients(false) end
		end
	end
end

local function initBuilding()
	local RUMBLE_TIME = 0.8
	local COLLAPSE_TIME = 2.6
	local RESPAWN_DELAY = 60
	local DEBRIS_CHUNKS = 9

	local touchingParts = {}
	local hitboxOwners = {}
	local destroyed = {}
	local buildingRefs = {}
	local beamLoops, blastLoops = {}, {}

	local DAMAGE_KEYWORDS = { "hitbox", "beam", "blast", "firebomb" }

	local function isValidDamager(name)
		name = name:lower()
		for _, k in DAMAGE_KEYWORDS do
			if name:find(k, 1, true) then return true end
		end
		return false
	end

	local function isHitPart(part)
		local cur = part.Parent
		while cur and cur ~= game do
			local n = cur.Name:lower()
			if n == "hitparts" or n == "hitparts2" then return true end
			cur = cur.Parent
		end
		return false
	end

	local function getPlayerFromHitbox(hit)
		local cur = hit.Parent
		while cur do
			if cur:FindFirstChildOfClass("Humanoid") then
				return Players:GetPlayerFromCharacter(cur)
			end
			cur = cur.Parent
		end
		local attacker = hit:GetAttribute("Attacker")
		if not attacker then
			local dps = hit:FindFirstChild("DPS")
			attacker = dps and dps:GetAttribute("Attacker")
		end
		return attacker and Players:FindFirstChild(attacker) or nil
	end

	local function playHitSound(base)
		local template = script:FindFirstChild("HitSound")
		if template and base and base.Parent then
			local s = template:Clone()
			s.Parent = base
			s:Play()
			Debris:AddItem(s, 5)
		end
	end

	local function reward(player, cells, damage, at)
		if not player then return end
		local ls = player:FindFirstChild("leaderstats")
		local gcells = ls and (ls:FindFirstChild("GCells") or ls:FindFirstChild("gcells"))
		if gcells and gcells:IsA("IntValue") then
			if _G.GCellGuardAllow then _G.GCellGuardAllow(gcells, 3) end
			gcells.Value += cells
		end
		local char = player.Character
		local xp = char and char:FindFirstChild("AddXP")
		local xpAmount = 0
		if xp and xp:IsA("BindableEvent") then
			xpAmount = math.random(1, 3)
			xp:Fire(xpAmount)
		end
		if _G.ShowIndicator then _G.ShowIndicator(player, damage or 0, cells, xpAmount, at) end
	end

	local function liveRefs()
		return coroutine.wrap(function()
			for building, refs in buildingRefs do
				if not destroyed[building] and refs.base and refs.base.Parent then
					coroutine.yield(building, refs)
				end
			end
		end)
	end

	local function startBlastCheck(blast)
		if blastLoops[blast] then return end
		blastLoops[blast] = true
		task.spawn(function()
			while blast.Parent and blast:GetAttribute("BlastActive") do
				local pos, r = blast.Position, maxAxis(blast)
				for _, refs in liveRefs() do
					if (pos - refs.pos).Magnitude <= r + refs.radius then
						playHitSound(refs.base)
						refs.HP.Value = 0
						refs.onDestroyed()
					end
				end
				task.wait(0.15)
			end
			blastLoops[blast] = nil
		end)
	end

	local function trackBlast(part)
		if part:GetAttribute("BlastTrackingSetup") then return end
		part:SetAttribute("BlastTrackingSetup", true)
		if part:GetAttribute("BlastActive") then startBlastCheck(part) end
		local conn = part:GetAttributeChangedSignal("BlastActive"):Connect(function()
			if part:GetAttribute("BlastActive") then startBlastCheck(part) end
		end)
		part.AncestryChanged:Connect(function(_, p)
			if not p then conn:Disconnect() end
		end)
	end

	local function startBeamCheck(hitbox)
		if beamLoops[hitbox] then return end
		beamLoops[hitbox] = true
		task.spawn(function()
			while hitbox.Parent do
				local pos, r = hitbox.Position, maxAxis(hitbox)
				for building, refs in liveRefs() do
					local set = touchingParts[building]
					if set then
						if (pos - refs.pos).Magnitude <= r + refs.radius then
							if not set[hitbox] then
								set[hitbox] = true
								playHitSound(refs.base)
								refs.startDamageLoop()
							end
						else
							set[hitbox] = nil
						end
					end
				end
				task.wait(0.15)
			end
			beamLoops[hitbox] = nil
		end)
	end

	local function setupBuilding(building)
		if not building.Name:lower():find("building") or buildingRefs[building] then return end

		local leftovers = {}
		for _, c in building:GetChildren() do
			if c:IsA("BasePart") and c.Name:lower():find("leftover") then
				table.insert(leftovers, c)
			end
		end
		local base = building:FindFirstChild("BuildingBase")
		local stats = building:FindFirstChild("Stats")
		local HP = stats and stats:FindFirstChild("HP")
		if #leftovers == 0 or not base or not HP then return end

		for _, l in leftovers do
			l.CanCollide, l.Transparency, l.Anchored = false, 1, true
		end
		for _, name in { "Fire", "Smoke" } do
			local e = base:FindFirstChild(name)
			if e and e:IsA("ParticleEmitter") then
				e.Enabled = false
				e.Parent = leftovers[1]
			end
		end

		local parts, original, origCFs = {}, {}, {}
		local minY = math.huge
		for _, d in building:GetDescendants() do
			if d:IsA("BasePart") and not d.Name:lower():find("leftover") then
				table.insert(parts, d)
				table.insert(origCFs, d.CFrame)
				original[d] = { Material = d.Material, Color = d.Color, CanCollide = d.CanCollide }
				minY = math.min(minY, d.Position.Y - d.Size.Y / 2)
				if d.Name:lower():find("window", 1, true) and not savedWindowState[d] then
					savedWindowState[d] = { Material = d.Material, Color = d.Color }
				end
			end
		end

		local basePos = base.Position
		local pivot = Vector3.new(basePos.X, minY, basePos.Z)
		local footW, footD = base.Size.X, base.Size.Z
		local shakeScale = math.clamp(maxAxis(base) / 25, 0.4, 2.5)
		local dustScale = math.clamp(math.max(footW, footD) / 8, 3, 14)

		local pose = { sink = 0, tx = 0, tz = 0 }
		local anim, jolt = nil, nil
		local rendering = false
		local seed = math.random() * 1000
		local cframes = table.create(#parts)

		local function apply(sx, sy, sz, rx, rz)
			local rot = CFrame.Angles(pose.tx + rx, 0, pose.tz + rz)
			local offset = CFrame.new(sx, sy - pose.sink, sz) * CFrame.new(pivot) * rot * CFrame.new(-pivot)
			for i = 1, #parts do cframes[i] = offset * origCFs[i] end
			pcall(workspace.BulkMoveTo, workspace, parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end

		local function render()
			if rendering then return end
			rendering = true
			task.spawn(function()
				while base.Parent do
					local now = os.clock()
					local amp = 0
					if anim then
						local p = math.clamp((now - anim.t0) / anim.dur, 0, 1)
						local e = anim.ease(p)
						local te = anim.tiltEase(p)
						pose.sink = lerp(anim.from.sink, anim.to.sink, e)
						pose.tx = lerp(anim.from.tx, anim.to.tx, te)
						pose.tz = lerp(anim.from.tz, anim.to.tz, te)
						amp = anim.amp * math.sin(math.pi * p ^ 0.6)
						if p >= 1 then anim = nil end
					end
					if jolt then
						local jp = (now - jolt.t0) / jolt.dur
						if jp >= 1 then
							jolt = nil
						else
							amp += jolt.amp * (1 - jp) ^ 2
						end
					end
					local sx, sy, sz, rx, rz = 0, 0, 0, 0, 0
					if amp > 0.001 then
						local t = now * 24
						local ts = amp * shakeScale
						sx = math.noise(t, seed, 0.5) * 2 * ts
						sy = math.noise(t, seed, 10.5) * ts
						sz = math.noise(t, seed, 20.5) * 2 * ts
						rx = math.noise(t, seed, 30.5) * 0.012 * amp
						rz = math.noise(t, seed, 40.5) * 0.012 * amp
					end
					apply(sx, sy, sz, rx, rz)
					if not anim and not jolt then break end
					task.wait(1 / 30)
				end
				rendering = false
			end)
		end

		local function startAnim(sink, tx, tz, dur, amp, ease, tiltEase)
			seed = math.random() * 1000
			anim = {
				from = { sink = pose.sink, tx = pose.tx, tz = pose.tz },
				to = { sink = sink, tx = tx, tz = tz },
				t0 = os.clock(), dur = dur, amp = amp,
				ease = ease, tiltEase = tiltEase or ease,
			}
			render()
		end

		local function addJolt(amp, dur)
			if jolt and jolt.amp * (1 - (os.clock() - jolt.t0) / jolt.dur) > amp then return end
			seed = math.random() * 1000
			jolt = { amp = amp, dur = dur, t0 = os.clock() }
			render()
		end

		local function dust(count, sources)
			for _ = 1, sources do
				local att = Instance.new("Attachment")
				att.Parent = workspace.Terrain
				att.WorldPosition = pivot + Vector3.new(rand(-footW / 2, footW / 2) * 0.8, 0.5, rand(-footD / 2, footD / 2) * 0.8)
				local e = Instance.new("ParticleEmitter")
				e.Texture = "rbxasset://textures/particles/smoke_main.dds"
				e.Rate = 0
				e.Lifetime = NumberRange.new(2, 4)
				e.Speed = NumberRange.new(8, 26)
				e.SpreadAngle = Vector2.new(75, 75)
				e.EmissionDirection = Enum.NormalId.Top
				e.Rotation = NumberRange.new(0, 360)
				e.RotSpeed = NumberRange.new(-40, 40)
				e.Drag = 2
				e.Acceleration = Vector3.new(0, 1.5, 0)
				e.Color = ColorSequence.new(Color3.fromRGB(155, 145, 130), Color3.fromRGB(105, 105, 105))
				e.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, dustScale * 0.4),
					NumberSequenceKeypoint.new(1, dustScale * 1.6),
				})
				e.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5),
					NumberSequenceKeypoint.new(0.6, 0.75),
					NumberSequenceKeypoint.new(1, 1),
				})
				e.Parent = att
				e:Emit(count)
				Debris:AddItem(att, 7)
			end
		end

		local function throwChunks(count)
			for _ = 1, count do
				local chunk = Instance.new("Part")
				chunk.Name = "CollapseChunk"
				chunk.Size = Vector3.new(rand(0.8, 2.8), rand(0.8, 2.8), rand(0.8, 2.8))
				chunk.Material = Enum.Material.CorrodedMetal
				chunk.Transparency = 0
				chunk.Color = base.Color
				chunk.CanTouch = false
				chunk.CanQuery = false
				if debrisReady then chunk.CollisionGroup = DEBRIS_GROUP end
				chunk.CFrame = CFrame.new(pivot + Vector3.new(rand(-footW / 2, footW / 2), rand(2, 15), rand(-footD / 2, footD / 2)))
					* CFrame.Angles(rand(0, 6), rand(0, 6), rand(0, 6))
				chunk.Parent = workspace
				chunk.AssemblyLinearVelocity = Vector3.new(rand(-1, 1), rand(0.4, 1.2), rand(-1, 1)).Unit * rand(18, 45)
				chunk.AssemblyAngularVelocity = Vector3.new(rand(-8, 8), rand(-8, 8), rand(-8, 8))
				local life = rand(2, 2.8)
				task.delay(life - 1, function()
					if chunk.Parent then TweenService:Create(chunk, TweenInfo.new(1), { Transparency = 1 }):Play() end
				end)
				Debris:AddItem(chunk, life)
			end
		end

		local function setLeftoverEffects(on)
			for _, l in leftovers do
				for _, d in l:GetDescendants() do
					if d:IsA("ParticleEmitter") then d.Enabled = on end
				end
			end
		end

		local halfTriggered = false
		local lastFlicker = 0
		HP.Value = 100
		touchingParts[building] = {}

		local function respawn()
			if not base.Parent then return end
			anim, jolt = nil, nil
			pose.sink, pose.tx, pose.tz = 0, 0, 0
			apply(0, 0, 0, 0, 0)
			HP.Value = 100
			halfTriggered = false
			for _, l in leftovers do l.Transparency, l.CanCollide = 1, false end
			setLeftoverEffects(false)
			local sound = base:FindFirstChildOfClass("Sound")
			if sound then sound:Stop() end
			for _, p in parts do
				local o = original[p]
				p.Material, p.Color, p.CanCollide = o.Material, o.Color, o.CanCollide
			end
			destroyed[building] = nil
			if windowApi.resetBuilding then windowApi.resetBuilding(building) end
		end

		local function onDestroyed()
			if destroyed[building] then return end
			destroyed[building] = true

			for _, p in parts do p.Material, p.CanCollide = Enum.Material.CorrodedMetal, false end
			local sound = base:FindFirstChildOfClass("Sound")
			if sound then sound:Play() end

			startAnim(pose.sink, pose.tx, pose.tz, RUMBLE_TIME, 2.6, easeLinear)
			dust(20, 2)
			if windowApi.flickerBuilding then
				windowApi.flickerBuilding(building, RUMBLE_TIME + COLLAPSE_TIME, true)
			end

			task.delay(RUMBLE_TIME, function()
				if not base.Parent then return end
				for _, l in leftovers do l.Transparency, l.CanCollide = 0, false end
				setLeftoverEffects(true)

				local ang = math.rad(rand(10, 22))
				local dir = math.random() * math.pi * 2
				startAnim(base.Size.Y, ang * math.cos(dir), ang * math.sin(dir), COLLAPSE_TIME, 3.4, easeCollapse, easeTilt)
				dust(35, 4)
				task.spawn(function()
					local t0 = os.clock()
					while base.Parent and os.clock() - t0 < COLLAPSE_TIME do
						throwChunks(1)
						task.wait(COLLAPSE_TIME / DEBRIS_CHUNKS)
					end
				end)

				task.delay(COLLAPSE_TIME, function()
					if not base.Parent then return end
					dust(80, 5)
					addJolt(5, 0.9)
					task.delay(RESPAWN_DELAY, respawn)
				end)
			end)
		end

		local function halfCollapse()
			halfTriggered = true
			for _, p in parts do p.Material = Enum.Material.CorrodedMetal end
			local ang = math.rad(rand(3, 8))
			local dir = math.random() * math.pi * 2
			startAnim(base.Size.Y * rand(0.25, 0.75), ang * math.cos(dir), ang * math.sin(dir), 1.6, 1.8, easeInOut)
			dust(25, 2)
		end

		local function applyDamage(amount, rewardsByPlayer)
			if HP.Value <= 0 or destroyed[building] then return false end
			HP.Value -= amount
			if HP.Value <= 50 and not halfTriggered then halfCollapse() end
			addJolt(1 + (100 - math.max(HP.Value, 0)) / 60, 0.45)
			dust(6, 1)
			if windowApi.flickerBuilding and os.clock() - lastFlicker > 0.35 then
				lastFlicker = os.clock()
				windowApi.flickerBuilding(building, 0.45, false)
			end
			playHitSound(base)
			for player, cells in rewardsByPlayer do reward(player, cells, amount, building) end
			if HP.Value <= 0 then
				HP.Value = 0
				onDestroyed()
			end
			return true
		end

		local damaging = false
		local function startDamageLoop()
			if damaging then return end
			damaging = true
			task.spawn(function()
				while true do
					local set = touchingParts[building]
					if not set or HP.Value <= 0 or destroyed[building] then break end

					local rewards, any = {}, false
					for hit in set do
						if not hit.Parent then
							set[hit] = nil
							hitboxOwners[hit] = nil
						else
							any = true
							local owner = hitboxOwners[hit]
							if owner then rewards[owner] = (rewards[owner] or 0) + 1 end
						end
					end
					if not any then break end

					applyDamage(20, rewards)
					task.wait(0.5)
				end
				damaging = false
			end)
		end

		buildingRefs[building] = {
			base = base, HP = HP,
			pos = base.Position, radius = maxAxis(base),
			startDamageLoop = startDamageLoop,
			onDestroyed = onDestroyed,
			damageBuilding = function(attacker)
				applyDamage(20, attacker and { [attacker] = 3 } or {})
			end,
		}

		base.Touched:Connect(function(hit)
			if not (isValidDamager(hit.Name) or isHitPart(hit)) then return end
			local player = getPlayerFromHitbox(hit)
			if player then hitboxOwners[hit] = player end

			if hit.Name:lower():find("blast") then
				playHitSound(base)
				HP.Value = 0
				onDestroyed()
				return
			end
			local set = touchingParts[building]
			if set then
				set[hit] = true
				playHitSound(base)
				startDamageLoop()
			end
		end)

		base.TouchEnded:Connect(function(hit)
			if isHitPart(hit) then return end
			local set = touchingParts[building]
			if set then set[hit] = nil end
			hitboxOwners[hit] = nil
		end)

		building.AncestryChanged:Connect(function(_, parent)
			if not parent then
				touchingParts[building] = nil
				buildingRefs[building] = nil
				destroyed[building] = nil
			end
		end)
	end

	local Map = workspace:WaitForChild("Map")
	for _, b in Map:GetChildren() do
		if b:IsA("Model") then
			setupBuilding(b)
			task.wait()
		end
	end
	Map.DescendantAdded:Connect(function(d)
		if d:IsA("Model") and d.Name:lower():find("building") then
			task.wait(0.1)
			setupBuilding(d)
		end
	end)

	workspace.DescendantAdded:Connect(function(d)
		if not d:IsA("BasePart") or not isValidDamager(d.Name) then return end
		task.defer(function()
			if not d.Parent then return end
			local lname = d.Name:lower()
			local isBlast = lname:find("blast") ~= nil

			local player = getPlayerFromHitbox(d)
			if player then hitboxOwners[d] = player end

			local pos, r = d.Position, maxAxis(d)
			for building, refs in liveRefs() do
				if (pos - refs.pos).Magnitude <= r + refs.radius then
					if isBlast then
						playHitSound(refs.base)
						refs.HP.Value = 0
						refs.onDestroyed()
					elseif touchingParts[building] then
						touchingParts[building][d] = true
						refs.startDamageLoop()
					end
				end
			end

			if isBlast then
				trackBlast(d)
			elseif lname:find("beam") or lname:find("hitbox") then
				startBeamCheck(d)
			end

			d.AncestryChanged:Connect(function(_, parent)
				if parent then return end
				for building in buildingRefs do
					local set = touchingParts[building]
					if set then set[d] = nil end
				end
				hitboxOwners[d] = nil
			end)
		end)
	end)

	local function scanCharacter(char)
		for _, d in char:GetDescendants() do
			if d:IsA("BasePart") and d.Name:lower():find("blast") then trackBlast(d) end
		end
	end
	local function hookPlayer(player)
		player.CharacterAdded:Connect(function(char)
			task.wait(0.5)
			scanCharacter(char)
		end)
		if player.Character then scanCharacter(player.Character) end
	end
	Players.PlayerAdded:Connect(hookPlayer)
	for _, p in Players:GetPlayers() do hookPlayer(p) end

	_G.DamageBuildingsInRadius = function(position, radius, attacker)
		for _, refs in liveRefs() do
			if (position - refs.pos).Magnitude <= radius + refs.radius then
				refs.damageBuilding(attacker)
			end
		end
	end
end

local function initCollisions()
	local INVISIBLE_THRESHOLD = 0.9

	local function fixPart(part)
		if part:IsA("BasePart") and part.CanCollide and part.Transparency >= INVISIBLE_THRESHOLD then
			part.CanCollide = false
		end
	end

	local function fixTree(root)
		fixPart(root)
		for _, d in root:GetDescendants() do fixPart(d) end
	end

	fixTree(workspace)

	workspace.DescendantAdded:Connect(function(d)
		task.defer(fixPart, d)
	end)

	while true do
		task.wait(30)
		local n = 0
		for _, d in workspace:GetDescendants() do
			fixPart(d)
			n += 1
			if n % 2000 == 0 then task.wait() end
		end
	end
end

function World.Init()
	if initialized then return end
	initialized = true
	task.spawn(initDayNight)
	task.spawn(initWindowLights)
	task.spawn(initRain)
	task.spawn(initBuilding)
	task.spawn(initCollisions)
	initDebrisCollision()
	task.spawn(initHolidayGround)
	task.spawn(initSky)
end

function World.IsRaining()
	return state.IsRaining
end

return World]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
			<Item class="ModuleScript" referent="RBX21">
				<Properties>
					<string name="Name">SecurityPolicy</string>
					<ProtectedString name="Source"><![CDATA[
local SecurityPolicy = {}

local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ownershipStore
do
    local ok, store = pcall(function()
        return DataStoreService:GetDataStore("Ownership")
    end)
    if ok then
        ownershipStore = store
    else
        warn("[SecurityPolicy] Ownership datastore unavailable: " .. tostring(store))
    end
end
local ownershipCache = {}

function SecurityPolicy.ClearOwnershipCache(player)
	if player then
		ownershipCache[player.UserId] = nil
	end
end

task.spawn(function()
	local buyEvent = ReplicatedStorage:WaitForChild("BuyKaiju", 30)
	if buyEvent and buyEvent:IsA("RemoteEvent") then
		buyEvent.OnServerEvent:Connect(function(player, kaijuName)
			ownershipCache[player.UserId] = nil
		end)
	end
end)

local GamepassWhitelist = {
	[274893778] = true
}

local gamepassKaijus = {
	["BURNING GODZILLA"] = 1891042639,
	["THERMONUCLEAR GODZILLA"] = 1818653788,
	["VOLCANIC BIOLLANTE"] = 1893256558,
	["FROSTBITE GODZILLA"] = 1822212269,
	["MINILLA"] = 1928197563,
}

local FREE_MORPHS = {
    ["GOJIRA [FREE]"] = true,
    ["SHIN FORM 2 [FREE]"] = true,
    ["ANGUIRUS [FREE]"] = true,
    ["MILITARY TANK [FREE]"] = true,
    ["F16C [FREE]"] = true,
    ["CIVILIAN [FREE]"] = true,
}

local legacyNames = {
	Godzilla2014 = "GODZILLA 2014",
	TitanusGhidorah = "TITANUS GHIDORAH",
	Godzilla2019 = "TITANUS GOJIRA",
	F16C = "F16C [FREE]",
	Mosura = "TITANUS MOSURA",
	Behemoth = "TITANUS BEHEMOTH",
	Gigan = "GIGAN",
	Anguirus = "ANGUIRUS [FREE]",
	Biollante = "BIOLLANTE",
	Burning = "BURNING GODZILLA",
	FinalWars = "FINAL WARS GODZILLA",
	Heisei = "HEISEI GODZILLA",
	KamataKun = "SHIN FORM 2 [FREE]",
	KingGhidorah = "KING GHIDORAH",
	MaleMuto = "MALE MUTO",
	Mothra = "MOTHRA",
	Rodan = "TITANUS RODAN",
	Shin = "SHIN GOJIRA",
	ShinagawaKun = "SHIN FORM 3",
	Tank = "MILITARY TANK [FREE]",
	Human = "CIVILIAN [FREE]",
	Godzilla1954 = "GOJIRA [FREE]",
	Kiryu = "KIRYU",
	["Mecha King Ghidorah"] = "MECHA KING GHIDORAH",
}

local function getMorphFolder()
	local replicatedStorage = game:GetService("ReplicatedStorage")
	local supplies = replicatedStorage:FindFirstChild("MorphSupplies")
	return supplies and supplies:FindFirstChild("Morphs")
end

local function getPrice(model)
	local stats = model and model:FindFirstChild("Stats")
	local price = stats and stats:FindFirstChild("Price")
	if not price then
		return nil
	end
	return tonumber(price.Value)
end

local function loadOwnership(player)
	local cached = ownershipCache[player.UserId]
	if cached ~= nil then
		return cached
	end

    if not ownershipStore then return nil end
	local success, data = pcall(function()
		return ownershipStore:GetAsync(tostring(player.UserId))
	end)
	if not success or type(data) ~= "table" then
		return nil
	end

	ownershipCache[player.UserId] = data
	return data
end

local function dataOwns(data, morphName)
	if type(data) ~= "table" then
		return false
	end
	if data[morphName] then
		return true
	end
	for legacyName, mappedName in pairs(legacyNames) do
		if mappedName == morphName and data[legacyName] then
			return true
		end
	end
	for _, value in ipairs(data) do
		if value == morphName or legacyNames[value] == morphName then
			return true
		end
	end
	return false
end

local function ownsGamepass(player, morphName)
	
	if GamepassWhitelist[player.UserId] then
		return true
	end
	
	local gamepassId = gamepassKaijus[morphName]
	if not gamepassId then
		return false
	end
	local success, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gamepassId)
	end)
	return success and owns == true
end

function SecurityPolicy.CanUseMorph(player, selectedCreature)
	if not player or player.Parent ~= Players then
		return false
	end
	if typeof(selectedCreature) ~= "Instance" or not selectedCreature:IsA("Model") then
		return false
	end
	
	if GamepassWhitelist[player.UserId] then
		return true
	end

	local morphFolder = getMorphFolder()
	if not morphFolder or not selectedCreature:IsDescendantOf(morphFolder) then
		return false
	end

	local morphName = selectedCreature.Name
	local price = getPrice(selectedCreature)
	if price == nil then
    return FREE_MORPHS[morphName] == true
	end
	if price <= 0 then
		return true
	end
	if ownsGamepass(player, morphName) then
		return true
	end

	if type(_G.KUNOwnsKaiju) == "function" then
		return _G.KUNOwnsKaiju(player, morphName)
	end

	local data = loadOwnership(player)
	return dataOwns(data, morphName)
end

Players.PlayerRemoving:Connect(function(player)
	ownershipCache[player.UserId] = nil
end)

return SecurityPolicy
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX22">
				<Properties>
					<string name="Name">Server</string>
					<token name="RunContext">0</token>
					<ProtectedString name="Source"><![CDATA[local ServerScriptService = game:GetService("ServerScriptService")

if ServerScriptService:GetAttribute("ServerFrameworkActive") then
	return
end

local Services = script:WaitForChild("Services")
local Logger = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Logger"))
local Lifecycle = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Lifecycle"))
local Config = require(script:WaitForChild("Config"))
local log = Logger.new("Server")

local REPLACED = {
	"ServerHandler",
	"MorphBootstrap",
	"HealthEnforcer",
	"GCellIntegrityGuard",
	"PlayerEliminator",
	"SettingsStore",
}
local stillActive = {}
for _, name in ipairs(REPLACED) do
	local found = ServerScriptService:FindFirstChild(name)
	if found and found ~= script and not (found:IsA("BaseScript") and found.Disabled) then
		table.insert(stillActive, name)
	end
end
if #stillActive > 0 then
	log:warn("Not starting: disable or delete these replaced scripts first: " .. table.concat(stillActive, ", "))
	return
end

ServerScriptService:SetAttribute("ServerFrameworkActive", true)

local lifecycle = Lifecycle.new(log)

lifecycle:Register(require(Services.MorphService))
lifecycle:Register(require(Services.GCellGuardService))
lifecycle:Register(require(Services.IndicatorService))
lifecycle:Register(require(Services.CandyService))
lifecycle:Register(require(Services.EliminatorService))
lifecycle:Register(require(Services.SettingsService))
lifecycle:Register(require(Services.HealthService))
lifecycle:Register(require(Services.OceanDepthService))

local LegacyService = require(Services.LegacyService)
for _, moduleName in ipairs(Config.LegacyModules) do
	lifecycle:Register(LegacyService.Create(moduleName))
end

lifecycle:Register(require(Services.KnitService))

lifecycle:InitAll()
lifecycle:StartAll()

ServerScriptService:SetAttribute("ServerReady", true)
log:info("Started. Service status:\n" .. lifecycle:Report())
]]></ProtectedString>
				</Properties>
				<Item class="ModuleScript" referent="RBX23">
