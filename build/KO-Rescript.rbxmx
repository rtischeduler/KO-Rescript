					<Item class="Folder" referent="RBX60">
						<Properties>
							<string name="Name">Controllers</string>
						</Properties>
						<Item class="ModuleScript" referent="RBX61">
							<Properties>
								<string name="Name">Chat</string>
								<ProtectedString name="Source"><![CDATA[local ChatController = { Name = "Chat" }

local KILL_RICH = "rgb(255,80,80)"
local KILL_FALLBACK = Color3.fromRGB(255, 105, 85)
local GREEN_RICH = "rgb(0,255,100)"
local GREEN_FALLBACK = Color3.fromRGB(0, 255, 100)
local RED_RICH = "rgb(255,50,50)"
local RED_FALLBACK = Color3.fromRGB(255, 50, 50)

local function showSystemMessage(message, richColor, fallbackColor)
	local StarterGui = game:GetService("StarterGui")

	local success = pcall(function()
		local TextChatService = game:GetService("TextChatService")
		local channel = TextChatService.TextChannels:FindFirstChild("RBXSystem")
		if channel then
			channel:DisplaySystemMessage('<font color="' .. richColor .. '">' .. message .. "</font>")
		end
	end)

	if not success then
		pcall(function()
			StarterGui:SetCore("ChatMakeSystemMessage", {
				Text = message,
				Color = fallbackColor,
				Font = Enum.Font.GothamBold,
			})
		end)
	end
end

function ChatController:Start()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local framework = script:FindFirstAncestor("Client")
	local Util = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Util"))
	local log = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Logger")).new("Chat")

	Util.spawn(log, "KillMessage", function()
		local killMessageEvent = ReplicatedStorage:WaitForChild("KillMessage")
		killMessageEvent.OnClientEvent:Connect(function(message)
			showSystemMessage(message, KILL_RICH, KILL_FALLBACK)
		end)
	end)

	Util.spawn(log, "EliminatorPopup", function()
		local eliminatorPopupEvent = ReplicatedStorage:WaitForChild("EliminatorPopup")
		eliminatorPopupEvent.OnClientEvent:Connect(function(message, colorType)
			if colorType == "green" then
				showSystemMessage(message, GREEN_RICH, GREEN_FALLBACK)
			else
				showSystemMessage(message, RED_RICH, RED_FALLBACK)
			end
		end)
	end)
end

return ChatController
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX62">
							<Properties>
								<string name="Name">Effects</string>
								<ProtectedString name="Source"><![CDATA[local EffectsController = { Name = "Effects" }

local function startRain(cfg)
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local RunService = game:GetService("RunService")
	local Workspace = game:GetService("Workspace")

	local rainTemplate = ReplicatedStorage:WaitForChild("Rain")
	local toggleEvent = ReplicatedStorage:WaitForChild("ToggleRain")

	local rainClone = nil
	local renderConn = nil

	local RAIN_OFFSET = Vector3.new(0, cfg.OffsetY, 0)

	local TweenService = game:GetService("TweenService")
	local FADE = 6
	local UserInputService = game:GetService("UserInputService")
	local okQuality, quality = pcall(function()
		return UserSettings().GameSettings.SavedQualityLevel.Value
	end)
	local lowEnd = UserInputService.TouchEnabled or (okQuality and quality > 0 and quality <= 4)
	local rainScale = lowEnd and 0.5 or 1
	local okCfg, HolidayConfigs = pcall(function()
		return require(ReplicatedStorage:WaitForChild("HolidayConfigs", 5))
	end)

	local function follow(clone)
		local conn
		conn = RunService.RenderStepped:Connect(function()
			if not clone.Parent then
				conn:Disconnect()
				return
			end
			local camera = Workspace.CurrentCamera
			if camera then
				clone.CFrame = CFrame.new(camera.CFrame.Position + RAIN_OFFSET)
			end
		end)
		return conn
	end

	local function startRain()
		if rainClone then return end

		local clone = rainTemplate:Clone()
		rainClone = clone
		clone.Parent = Workspace

		local holiday = okCfg and HolidayConfigs.getActive() or nil
		local tint = holiday and holiday.RainColor or nil
		local info = TweenInfo.new(FADE, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
		for _, child in clone:GetChildren() do
			if child:IsA("ParticleEmitter") then
				if tint then child.Color = ColorSequence.new(tint) end
				local rate = child.Rate * rainScale
				child.Rate = 0
				child.Enabled = true
				TweenService:Create(child, info, { Rate = rate }):Play()
			end
		end

		local sound = clone:FindFirstChild("Raining")
		if sound then
			local volume = sound.Volume
			sound.Volume = 0
			sound:Play()
			TweenService:Create(sound, info, { Volume = volume }):Play()
		end
		renderConn = follow(clone)
	end

	local function stopRain()
		local old, oldConn = rainClone, renderConn
		rainClone, renderConn = nil, nil
		if not old then return end

		local info = TweenInfo.new(FADE, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
		for _, child in old:GetChildren() do
			if child:IsA("ParticleEmitter") then
				TweenService:Create(child, info, { Rate = 0 }):Play()
			end
		end
		local sound = old:FindFirstChild("Raining")
		if sound then
			TweenService:Create(sound, info, { Volume = 0 }):Play()
		end
		task.delay(FADE + 1, function()
			if oldConn then oldConn:Disconnect() end
			old:Destroy()
		end)
	end

	toggleEvent.OnClientEvent:Connect(function(isRaining)
		if isRaining then
			startRain()
		else
			stopRain()
		end
	end)
end

local function startPulse(cfg)
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local RunService = game:GetService("RunService")
	local Debris = game:GetService("Debris")

	local pulseFireEvent = ReplicatedStorage:WaitForChild("PulseFire", cfg.WaitTimeout)
	if not pulseFireEvent then return end

	local BURST_TIME = cfg.BurstTime
	local SUSTAIN_TIME = cfg.SustainTime
	local DISSIPATE_TIME = cfg.DissipateTime
	local BURST_OVERSHOOT = cfg.BurstOvershoot
	local DISSIPATE_GROWTH = cfg.DissipateGrowth
	local MAX_ACTIVE = cfg.MaxActive
	local DEFAULT_COLOR = Color3.fromRGB(255, 120, 0)

	local PART_SPIN = {
		Shock     = Vector3.new(0,   90,  0),
		Shockwave = Vector3.new(0,  -55,  0),
		Sphere    = Vector3.new(25,  70,  0),
		Sphere2   = Vector3.new(0,  -85, 30),
	}
	local SPHERE_NAMES = { Sphere = true, Sphere2 = true }
	local SHOCK_NAME = "Shockwave"

	local active = {}

	local function removeActive(entry)
		local i = table.find(active, entry)
		if i then table.remove(active, i) end
	end

	local function destroyEntry(entry)
		removeActive(entry)
		if entry.clone and entry.clone.Parent then
			entry.clone:Destroy()
		end
	end

	local function getBaseDimension(clone)
		local ok, scale = pcall(clone.GetScale, clone)
		if not ok or not scale or scale <= 0 then scale = 1 end
		local _, size = clone:GetBoundingBox()
		local dim = math.max(size.X, size.Y, size.Z) / scale
		if dim <= 0 then dim = 1 end
		return dim
	end

	local function easeOutQuart(p) return 1 - (1 - p) ^ 4 end
	local function easeInPow(p) return p ^ 2.2 end
	local function rand(a, b) return a + math.random() * (b - a) end

	local function runPulse(firingPlayer, color, maxSize)
		if typeof(color) ~= "Color3" then color = DEFAULT_COLOR end
		if type(maxSize) ~= "number" then maxSize = cfg.DefaultSize end
		maxSize = math.clamp(maxSize, cfg.MinSize, cfg.MaxSize)

		if not firingPlayer or not firingPlayer.Parent then return end
		local character = firingPlayer.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local template = ReplicatedStorage:FindFirstChild("Pulse")
		if not template then return end

		local clone = template:Clone()
		local entry = { clone = clone }

		while #active >= MAX_ACTIVE do
			destroyEntry(active[1])
		end
		table.insert(active, entry)
		Debris:AddItem(clone, BURST_TIME + SUSTAIN_TIME + DISSIPATE_TIME + 5)

		local ok, err = pcall(function()
			local parts, emitters, baseTransparency = {}, {}, {}
			local spinParts = {}
			local sphereSet = {}
			local shockParts = {}

			for _, desc in ipairs(clone:GetDescendants()) do
				if desc:IsA("BasePart") then
					baseTransparency[desc] = desc.Name == "WD" and 1 or desc.Transparency
					desc.Color = color
					desc.CanCollide = false
					desc.CanTouch = false
					desc.CanQuery = false
					desc.Anchored = true
					desc.CastShadow = false
					if desc.Name == "WD" then desc.Transparency = 1 end
					table.insert(parts, desc)

					if PART_SPIN[desc.Name] then
						table.insert(spinParts, { part = desc, spin = PART_SPIN[desc.Name] })
					end
					if SPHERE_NAMES[desc.Name] then
						sphereSet[desc] = true
					end
				elseif desc:IsA("ParticleEmitter") then
					desc.Enabled = true
					desc.Color = ColorSequence.new(color)
					table.insert(emitters, desc)
				end
			end

			if not clone.PrimaryPart then
				local sw = clone:FindFirstChild("Shockwave", true)
				clone.PrimaryPart = (sw and sw:IsA("BasePart") and sw) or clone:FindFirstChildWhichIsA("BasePart", true)
			end
			if not clone.PrimaryPart then
				clone:Destroy()
				return
			end

			local light = Instance.new("PointLight")
			light.Color = color
			light.Brightness = 10
			light.Range = 80
			light.Shadows = false
			light.Parent = clone.PrimaryPart

			pcall(clone.ScaleTo, clone, 1)
			local baseDim = getBaseDimension(clone)

			for _, p in ipairs(parts) do
				if p.Name == SHOCK_NAME then
					table.insert(shockParts, { part = p, baseSize = p.Size })
				end
			end

			local lastPosition = hrp.Position
			local function currentPosition()
				if hrp and hrp.Parent then
					lastPosition = hrp.Position
				else
					local newChar = firingPlayer.Parent and firingPlayer.Character
					local newHrp = newChar and newChar:FindFirstChild("HumanoidRootPart")
					if newHrp then hrp = newHrp lastPosition = hrp.Position end
				end
				return lastPosition
			end

			local seed = math.random() * 1000
			local lastTick = os.clock()

			local function setPose(size, shake, spinMult, shockExtra)
				local now = os.clock()
				local dt = math.min(now - lastTick, 0.05)
				lastTick = now

				local scale = math.max(0.01, size / baseDim)
				local jitterScale = 1 + math.noise(now * 8, seed, 1) * 0.03 * shake
				pcall(clone.ScaleTo, clone, scale * jitterScale)

				for _, s in ipairs(shockParts) do
					s.part.Size = s.baseSize * (scale * jitterScale * shockExtra)
				end

				local tiltX = math.noise(now * 6, seed, 2) * 0.05 * shake
				local tiltZ = math.noise(now * 6, seed, 3) * 0.05 * shake
				local offset = Vector3.new(
					math.noise(now * 9, seed, 4) * shake * size * 0.005,
					math.noise(now * 9, seed, 5) * shake * size * 0.005,
					math.noise(now * 9, seed, 6) * shake * size * 0.005
				)
				clone:PivotTo(CFrame.new(currentPosition() + offset) * CFrame.Angles(tiltX, 0, tiltZ))

				for _, s in ipairs(spinParts) do
					local d = s.spin * (spinMult * dt)
					s.part.CFrame = s.part.CFrame * CFrame.Angles(math.rad(d.X), math.rad(d.Y), math.rad(d.Z))
				end
			end

			local function setTransparency(level, sphereLevel)
				for _, p in ipairs(parts) do
					local base = baseTransparency[p] or 0
					local l = sphereSet[p] and sphereLevel or level
					p.Transparency = base + (1 - base) * math.clamp(l, 0, 1)
				end
			end

			local function runPhase(duration, step)
				local t0 = os.clock()
				while clone.Parent do
					local e = os.clock() - t0
					if e >= duration then break end
					step(e / duration)
					RunService.Heartbeat:Wait()
				end
			end

			clone:PivotTo(CFrame.new(lastPosition))
			pcall(clone.ScaleTo, clone, 0.05)
			clone.Parent = workspace

			for _, e in ipairs(emitters) do
				e:Emit(math.max(1, math.floor(e:GetAttribute("EmitCount") or 25)))
			end

			local startSize = 2
			local peak = maxSize * BURST_OVERSHOOT

			runPhase(BURST_TIME, function(p)
				local size = startSize + (peak - startSize) * easeOutQuart(p)
				setPose(size, 1.2 * (1 - p * 0.4), 1.6 * (1 - p * 0.4), 1 + 0.15 * easeOutQuart(p))
				light.Brightness = 10 - 7 * p
				setTransparency(0, 0)
			end)
			if not clone.Parent then return end

			runPhase(SUSTAIN_TIME, function(p)
				local size = peak + (maxSize - peak) * p
				setPose(size, 1 - p * 0.5, 1.0 - p * 0.3, 1.15 + 0.10 * p)
				light.Brightness = 3 - p
				setTransparency(0, 0.35 * p)
			end)
			if not clone.Parent then return end

			for _, e in ipairs(emitters) do e.Enabled = false end

			runPhase(DISSIPATE_TIME, function(p)
				local grow = maxSize + (maxSize * DISSIPATE_GROWTH - maxSize) * easeOutQuart(p)
				setPose(grow, 0.5 * (1 - p), 0.7 * (1 - p), 1.25 + 0.30 * easeOutQuart(p))
				local level = easeInPow(p)
				local sphereLevel = 0.35 + p * 1.1
				setTransparency(level, sphereLevel)
				for _, e in ipairs(emitters) do
					e.Transparency = NumberSequence.new(level)
				end
				light.Brightness = 2 * (1 - p) ^ 2
			end)
		end)

		if not ok then
			warn("[Pulse] visual failed: " .. tostring(err))
		end

		destroyEntry(entry)
	end

	pulseFireEvent.OnClientEvent:Connect(function(firingPlayer, color, maxSize)
		task.spawn(runPulse, firingPlayer, color, maxSize)
	end)
end

function EffectsController:Start()
	local framework = script:FindFirstAncestor("Client")
	local cfg = require(framework.Config)
	local Util = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Util"))
	local log = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Logger")).new("Effects")
	Util.spawn(log, "Rain", startRain, cfg.Rain)
	Util.spawn(log, "Pulse", startPulse, cfg.Pulse)
end

return EffectsController
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX63">
							<Properties>
								<string name="Name">Hud</string>
								<ProtectedString name="Source"><![CDATA[local HudController = { Name = "Hud" }

local function startBossHud(cfg)
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local player = Players.LocalPlayer

	local bossEvent = ReplicatedStorage:WaitForChild("BossEvent")

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "BossHUD"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.Enabled = false
	screenGui.Parent = player:WaitForChild("PlayerGui")

	local container = Instance.new("Frame")
	container.Size = UDim2.new(0, 700, 0, 50)
	container.Position = UDim2.new(0.5, -350, 0, 10)
	container.BackgroundTransparency = 1
	container.Parent = screenGui

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 20)
	layout.Parent = container

	local greenText = Instance.new("TextLabel")
	greenText.Size = UDim2.new(0, 400, 0, 50)
	greenText.BackgroundTransparency = 1
	greenText.Text = ""
	greenText.TextColor3 = Color3.fromRGB(0, 255, 85)
	greenText.TextScaled = true
	greenText.Font = Enum.Font.GothamBold
	greenText.TextXAlignment = Enum.TextXAlignment.Center
	greenText.Parent = container

	local greenStroke = Instance.new("UIStroke")
	greenStroke.Thickness = 2
	greenStroke.Color = Color3.fromRGB(0, 0, 0)
	greenStroke.Parent = greenText

	local goldText = Instance.new("TextLabel")
	goldText.Size = UDim2.new(0, 280, 0, 50)
	goldText.BackgroundTransparency = 1
	goldText.Text = ""
	goldText.TextColor3 = Color3.fromRGB(255, 215, 0)
	goldText.TextScaled = true
	goldText.Font = Enum.Font.GothamBold
	goldText.TextXAlignment = Enum.TextXAlignment.Left
	goldText.Parent = container

	local goldStroke = Instance.new("UIStroke")
	goldStroke.Thickness = 2
	goldStroke.Color = Color3.fromRGB(0, 0, 0)
	goldStroke.Parent = goldText

	local sessionToken = 0

	bossEvent.OnClientEvent:Connect(function(action, ...)
		if action == "start" then
			sessionToken = sessionToken + 1
			local bossName = ...
			greenText.Text = bossName .. " is now the boss!"
			goldText.Text = "Top Damage Dealer: None"
			screenGui.Enabled = true
		elseif action == "update" then
			local playerName, percentage = ...
			if playerName == "None" or playerName == nil then
				goldText.Text = "Top Damage Dealer: None"
			else
				goldText.Text = "Top Damage Dealer: " .. tostring(playerName) .. " (" .. tostring(percentage) .. "%)"
			end
		elseif action == "end" then
			sessionToken = sessionToken + 1
			local myToken = sessionToken
			local winnerName = ...
			greenText.Text = "The boss has been defeated, " .. tostring(winnerName) .. " has won with the most damage!"
			goldText.Text = ""
			task.delay(cfg.BossEndSeconds, function()
				if sessionToken == myToken then
					screenGui.Enabled = false
				end
			end)
		end
	end)
end

local function startRaffleHud()
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local player = Players.LocalPlayer

	local raffleEvent = ReplicatedStorage:WaitForChild("RaffleEvent")

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "RaffleHUD"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.Enabled = false
	screenGui.Parent = player:WaitForChild("PlayerGui")

	local backdrop = Instance.new("Frame")
	backdrop.Size = UDim2.new(1, 0, 1, 0)
	backdrop.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	backdrop.BackgroundTransparency = 0.5
	backdrop.Parent = screenGui

	local card = Instance.new("Frame")
	card.Size = UDim2.new(0, 500, 0, 200)
	card.Position = UDim2.new(0.5, -250, 0.5, -100)
	card.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
	card.BorderSizePixel = 0
	card.Parent = backdrop

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = card

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(255, 215, 0)
	stroke.Parent = card

	local titleText = Instance.new("TextLabel")
	titleText.Size = UDim2.new(1, 0, 0, 50)
	titleText.Position = UDim2.new(0, 0, 0, 15)
	titleText.BackgroundTransparency = 1
	titleText.Text = "RAFFLE"
	titleText.TextColor3 = Color3.fromRGB(255, 215, 0)
	titleText.TextScaled = true
	titleText.Font = Enum.Font.GothamBlack
	titleText.Parent = card

	local nameText = Instance.new("TextLabel")
	nameText.Size = UDim2.new(1, -20, 0, 80)
	nameText.Position = UDim2.new(0, 10, 0, 70)
	nameText.BackgroundTransparency = 1
	nameText.Text = ""
	nameText.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameText.TextScaled = true
	nameText.Font = Enum.Font.GothamBold
	nameText.Parent = card

	local winnerStroke = Instance.new("UIStroke")
	winnerStroke.Thickness = 2
	winnerStroke.Color = Color3.fromRGB(255, 215, 0)
	winnerStroke.Parent = nameText

	local isRunning = false

	raffleEvent.OnClientEvent:Connect(function(names, winnerName)
		if isRunning then
			return
		end
		isRunning = true

		screenGui.Enabled = true
		nameText.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameText.Text = ""

		if #names < 2 then
			nameText.Text = winnerName .. " is the winner!"
			nameText.TextColor3 = Color3.fromRGB(255, 215, 0)
			task.wait(6)
			screenGui.Enabled = false
			isRunning = false
			return
		end

		local totalDuration = 4.5
		local elapsed = 0
		local interval = 0.04
		local lastIndex = 0

		task.spawn(function()
			while elapsed < totalDuration do
				lastIndex = lastIndex + 1
				if lastIndex > #names then
					lastIndex = 1
				end
				nameText.Text = names[lastIndex]

				task.wait(interval)
				elapsed = elapsed + interval

				local progress = elapsed / totalDuration
				interval = 0.04 + (progress * progress) * 0.35
			end

			nameText.Text = winnerName
			nameText.TextColor3 = Color3.fromRGB(255, 215, 0)

			for _ = 1, 3 do
				nameText.TextSize = 60
				task.wait(0.15)
				nameText.TextSize = 50
				task.wait(0.15)
			end

			nameText.Text = winnerName .. " is the winner!"
			nameText.TextColor3 = Color3.fromRGB(255, 215, 0)

			task.wait(5)
			screenGui.Enabled = false
			isRunning = false
		end)
	end)
end

local function startBlindEffect(cfg)
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local TweenService = game:GetService("TweenService")
	local Players = game:GetService("Players")

	local blindEvent = ReplicatedStorage:WaitForChild("BlindPulse")
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local isBlind = false

	blindEvent.OnClientEvent:Connect(function()
		if isBlind then
			return
		end
		isBlind = true

		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "BlindOverlay"
		screenGui.IgnoreGuiInset = true
		screenGui.ResetOnSpawn = false
		screenGui.DisplayOrder = 9999
		screenGui.Parent = playerGui

		local flashFrame = Instance.new("Frame")
		flashFrame.Size = UDim2.new(1, 0, 1, 0)
		flashFrame.Position = UDim2.new(0, 0, 0, 0)
		flashFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		flashFrame.BorderSizePixel = 0
		flashFrame.Parent = screenGui

		task.wait(cfg.BlindHoldSeconds)

		local tweenInfo = TweenInfo.new(cfg.BlindFadeSeconds, Enum.EasingStyle.Linear)
		local tween = TweenService:Create(flashFrame, tweenInfo, { BackgroundTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()

		screenGui:Destroy()
		isBlind = false
	end)
end

local function startHideOwnTag()
	local Players = game:GetService("Players")
	local localPlayer = Players.LocalPlayer

	local function hideTagIfMatch(instance)
		if instance.Name == "Tag" and instance:IsA("BillboardGui") then
			instance.Enabled = false
		end
	end

	local function hideOwnTag(character)
		for _, descendant in character:GetDescendants() do
			hideTagIfMatch(descendant)
		end

		character.DescendantAdded:Connect(hideTagIfMatch)
	end

	localPlayer.CharacterAdded:Connect(function(character)
		hideOwnTag(character)
	end)

	if localPlayer.Character then
		hideOwnTag(localPlayer.Character)
	end
end

function HudController:Start()
	local framework = script:FindFirstAncestor("Client")
	local cfg = require(framework.Config).Hud
	local Util = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Util"))
	local log = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Logger")).new("Hud")

	Util.spawn(log, "BossHud", startBossHud, cfg)
	Util.spawn(log, "RaffleHud", startRaffleHud)
	Util.spawn(log, "BlindEffect", startBlindEffect, cfg)
	Util.spawn(log, "HideOwnTag", startHideOwnTag)
end

return HudController
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX64">
							<Properties>
								<string name="Name">Indicators</string>
								<ProtectedString name="Source"><![CDATA[local IndicatorsController = { Name = "Indicators" }

local HOLD_TIME = 1.1
local FADE_TIME = 0.4
local RISE_STUDS = 5
local ROW_HEIGHT = 12
local WIDTH = 100
local TEXT_SIZE = 10
local REF_DISTANCE = 70
local MIN_SCALE = 0.3
local MAX_DISTANCE = 450
local MAX_ACTIVE = 24

local ROWS = {
	{ key = "damage", label = "Damage", color = Color3.fromRGB(255, 70, 70) },
	{ key = "gcells", label = "Gcells", color = Color3.fromRGB(70, 255, 110) },
	{ key = "xp", label = "Exp", color = Color3.fromRGB(255, 245, 106) },
	{ key = "candy", label = "Candy", color = Color3.fromRGB(255, 140, 0) },
}

local function formatAmount(value)
	if value >= 10 then
		return tostring(math.floor(value + 0.5))
	end
	return tostring(math.floor(value * 10 + 0.5) / 10)
end

function IndicatorsController:Start()
	task.spawn(function()
		local Players = game:GetService("Players")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local RunService = game:GetService("RunService")
		local TweenService = game:GetService("TweenService")
		local Workspace = game:GetService("Workspace")

		local player = Players.LocalPlayer
		local remote = ReplicatedStorage:WaitForChild("RewardIndicator")
		local playerGui = player:WaitForChild("PlayerGui")

		local guiFolder = Instance.new("Folder")
		guiFolder.Name = "RewardIndicators"
		guiFolder.Parent = playerGui

		local active = {}
		local floatInfo = TweenInfo.new(HOLD_TIME + FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local fadeInfo = TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

		local function getAnchorFolder()
			local camera = Workspace.CurrentCamera
			if not camera then
				return nil
			end
			local folder = camera:FindFirstChild("RewardAnchors")
			if not folder then
				folder = Instance.new("Folder")
				folder.Name = "RewardAnchors"
				folder.Parent = camera
			end
			return folder
		end

		local function destroyEntry(entry)
			if entry.dead then
				return
			end
			entry.dead = true
			entry.gui:Destroy()
			entry.anchor:Destroy()
		end

		local function spawnIndicator(position, values)
			local anchorFolder = getAnchorFolder()
			if not anchorFolder then
				return
			end

			local lines = {}
			for _, row in ROWS do
				local value = values[row.key]
				if value > 0.05 then
					table.insert(lines, { row = row, text = row.label .. ": " .. formatAmount(value) })
				end
			end
			if #lines == 0 then
				return
			end

			while #active >= MAX_ACTIVE do
				destroyEntry(table.remove(active, 1))
			end

			local anchor = Instance.new("Part")
			anchor.Name = "Anchor"
			anchor.Anchored = true
			anchor.CanCollide = false
			anchor.CanTouch = false
			anchor.CanQuery = false
			anchor.CastShadow = false
			anchor.Transparency = 1
			anchor.Size = Vector3.new(0.2, 0.2, 0.2)
			anchor.Position = position
			anchor.Parent = anchorFolder

			local gui = Instance.new("BillboardGui")
			gui.Name = "Indicator"
			gui.Adornee = anchor
			gui.AlwaysOnTop = true
			gui.LightInfluence = 0
			gui.ResetOnSpawn = false
			gui.MaxDistance = MAX_DISTANCE
			gui.Size = UDim2.fromOffset(WIDTH, ROW_HEIGHT * #lines)
			gui.StudsOffsetWorldSpace = Vector3.new(math.random(-20, 20) / 10, 0, math.random(-20, 20) / 10)

			local container = Instance.new("Frame")
			container.AnchorPoint = Vector2.new(0.5, 0.5)
			container.Position = UDim2.fromScale(0.5, 0.5)
			container.Size = UDim2.fromScale(1, 1)
			container.BackgroundTransparency = 1
			container.Parent = gui

			local scale = Instance.new("UIScale")
			scale.Parent = container

			local layout = Instance.new("UIListLayout")
			layout.SortOrder = Enum.SortOrder.LayoutOrder
			layout.Parent = container

			local labels = {}
			for index, line in lines do
				local label = Instance.new("TextLabel")
				label.LayoutOrder = index
				label.Size = UDim2.new(1, 0, 0, ROW_HEIGHT)
				label.BackgroundTransparency = 1
				label.Font = Enum.Font.GothamMedium
				label.TextSize = TEXT_SIZE
				label.TextColor3 = line.row.color
				label.TextStrokeColor3 = Color3.new(0, 0, 0)
				label.TextStrokeTransparency = 0.5
				label.Text = line.text
				label.Parent = container
				table.insert(labels, label)
			end

			gui.Parent = guiFolder

			local entry = { gui = gui, anchor = anchor, scale = scale, position = position, dead = false }
			table.insert(active, entry)

			TweenService:Create(gui, floatInfo, {
				StudsOffsetWorldSpace = gui.StudsOffsetWorldSpace + Vector3.new(0, RISE_STUDS, 0),
			}):Play()

			task.delay(HOLD_TIME, function()
				if entry.dead then
					return
				end
				for _, label in labels do
					TweenService:Create(label, fadeInfo, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
				end
			end)
			task.delay(HOLD_TIME + FADE_TIME, function()
				destroyEntry(entry)
			end)
		end

		RunService.Heartbeat:Connect(function()
			local camera = Workspace.CurrentCamera
			if not camera or #active == 0 then
				return
			end
			local cameraPosition = camera.CFrame.Position
			for index = #active, 1, -1 do
				local entry = active[index]
				if entry.dead then
					table.remove(active, index)
				else
					local distance = math.max((cameraPosition - entry.position).Magnitude, 1)
					entry.scale.Scale = math.clamp(REF_DISTANCE / distance, MIN_SCALE, 1)
				end
			end
		end)

		remote.OnClientEvent:Connect(function(position, damage, gcells, xp, candy)
			if typeof(position) ~= "Vector3" then
				return
			end
			spawnIndicator(position, {
				damage = tonumber(damage) or 0,
				gcells = tonumber(gcells) or 0,
				xp = tonumber(xp) or 0,
				candy = tonumber(candy) or 0,
			})
		end)
	end)
end

return IndicatorsController
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX65">
							<Properties>
								<string name="Name">Knit</string>
								<ProtectedString name="Source"><![CDATA[local KnitController = { Name = "Knit" }

function KnitController:Start()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Knit = require(ReplicatedStorage:WaitForChild("Knit"):WaitForChild("Knit"))
	Knit.Start():andThen(function()
		print("[Knit] Client started successfully")
	end):catch(function(err)
		warn("[Knit] Client failed to start:", err)
	end)
end

return KnitController
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX66">
							<Properties>
								<string name="Name">Menu</string>
								<ProtectedString name="Source"><![CDATA[local MenuController = { Name = "Menu" }

local function unlockEntity(cfg)
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer

	if player.Name ~= cfg.EntityUnlockUser then
		return
	end

	local playerGui = player:FindFirstChild("PlayerGui") or player:WaitForChild("PlayerGui", 10)
	if not playerGui then
		return
	end

	local newMenu = playerGui:FindFirstChild("NEWMenu") or playerGui:WaitForChild("NEWMenu", 10)
	if not newMenu then
		return
	end

	local kaijus = newMenu:FindFirstChild("Kaijus")
	local list = kaijus and kaijus:FindFirstChild("List")
	local scrollFrame = list and list:FindFirstChild("ScrollingFrame")

	if scrollFrame then
		local entityEntry = scrollFrame:FindFirstChild("ENTITY")
		if entityEntry then
			entityEntry.Visible = true
		end
	end
end

local function runMenuCamera(cfg)
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local Workspace = game:GetService("Workspace")
	local StarterGui = game:GetService("StarterGui")
	local TweenService = game:GetService("TweenService")

	local tweenInfo = TweenInfo.new(cfg.TweenSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	local player = Players.LocalPlayer

	local camPoints = Workspace:FindFirstChild("CamPoints") or Workspace:WaitForChild("CamPoints", 15)
	local menuCam = camPoints and (camPoints:FindFirstChild("Menu") or camPoints:WaitForChild("Menu", 5))

	local newMenuTemplate = StarterGui:FindFirstChild("NEWMenu") or StarterGui:WaitForChild("NEWMenu", 10)
	local gameGuiTemplate = StarterGui:FindFirstChild("GameGui") or StarterGui:WaitForChild("GameGui", 10)

	local enforcing = false
	local renderName = cfg.CameraName

	player:SetAttribute("HasMorphed", false)

	local function applyMenuCamera()
		local cam = Workspace.CurrentCamera
		if cam and menuCam then
			cam.CameraType = Enum.CameraType.Scriptable
			cam.CFrame = menuCam.CFrame
			return true
		end
		return false
	end

	local function startEnforcing()
		if enforcing or not menuCam then
			return
		end
		enforcing = true
		player:SetAttribute("MenuCameraActive", true)

		applyMenuCamera()

		pcall(function()
			RunService:UnbindFromRenderStep(renderName)
		end)
		RunService:BindToRenderStep(renderName, Enum.RenderPriority.Camera.Value + cfg.CameraPriorityOffset, function()
			if enforcing then
				applyMenuCamera()
			end
		end)
	end

	local function stopEnforcing()
		enforcing = false
		player:SetAttribute("MenuCameraActive", false)
		pcall(function()
			RunService:UnbindFromRenderStep(renderName)
		end)
		local cam = Workspace.CurrentCamera
		if cam then
			cam.CameraType = Enum.CameraType.Custom
		end
	end

	local function disableMenuGuis()
		local playerGui = player:FindFirstChild("PlayerGui")
		if playerGui then
			for _, menuGui in ipairs(playerGui:GetChildren()) do
				if menuGui:IsA("ScreenGui") and (menuGui.Name == "NEWMenu" or menuGui.Name == "oldMenu") then
					menuGui.Enabled = false
				end
			end
		end
	end

	local function cloneNewMenu(parentGui)
		if not newMenuTemplate then
			return
		end
		local cloned = newMenuTemplate:Clone()
		cloned.Enabled = true

		local mainMenu = cloned:FindFirstChild("MainMenu")
		if mainMenu then
			mainMenu.Visible = true
			mainMenu.Position = UDim2.new(0, 0, -1, 0)
		end
		cloned.Parent = parentGui
	end

	local function cloneGameGui(parentGui)
		if not gameGuiTemplate then
			return
		end
		local cloned = gameGuiTemplate:Clone()

		local mainFrame = cloned:FindFirstChild("MainFrame")
		if mainFrame then
			local interface = mainFrame:FindFirstChild("Interface")
			if interface then
				interface.Visible = false
			end
			local loading = mainFrame:FindFirstChild("Loading")
			if loading then
				loading.Visible = false
				loading.Position = UDim2.new(0, 0, -1, 0)
			end
		end
		cloned.Parent = parentGui
	end

	local function ensureGuiCloned(playerGui, guiName, template, cloneFunc)
		if playerGui:FindFirstChild(guiName) then
			return
		end
		if not template then
			return
		end

		cloneFunc(playerGui)

		local count = 0
		for _, child in ipairs(playerGui:GetChildren()) do
			if child.Name == guiName then
				count = count + 1
				if count > 1 then
					child:Destroy()
				end
			end
		end

		local ourInstance = playerGui:FindFirstChild(guiName)
		if ourInstance then
			local conn
			conn = playerGui.ChildAdded:Connect(function(child)
				if child.Name == guiName and child ~= ourInstance and ourInstance.Parent then
					child:Destroy()
				end
			end)
			task.delay(15, function()
				if conn then
					conn:Disconnect()
				end
			end)
		end
	end

	local function onDeath(deadCharacter)
		if player:GetAttribute("IsMorphing") then
			player:SetAttribute("IsMorphing", false)
			return
		end

		if player.Character and player.Character ~= deadCharacter and not player:GetAttribute("ReturnToMenu") then
			return
		end

		player:SetAttribute("HasMorphed", false)

		local playerGui = player:FindFirstChild("PlayerGui")
		if not playerGui then
			return
		end

		local gameGui = playerGui:FindFirstChild("GameGui")
		if gameGui then
			gameGui.Enabled = false
			local mainFrame = gameGui:FindFirstChild("MainFrame")
			if mainFrame then
				local interface = mainFrame:FindFirstChild("Interface")
				if interface then
					interface.Visible = false
				end
			end
		end

		local touchGui = playerGui:FindFirstChild("TouchGui")
		if touchGui then
			touchGui.Enabled = false
		end

		task.wait(cfg.DeathReturnDelay)

		if player:GetAttribute("HasMorphed") then
			return
		end

		startEnforcing()

		player:SetAttribute("ReturnToMenu", false)

		playerGui = player:FindFirstChild("PlayerGui")
		if playerGui then
			local existingMenu = playerGui:FindFirstChild("NEWMenu")
			if not existingMenu and newMenuTemplate then
				cloneNewMenu(playerGui)
				existingMenu = playerGui:FindFirstChild("NEWMenu")
			end

			if existingMenu then
				existingMenu.Enabled = true
				local mainMenu = existingMenu:FindFirstChild("MainMenu")
				if mainMenu then
					mainMenu.Visible = true
					mainMenu.Position = UDim2.new(0, 0, -1, 0)
					TweenService:Create(mainMenu, tweenInfo, {
						Position = UDim2.new(0, 0, 0, 0),
					}):Play()
				end

				local kaijusFrame = existingMenu:FindFirstChild("Kaijus")
				if kaijusFrame then
					kaijusFrame.Visible = true
					kaijusFrame.Position = UDim2.new(1.1, 0, 0, 0)
				end
			end
		end
	end

	local function onCharacterAdded(character)
		local morphWasRequested = player:GetAttribute("IsMorphing") == true
		if morphWasRequested or player:GetAttribute("HasMorphed") == true then
			stopEnforcing()
			disableMenuGuis()
		end
		player:SetAttribute("IsMorphing", false)

		if player:GetAttribute("HasMorphed") then
			stopEnforcing()
		end

		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)

		if humanoid then
			humanoid.Died:Connect(function()
				task.spawn(onDeath, character)
			end)
		end
	end

	player:SetAttribute("HasMorphed", false)
	startEnforcing()

	task.spawn(function()
		for _ = 1, 10 do
			task.wait(0.5)
			if not enforcing then
				return
			end
			local cam = Workspace.CurrentCamera
			if cam and cam.CameraType == Enum.CameraType.Scriptable then
				return
			end
			applyMenuCamera()
		end
	end)

	task.spawn(function()
		local playerGui = player:WaitForChild("PlayerGui", 10)
		if not playerGui then
			return
		end

		task.wait(0.5)

		ensureGuiCloned(playerGui, "NEWMenu", newMenuTemplate, cloneNewMenu)

		ensureGuiCloned(playerGui, "GameGui", gameGuiTemplate, cloneGameGui)

		local gameGui = playerGui:FindFirstChild("GameGui")
		if gameGui then
			gameGui.Enabled = false
			local mainFrame = gameGui:FindFirstChild("MainFrame")
			if mainFrame then
				local interface = mainFrame:FindFirstChild("Interface")
				if interface then
					interface.Visible = false
				end
				local loading = mainFrame:FindFirstChild("Loading")
				if loading then
					loading.Visible = false
					loading.Position = UDim2.new(0, 0, -1, 0)
				end
			end
		end

		task.wait(0.2)
		local newMenu = playerGui:FindFirstChild("NEWMenu")
		if newMenu then
			newMenu.Enabled = true
			local mainMenu = newMenu:FindFirstChild("MainMenu")
			if mainMenu and mainMenu.Position.Y.Scale < -0.5 then
				mainMenu.Visible = true
				mainMenu.Position = UDim2.new(0, 0, -1, 0)
				TweenService:Create(mainMenu, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Position = UDim2.new(0, 0, 0, 0),
				}):Play()
			end
		end
	end)

	player.CharacterAdded:Connect(onCharacterAdded)

	player:GetAttributeChangedSignal("HasMorphed"):Connect(function()
		if player:GetAttribute("HasMorphed") == true then
			stopEnforcing()
			disableMenuGuis()
		end
	end)

	if player.Character then
		onCharacterAdded(player.Character)
	end
end

function MenuController:Start()
	local framework = script:FindFirstAncestor("Client")
	local cfg = require(framework.Config).Menu
	local Util = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Util"))
	local log = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Logger")).new("Menu")

	Util.spawn(log, "EntityUnlock", unlockEntity, cfg)
	Util.spawn(log, "MenuCamera", runMenuCamera, cfg)
end

return MenuController
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX67">
							<Properties>
								<string name="Name">Ocean</string>
								<ProtectedString name="Source"><![CDATA[local OceanController = { Name = "Ocean" }

function OceanController:Start()
	local cfg = require(script:FindFirstAncestor("Client").Config).Ocean
	local AssetService = game:GetService("AssetService")
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")

	local ocean = workspace:WaitForChild("Ocean", cfg.WaitTimeout)
	if not ocean or not ocean:IsA("BasePart") then return end

	local LEVEL_OFFSET = cfg.LevelOffset
	local UPDATE_RATE = cfg.UpdateRate
	local WAVE_SPEED = cfg.WaveSpeed
	local WAVE_HEIGHT = cfg.WaveHeight
	local NORMAL_STRENGTH = cfg.NormalStrength
	local DARKEN = cfg.Darken

	local RIPPLE_HEIGHT = cfg.RippleHeight
	local RIPPLE_SPEED = cfg.RippleSpeed
	local RIPPLE_WIDTH = cfg.RippleWidth
	local RIPPLE_LIFE = cfg.RippleLife
	local RIPPLE_BRIGHTNESS = cfg.RippleBrightness
	local MAX_RIPPLES = cfg.MaxRipples

	local MAX_TRIANGLES = cfg.MaxTriangles
	local RING_SEGMENTS = cfg.RingSegments
	local DETAIL_RADIUS = cfg.DetailRadius
	local DETAIL_POWER = cfg.DetailPower
	local DETAIL_RINGS = cfg.DetailRings
	local OUTER_RADIUS = cfg.OuterRadius
	local OUTER_RINGS = cfg.OuterRings
	local FAR_DROP = cfg.FarDrop

	local function countTriangles(detailRings)
		local rings = detailRings + OUTER_RINGS
		return ((rings - 1) * RING_SEGMENTS * 2 + RING_SEGMENTS) * 2
	end

	local detailRings = DETAIL_RINGS
	while detailRings > 8 and countTriangles(detailRings) > MAX_TRIANGLES do
		detailRings -= 1
	end

	local WAVE_RADIUS = DETAIL_RADIUS

	local WAVE_DEFS = cfg.Waves

	local waves = {}
	for i, def in ipairs(WAVE_DEFS) do
		local a = math.rad(def.angle)
		local k = 2 * math.pi / def.length
		local fadeEnd = WAVE_RADIUS * def.fade
		waves[i] = {
			dx = math.cos(a),
			dz = math.sin(a),
			k = k,
			w = math.sqrt(workspace.Gravity * k) * WAVE_SPEED,
			amp = def.amp * WAVE_HEIGHT,
			phase = i * 1.7,
			fadeStart = fadeEnd * 0.4,
			fadeEnd = fadeEnd,
		}
	end
	local waveCount = #waves

	local function sample(x, z, t, dist)
		local h, gx, gz = 0, 0, 0
		for i = 1, waveCount do
			local wv = waves[i]
			local f = 1 - math.clamp((dist - wv.fadeStart) / (wv.fadeEnd - wv.fadeStart), 0, 1)
			if f > 0 then
				f = f * f * (3 - 2 * f)
				local a = wv.amp * f
				local phase = wv.k * (wv.dx * x + wv.dz * z) - wv.w * t + wv.phase
				h += a * math.sin(phase)
				local d = a * wv.k * math.cos(phase)
				gx += d * wv.dx
				gz += d * wv.dz
			end
		end
		return h, gx, gz
	end

	local function getLevel()
		return ocean.Position.Y + ocean.Size.Y / 2 + LEVEL_OFFSET
	end

	local function baseHeight(r)
		if r <= WAVE_RADIUS then return 0 end
		local u = math.clamp((r - WAVE_RADIUS) / (OUTER_RADIUS - WAVE_RADIUS), 0, 1)
		u = u * u * (3 - 2 * u)
		return -FAR_DROP * u
	end

	local function buildSurface()
		local radii = {}
		for j = 1, detailRings do
			radii[#radii + 1] = DETAIL_RADIUS * (j / detailRings) ^ DETAIL_POWER
		end
		local ratio = OUTER_RADIUS / DETAIL_RADIUS
		for k = 1, OUTER_RINGS do
			radii[#radii + 1] = DETAIL_RADIUS * ratio ^ (k / OUTER_RINGS)
		end

		local mesh = AssetService:CreateEditableMesh()
		local uv = mesh:AddUV(Vector2.new(0, 0))

		local colorsOk = true
		local baseShade = Color3.new(DARKEN, DARKEN, DARKEN)
		local vertexIds, normalIds, colorIds, lx, lz, rad = {}, {}, {}, {}, {}, {}

		local function addVertex(x, z, r)
			local n = #vertexIds + 1
			vertexIds[n] = mesh:AddVertex(Vector3.new(x, baseHeight(r), z))
			normalIds[n] = mesh:AddNormal(Vector3.yAxis)
			if colorsOk then
				local ok, id = pcall(mesh.AddColor, mesh, baseShade, 1)
				if ok then
					colorIds[n] = id
				else
					colorsOk = false
				end
			end
			lx[n], lz[n], rad[n] = x, z, r
		end

		addVertex(0, 0, 0)
		for _, r in ipairs(radii) do
			for i = 0, RING_SEGMENTS - 1 do
				local a = i / RING_SEGMENTS * 2 * math.pi
				addVertex(r * math.cos(a), r * math.sin(a), r)
			end
		end

		local function index(ring, i)
			return 1 + (ring - 1) * RING_SEGMENTS + (i % RING_SEGMENTS) + 1
		end

		local function addFace(a, b, c)
			local f = mesh:AddTriangle(vertexIds[a], vertexIds[b], vertexIds[c])
			mesh:SetFaceNormals(f, { normalIds[a], normalIds[b], normalIds[c] })
			mesh:SetFaceUVs(f, { uv, uv, uv })
			if colorsOk then
				local ok = pcall(mesh.SetFaceColors, mesh, f, { colorIds[a], colorIds[b], colorIds[c] })
				if not ok then colorsOk = false end
			end
		end

		local function addTriangle(a, b, c)
			addFace(a, b, c)
			addFace(a, c, b)
		end

		for i = 0, RING_SEGMENTS - 1 do
			addTriangle(1, index(1, i + 1), index(1, i))
		end
		for ring = 1, #radii - 1 do
			for i = 0, RING_SEGMENTS - 1 do
				addTriangle(index(ring, i), index(ring + 1, i + 1), index(ring + 1, i))
				addTriangle(index(ring, i), index(ring, i + 1), index(ring + 1, i + 1))
			end
		end

		local part = AssetService:CreateMeshPartAsync(Content.fromObject(mesh))
		part.Name = "OceanSurface"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		if colorsOk then
			part.Color = ocean.Color
		else
			part.Color = ocean.Color:Lerp(Color3.new(0, 0, 0), 1 - DARKEN)
		end
		part.Material = ocean.Material
		part.Reflectance = ocean.Reflectance
		part.Transparency = ocean.Transparency
		part.CFrame = CFrame.new(ocean.Position.X, getLevel(), ocean.Position.Z)
		part.Parent = workspace

		local activeCount = 1
		for n = 1, #rad do
			if rad[n] <= WAVE_RADIUS then activeCount = n end
		end

		return {
			mesh = mesh,
			part = part,
			vertexIds = vertexIds,
			normalIds = normalIds,
			colorIds = colorIds,
			colorsOk = colorsOk,
			lx = lx,
			lz = lz,
			rad = rad,
			activeCount = activeCount,
		}
	end

	local function buildFarWater()
		local far = ocean:Clone()
		far.Name = "OceanFar"
		far.Anchored = true
		far.CanCollide = false
		far.CanQuery = false
		far.CanTouch = false
		far.CastShadow = false
		far.Color = ocean.Color:Lerp(Color3.new(0, 0, 0), 1 - DARKEN)
		far.CFrame = ocean.CFrame + Vector3.new(0, LEVEL_OFFSET - FAR_DROP - 0.15, 0)
		far.Parent = workspace
		return far
	end

	local function hideOriginal()
		ocean.LocalTransparencyModifier = 1
		for _, d in ipairs(ocean:GetDescendants()) do
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = 1
			end
		end
	end

	local function runFallback()
		local base = ocean.CFrame
		RunService.RenderStepped:Connect(function()
			local t = workspace:GetServerTimeNow()
			local bob = math.sin(t * 0.9) * 0.2 + math.sin(t * 0.37 + 1.3) * 0.15
			ocean.CFrame = base + Vector3.new(0, bob, 0)
		end)
	end

	local ok, surface = pcall(buildSurface)
	if not ok then
		warn("[OceanWaves] EditableMesh unavailable, using fallback bob: " .. tostring(surface))
		runFallback()
		return
	end

	buildFarWater()
	hideOriginal()

	local mesh = surface.mesh
	local part = surface.part
	local vertexIds = surface.vertexIds
	local normalIds = surface.normalIds
	local colorIds = surface.colorIds
	local colorsOk = surface.colorsOk
	local lx, lz, rad = surface.lx, surface.lz, surface.rad
	local activeCount = surface.activeCount

	local lastShade = table.create(activeCount, DARKEN)
	local ripples = {}
	local partState = setmetatable({}, { __mode = "k" })

	local function spawnRipple(x, z, amp, r0, clock)
		if #ripples >= MAX_RIPPLES then
			table.remove(ripples, 1)
		end
		ripples[#ripples + 1] = {
			x = x,
			z = z,
			amp0 = amp,
			r0 = r0,
			t0 = clock,
			radius = r0,
			width = RIPPLE_WIDTH,
			amp = amp,
			kk = 1.1 / RIPPLE_WIDTH,
			strength = 1,
			lo2 = 0,
			hi2 = 0,
		}
	end

	local function collectSources(cx, cz, level, t, clock, stepDt)
		local limit = WAVE_RADIUS * WAVE_RADIUS * 0.7
		for _, plr in ipairs(Players:GetPlayers()) do
			local char = plr.Character
			if char then
				for _, p in ipairs(char:GetChildren()) do
					if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Transparency < 0.95 then
						local pos = p.Position
						local dx, dz = pos.X - cx, pos.Z - cz
						local d2 = dx * dx + dz * dz
						local st = partState[p]
						if not st then
							st = { pos = pos, t = 0 }
							partState[p] = st
						end
						local speed = math.min((pos - st.pos).Magnitude / math.max(stepDt, 1e-3), 40)
						st.pos = pos
						if d2 < limit then
							local half = math.max(p.Size.X, p.Size.Y, p.Size.Z) * 0.5
							local h = sample(pos.X, pos.Z, t, math.sqrt(d2))
							local surfaceY = level + h
							if math.abs(pos.Y - surfaceY) < half * 0.8 + 0.3 then
								local interval = math.clamp(0.7 - speed * 0.03, 0.18, 0.7)
								if clock - st.t >= interval then
									st.t = clock
									local amp = RIPPLE_HEIGHT
										* math.clamp(0.4 + speed / 18, 0.4, 1.3)
										* math.clamp(half / 2, 0.5, 1.4)
									spawnRipple(pos.X, pos.Z, amp, half * 0.8, clock)
								end
							end
						end
					end
				end
			end
		end
	end

	local function updateRipples(clock)
		for i = #ripples, 1, -1 do
			local rp = ripples[i]
			local age = clock - rp.t0
			if age >= RIPPLE_LIFE then
				table.remove(ripples, i)
			else
				local fade = 1 - age / RIPPLE_LIFE
				fade *= fade
				local radius = rp.r0 + RIPPLE_SPEED * age
				local width = RIPPLE_WIDTH * (1 + age * 0.6)
				rp.radius = radius
				rp.width = width
				rp.kk = 1.1 / width
				rp.amp = rp.amp0 * fade / (1 + radius * 0.05)
				rp.strength = fade * math.min(1, rp.amp0 / RIPPLE_HEIGHT)
				local lo = math.max(0, radius - width * 3)
				local hi = radius + width * 3
				rp.lo2 = lo * lo
				rp.hi2 = hi * hi
			end
		end
	end

	local rate = UPDATE_RATE
	local MIN_RATE = math.min(12, UPDATE_RATE)
	local step = 1 / rate
	local fpsAcc, fpsN = 0, 0
	local accumulator = 0
	local lastUpdate = os.clock()

	RunService.RenderStepped:Connect(function(dt)
		fpsAcc += dt
		fpsN += 1
		if fpsN >= 60 then
			local avg = fpsAcc / fpsN
			fpsAcc, fpsN = 0, 0
			if avg > 1 / 30 then
				rate = math.max(rate - 3, MIN_RATE)
			elseif avg < 1 / 45 then
				rate = math.min(rate + 2, UPDATE_RATE)
			end
			step = 1 / rate
		end
		accumulator += dt
		if accumulator < step then return end
		accumulator %= step

		local camera = workspace.CurrentCamera
		if not camera then return end
		local camPos = camera.CFrame.Position
		local cx, cz = camPos.X, camPos.Z
		local t = workspace:GetServerTimeNow()
		local clock = os.clock()
		local stepDt = clock - lastUpdate
		lastUpdate = clock
		local level = getLevel()

		part.CFrame = CFrame.new(cx, level, cz)

		collectSources(cx, cz, level, t, clock, stepDt)
		updateRipples(clock)
		local rc = #ripples

		for n = 1, activeCount do
			local x, z = lx[n], lz[n]
			local wx, wz = cx + x, cz + z
			local h, gx, gz = sample(wx, wz, t, rad[n])
			local bright = 0

			for i = 1, rc do
				local rp = ripples[i]
				local dx, dz = wx - rp.x, wz - rp.z
				local d2 = dx * dx + dz * dz
				if d2 >= rp.lo2 and d2 <= rp.hi2 then
					local d = math.sqrt(d2)
					local w = rp.width
					local u = d - rp.radius
					local q = u / w
					local env = math.exp(-q * q)
					local ph = u * rp.kk
					local c = math.cos(ph)
					local hh = rp.amp * env
					h += hh * c
					local dh = hh * (-2 * q / w * c - rp.kk * math.sin(ph))
					if d > 1e-3 then
						gx += dh * dx / d
						gz += dh * dz / d
					end
					local slope = math.min(1, math.abs(dh) * w / math.max(rp.amp, 1e-4) * 1.16)
					bright += rp.strength * (0.5 * env + 0.5 * slope)
				end
			end

			mesh:SetPosition(vertexIds[n], Vector3.new(x, h, z))
			local sx, sz = gx * NORMAL_STRENGTH, gz * NORMAL_STRENGTH
			local inv = 1 / math.sqrt(sx * sx + 1 + sz * sz)
			mesh:SetNormal(normalIds[n], Vector3.new(-sx * inv, inv, -sz * inv))

			if colorsOk then
				local shade = DARKEN + (1 - DARKEN) * math.min(bright * RIPPLE_BRIGHTNESS, 1)
				if math.abs(shade - lastShade[n]) > 0.002 then
					lastShade[n] = shade
					mesh:SetColor(colorIds[n], Color3.new(shade, shade, shade))
				end
			end
		end
	end)
end

return OceanController
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX68">
							<Properties>
								<string name="Name">Settings</string>
								<ProtectedString name="Source"><![CDATA[local SettingsController = { Name = "Settings" }

function SettingsController:Start()
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Workspace = game:GetService("Workspace")
	local cfg = require(script:FindFirstAncestor("Client").Config).Settings

	local player = Players.LocalPlayer
	local saveRemote = ReplicatedStorage:WaitForChild("GetSettingsData")

	local settingsGui = player.PlayerGui:WaitForChild("NEWMenu"):FindFirstChild("Settings"):FindFirstChild("SettingsPanel")
	local fovValue = settingsGui:FindFirstChild("FOVUpdater"):FindFirstChild("FOV")
	local fovShowcase = settingsGui:FindFirstChild("FOVText")
	local fovSlider = settingsGui:FindFirstChild("FOVBack"):FindFirstChild("FOVFront")

	fovValue.Changed:Connect(function()
		saveRemote:InvokeServer(fovValue.Value)
	end)

	local savedFOV = saveRemote:InvokeServer()

	local function applyFOV()
		local camera = Workspace.CurrentCamera
		if camera and savedFOV then
			camera.FieldOfView = savedFOV

			local clampedNumber = math.clamp(savedFOV, cfg.MinFov, cfg.MaxFov)
			local calculatedSize = (clampedNumber - cfg.MinFov) / (cfg.MaxFov - cfg.MinFov)
			fovSlider.Size = UDim2.fromScale(calculatedSize, 1)
			fovShowcase.Text = tostring(savedFOV)
		end
	end

	applyFOV()

	player.CharacterAdded:Connect(function()
		task.wait()
		applyFOV()
	end)
end

return SettingsController
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX69">
							<Properties>
								<string name="Name">Sounds</string>
								<ProtectedString name="Source"><![CDATA[local SoundController = { Name = "Sounds" }

function SoundController:Start()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local FootstepsSoundGroup = game:GetService("SoundService"):WaitForChild("Footsteps")

	local SOUND_DATA = {
		Climbing = {
			SoundId = "rbxassetid://IDHERE",
			Looped = true,
		},
		Died = {
			SoundId = "rbxassetid://IDHERE",
		},
		FreeFalling = {
			SoundId = "rbxassetid://IDHERE",
			Looped = true,
		},
		GettingUp = {
			SoundId = "rbxassetid://IDHERE",
		},
		Jumping = {
			SoundId = "rbxassetid://IDHERE",
		},
		Landing = {
			SoundId = "rbxassetid://IDHERE",
		},
		Running = {
			SoundId = "",
			Looped = true,
			Playing = true,
			Pitch = 1,
		},
		Splash = {
			SoundId = "rbxassetid://IDHERE",
		},
		Swimming = {
			SoundId = "rbxassetid://IDHERE",
			Looped = true,
			Pitch = 1.6,
		},
	}



	local function waitForFirst(...)
		local shunt = Instance.new("BindableEvent")
		local slots = {...}

		local function fire(...)
			for i = 1, #slots do
				slots[i]:Disconnect()
			end

			return shunt:Fire(...)
		end

		for i = 1, #slots do
			slots[i] = slots[i]:Connect(fire)
		end

		return shunt.Event:Wait()
	end


	local function map(x, inMin, inMax, outMin, outMax)
		return (x - inMin)*(outMax - outMin)/(inMax - inMin) + outMin
	end

	local function playSound(sound)
		sound.TimePosition = 0
		sound.Playing = true
	end

	local function stopSound(sound)
		sound.Playing = false
		sound.TimePosition = 0
	end

	local function initializeSoundSystem(player, humanoid, rootPart)
		local sounds = {}


		for name, props in pairs(SOUND_DATA) do
			local sound = Instance.new("Sound")
			sound.Name = name


			sound.Archivable = false
			sound.EmitterSize = 5
			sound.MaxDistance = 150
			sound.Volume = 0.65

			for propName, propValue in pairs(props) do
				sound[propName] = propValue
			end

			sound.Parent = rootPart
			sounds[name] = sound
		end

		local playingLoopedSounds = {}

		local function stopPlayingLoopedSounds(except)
			for sound in pairs(playingLoopedSounds) do
				if sound ~= except then
					sound.Playing = false
					playingLoopedSounds[sound] = nil
				end
			end
		end


		local stateTransitions = {
			[Enum.HumanoidStateType.FallingDown] = function()
				stopPlayingLoopedSounds()
			end,

			[Enum.HumanoidStateType.GettingUp] = function()
				stopPlayingLoopedSounds()
				playSound(sounds.GettingUp)
			end,

			[Enum.HumanoidStateType.Jumping] = function()
				stopPlayingLoopedSounds()
				playSound(sounds.Jumping)
			end,

			[Enum.HumanoidStateType.Swimming] = function()
				local verticalSpeed = math.abs(rootPart.Velocity.Y)
				if verticalSpeed > 0.1 then
					sounds.Splash.Volume = math.clamp(map(verticalSpeed, 100, 350, 0.28, 1), 0, 1)
					playSound(sounds.Splash)
				end
				stopPlayingLoopedSounds(sounds.Swimming)
				sounds.Swimming.Playing = true
				playingLoopedSounds[sounds.Swimming] = true
			end,

			[Enum.HumanoidStateType.Freefall] = function()
				sounds.FreeFalling.Volume = 0
				stopPlayingLoopedSounds(sounds.FreeFalling)
				playingLoopedSounds[sounds.FreeFalling] = true
			end,

			[Enum.HumanoidStateType.Landed] = function()
				stopPlayingLoopedSounds()
				local verticalSpeed = math.abs(rootPart.Velocity.Y)
				if verticalSpeed > 75 then
					sounds.Landing.Volume = math.clamp(map(verticalSpeed, 50, 100, 0, 1), 0, 1)
					playSound(sounds.Landing)
				end
			end,

			[Enum.HumanoidStateType.Running] = function()
				stopPlayingLoopedSounds(sounds.Running)
				sounds.Running.Playing = true
				playingLoopedSounds[sounds.Running] = true
			end,

			[Enum.HumanoidStateType.Climbing] = function()
				local sound = sounds.Climbing
				if math.abs(rootPart.Velocity.Y) > 0.1 then
					sound.Playing = true
					stopPlayingLoopedSounds(sound)
				else
					stopPlayingLoopedSounds()
				end
				playingLoopedSounds[sound] = true
			end,

			[Enum.HumanoidStateType.Seated] = function()
				stopPlayingLoopedSounds()
			end,

			[Enum.HumanoidStateType.Dead] = function()
				stopPlayingLoopedSounds()
				playSound(sounds.Died)
			end,
		}


		local loopedSoundUpdaters = {
			[sounds.Climbing] = function(dt, sound, vel)
				sound.Playing = vel.Magnitude > 0.1
			end,

			[sounds.FreeFalling] = function(dt, sound, vel)
				if vel.Magnitude > 75 then
					sound.Volume = math.clamp(sound.Volume + 0.9*dt, 0, 1)
				else
					sound.Volume = 0
				end
			end,

			[sounds.Running] = function(dt, sound, vel)


			sound.SoundId = FootstepsSoundGroup:WaitForChild(humanoid.FloorMaterial).SoundId
			sound.PlaybackSpeed = FootstepsSoundGroup:WaitForChild(humanoid.FloorMaterial).PlaybackSpeed
			sound.Volume = FootstepsSoundGroup:WaitForChild(humanoid.FloorMaterial).Volume * (vel.Magnitude/12)
			sound.EmitterSize = FootstepsSoundGroup:WaitForChild(humanoid.FloorMaterial).Volume * (vel.Magnitude/12) * 50

			if FootstepsSoundGroup:FindFirstChild(humanoid.FloorMaterial) == nil then
				sound.SoundId = FootstepsSoundGroup:WaitForChild("nil Sound").SoundId
				sound.PlaybackSpeed = FootstepsSoundGroup:WaitForChild("nil Sound").PlaybackSpeed
				sound.EmitterSize = FootstepsSoundGroup:WaitForChild("nil Sound").Volume
				sound.Volume = FootstepsSoundGroup:WaitForChild("nil Sound").Volume
			end
			end,
		}


		local stateRemap = {
			[Enum.HumanoidStateType.RunningNoPhysics] = Enum.HumanoidStateType.Running,
		}

		local activeState = stateRemap[humanoid:GetState()] or humanoid:GetState()
		local activeConnections = {}

		local stateChangedConn = humanoid.StateChanged:Connect(function(_, state)
			state = stateRemap[state] or state

			if state ~= activeState then
				local transitionFunc = stateTransitions[state]

				if transitionFunc then
					transitionFunc()
				end

				activeState = state
			end
		end)

		local steppedConn = RunService.Stepped:Connect(function(_, worldDt)

			for sound in pairs(playingLoopedSounds) do
				local updater = loopedSoundUpdaters[sound]

				if updater then
					updater(worldDt, sound, rootPart.Velocity)
				end
			end
		end)

		local humanoidAncestryChangedConn
		local rootPartAncestryChangedConn
		local characterAddedConn

		local function terminate()
			stateChangedConn:Disconnect()
			steppedConn:Disconnect()
			humanoidAncestryChangedConn:Disconnect()
			rootPartAncestryChangedConn:Disconnect()
			characterAddedConn:Disconnect()
		end

		humanoidAncestryChangedConn = humanoid.AncestryChanged:Connect(function(_, parent)
			if not parent then
				terminate()
			end
		end)

		rootPartAncestryChangedConn = rootPart.AncestryChanged:Connect(function(_, parent)
			if not parent then
				terminate()
			end
		end)

		characterAddedConn = player.CharacterAdded:Connect(terminate)
	end

	local function playerAdded(player)
		local function characterAdded(character)









			if not character.Parent then
				waitForFirst(character.AncestryChanged, player.CharacterAdded)
			end

			if player.Character ~= character or not character.Parent then
				return
			end

			local humanoid = character:FindFirstChildOfClass("Humanoid")
			while character:IsDescendantOf(game) and not humanoid do
				waitForFirst(character.ChildAdded, character.AncestryChanged, player.CharacterAdded)
				humanoid = character:FindFirstChildOfClass("Humanoid")
			end

			if player.Character ~= character or not character:IsDescendantOf(game) then
				return
			end


			local rootPart = character:FindFirstChild("HumanoidRootPart")
			while character:IsDescendantOf(game) and not rootPart do
				waitForFirst(character.ChildAdded, character.AncestryChanged, humanoid.AncestryChanged, player.CharacterAdded)
				rootPart = character:FindFirstChild("HumanoidRootPart")
			end

			if rootPart and humanoid:IsDescendantOf(game) and character:IsDescendantOf(game) and player.Character == character then
				initializeSoundSystem(player, humanoid, rootPart)
			end
		end

		if player.Character then
			characterAdded(player.Character)
		end
		player.CharacterAdded:Connect(characterAdded)
	end

	Players.PlayerAdded:Connect(playerAdded)
	for _, player in ipairs(Players:GetPlayers()) do
		playerAdded(player)
	end



	local function onCharacterAdded(character)
		local Head = character:WaitForChild("HumanoidRootPart")
		local RunningSound = Head:WaitForChild("Running")
		local Humanoid = character:WaitForChild("Humanoid")
		local vel = 0

		Humanoid.Running:connect(function(a)
				RunningSound.PlaybackSpeed 	= FootstepsSoundGroup:WaitForChild(Humanoid.FloorMaterial).PlaybackSpeed * (a/20) * (math.random(30,50)/40)
				RunningSound.Volume 		= FootstepsSoundGroup:WaitForChild(Humanoid.FloorMaterial).Volume * (vel/12)
				RunningSound.EmitterSize 	= FootstepsSoundGroup:WaitForChild(Humanoid.FloorMaterial).Volume * (vel/12) * 50
				vel 						= a
		end)
	end

	local localPlayer = game.Players.LocalPlayer
	if localPlayer.Character then
		onCharacterAdded(localPlayer.Character)
	end
	localPlayer.CharacterAdded:Connect(onCharacterAdded)
end

return SoundController
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX70">
							<Properties>
								<string name="Name">Touch</string>
								<ProtectedString name="Source"><![CDATA[local TouchController = { Name = "Touch" }

function TouchController:Start()
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local UserInputService = game:GetService("UserInputService")

	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local hasMorphed = false

	local function findMobileFrame()
		local gameGui = playerGui:FindFirstChild("GameGui")
		local mainFrame = gameGui and gameGui:FindFirstChild("MainFrame")
		local interface = mainFrame and mainFrame:FindFirstChild("Interface")
		return interface and interface:FindFirstChild("Mobile")
	end

	local function hideTouchControls()
		local touchGui = playerGui:FindFirstChild("TouchGui")
		if touchGui then
			touchGui.Enabled = false
		end

		local mobile = findMobileFrame()
		if mobile then
			mobile.Visible = false
		end
	end

	local function showTouchControls()
		local touchGui = playerGui:FindFirstChild("TouchGui")
		if touchGui then
			touchGui.Enabled = true
		end

		if UserInputService.TouchEnabled then
			local mobile = findMobileFrame()
			if mobile then
				mobile.Visible = true
			end
		end
	end

	hideTouchControls()

	playerGui.ChildAdded:Connect(function(child)
		if child.Name == "TouchGui" and not hasMorphed then
			task.defer(function()
				child.Enabled = false
			end)
		end
	end)

	local function monitorTouchGui(touchGui)
		touchGui.Changed:Connect(function(prop)
			if prop == "Enabled" and not hasMorphed then
				if touchGui.Enabled then
					task.defer(function()
						if not hasMorphed then
							touchGui.Enabled = false
						end
					end)
				end
			end
		end)
	end

	local existingTouchGui = playerGui:FindFirstChild("TouchGui")
	if existingTouchGui then
		monitorTouchGui(existingTouchGui)
	end

	local morphSupplies = ReplicatedStorage:FindFirstChild("MorphSupplies")
	local events = morphSupplies and morphSupplies:FindFirstChild("Events")
	local fireEvent = events and events:FindFirstChild("Fire")
	if fireEvent then
		fireEvent.OnClientEvent:Connect(function()
			hasMorphed = true

			task.wait(1)
			showTouchControls()
		end)
	end

	player.CharacterAdded:Connect(function(character)
		task.wait(1)

		local kaijuValue = character:FindFirstChild("Kaiju")
		if kaijuValue then
			hasMorphed = true
			showTouchControls()
		end
	end)
end

return TouchController
]]></ProtectedString>
							</Properties>
						</Item>
						<Item class="ModuleScript" referent="RBX71">
							<Properties>
								<string name="Name">WaterFX</string>
								<ProtectedString name="Source"><![CDATA[local WaterFX = { Name = "WaterFX" }

local FOAM = "rbxasset://textures/particles/smoke_main.dds"
local SPRAY = "rbxasset://textures/particles/sparkles_main.dds"

local function sizeSequence(a, b)
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, a),
		NumberSequenceKeypoint.new(1, b),
	})
end

local function build(folder, fx)
	local part = Instance.new("Part")
	part.Name = "WaterFXEmitter"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.one
	part.Parent = folder

	local attachment = Instance.new("Attachment")
	attachment.Parent = part

	local wake = Instance.new("ParticleEmitter")
	wake.Texture = FOAM
	wake.Rate = 0
	wake.Lifetime = NumberRange.new(fx.WakeLifetime * 0.7, fx.WakeLifetime)
	wake.Speed = NumberRange.new(0.5, 2)
	wake.SpreadAngle = Vector2.new(180, 180)
	wake.Drag = 3
	wake.LightEmission = 0.3
	wake.Color = ColorSequence.new(fx.FoamColor)
	wake.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	wake.Size = sizeSequence(1, 3)
	wake.Parent = attachment

	local spray = Instance.new("ParticleEmitter")
	spray.Texture = SPRAY
	spray.Rate = 0
	spray.Lifetime = NumberRange.new(0.5, 0.9)
	spray.Speed = NumberRange.new(8, 16)
	spray.SpreadAngle = Vector2.new(35, 35)
	spray.EmissionDirection = Enum.NormalId.Top
	spray.Acceleration = Vector3.new(0, -workspace.Gravity * 0.6, 0)
	spray.LightEmission = 0.5
	spray.Color = ColorSequence.new(fx.SprayColor)
	spray.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	spray.Size = sizeSequence(0.6, 0.2)
	spray.Parent = attachment

	return part, wake, spray
end

function WaterFX:Start()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local config = require(script:FindFirstAncestor("Client").Config)
	local fx = config.WaterFX
	local levelOffset = config.Ocean.LevelOffset

	local ocean = workspace:WaitForChild("Ocean", config.Ocean.WaitTimeout)
	if not ocean or not ocean:IsA("BasePart") then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "WaterFX"
	folder.Parent = workspace

	local tracked = {}

	local function untrack(player)
		local entry = tracked[player]
		if entry then
			entry.part:Destroy()
			tracked[player] = nil
		end
	end

	local function track(player, character)
		untrack(player)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if not root then
			return
		end
		local part, wake, spray = build(folder, fx)
		tracked[player] = {
			root = root,
			part = part,
			wake = wake,
			spray = spray,
			scale = 0,
			wasIn = false,
			nextSplash = 0,
		}
	end

	local function hook(player)
		player.CharacterAdded:Connect(function(character)
			track(player, character)
		end)
		player.CharacterRemoving:Connect(function()
			untrack(player)
		end)
		if player.Character then
			task.spawn(track, player, player.Character)
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		hook(player)
	end
	Players.PlayerAdded:Connect(hook)
	Players.PlayerRemoving:Connect(untrack)

	local function applyScale(entry, scale)
		if math.abs(entry.scale - scale) < 0.25 then
			return
		end
		entry.scale = scale
		entry.wake.Size = sizeSequence(scale, scale * 3)
		entry.spray.Size = sizeSequence(scale * 0.6, scale * 0.2)
		entry.spray.Speed = NumberRange.new(8 * scale ^ 0.5, 16 * scale ^ 0.5)
	end

	local interval = 1 / fx.UpdateRate
	local elapsed = 0

	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < interval then
			return
		end
		elapsed = 0

		local camera = workspace.CurrentCamera
		if not camera or not ocean.Parent then
			return
		end

		local camPos = camera.CFrame.Position
		local level = ocean.Position.Y + ocean.Size.Y / 2 + levelOffset
		local now = os.clock()

		for player, entry in pairs(tracked) do
			local root = entry.root
			if not root.Parent then
				untrack(player)
			else
				local pos = root.Position
				local halfHeight = root.Size.Y / 2
				local inWater = pos.Y - halfHeight <= level + fx.SurfaceMargin
					and pos.Y > level - fx.MaxDepth
					and (pos - camPos).Magnitude <= fx.MaxDistance

				if inWater then
					local velocity = root.AssemblyLinearVelocity
					local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
					local scale = math.clamp(math.max(root.Size.X, root.Size.Z) / fx.ReferenceSize, 1, fx.MaxScale)
					applyScale(entry, scale)
					entry.part.CFrame = CFrame.new(pos.X, level + fx.SurfaceLift, pos.Z)

					entry.wake.Rate = speed > fx.MinSpeed and math.min(speed * fx.RatePerSpeed, fx.MaxRate) or 0
					entry.spray.Rate = speed > fx.SprayMinSpeed
							and math.min((speed - fx.SprayMinSpeed) * fx.SprayPerSpeed, fx.SprayMaxRate)
						or 0

					if not entry.wasIn and now >= entry.nextSplash then
						local count = math.clamp(-velocity.Y * fx.SplashPerSpeed * scale ^ 0.5, fx.SplashMinCount, fx.SplashMaxCount)
						entry.spray:Emit(math.floor(count))
						entry.wake:Emit(math.floor(count * 0.5))
						entry.nextSplash = now + fx.SplashCooldown
					end
				else
					entry.wake.Rate = 0
					entry.spray.Rate = 0
				end

				entry.wasIn = inWater
			end
		end
	end)
end

return WaterFX
]]></ProtectedString>
							</Properties>
						</Item>
					</Item>
					<Item class="Folder" referent="RBX72">
						<Properties>
							<string name="Name">Core</string>
						</Properties>
						<Item class="ModuleScript" referent="RBX73">
							<Properties>
								<string name="Name">Util</string>
								<ProtectedString name="Source"><![CDATA[local Util = {}

function Util.spawn(log, name, fn, ...)
	task.spawn(function(...)
		local ok, err = pcall(fn, ...)
		if not ok then
			log:warn(name .. " failed: " .. tostring(err))
		end
	end, ...)
end

return Util
]]></ProtectedString>
							</Properties>
