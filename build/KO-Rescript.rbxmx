		MaxFov = 120,
		DataStoreAttempts = 3,
		RemoteWaitTimeout = 60,
	},

	LegacyModules = { "Character", "Combat", "Data", "World" },

	OceanDepth = {
		Enabled = true,
		FloorNames = { "Bottom" },
