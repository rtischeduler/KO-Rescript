			</Item>
			<Item class="Folder" referent="RBX6">
				<Properties>
					<string name="Name">framework</string>
				</Properties>
				<Item class="Folder" referent="RBX7">
					<Properties>
						<string name="Name">modules</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX8">
						<Properties>
							<string name="Name">Combat</string>
							<ProtectedString name="Source"><![CDATA[local Combat = {}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local function safeRequire(name)
	local module = ReplicatedStorage:FindFirstChild(name)
	if not module then return nil end
	local ok, result = pcall(require, module)
	if not ok then
		warn("[Combat] Failed to require " .. name .. ": " .. tostring(result))
		return nil
	end
	return result
end

safeRequire("LevelGuard")
safeRequire("ChargeManager")

local function getOrCreateRemote(name)
	local remote = ReplicatedStorage:FindFirstChild(name)
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = ReplicatedStorage
	end
	return remote
end

local function getGCells(player)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then return nil end
	local gcells = leaderstats:FindFirstChild("GCells") or leaderstats:FindFirstChild("gcells")
	if gcells and gcells:IsA("IntValue") then return gcells end
	return nil
end

local function giveGCells(player, amount, isKillReward)
	local gcells = getGCells(player)
	if not gcells then return end
	if isKillReward and _G.SetKillRewardFlag then _G.SetKillRewardFlag(player) end
	if _G.GCellGuardAllow then _G.GCellGuardAllow(gcells, amount) end
	gcells.Value += amount
	if _G.ShowIndicator then _G.ShowIndicator(player, 0, amount, 0) end
	if isKillReward and _G.ClearKillRewardFlag then _G.ClearKillRewardFlag(player) end
end

local function giveXP(player, minXP, maxXP)
	local character = player.Character
	local addXP = character and character:FindFirstChild("AddXP")
	if addXP and addXP:IsA("BindableEvent") then
		if _G.SetKillRewardFlag then _G.SetKillRewardFlag(player) end
		local xpAmount = math.random(minXP, maxXP)
		addXP:Fire(xpAmount)
		if _G.ShowIndicator then _G.ShowIndicator(player, 0, 0, xpAmount) end
		if _G.ClearKillRewardFlag then _G.ClearKillRewardFlag(player) end
	end
end

local function setCreator(humanoid, player)
	local creator = humanoid:FindFirstChild("creator")
	if not creator then
		creator = Instance.new("ObjectValue")
		creator.Name = "creator"
		creator.Parent = humanoid
	end
	creator.Value = player
end

local function resolveAttackers(damages)
	local topKiller, topDamage = nil, 0
	local others = {}
	for attacker, damage in pairs(damages) do
		if damage > topDamage then
			if topKiller then table.insert(others, topKiller) end
			topKiller, topDamage = attacker, damage
		else
			table.insert(others, attacker)
		end
	end
	return topKiller, others
end

local initialized = false

local function initCombat()
	local HEALTH_THRESHOLD = 0.50
	local SLOW_PERCENT = 0.65
	local KILL_REWARD = 300
	local ASSIST_REWARD = 100
	local HEAL_PERCENT_ON_KILL = 0.80
	local KILL_XP_MIN, KILL_XP_MAX = 200, 300
	local ASSIST_XP_MIN, ASSIST_XP_MAX = 50, 100

	local damageLog = {}
	_G.CombatDamageLog = damageLog
	local lastHealth = {}
	local applyingBossBonus = {}
	local restoringHealth = {}
	local setupDone = {}

	local KILL_MESSAGES = {
		"{killer} slimed {victim}",
		"{killer} obliterated {victim}",
		"{killer} sent {victim} to Destoroyah",
		"{killer} cooked {victim}",
		"{killer} absolutely demolished {victim}",
		"{killer} made {victim} rage quit",
		"{killer} blasted {victim} into oblivion",
		"{killer} said goodnight to {victim}",
		"{killer} gave {victim} Ghidorah treatment",
		"{killer} turned {victim} into dust",
		"{killer} showed {victim} no mercy",
		"{killer} made {victim} reconsider their life choices",
		"{victim} got folded by {killer}",
		"{victim} was no match for {killer}",
		"{killer} ended {victim}'s career",
		"{killer} uhh gave laxatives to {victim} and self imploded",
		"{victim} somehow died to {killer}",
		"{victim} did something evil to {killer}",
		"{killer} transmitted a message to {victim} and told them the next kaiju added is going to be Gorosaurus",
		"{victim} used the Mechagodzilla method on {killer} and failed miserabely",
		"{killer} transformed into Lotszilla and took care of  {victim}. ",
		"{killer} found {victim}",
		"{killer} turned {victim} into a burger",
	}

	local function sendKillMessage(killerName, victimName)
		local event = ReplicatedStorage:FindFirstChild("KillMessage")
		if not event then return end
		local template = KILL_MESSAGES[math.random(1, #KILL_MESSAGES)]
		local message = (string.gsub(template, "{(%w+)}", { killer = killerName, victim = victimName }))
		event:FireAllClients(message)
	end

	local function healPlayer(player, percent)
		local character = player.Character
		if not character or character:GetAttribute("BossMode") then return end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then return end
		humanoid.Health = math.min(humanoid.Health + humanoid.MaxHealth * percent, humanoid.MaxHealth)
	end

	local function clearCharacter(character)
		damageLog[character] = nil
		lastHealth[character] = nil
		applyingBossBonus[character] = nil
		restoringHealth[character] = nil
		setupDone[character] = nil
	end

	local function setupCharacter(character)
		if setupDone[character] then return end
		setupDone[character] = true

		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid then
			setupDone[character] = nil
			return
		end

		local isLowHealth = false
		local isApplyingSlow = false
		local baseWalkSpeed = nil
		lastHealth[character] = humanoid.Health
		damageLog[character] = {}

		humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
			if isApplyingSlow or not isLowHealth or not baseWalkSpeed then return end
			local maxAllowed = baseWalkSpeed * (1 - SLOW_PERCENT)
			if humanoid.WalkSpeed > maxAllowed then
				isApplyingSlow = true
				humanoid.WalkSpeed = maxAllowed
				isApplyingSlow = false
			end
		end)

		humanoid.HealthChanged:Connect(function(newHealth)
			if applyingBossBonus[character] or restoringHealth[character] then
				lastHealth[character] = newHealth
				return
			end
			if newHealth <= 0 then return end

			local healthPercent = newHealth / humanoid.MaxHealth
			if healthPercent <= HEALTH_THRESHOLD then
				if not isLowHealth then
					isLowHealth = true
					local beamFactor = humanoid:GetAttribute("BeamSlowFactor") or 1
					baseWalkSpeed = humanoid.WalkSpeed / beamFactor
					humanoid:SetAttribute("Slowed", true)
					isApplyingSlow = true
					humanoid.WalkSpeed = baseWalkSpeed * (1 - SLOW_PERCENT) * beamFactor
					isApplyingSlow = false
				end
			elseif isLowHealth then
				isLowHealth = false
				humanoid:SetAttribute("Slowed", false)
				isApplyingSlow = true
				local beamFactor = humanoid:GetAttribute("BeamSlowFactor") or 1
				humanoid.WalkSpeed = baseWalkSpeed and (baseWalkSpeed * beamFactor) or humanoid.WalkSpeed / (1 - SLOW_PERCENT)
				isApplyingSlow = false
				baseWalkSpeed = nil
			end

			local oldHealth = lastHealth[character] or humanoid.MaxHealth
			if newHealth < oldHealth then
				local damageDealt = oldHealth - newHealth
				local creator = humanoid:FindFirstChild("creator")
				local attacker = creator and creator.Value
				if attacker and attacker:IsA("Player") then
					local bossSystem = _G.BossSystem
					if bossSystem and bossSystem.active then
						local attackerChar = attacker.Character
						local attackerIsBoss = attackerChar and attackerChar:GetAttribute("BossMode")
						local victimIsBoss = character:GetAttribute("BossMode")
						if not victimIsBoss and not attackerIsBoss then
							restoringHealth[character] = true
							humanoid.Health = oldHealth
							restoringHealth[character] = nil
							lastHealth[character] = oldHealth
							return
						end
					end

					local log = damageLog[character]
					if not log then
						log = {}
						damageLog[character] = log
					end
					log[attacker] = (log[attacker] or 0) + damageDealt

					local attackerChar = attacker.Character
					if attackerChar and attackerChar:GetAttribute("BossMode") then
						local bonus = math.floor(damageDealt * 0.5)
						if bonus > 0 then
							task.defer(function()
								if humanoid.Parent and humanoid.Health > 0 then
									applyingBossBonus[character] = true
									humanoid:TakeDamage(bonus)
									applyingBossBonus[character] = nil
									local current = damageLog[character]
									if current then
										current[attacker] = (current[attacker] or 0) + bonus
									end
								end
							end)
						end
					end
				end
			end
			lastHealth[character] = newHealth
		end)

		humanoid.Died:Connect(function()
			local charDamages = damageLog[character]
			if charDamages then
				local topKiller, others = resolveAttackers(charDamages)
				local victimPlayer = Players:GetPlayerFromCharacter(character)
				local victimName = victimPlayer and victimPlayer.Name or character.Name

				if topKiller and topKiller:IsA("Player") then
					sendKillMessage(topKiller.Name, victimName)
					giveGCells(topKiller, KILL_REWARD, true)
					local stats = topKiller:FindFirstChild("leaderstats")
					local kills = stats and stats:FindFirstChild("Kills")
					if kills and kills:IsA("IntValue") then kills.Value += 1 end
					giveXP(topKiller, KILL_XP_MIN, KILL_XP_MAX)
					healPlayer(topKiller, HEAL_PERCENT_ON_KILL)
				end
				for _, attacker in ipairs(others) do
					if attacker ~= topKiller and attacker:IsA("Player") then
						giveGCells(attacker, ASSIST_REWARD, true)
						giveXP(attacker, ASSIST_XP_MIN, ASSIST_XP_MAX)
					end
				end
			end
			damageLog[character] = nil
			lastHealth[character] = nil
		end)

		character.AncestryChanged:Connect(function(_, parent)
			if not parent then clearCharacter(character) end
		end)
	end

	local function setupPlayer(player)
		player.CharacterAdded:Connect(setupCharacter)
		if player.Character then task.spawn(setupCharacter, player.Character) end
	end

	for _, player in ipairs(Players:GetPlayers()) do setupPlayer(player) end
	Players.PlayerAdded:Connect(setupPlayer)

	Players.PlayerRemoving:Connect(function(player)
		local character = player.Character
		if not character then return end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then return end
		local charDamages = damageLog[character]
		if not charDamages or next(charDamages) == nil then return end

		local damagePercent = 1 - humanoid.Health / humanoid.MaxHealth
		if damagePercent <= 0 then return end

		local topKiller, others = resolveAttackers(charDamages)
		if topKiller and topKiller:IsA("Player") then
			local reward = math.floor(damagePercent * KILL_REWARD)
			if reward > 0 then
				sendKillMessage(topKiller.Name, player.Name)
				giveGCells(topKiller, reward, true)
				giveXP(topKiller, KILL_XP_MIN, KILL_XP_MAX)
			end
		end
		for _, attacker in ipairs(others) do
			if attacker ~= topKiller and attacker:IsA("Player") then
				local reward = math.floor(damagePercent * ASSIST_REWARD)
				if reward > 0 then
					giveGCells(attacker, reward, true)
					giveXP(attacker, ASSIST_XP_MIN, ASSIST_XP_MAX)
				end
			end
		end
		damageLog[character] = nil
		lastHealth[character] = nil
	end)
end

local function initAtomicBreath()
	local gojiraModel = workspace:FindFirstChild("GVK GOJIRA", true)
	local model = gojiraModel and gojiraModel:FindFirstChild("AtomicBreath", true)
	if not model then
		warn("[Combat] AtomicBreath model is missing; atomic breath effects disabled")
		return
	end

	local ELECTRIC_BLUE = Color3.fromRGB(0, 191, 255)
	local original = {}
	local sequence = {}

	local function collect(prefix, from, to)
		for i = from, to do
			local spike = model:FindFirstChild(prefix .. i)
			if spike and spike:IsA("BasePart") then
				table.insert(sequence, spike)
				original[spike] = { Color = spike.Color, Material = spike.Material }
			end
		end
	end
	collect("TailSpikes", 1, 11)
	collect("Spikes", 12, 19)

	local function restore(spike)
		local props = original[spike]
		if props and spike.Parent then
			spike.Color, spike.Material = props.Color, props.Material
		end
	end

	_G.AtomicBreathCharge = {
		ChargeUp = function()
			for _, spike in ipairs(sequence) do
				if spike.Parent then
					spike.Color = ELECTRIC_BLUE
					spike.Material = Enum.Material.Neon
				end
				task.wait(0.5)
			end
		end,
		Reset = function()
			for spike in pairs(original) do restore(spike) end
		end,
		Discharge = function()
			for i = #sequence, 1, -1 do
				restore(sequence[i])
				task.wait(0.3)
			end
		end,
	}
end

local function initPulse()
	local pulseHitEvent = getOrCreateRemote("PulseHit")
	local pulseFireEvent = getOrCreateRemote("PulseFire")

	local function getHumanoidAndPlayer(part)
		local current = part.Parent
		while current and current ~= workspace do
			local humanoid = current:FindFirstChildOfClass("Humanoid")
			if humanoid then
				return humanoid, Players:GetPlayerFromCharacter(current)
			end
			current = current.Parent
		end
		return nil, nil
	end

	_G.FirePulse = function(player, color, maxSize, duration, damage)
		local character = player and player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		pulseFireEvent:FireAllClients(player, color, maxSize, duration)

		local hitbox = Instance.new("Part")
		hitbox.Name = "PulseHitbox"
		hitbox.Shape = Enum.PartType.Ball
		hitbox.Size = Vector3.new(5, 5, 5)
		hitbox.CFrame = hrp.CFrame
		hitbox.Anchored = true
		hitbox.CanCollide = false
		hitbox.CanTouch = false
		hitbox.CanQuery = true
		hitbox.Transparency = 1
		hitbox:SetAttribute("BlastActive", true)
		hitbox:SetAttribute("Attacker", player.Name)

		local pn = Instance.new("StringValue")
		pn.Name = "PlayerName"
		pn.Value = player.Name
		pn.Parent = hitbox

		hitbox.Parent = workspace
		Debris:AddItem(hitbox, duration + 2)

		local damagePerTick = damage / 10
		local gcellsPerTick = 25
		local startSize = 50
		maxSize = math.max(maxSize, 300)
		local tickInterval = 0.5

		local overlapParams = OverlapParams.new()
		overlapParams.FilterDescendantsInstances = { character }
		overlapParams.FilterType = Enum.RaycastFilterType.Exclude

		local startTime = os.clock()
		while os.clock() - startTime < duration do
			if not hitbox.Parent or not hrp.Parent then break end

			local progress = math.clamp((os.clock() - startTime) / duration, 0, 1)
			local size = startSize + (maxSize - startSize) * progress
			hitbox.Size = Vector3.new(size, size, size)
			hitbox.CFrame = hrp.CFrame

			local hitThisTick = {}
			for _, part in ipairs(workspace:GetPartsInPart(hitbox, overlapParams)) do
				local hitHumanoid, hitPlayer = getHumanoidAndPlayer(part)
				if hitHumanoid and hitPlayer and hitPlayer ~= player and not hitThisTick[hitPlayer] then
					hitThisTick[hitPlayer] = true
					setCreator(hitHumanoid, player)
					hitHumanoid:TakeDamage(damagePerTick)
					if _G.ShowIndicator then _G.ShowIndicator(player, damagePerTick, 0, 0) end
					pulseHitEvent:FireClient(hitPlayer)
					giveGCells(player, gcellsPerTick, false)
				end
			end

			if _G.DamageBuildingsInRadius then
				_G.DamageBuildingsInRadius(hrp.Position, size / 2, player)
			end
			task.wait(tickInterval)
		end

		if hitbox.Parent then
			hitbox:SetAttribute("BlastActive", false)
			hitbox:Destroy()
		end
	end
end

local function initLevelGuard()
	local LEVEL_THRESHOLD = 10
	local BLOCK_DURATION = 3

	local blockTimers = {}
	local killRewardFlags = {}
	local previousGCells = {}
	local changing = {}
	local hookedGCells = {}

	local function getLevel(character)
		local levelVal = character and character:FindFirstChild("Level")
		if levelVal and levelVal:IsA("IntValue") then return levelVal.Value end
		return nil
	end

	local function isBlocked(player)
		if not player or not player.Parent then return false end
		local expires = blockTimers[player]
		if not expires then return false end
		if os.clock() > expires then
			blockTimers[player] = nil
			return false
		end
		return true
	end

	_G.IsRewardBlocked = isBlocked
	_G.SetKillRewardFlag = function(player)
		if player then killRewardFlags[player] = true end
	end
	_G.ClearKillRewardFlag = function(player)
		if player then killRewardFlags[player] = nil end
	end

	local function checkAttack(attacker, targetCharacter)
		if not attacker or not attacker:IsA("Player") or not targetCharacter then return end
		local attackerLevel = getLevel(attacker.Character)
		local targetLevel = getLevel(targetCharacter)
		if not attackerLevel or not targetLevel then return end
		if attackerLevel > LEVEL_THRESHOLD and targetLevel < LEVEL_THRESHOLD then
			blockTimers[attacker] = os.clock() + BLOCK_DURATION
		end
	end

	local function hookCreator(humanoid, targetCharacter)
		local function check(creator)
			local value = creator.Value
			if value and value:IsA("Player") then checkAttack(value, targetCharacter) end
		end
		local function watch(creator)
			if not creator:IsA("ObjectValue") then return end
			creator.Changed:Connect(function() check(creator) end)
			check(creator)
		end
		local existing = humanoid:FindFirstChild("creator")
		if existing then watch(existing) end
		humanoid.ChildAdded:Connect(function(child)
			if child.Name == "creator" then watch(child) end
		end)
	end

	local function hookDPSAttacker(humanoid, targetCharacter)
		local function check()
			local attackerId = humanoid:GetAttribute("LastDPSAttacker")
			if attackerId then
				local attacker = Players:GetPlayerByUserId(attackerId)
				if attacker then checkAttack(attacker, targetCharacter) end
			end
		end
		humanoid:GetAttributeChangedSignal("LastDPSAttacker"):Connect(check)
		check()
	end

	local function hookGCells(player)
		local function setup()
			local gcells = getGCells(player)
			if not gcells or hookedGCells[gcells] then return end
			hookedGCells[gcells] = true
			previousGCells[player] = gcells.Value
			gcells.Changed:Connect(function(newValue)
				if changing[player] then return end
				if killRewardFlags[player] then
					previousGCells[player] = newValue
					return
				end
				if isBlocked(player) then
					local prev = previousGCells[player] or 0
					if newValue > prev then
						changing[player] = true
						gcells.Value = prev
						changing[player] = nil
						return
					end
				end
				previousGCells[player] = newValue
			end)
			gcells.AncestryChanged:Connect(function(_, parent)
				if not parent then hookedGCells[gcells] = nil end
			end)
		end

		setup()
		player.ChildAdded:Connect(function(child)
			if child.Name == "leaderstats" then
				task.wait(0.1)
				setup()
			end
		end)
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			leaderstats.ChildAdded:Connect(function() task.defer(setup) end)
		end
	end

	local function hookCharacter(character)
		local humanoid = character:WaitForChild("Humanoid", 5)
		if not humanoid then return end
		hookCreator(humanoid, character)
		hookDPSAttacker(humanoid, character)
	end

	local function hookPlayer(player)
		hookGCells(player)
		player.CharacterAdded:Connect(function(character)
			task.spawn(hookCharacter, character)
		end)
		if player.Character then task.spawn(hookCharacter, player.Character) end
	end

	for _, player in ipairs(Players:GetPlayers()) do hookPlayer(player) end
	Players.PlayerAdded:Connect(hookPlayer)
	Players.PlayerRemoving:Connect(function(player)
		blockTimers[player] = nil
		killRewardFlags[player] = nil
		previousGCells[player] = nil
		changing[player] = nil
	end)
end

local function initWaterBubbles()
	local bubblesTemplate = ReplicatedStorage:FindFirstChild("bubbles")
	if not bubblesTemplate then
		warn("[WaterBubbles] Could not find bubbles template in ReplicatedStorage")
		return
	end
	local waterStateEvent = ReplicatedStorage:FindFirstChild("WaterState")
	if not waterStateEvent then
		warn("[WaterBubbles] Could not find WaterState RemoteEvent")
		return
	end

	local BUBBLES_NAME = "bubbles"
	local HEAD_NAMES = { "FakeHead", "Fakehead", "Head" }

	local function getHead(character)
		for _, name in ipairs(HEAD_NAMES) do
			local head = character:FindFirstChild(name)
			if head and head:IsA("BasePart") then return head end
		end
		return nil
	end

	waterStateEvent.OnServerEvent:Connect(function(player, inWater)
		if type(inWater) ~= "boolean" then return end
		local character = player.Character
		if not character then return end
		local head = getHead(character)
		if not head then return end
		local existing = head:FindFirstChild(BUBBLES_NAME)
		if inWater then
			if not existing then
				local bubbles = bubblesTemplate:Clone()
				bubbles.Name = BUBBLES_NAME
				bubbles.Parent = head
			end
		elseif existing then
			existing:Destroy()
		end
	end)
end

local function initAttackHandler()
	local BeamSystem = safeRequire("BeamSystem")

	local playerDebounces = {}
	local connectedRemotes = {}

	local VALID_ATTACK_TYPES = {
		Melee = true, Pulse = true, Beam = true, FirePulse = true, BackBeam = true,
	}

	local function getHumanoidAndPlayer(part)
		if part.Name == "AttackHitbox" or part.Name == "BeamHitbox" or part.Name == "PulseHitbox" or part:GetAttribute("MeleeHit") then
			return nil, nil
		end
		local character = part.Parent
		if not character then return nil, nil end
		return character:FindFirstChildOfClass("Humanoid"), Players:GetPlayerFromCharacter(character)
	end

	local function findSounds(character)
		local sounds = character:FindFirstChild("Sounds")
		if sounds then return sounds end
		local scripts = character:FindFirstChild("CharacterScripts")
		return scripts and scripts:FindFirstChild("Sounds") or nil
	end

	local function getGlowManager(character)
		local scripts = character:FindFirstChild("CharacterScripts")
		local module = scripts and scripts:FindFirstChild("GlowManager")
		if not module then return nil end
		local ok, gm = pcall(require, module)
		return ok and gm or nil
	end

	local function playSoundFrom(character, soundName, parent)
		local sounds = findSounds(character)
		local template = sounds and sounds:FindFirstChild(soundName)
		if not template or not parent then return end
		local clone = template:Clone()
		clone.Parent = parent
		clone.Looped = false
		clone.Ended:Connect(function() clone:Destroy() end)
		clone:Play()
		Debris:AddItem(clone, 15)
	end

	local function playHitSound(character)
		playSoundFrom(character, "HitSound", character:FindFirstChild("HumanoidRootPart"))
	end

	local function playAttackAnimation(character, animName)
		local animations = character:FindFirstChild("Animations")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local animator = humanoid and humanoid:FindFirstChild("Animator")
		local anim = animations and animations:FindFirstChild(animName)
		if animator and anim then
			local track = animator:LoadAnimation(anim)
			track.Looped = false
			track:Play()
		end
	end

	local function getAnimName(remoteName)
		if remoteName == "Attack" then return "Attack1" end
		if remoteName == "Beam" then return "Attack2" end
		return remoteName
	end

	local function getDamage(character, damageStat)
		local stats = character:FindFirstChild("Stats")
		local value = stats and stats:FindFirstChild(damageStat)
		return value and value.Value or 10
	end

	local function registerHit(attacker, attackerChar, humanoid, damage, gcells)
		setCreator(humanoid, attacker)
		humanoid:TakeDamage(damage)
		if _G.ShowIndicator then _G.ShowIndicator(attacker, damage, 0, 0) end
		playHitSound(attackerChar)
		giveGCells(attacker, gcells, false)
	end

	local function enableHitParts(character, hitPlayers, player, damage)
		local connections, enabled = {}, {}
		for _, folder in ipairs({ character:FindFirstChild("HitParts"), character:FindFirstChild("HitParts2") }) do
			if folder then
				for _, part in ipairs(folder:GetDescendants()) do
					if part:IsA("BasePart") and not part:FindFirstChildWhichIsA("Script") then
						part.CanTouch = true
						table.insert(enabled, part)
						table.insert(connections, part.Touched:Connect(function(hit)
							local hitHumanoid, hitPlayer = getHumanoidAndPlayer(hit)
							if hitHumanoid and hitPlayer and hitPlayer ~= player and not hitPlayers[hitPlayer] then
								hitPlayers[hitPlayer] = true
								registerHit(player, character, hitHumanoid, damage, 25)
							end
						end))
					end
				end
			end
		end
		return connections, enabled
	end

	local function disableHitParts(connections, enabled)
		for _, conn in ipairs(connections) do conn:Disconnect() end
		for _, part in ipairs(enabled) do
			if part.Parent then part.CanTouch = false end
		end
	end

	local function executeMeleeAttack(player, character, remote, remoteName, durationOverride)
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local size = Vector3.new(
			remote:GetAttribute("HitboxSizeX") or 15,
			remote:GetAttribute("HitboxSizeY") or 15,
			remote:GetAttribute("HitboxSizeZ") or 15
		)
		local offset = CFrame.new(
			remote:GetAttribute("HitboxOffsetX") or 0,
			remote:GetAttribute("HitboxOffsetY") or 0,
			remote:GetAttribute("HitboxOffsetZ") or -10
		)
		local duration = durationOverride or remote:GetAttribute("HitboxDuration") or 0.5
		local damage = getDamage(character, remote:GetAttribute("DamageStat") or "DMG1")

		playAttackAnimation(character, getAnimName(remoteName))

		local hitbox = Instance.new("Part")
		hitbox.Name = "AttackHitbox"
		hitbox:SetAttribute("MeleeHit", true)
		hitbox.Size = size
		hitbox.Anchored = true
		hitbox.CanCollide = false
		hitbox.CanTouch = true
		hitbox.Transparency = 1
		hitbox.Color = Color3.fromRGB(255, 0, 0)
		hitbox.Material = Enum.Material.Neon
		hitbox.Parent = character
		hitbox.CFrame = hrp.CFrame * offset
		Debris:AddItem(hitbox, duration + 2)

		local hitPlayers = {}
		local partConns, partsEnabled = enableHitParts(character, hitPlayers, player, damage)

		local connection = hitbox.Touched:Connect(function(hit)
			local hitHumanoid, hitPlayer = getHumanoidAndPlayer(hit)
			if hitHumanoid and hitPlayer and hitPlayer ~= player and not hitPlayers[hitPlayer] then
				hitPlayers[hitPlayer] = true
				registerHit(player, character, hitHumanoid, damage, 25)
			end
		end)

		local overlapParams = OverlapParams.new()
		overlapParams.FilterDescendantsInstances = { character }
		overlapParams.FilterType = Enum.RaycastFilterType.Exclude

		local startTime = os.clock()
		while os.clock() - startTime < duration do
			if not character.Parent or not hrp.Parent or not hitbox.Parent then break end
			for _, part in ipairs(workspace:GetPartsInPart(hitbox, overlapParams)) do
				local hitHumanoid, hitPlayer = getHumanoidAndPlayer(part)
				if hitHumanoid and hitPlayer and hitPlayer ~= player and not hitPlayers[hitPlayer] then
					hitPlayers[hitPlayer] = true
					registerHit(player, character, hitHumanoid, damage, 25)
				end
			end
			task.wait(0.05)
		end

		connection:Disconnect()
		hitbox:Destroy()
		disableHitParts(partConns, partsEnabled)
	end

	local function executePulseAttack(player, character, remote, remoteName)
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local sizeX = remote:GetAttribute("HitboxSizeX") or 50
		local sizeY = remote:GetAttribute("HitboxSizeY") or 50
		local sizeZ = remote:GetAttribute("HitboxSizeZ") or 50
		local duration = remote:GetAttribute("HitboxDuration") or 2
		local maxSize = remote:GetAttribute("PulseMaxSize") or 500
		local tickInterval = remote:GetAttribute("PulseTickInterval") or 0.3
		local damage = getDamage(character, remote:GetAttribute("DamageStat") or "DMG3")

		playAttackAnimation(character, getAnimName(remoteName))
		playSoundFrom(character, "Beam", hrp)

		local pulsePart = Instance.new("Part")
		pulsePart.Name = "PulseHitbox"
		pulsePart.Shape = Enum.PartType.Ball
		pulsePart.Material = Enum.Material.Neon
		pulsePart.Color = Color3.fromRGB(0, 0, 0)
		pulsePart.Anchored = true
		pulsePart.CanCollide = false
		pulsePart.CanTouch = false
		pulsePart.Transparency = 0
		pulsePart.Size = Vector3.new(sizeX, sizeY, sizeZ)
		pulsePart.CFrame = hrp.CFrame
		pulsePart.Parent = workspace
		Debris:AddItem(pulsePart, duration + 2)

		local oneShotHit = {}
		local partConns, partsEnabled = enableHitParts(character, oneShotHit, player, damage)

		local numTicks = math.max(duration / tickInterval, 1)
		local damagePerTick = damage / numTicks
		local gcellsPerTick = 25 / numTicks
		local startSize = math.max(sizeX, sizeY, sizeZ)

		local overlapParams = OverlapParams.new()
		overlapParams.FilterDescendantsInstances = { character }
		overlapParams.FilterType = Enum.RaycastFilterType.Exclude

		local startTime = os.clock()
		while os.clock() - startTime < duration do
			if not character.Parent or not hrp.Parent or not pulsePart.Parent then break end

			local progress = math.clamp((os.clock() - startTime) / duration, 0, 1)
			local currentSize = startSize + (maxSize - startSize) * progress
			pulsePart.Size = Vector3.new(currentSize, currentSize, currentSize)
			pulsePart.Transparency = progress
			pulsePart.CFrame = hrp.CFrame

			local hitThisTick = {}
			for _, part in ipairs(workspace:GetPartsInPart(pulsePart, overlapParams)) do
				local hitHumanoid, hitPlayer = getHumanoidAndPlayer(part)
				if hitHumanoid and hitPlayer and hitPlayer ~= player and not hitThisTick[hitPlayer] then
					hitThisTick[hitPlayer] = true
					registerHit(player, character, hitHumanoid, damagePerTick, gcellsPerTick)
				end
			end
			task.wait(tickInterval)
		end

		if pulsePart.Parent then pulsePart:Destroy() end
		disableHitParts(partConns, partsEnabled)
	end

	local function executeFirePulse(player, character, remote, remoteName)
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local damage = getDamage(character, remote:GetAttribute("DamageStat") or "DMG3")
		local windup = remote:GetAttribute("PulseWindup") or 0
		local pulseColor = remote:GetAttribute("PulseColor") or Color3.fromRGB(255, 120, 0)
		local pulseMaxSize = remote:GetAttribute("PulseMaxSize") or 300
		local pulseDuration = remote:GetAttribute("HitboxDuration") or 4

		playAttackAnimation(character, getAnimName(remoteName))
		playSoundFrom(character, "Pulse", hrp)

		if windup > 0 then task.wait(windup) end
		if _G.FirePulse then
			_G.FirePulse(player, pulseColor, pulseMaxSize, pulseDuration, damage)
		end
	end

	local function executeBeamAttack(player, character, remote, remoteName, targetPos)
		if not BeamSystem then return end
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		if typeof(targetPos) ~= "Vector3" then targetPos = nil end

		local duration = remote:GetAttribute("BeamDuration") or remote:GetAttribute("HitboxDuration") or 4.7
		local chargeTime = remote:GetAttribute("BeamChargeTime") or 0

		playAttackAnimation(character, getAnimName(remoteName))

		local glowManager = getGlowManager(character)
		if glowManager then glowManager.StartGlow(chargeTime) end

		playSoundFrom(character, "Beam", hrp)

		local sortedSpikes = {}
		local originalProps = {}
		local spikesFolder = character:FindFirstChild("Spikes")
		if spikesFolder then
			for _, child in ipairs(spikesFolder:GetChildren()) do
				if child:IsA("BasePart") then
					local number = tonumber(string.match(child.Name, "%d+"))
					if number then
						table.insert(sortedSpikes, { part = child, number = number })
						originalProps[child] = { Material = child.Material, UsePartColor = child.UsePartColor }
					end
				end
			end
			table.sort(sortedSpikes, function(a, b) return a.number < b.number end)
		end

		local function resetEffects()
			task.spawn(function()
				for i = #sortedSpikes, 1, -1 do
					local spike = sortedSpikes[i].part
					local props = originalProps[spike]
					if props and spike.Parent then
						spike.Material = props.Material
						spike.UsePartColor = props.UsePartColor
					end
					task.wait(0.1)
				end
				if glowManager then glowManager.EndGlow() end
			end)
		end

		if #sortedSpikes > 0 then
			local perSpikeDelay = chargeTime > 0 and chargeTime / #sortedSpikes or 0.21
			for _, data in ipairs(sortedSpikes) do
				data.part.Material = Enum.Material.Neon
				data.part.UsePartColor = true
				task.wait(perSpikeDelay)
			end
		elseif chargeTime > 0 then
			task.wait(chargeTime)
		end

		local ok, err = pcall(BeamSystem.ActivateBeam, {
			character = character,
			player = player,
			initialTargetPosition = targetPos,
			duration = duration,
		})
		if not ok then warn("[AttackHandler] ActivateBeam failed: " .. tostring(err)) end

		resetEffects()
	end

	local function executeBackBeam(player, character, remote, remoteName)
		local glowManager = getGlowManager(character)
		if glowManager then glowManager.StartGlow() end

		local windup = remote:GetAttribute("BackBeamWindup") or 0
		if windup > 0 then task.wait(windup) end

		local activeDuration = remote:GetAttribute("BackBeamActive") or remote:GetAttribute("HitboxDuration") or 0.5
		local ok, err = pcall(executeMeleeAttack, player, character, remote, remoteName, activeDuration)
		if not ok then warn("[AttackHandler] BackBeam failed: " .. tostring(err)) end

		if glowManager then glowManager.EndGlow() end
	end

	local function connectRemote(remote)
		if connectedRemotes[remote] then return end
		local attackType = remote:GetAttribute("AttackType")
		if not attackType or not VALID_ATTACK_TYPES[attackType] then return end
		connectedRemotes[remote] = true

		remote.AncestryChanged:Connect(function(_, parent)
			if not parent then connectedRemotes[remote] = nil end
		end)

		local remoteName = remote.Name
		remote.OnServerEvent:Connect(function(player, ...)
			local debounces = playerDebounces[player]
			if not debounces then
				debounces = {}
				playerDebounces[player] = debounces
			end
			if debounces[remote] then return end

			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			if not hrp or not humanoid or humanoid.Health <= 0 then return end

			debounces[remote] = true

			local args = table.pack(...)
			local ok, err = pcall(function()
				if attackType == "Melee" then
					executeMeleeAttack(player, char, remote, remoteName)
				elseif attackType == "Pulse" then
					executePulseAttack(player, char, remote, remoteName)
				elseif attackType == "Beam" then
					executeBeamAttack(player, char, remote, remoteName, args[1])
				elseif attackType == "FirePulse" then
					executeFirePulse(player, char, remote, remoteName)
				elseif attackType == "BackBeam" then
					executeBackBeam(player, char, remote, remoteName)
				end
			end)
			if not ok then warn("[AttackHandler] " .. attackType .. " failed: " .. tostring(err)) end

			if playerDebounces[player] then
				playerDebounces[player][remote] = nil
			end
		end)
	end

	local function scanCharacter(character)
		for _, descendant in ipairs(character:GetDescendants()) do
			if descendant:IsA("RemoteEvent") then connectRemote(descendant) end
		end
	end

	local function setupPlayer(player)
		player.CharacterAdded:Connect(function(character)
			scanCharacter(character)
			character.DescendantAdded:Connect(function(descendant)
				if descendant:IsA("RemoteEvent") then
					task.defer(connectRemote, descendant)
				end
			end)
		end)
		local character = player.Character
		if character then
			scanCharacter(character)
			character.DescendantAdded:Connect(function(descendant)
				if descendant:IsA("RemoteEvent") then
					task.defer(connectRemote, descendant)
				end
			end)
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do setupPlayer(player) end
	Players.PlayerAdded:Connect(setupPlayer)
	Players.PlayerRemoving:Connect(function(player)
		playerDebounces[player] = nil
	end)
end

local function initDPS()
	local CollectionService = game:GetService("CollectionService")
	local connected = setmetatable({}, { __mode = "k" })

	local function findAttacker(part)
		local model = part:FindFirstAncestorOfClass("Model")
		while model do
			local player = Players:GetPlayerFromCharacter(model)
			if player then return player end
			model = model:FindFirstAncestorOfClass("Model")
		end
		local nameValue = part:FindFirstChild("PlayerName")
		if nameValue and nameValue:IsA("StringValue") then
			return Players:FindFirstChild(nameValue.Value)
		end
		return nil
	end

	local function levelScale(attacker)
		local perLevel = ReplicatedStorage:FindFirstChild("DamageMultiplierPerLevel")
		if not perLevel then return 1 end
		local character = attacker and attacker.Character
		local levelValue = character and character:FindFirstChild("Level")
		local level = levelValue and levelValue.Value or 1
		return perLevel.Value ^ (level - 1)
	end

	local function payGCells(attacker, amount)
		local leaderstats = attacker:FindFirstChild("leaderstats")
		if not leaderstats then return end
		local gcells = leaderstats:FindFirstChild("GCells") or leaderstats:FindFirstChild("gcells")
		if gcells and gcells:IsA("IntValue") then
			if _G.GCellGuardAllow then _G.GCellGuardAllow(gcells, amount) end
			gcells.Value = gcells.Value + amount
			if _G.ShowIndicator and amount >= 1 then _G.ShowIndicator(attacker, 0, amount, 0) end
		end
	end

	local function hook(part)
		if connected[part] or not part:IsA("BasePart") then return end
		connected[part] = true
		local lastHit = setmetatable({}, { __mode = "k" })
		part.Touched:Connect(function(other)
			if part:GetAttribute("RequireBlastActive") and not part:GetAttribute("BlastActive") then return end
			local character = other.Parent
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if not humanoid or humanoid.Health <= 0 then return end
			local attacker = findAttacker(part)
			if attacker and attacker.Character == character then return end
			local cooldown = part:GetAttribute("Cooldown") or 0.5
			local now = os.clock()
			if cooldown > 0 and lastHit[character] and now - lastHit[character] < cooldown then return end
			lastHit[character] = now
			local multiplier = part:GetAttribute("DamageMultiplier") or 1
			if part:GetAttribute("LevelScaled") then
				multiplier = multiplier * levelScale(attacker)
			end
			humanoid.Health = humanoid.Health - (part:GetAttribute("Damage") or 0.9) * multiplier
			if attacker then
				humanoid:SetAttribute("LastDPSAttacker", attacker.UserId)
				payGCells(attacker, part:GetAttribute("GCellRate") or 0.2)
				if _G.ShowIndicator then _G.ShowIndicator(attacker, (part:GetAttribute("Damage") or 0.9) * multiplier, 0, 0) end
			end
		end)
	end

	for _, part in ipairs(CollectionService:GetTagged("DPSPart")) do
		hook(part)
	end
	CollectionService:GetInstanceAddedSignal("DPSPart"):Connect(hook)
end

local function initRoar()
	local connected = setmetatable({}, { __mode = "k" })

	local function hook(event)
		if not event:IsA("RemoteEvent") or connected[event] then return end
		local scripts = event.Parent
		if not scripts or scripts.Name ~= "CharacterScripts" then return end
		local roarName = event.Name
		if not roarName:match("^Roar%d*$") then return end
		connected[event] = true
		event.OnServerEvent:Connect(function(player)
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if not humanoid then return end
			local debounce = scripts:FindFirstChild("Debounce")
			if not debounce or debounce.Value then return end
			debounce.Value = true
			local animations = scripts.Parent and scripts.Parent:FindFirstChild("Animations")
			local roarAnim = animations and animations:FindFirstChild(roarName)
			local animator = roarAnim and humanoid:FindFirstChild("Animator")
			if animator then
				local track = animator:LoadAnimation(roarAnim)
				track.Looped = false
				track.Priority = Enum.AnimationPriority.Action
				track:Play(0.1, 10)
			end
			local sounds = scripts:FindFirstChild("Sounds")
			local roarSound = sounds and sounds:FindFirstChild(roarName)
			if roarSound then
				local clone = roarSound:Clone()
				clone.Parent = character:FindFirstChild("Head") or character:FindFirstChild("Torso") or character
				clone.Looped = false
				clone:Play()
				task.wait(clone.TimeLength / math.max(clone.PlaybackSpeed, 0.01))
				clone:Destroy()
			end
			debounce.Value = false
		end)
	end

	for _, inst in ipairs(workspace:GetDescendants()) do
		hook(inst)
	end
	workspace.DescendantAdded:Connect(hook)
end

function Combat.Init()
	if initialized then return end
	initialized = true
	task.spawn(initCombat)
	task.spawn(initAtomicBreath)
	task.spawn(initLevelGuard)
	task.spawn(initWaterBubbles)
	task.spawn(initPulse)
	task.spawn(initAttackHandler)
	task.spawn(initDPS)
	task.spawn(initRoar)
end

return Combat]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX9">
						<Properties>
							<string name="Name">World</string>
							<ProtectedString name="Source"><![CDATA[local World = {}

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")
local PhysicsService = game:GetService("PhysicsService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HolidayConfigs = require(ReplicatedStorage:WaitForChild("HolidayConfigs"))

local state = { IsRaining = false, IsSnowing = false }
local initialized = false
local windowApi = {}
local savedWindowState = setmetatable({}, { __mode = "k" })

local DEBRIS_GROUP = "CollapseDebris"
local CHARACTER_GROUP = "Characters"
local debrisReady = false

local function initDebrisCollision()
	local ok = pcall(function()
		for _, name in { DEBRIS_GROUP, CHARACTER_GROUP } do
			if not PhysicsService:IsCollisionGroupRegistered(name) then
				PhysicsService:RegisterCollisionGroup(name)
			end
		end
		PhysicsService:CollisionGroupSetCollidable(DEBRIS_GROUP, CHARACTER_GROUP, false)
	end)
	if not ok then return end
	debrisReady = true

	local function assign(character)
		local function mark(d)
			if d:IsA("BasePart") then d.CollisionGroup = CHARACTER_GROUP end
		end
		for _, d in character:GetDescendants() do mark(d) end
		character.DescendantAdded:Connect(mark)
	end

	local function hook(player)
		player.CharacterAdded:Connect(assign)
		if player.Character then assign(player.Character) end
	end

	for _, player in Players:GetPlayers() do hook(player) end
	Players.PlayerAdded:Connect(hook)
end

local function lerp(a, b, t) return a + (b - a) * t end

local function rand(a, b) return a + math.random() * (b - a) end

local function shuffle(list)
	local copy = table.clone(list)
	for i = #copy, 2, -1 do
		local j = math.random(1, i)
		copy[i], copy[j] = copy[j], copy[i]
	end
	return copy
end

local function maxAxis(part)
	return math.max(part.Size.X, part.Size.Y, part.Size.Z) / 2
end

local function easeLinear(p) return p end
local function easeInOut(p)
	if p < 0.5 then return 2 * p * p end
	return 1 - (-2 * p + 2) ^ 2 / 2
end
local function easeCollapse(p) return p ^ 1.7 end
local function easeTilt(p) return p ^ 1.6 end

local function initDayNight()
	local DAY_LENGTH_MIN = 30
	local WEATHER_FADE = 10
	local START_MINUTES = 720
	local timeRatio = (24 * 60) / (math.max(DAY_LENGTH_MIN, 1) * 60)
	local t0 = os.clock()

	local DAY = {
		Brightness = 2, Ambient = Color3.new(0.5, 0.5, 0.5),
		OutdoorAmbient = Color3.new(0.25, 0.28, 0.21),
		ColorShift_Top = Color3.new(1, 0.75, 0.57),
		ColorShift_Bottom = Color3.new(0.15, 0.15, 0.2),
		FogColor = Color3.new(0.61, 0.67, 0.77), FogEnd = 5500,
		Density = 0.3, AtmColor = Color3.new(0.7, 0.75, 0.85), Haze = 2,
		Cloud = Color3.new(1, 1, 1),
	}
	local NIGHT = {
		Brightness = 1.2, Ambient = Color3.new(0.28, 0.32, 0.45),
		OutdoorAmbient = Color3.new(0.15, 0.18, 0.3),
		ColorShift_Top = Color3.new(0.12, 0.15, 0.28),
		ColorShift_Bottom = Color3.new(0.06, 0.07, 0.14),
		FogColor = Color3.new(0.18, 0.21, 0.3), FogEnd = 3000,
		Density = 0.4, AtmColor = Color3.new(0.1, 0.1, 0.18), Haze = 3,
		Cloud = Color3.new(0.12, 0.12, 0.16),
	}
	local RAIN = {
		FogEndMul = 0.4, DensityAdd = 0.15, HazeAdd = 1,
		FogColor = Color3.new(0.35, 0.37, 0.4),
		AtmColor = Color3.new(0.4, 0.42, 0.45),
		Cloud = Color3.new(0.15, 0.15, 0.18),
	}

	local SNOW = RAIN
	local DEFAULT = { Day = DAY, Night = NIGHT, Rain = RAIN }
	local lastCheck = -math.huge
	local baseDecay = nil
	local wxLevel, wxTable = 0, nil
	local lastWx = os.clock()

	local fxBase = setmetatable({}, { __mode = "k" })

	local function setFx(inst, prop, value)
		local saved = fxBase[inst]
		if not saved then
			saved = {}
			fxBase[inst] = saved
		end
		if saved[prop] == nil then saved[prop] = inst[prop] end
		if value ~= nil then inst[prop] = value else inst[prop] = saved[prop] end
	end

	local function applyEffects(fx)
		fx = fx or {}
		local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
		if atmosphere then
			setFx(atmosphere, "Offset", fx.AtmOffset)
			setFx(atmosphere, "Glare", fx.AtmGlare)
		end
		for _, child in Lighting:GetChildren() do
			if child:IsA("BloomEffect") then
				setFx(child, "Intensity", fx.BloomIntensity)
				setFx(child, "Threshold", fx.BloomThreshold)
			elseif child:IsA("SunRaysEffect") then
				setFx(child, "Intensity", fx.SunRaysIntensity)
			end
		end
		setFx(Lighting, "ExposureCompensation", fx.Exposure)
	end

	local function rawDayFactor(m)
		if m >= 420 and m <= 1020 then return 1
		elseif m >= 1140 or m <= 300 then return 0
		elseif m < 420 then return (m - 300) / 120
		else return 1 - (m - 1020) / 120 end
	end

	local function dayFactor(m)
		local x = rawDayFactor(m)
		return x * x * (3 - 2 * x)
	end

	while true do
		local clock = os.clock()
		if clock - lastCheck >= 30 then
			lastCheck = clock
			local holiday = HolidayConfigs.getActive()
			local set = holiday and holiday.Lighting or DEFAULT
			DAY, NIGHT = set.Day or DEFAULT.Day, set.Night or DEFAULT.Night
			RAIN = set.Rain or DEFAULT.Rain
			SNOW = set.Snow or set.Rain or DEFAULT.Rain
			applyEffects(holiday and holiday.Effects or nil)
		end

		local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
		local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")

		local minutes = (START_MINUTES + (os.clock() - t0) * timeRatio) % 1440
		Lighting:SetMinutesAfterMidnight(minutes)
		local t = dayFactor(minutes)

		Lighting.Brightness = lerp(NIGHT.Brightness, DAY.Brightness, t)
		Lighting.Ambient = NIGHT.Ambient:Lerp(DAY.Ambient, t)
		Lighting.OutdoorAmbient = NIGHT.OutdoorAmbient:Lerp(DAY.OutdoorAmbient, t)
		Lighting.ColorShift_Top = NIGHT.ColorShift_Top:Lerp(DAY.ColorShift_Top, t)
		Lighting.ColorShift_Bottom = NIGHT.ColorShift_Bottom:Lerp(DAY.ColorShift_Bottom, t)

		local fogEnd = lerp(NIGHT.FogEnd, DAY.FogEnd, t)
		local density = lerp(NIGHT.Density, DAY.Density, t)
		local haze = lerp(NIGHT.Haze, DAY.Haze, t)

		local target = (state.IsRaining or state.IsSnowing) and 1 or 0
		local active = state.IsRaining and RAIN or state.IsSnowing and SNOW or nil
		if active then wxTable = active end
		local maxStep = math.max(clock - lastWx, 0) / WEATHER_FADE
		lastWx = clock
		wxLevel += math.clamp(target - wxLevel, -maxStep, maxStep)
		if wxLevel <= 0 then wxTable = nil end
		local k = wxLevel * wxLevel * (3 - 2 * wxLevel)

		local fogColor = NIGHT.FogColor:Lerp(DAY.FogColor, t)
		local atmColor = NIGHT.AtmColor:Lerp(DAY.AtmColor, t)
		local cloudColor = NIGHT.Cloud:Lerp(DAY.Cloud, t)
		if wxTable and k > 0 then
			fogColor = fogColor:Lerp(wxTable.FogColor, k)
			atmColor = atmColor:Lerp(wxTable.AtmColor, k)
			cloudColor = cloudColor:Lerp(wxTable.Cloud, k)
			fogEnd *= lerp(1, wxTable.FogEndMul, k)
			density += wxTable.DensityAdd * k
			haze += wxTable.HazeAdd * k
		end
		Lighting.FogColor = fogColor
		Lighting.FogEnd = fogEnd
		if atmosphere then
			atmosphere.Density = density
			atmosphere.Color = atmColor
			atmosphere.Haze = haze
		end
		if clouds then clouds.Color = cloudColor end

		if atmosphere then
			if baseDecay == nil then baseDecay = atmosphere.Decay end
			atmosphere.Decay = DAY.AtmDecay and NIGHT.AtmDecay and NIGHT.AtmDecay:Lerp(DAY.AtmDecay, t) or baseDecay
		end

		task.wait(1 / 15)
	end
end

local function initWindowLights()
	local LIT = Color3.fromRGB(197, 166, 89)
	local DARK = Color3.new(0, 0, 0)

	local windowsOn = false
	local epoch = 0
	local saved = savedWindowState
	local lights = {}
	local buildings = {}
	local pool = {}
	local winToken = setmetatable({}, { __mode = "k" })
	local LIGHT_BRIGHTNESS = 1.25
	local LIGHT_RANGE = 30
	local LIGHTS_PER_FRAME = 3
	local TURN_ON_SPREAD = 6
	local TURN_OFF_SPREAD = 5
	local jobs, jobHead, jobTail = {}, 1, 0
	local pending = {}
	local function enqueue(fn)
		jobTail += 1
		jobs[jobTail] = fn
	end
	task.spawn(function()
		while true do
			local n = 0
			while jobHead <= jobTail and n < LIGHTS_PER_FRAME do
				local fn = jobs[jobHead]
				jobs[jobHead] = nil
				jobHead += 1
				n += 1
				pcall(fn)
			end
			task.wait()
		end
	end)

	local function owningBuilding(inst)
		local p = inst.Parent
		while p do
			if p:IsA("Model") and p.Name:find("Building") then return p end
			p = p.Parent
		end
	end

	local function register(inst)
		if inst:IsA("UnionOperation") and inst.Name:find("Windows") then
			local b = owningBuilding(inst)
			if b then
				buildings[b] = buildings[b] or {}
				if not table.find(buildings[b], inst) then
					table.insert(buildings[b], inst)
				end
			end
		end
	end

	for _, d in workspace:GetDescendants() do register(d) end
	workspace.DescendantAdded:Connect(register)
	workspace.DescendantRemoving:Connect(function(inst)
		saved[inst] = nil
		for b, list in buildings do
			local i = table.find(list, inst)
			if i then
				table.remove(list, i)
				if #list == 0 then buildings[b] = nil end
				break
			end
		end
	end)

	local function isDestroyed(building)
		local base = building:FindFirstChild("BuildingBase")
		return base and base:IsA("BasePart") and base.Material == Enum.Material.CorrodedMetal or false
	end

	local function windowsOf(building)
		local list = {}
		for _, d in building:GetDescendants() do
			if d:IsA("BasePart") and d.Name:lower():find("window", 1, true) then
				table.insert(list, d)
			end
		end
		return list
	end

	local function capture(window)
		if not saved[window] then
			saved[window] = { Material = window.Material, Color = window.Color }
		end
	end

	local colorCache = setmetatable({}, { __mode = "k" })
	local winBuilding = setmetatable({}, { __mode = "k" })
	local palette = nil
	local dayLit = {}
	local dayLitAt = 0
	local dayLitOn = false

	local function buildingColor(building)
		if not palette or not building then return LIT end
		local c = colorCache[building]
		if not c then
			local base = building:FindFirstChild("BuildingBase")
			local p = base and base:IsA("BasePart") and base.Position or Vector3.zero
			local h = math.floor(math.abs(p.X * 7.13 + p.Z * 13.37 + p.Y * 3.1))
			c = palette[h % #palette + 1]
			colorCache[building] = c
		end
		return c
	end

	local function colorOf(window)
		local b = winBuilding[window]
		if not b then
			b = owningBuilding(window)
			winBuilding[window] = b
		end
		return buildingColor(b)
	end

	local function refreshPalette()
		local holiday = HolidayConfigs.getActive()
		local nextPalette = holiday and holiday.WindowColors or nil
		if nextPalette == palette then return end
		palette = nextPalette
		table.clear(colorCache)
		for base, light in lights do
			if light.Parent and base.Parent then light.Color = buildingColor(base.Parent) end
		end
	end

	local function setWindow(window, lit)
		if not window.Parent then return end
		capture(window)
		window.Material = Enum.Material.Neon
		window.Color = lit and colorOf(window) or DARK
	end

	local function restoreWindow(window)
		if not window.Parent then return end
		local s = saved[window]
		if s then
			window.Material, window.Color = s.Material, s.Color
		else
			window.Material, window.Color = Enum.Material.Glass, DARK
		end
	end

	local function flickerWindow(window, duration, final)
		if not window.Parent then return end
		capture(window)
		winToken[window] = (winToken[window] or 0) + 1
		local mine = winToken[window]
		task.spawn(function()
			local stop = os.clock() + duration
			local litColor = colorOf(window)
			while winToken[window] == mine and window.Parent and os.clock() < stop do
				window.Material = Enum.Material.Neon
				window.Color = math.random() < 0.5 and litColor or DARK
				task.wait(0.03 + math.random() * 0.09)
			end
			if winToken[window] ~= mine or not window.Parent then return end
			if final == "lit" then
				setWindow(window, true)
			elseif final == "dark" then
				setWindow(window, false)
			else
				restoreWindow(window)
			end
		end)
	end

	local function ensureLight(base)
		if lights[base] or pending[base] or not base.Parent then return end
		pending[base] = true
		enqueue(function()
			pending[base] = nil
			if lights[base] or not base.Parent or not windowsOn then return end
			local l = Instance.new("PointLight")
			l.Name = "BuildingGlowLight"
			l.Color = buildingColor(base.Parent)
			l.Brightness = LIGHT_BRIGHTNESS
			l.Range = LIGHT_RANGE
			l.Shadows = false
			CollectionService:AddTag(l, "BuildingGlowLight")
			l.Parent = base
			lights[base] = l
		end)
	end

	local function removeLight(base)
		local l = lights[base]
		if l then
			lights[base] = nil
			enqueue(function()
				if l.Parent then l:Destroy() end
			end)
		end
	end

	local function lightBuilding(building, windows, myEpoch)
		if epoch ~= myEpoch then return end
		local destroyed = isDestroyed(building)
		local base = building:FindFirstChild("BuildingBase")
		if not destroyed and base and base:IsA("BasePart") then ensureLight(base) end

		local function step(delay)
			task.wait(delay)
			return epoch == myEpoch
		end

		if not destroyed then
			for _, w in windows do
				if not step(math.random() * 0.3 + 0.8) then return end
				flickerWindow(w, 0.3 + math.random() * 0.6, "lit")
			end
		elseif #windows == 1 then
			if not step(math.random() * 0.3 + 8) then return end
			flickerWindow(windows[1], 0.3 + math.random() * 0.6, "dark")
		else
			for i, w in shuffle(windows) do
				if not step(math.random() * 0.3 + 0.8) then return end
				flickerWindow(w, 0.3 + math.random() * 0.6, i <= 2 and "lit" or "dark")
			end
		end
	end

	local function turnOn()
		if windowsOn then return end
		windowsOn = true
		dayLitOn = false
		table.clear(dayLit)
		refreshPalette()
		epoch += 1
		local myEpoch = epoch
		for building, windows in buildings do
			task.delay(math.random() * TURN_ON_SPREAD, lightBuilding, building, table.clone(windows), myEpoch)
		end
	end

	local function turnOff()
		if not windowsOn then return end
		windowsOn = false
		dayLitOn = false
		table.clear(dayLit)
		dayLitAt = os.clock() + TURN_OFF_SPREAD + 1
		epoch += 1
		local stale = {}
		for base in lights do table.insert(stale, base) end
		for _, base in stale do removeLight(base) end
		pool = {}
		for _, windows in buildings do
			for _, w in windows do
				winToken[w] = (winToken[w] or 0) + 1
				task.delay(math.random() * TURN_OFF_SPREAD + 0.2, restoreWindow, w)
			end
		end
	end

	local function syncLights()
		local newPool = {}
		for building, windows in buildings do
			local base = building:FindFirstChild("BuildingBase")
			if base and base:IsA("BasePart") then
				if isDestroyed(building) then
					removeLight(base)
				else
					ensureLight(base)
					for _, w in windows do table.insert(newPool, { w, building }) end
				end
			end
		end
		pool = newPool
		for base in lights do
			if not base.Parent then removeLight(base) end
		end
	end

	local function clearDayLights()
		for window in dayLit do
			if window.Parent then restoreWindow(window) end
		end
		table.clear(dayLit)
		dayLitOn = false
	end

	local function refreshDayLights()
		if windowsOn then return end
		local holiday = HolidayConfigs.getActive()
		local cfg = holiday and holiday.DayLights or nil
		if not cfg then
			if dayLitOn then clearDayLights() end
			return
		end
		if dayLitOn or os.clock() < dayLitAt or next(buildings) == nil then return end
		dayLitOn = true
		for building, windows in buildings do
			if not isDestroyed(building) and math.random() < cfg.Buildings then
				for _, window in windows do
					if window.Parent and math.random() < cfg.Windows then
						dayLit[window] = true
						task.delay(math.random() * cfg.Spread, function()
							if dayLitOn and dayLit[window] and not windowsOn then
								flickerWindow(window, 0.3 + math.random() * 0.6, "lit")
							end
						end)
					end
				end
			end
		end
	end

	windowApi.flickerBuilding = function(building, duration, ruined)
		local list = windowsOf(building)
		if #list == 0 then return end
		local darkCount = #list == 1 and 1 or math.random(1, math.min(#list, 3))
		for i, w in shuffle(list) do
			local final
			if ruined then
				if windowsOn then
					final = i <= 2 and "lit" or "dark"
				else
					final = i <= darkCount and "dark" or "restore"
				end
			else
				final = windowsOn and "lit" or "restore"
			end
			flickerWindow(w, duration * (0.7 + math.random() * 0.3), final)
		end
	end

	windowApi.resetBuilding = function(building)
		for _, w in windowsOf(building) do
			winToken[w] = (winToken[w] or 0) + 1
			if windowsOn then setWindow(w, true) else restoreWindow(w) end
		end
	end

	game:BindToClose(function()
		for _, windows in buildings do
			for _, w in windows do restoreWindow(w) end
		end
	end)

	refreshPalette()
	local lastNight, counter = nil, 0
	while true do
		refreshPalette()
		local m = Lighting:GetMinutesAfterMidnight()
		local night = m >= 1080 or m < 360
		if night ~= lastNight then
			lastNight = night
			if night then turnOn() else turnOff() end
		end
		refreshDayLights()
		if windowsOn then
			counter += 1
			if counter >= 3 then counter = 0 syncLights() end
			if #pool > 0 and math.random() < 0.6 then
				local pick = pool[math.random(1, #pool)]
				if pick[1].Parent and not isDestroyed(pick[2]) then
					flickerWindow(pick[1], 0.15 + math.random() * 0.45, "lit")
				end
			end
		end
		task.wait(1)
	end
end

local function initHolidayGround()
	local terrain = workspace.Terrain
	local terrainBase = terrain:GetMaterialColor(Enum.Material.Grass)
	local saved = setmetatable({}, { __mode = "k" })
	local activeColor, activeName = nil, nil

	local function tint(part)
		if activeColor and part ~= terrain and part:IsA("BasePart") and part.Material == Enum.Material.Grass and saved[part] == nil then
			saved[part] = part.Color
			part.Color = activeColor
		end
	end

	workspace.DescendantAdded:Connect(tint)

	local function sweep(color)
		local n = 0
		for _, d in workspace:GetDescendants() do
			if activeColor ~= color then return end
			tint(d)
			n += 1
			if n % 300 == 0 then task.wait() end
		end
	end

	local function clear()
		activeColor, activeName = nil, nil
		for part, c in saved do
			if part.Parent then part.Color = c end
			saved[part] = nil
		end
		terrain:SetMaterialColor(Enum.Material.Grass, terrainBase)
	end

	while true do
		local holiday = HolidayConfigs.getActive()
		local color = holiday and holiday.GroundColor or nil
		local name = color and holiday.Name or nil
		if name ~= activeName then
			if activeName then clear() end
			if color then
				activeColor, activeName = color, name
				terrain:SetMaterialColor(Enum.Material.Grass, color)
				task.spawn(sweep, color)
			end
		end
		task.wait(60)
	end
end

local function initSky()
	local skys = Lighting:WaitForChild("Skys", 30)
	if not skys then return end
	for _, child in Lighting:GetChildren() do
		if child:IsA("Sky") then child:Destroy() end
	end

	local active, activeName = nil, nil
	while true do
		local holiday = HolidayConfigs.getActive()
		local desired = holiday and holiday.Sky or (state.IsRaining and "Rainy" or "Sunny")
		if desired ~= activeName then
			local template = skys:FindFirstChild(desired)
			if template and template:IsA("Sky") then
				local sky = template:Clone()
				sky.Name = "ActiveSky"
				sky.Parent = Lighting
				if active then active:Destroy() end
				active, activeName = sky, desired
			end
		end
		task.wait(1)
	end
end

local function initRain()
	local toggleRain = ReplicatedStorage:FindFirstChild("ToggleRain")
	local toggleSnow = ReplicatedStorage:FindFirstChild("ToggleSnow")

	while true do
		local weather = HolidayConfigs.getWeather()
		task.wait(math.random(weather.Gap[1], weather.Gap[2]))

		weather = HolidayConfigs.getWeather()
		local snow = weather.Kind == "Snow"
		if snow then
			state.IsSnowing = true
			if toggleSnow then toggleSnow:FireAllClients(true) end
		else
			state.IsRaining = true
			if toggleRain then toggleRain:FireAllClients(true) end
		end

		task.wait(math.random(weather.Duration[1], weather.Duration[2]))

		if snow then
			state.IsSnowing = false
			if toggleSnow then toggleSnow:FireAllClients(false) end
		else
			state.IsRaining = false
			if toggleRain then toggleRain:FireAllClients(false) end
		end
	end
end

local function initBuilding()
	local RUMBLE_TIME = 0.8
	local COLLAPSE_TIME = 2.6
	local RESPAWN_DELAY = 60
	local DEBRIS_CHUNKS = 9

	local touchingParts = {}
	local hitboxOwners = {}
	local destroyed = {}
	local buildingRefs = {}
	local beamLoops, blastLoops = {}, {}

	local DAMAGE_KEYWORDS = { "hitbox", "beam", "blast", "firebomb" }

	local function isValidDamager(name)
		name = name:lower()
		for _, k in DAMAGE_KEYWORDS do
			if name:find(k, 1, true) then return true end
		end
		return false
	end

	local function isHitPart(part)
		local cur = part.Parent
		while cur and cur ~= game do
			local n = cur.Name:lower()
			if n == "hitparts" or n == "hitparts2" then return true end
			cur = cur.Parent
		end
		return false
	end

	local function getPlayerFromHitbox(hit)
		local cur = hit.Parent
		while cur do
			if cur:FindFirstChildOfClass("Humanoid") then
				return Players:GetPlayerFromCharacter(cur)
			end
			cur = cur.Parent
		end
		local attacker = hit:GetAttribute("Attacker")
		if not attacker then
			local dps = hit:FindFirstChild("DPS")
			attacker = dps and dps:GetAttribute("Attacker")
		end
		return attacker and Players:FindFirstChild(attacker) or nil
	end

	local function playHitSound(base)
		local template = script:FindFirstChild("HitSound")
		if template and base and base.Parent then
			local s = template:Clone()
			s.Parent = base
			s:Play()
			Debris:AddItem(s, 5)
		end
	end

	local function reward(player, cells, damage)
		if not player then return end
		local ls = player:FindFirstChild("leaderstats")
		local gcells = ls and (ls:FindFirstChild("GCells") or ls:FindFirstChild("gcells"))
		if gcells and gcells:IsA("IntValue") then
			if _G.GCellGuardAllow then _G.GCellGuardAllow(gcells, 3) end
			gcells.Value += cells
		end
		local char = player.Character
		local xp = char and char:FindFirstChild("AddXP")
		local xpAmount = 0
		if xp and xp:IsA("BindableEvent") then
			xpAmount = math.random(1, 3)
			xp:Fire(xpAmount)
		end
		if _G.ShowIndicator then _G.ShowIndicator(player, damage or 0, cells, xpAmount) end
	end

	local function liveRefs()
		return coroutine.wrap(function()
			for building, refs in buildingRefs do
				if not destroyed[building] and refs.base and refs.base.Parent then
					coroutine.yield(building, refs)
				end
			end
		end)
	end

	local function startBlastCheck(blast)
		if blastLoops[blast] then return end
		blastLoops[blast] = true
		task.spawn(function()
			while blast.Parent and blast:GetAttribute("BlastActive") do
				local pos, r = blast.Position, maxAxis(blast)
				for _, refs in liveRefs() do
					if (pos - refs.pos).Magnitude <= r + refs.radius then
						playHitSound(refs.base)
						refs.HP.Value = 0
						refs.onDestroyed()
					end
				end
				task.wait(0.15)
			end
			blastLoops[blast] = nil
		end)
	end

	local function trackBlast(part)
		if part:GetAttribute("BlastTrackingSetup") then return end
		part:SetAttribute("BlastTrackingSetup", true)
		if part:GetAttribute("BlastActive") then startBlastCheck(part) end
		local conn = part:GetAttributeChangedSignal("BlastActive"):Connect(function()
			if part:GetAttribute("BlastActive") then startBlastCheck(part) end
		end)
		part.AncestryChanged:Connect(function(_, p)
			if not p then conn:Disconnect() end
		end)
	end

	local function startBeamCheck(hitbox)
		if beamLoops[hitbox] then return end
		beamLoops[hitbox] = true
		task.spawn(function()
			while hitbox.Parent do
				local pos, r = hitbox.Position, maxAxis(hitbox)
				for building, refs in liveRefs() do
					local set = touchingParts[building]
					if set then
						if (pos - refs.pos).Magnitude <= r + refs.radius then
							if not set[hitbox] then
								set[hitbox] = true
								playHitSound(refs.base)
								refs.startDamageLoop()
							end
						else
							set[hitbox] = nil
						end
					end
				end
				task.wait(0.15)
			end
			beamLoops[hitbox] = nil
		end)
	end

	local function setupBuilding(building)
		if not building.Name:lower():find("building") or buildingRefs[building] then return end

		local leftovers = {}
		for _, c in building:GetChildren() do
			if c:IsA("BasePart") and c.Name:lower():find("leftover") then
				table.insert(leftovers, c)
			end
		end
		local base = building:FindFirstChild("BuildingBase")
		local stats = building:FindFirstChild("Stats")
		local HP = stats and stats:FindFirstChild("HP")
		if #leftovers == 0 or not base or not HP then return end

		for _, l in leftovers do
			l.CanCollide, l.Transparency, l.Anchored = false, 1, true
		end
		for _, name in { "Fire", "Smoke" } do
			local e = base:FindFirstChild(name)
			if e and e:IsA("ParticleEmitter") then
				e.Enabled = false
				e.Parent = leftovers[1]
			end
		end

		local parts, original, origCFs = {}, {}, {}
		local minY = math.huge
		for _, d in building:GetDescendants() do
			if d:IsA("BasePart") and not d.Name:lower():find("leftover") then
				table.insert(parts, d)
				table.insert(origCFs, d.CFrame)
				original[d] = { Material = d.Material, Color = d.Color, CanCollide = d.CanCollide }
				minY = math.min(minY, d.Position.Y - d.Size.Y / 2)
				if d.Name:lower():find("window", 1, true) and not savedWindowState[d] then
					savedWindowState[d] = { Material = d.Material, Color = d.Color }
				end
			end
		end

		local basePos = base.Position
		local pivot = Vector3.new(basePos.X, minY, basePos.Z)
		local footW, footD = base.Size.X, base.Size.Z
		local shakeScale = math.clamp(maxAxis(base) / 25, 0.4, 2.5)
		local dustScale = math.clamp(math.max(footW, footD) / 8, 3, 14)

		local pose = { sink = 0, tx = 0, tz = 0 }
		local anim, jolt = nil, nil
		local rendering = false
		local seed = math.random() * 1000
		local cframes = table.create(#parts)

		local function apply(sx, sy, sz, rx, rz)
			local rot = CFrame.Angles(pose.tx + rx, 0, pose.tz + rz)
			local offset = CFrame.new(sx, sy - pose.sink, sz) * CFrame.new(pivot) * rot * CFrame.new(-pivot)
			for i = 1, #parts do cframes[i] = offset * origCFs[i] end
			pcall(workspace.BulkMoveTo, workspace, parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end

		local function render()
			if rendering then return end
			rendering = true
			task.spawn(function()
				while base.Parent do
					local now = os.clock()
					local amp = 0
					if anim then
						local p = math.clamp((now - anim.t0) / anim.dur, 0, 1)
						local e = anim.ease(p)
						local te = anim.tiltEase(p)
						pose.sink = lerp(anim.from.sink, anim.to.sink, e)
						pose.tx = lerp(anim.from.tx, anim.to.tx, te)
						pose.tz = lerp(anim.from.tz, anim.to.tz, te)
						amp = anim.amp * math.sin(math.pi * p ^ 0.6)
						if p >= 1 then anim = nil end
					end
					if jolt then
						local jp = (now - jolt.t0) / jolt.dur
						if jp >= 1 then
							jolt = nil
						else
							amp += jolt.amp * (1 - jp) ^ 2
						end
					end
					local sx, sy, sz, rx, rz = 0, 0, 0, 0, 0
					if amp > 0.001 then
						local t = now * 24
						local ts = amp * shakeScale
						sx = math.noise(t, seed, 0.5) * 2 * ts
						sy = math.noise(t, seed, 10.5) * ts
						sz = math.noise(t, seed, 20.5) * 2 * ts
						rx = math.noise(t, seed, 30.5) * 0.012 * amp
						rz = math.noise(t, seed, 40.5) * 0.012 * amp
					end
					apply(sx, sy, sz, rx, rz)
					if not anim and not jolt then break end
					task.wait(1 / 30)
				end
				rendering = false
			end)
		end

		local function startAnim(sink, tx, tz, dur, amp, ease, tiltEase)
			seed = math.random() * 1000
			anim = {
				from = { sink = pose.sink, tx = pose.tx, tz = pose.tz },
				to = { sink = sink, tx = tx, tz = tz },
				t0 = os.clock(), dur = dur, amp = amp,
				ease = ease, tiltEase = tiltEase or ease,
			}
			render()
		end

		local function addJolt(amp, dur)
			if jolt and jolt.amp * (1 - (os.clock() - jolt.t0) / jolt.dur) > amp then return end
			seed = math.random() * 1000
			jolt = { amp = amp, dur = dur, t0 = os.clock() }
			render()
		end

		local function dust(count, sources)
			for _ = 1, sources do
				local att = Instance.new("Attachment")
				att.Parent = workspace.Terrain
				att.WorldPosition = pivot + Vector3.new(rand(-footW / 2, footW / 2) * 0.8, 0.5, rand(-footD / 2, footD / 2) * 0.8)
				local e = Instance.new("ParticleEmitter")
				e.Texture = "rbxasset://textures/particles/smoke_main.dds"
				e.Rate = 0
				e.Lifetime = NumberRange.new(2, 4)
				e.Speed = NumberRange.new(8, 26)
				e.SpreadAngle = Vector2.new(75, 75)
				e.EmissionDirection = Enum.NormalId.Top
				e.Rotation = NumberRange.new(0, 360)
				e.RotSpeed = NumberRange.new(-40, 40)
				e.Drag = 2
				e.Acceleration = Vector3.new(0, 1.5, 0)
				e.Color = ColorSequence.new(Color3.fromRGB(155, 145, 130), Color3.fromRGB(105, 105, 105))
				e.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, dustScale * 0.4),
					NumberSequenceKeypoint.new(1, dustScale * 1.6),
				})
				e.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5),
					NumberSequenceKeypoint.new(0.6, 0.75),
					NumberSequenceKeypoint.new(1, 1),
				})
				e.Parent = att
				e:Emit(count)
				Debris:AddItem(att, 7)
			end
		end

		local function throwChunks(count)
			for _ = 1, count do
				local chunk = Instance.new("Part")
				chunk.Name = "CollapseChunk"
				chunk.Size = Vector3.new(rand(0.8, 2.8), rand(0.8, 2.8), rand(0.8, 2.8))
				chunk.Material = Enum.Material.CorrodedMetal
				chunk.Transparency = 0
				chunk.Color = base.Color
				chunk.CanTouch = false
				chunk.CanQuery = false
				if debrisReady then chunk.CollisionGroup = DEBRIS_GROUP end
				chunk.CFrame = CFrame.new(pivot + Vector3.new(rand(-footW / 2, footW / 2), rand(2, 15), rand(-footD / 2, footD / 2)))
					* CFrame.Angles(rand(0, 6), rand(0, 6), rand(0, 6))
				chunk.Parent = workspace
				chunk.AssemblyLinearVelocity = Vector3.new(rand(-1, 1), rand(0.4, 1.2), rand(-1, 1)).Unit * rand(18, 45)
				chunk.AssemblyAngularVelocity = Vector3.new(rand(-8, 8), rand(-8, 8), rand(-8, 8))
				local life = rand(2, 2.8)
				task.delay(life - 1, function()
					if chunk.Parent then TweenService:Create(chunk, TweenInfo.new(1), { Transparency = 1 }):Play() end
				end)
				Debris:AddItem(chunk, life)
			end
		end

		local function setLeftoverEffects(on)
			for _, l in leftovers do
				for _, d in l:GetDescendants() do
					if d:IsA("ParticleEmitter") then d.Enabled = on end
				end
			end
		end

		local halfTriggered = false
		local lastFlicker = 0
		HP.Value = 100
		touchingParts[building] = {}

		local function respawn()
			if not base.Parent then return end
			anim, jolt = nil, nil
			pose.sink, pose.tx, pose.tz = 0, 0, 0
			apply(0, 0, 0, 0, 0)
			HP.Value = 100
			halfTriggered = false
			for _, l in leftovers do l.Transparency, l.CanCollide = 1, false end
			setLeftoverEffects(false)
			local sound = base:FindFirstChildOfClass("Sound")
			if sound then sound:Stop() end
			for _, p in parts do
				local o = original[p]
				p.Material, p.Color, p.CanCollide = o.Material, o.Color, o.CanCollide
			end
			destroyed[building] = nil
			if windowApi.resetBuilding then windowApi.resetBuilding(building) end
		end

		local function onDestroyed()
			if destroyed[building] then return end
			destroyed[building] = true

			for _, p in parts do p.Material, p.CanCollide = Enum.Material.CorrodedMetal, false end
			local sound = base:FindFirstChildOfClass("Sound")
			if sound then sound:Play() end

			startAnim(pose.sink, pose.tx, pose.tz, RUMBLE_TIME, 2.6, easeLinear)
			dust(20, 2)
			if windowApi.flickerBuilding then
				windowApi.flickerBuilding(building, RUMBLE_TIME + COLLAPSE_TIME, true)
			end

			task.delay(RUMBLE_TIME, function()
				if not base.Parent then return end
				for _, l in leftovers do l.Transparency, l.CanCollide = 0, false end
				setLeftoverEffects(true)

				local ang = math.rad(rand(10, 22))
				local dir = math.random() * math.pi * 2
				startAnim(base.Size.Y, ang * math.cos(dir), ang * math.sin(dir), COLLAPSE_TIME, 3.4, easeCollapse, easeTilt)
				dust(35, 4)
				task.spawn(function()
					local t0 = os.clock()
					while base.Parent and os.clock() - t0 < COLLAPSE_TIME do
						throwChunks(1)
						task.wait(COLLAPSE_TIME / DEBRIS_CHUNKS)
					end
				end)

				task.delay(COLLAPSE_TIME, function()
					if not base.Parent then return end
					dust(80, 5)
					addJolt(5, 0.9)
					task.delay(RESPAWN_DELAY, respawn)
				end)
			end)
		end

		local function halfCollapse()
			halfTriggered = true
			for _, p in parts do p.Material = Enum.Material.CorrodedMetal end
			local ang = math.rad(rand(3, 8))
			local dir = math.random() * math.pi * 2
			startAnim(base.Size.Y * rand(0.25, 0.75), ang * math.cos(dir), ang * math.sin(dir), 1.6, 1.8, easeInOut)
			dust(25, 2)
		end

		local function applyDamage(amount, rewardsByPlayer)
			if HP.Value <= 0 or destroyed[building] then return false end
			HP.Value -= amount
			if HP.Value <= 50 and not halfTriggered then halfCollapse() end
			addJolt(1 + (100 - math.max(HP.Value, 0)) / 60, 0.45)
			dust(6, 1)
			if windowApi.flickerBuilding and os.clock() - lastFlicker > 0.35 then
				lastFlicker = os.clock()
				windowApi.flickerBuilding(building, 0.45, false)
			end
			playHitSound(base)
			for player, cells in rewardsByPlayer do reward(player, cells, amount) end
			if HP.Value <= 0 then
				HP.Value = 0
				onDestroyed()
			end
			return true
		end

		local damaging = false
		local function startDamageLoop()
			if damaging then return end
			damaging = true
			task.spawn(function()
				while true do
					local set = touchingParts[building]
					if not set or HP.Value <= 0 or destroyed[building] then break end

					local rewards, any = {}, false
					for hit in set do
						if not hit.Parent then
							set[hit] = nil
							hitboxOwners[hit] = nil
						else
							any = true
							local owner = hitboxOwners[hit]
							if owner then rewards[owner] = (rewards[owner] or 0) + 1 end
						end
					end
					if not any then break end

					applyDamage(20, rewards)
					task.wait(0.5)
				end
				damaging = false
			end)
		end

		buildingRefs[building] = {
			base = base, HP = HP,
			pos = base.Position, radius = maxAxis(base),
			startDamageLoop = startDamageLoop,
			onDestroyed = onDestroyed,
			damageBuilding = function(attacker)
				applyDamage(20, attacker and { [attacker] = 3 } or {})
			end,
		}

		base.Touched:Connect(function(hit)
			if not (isValidDamager(hit.Name) or isHitPart(hit)) then return end
			local player = getPlayerFromHitbox(hit)
			if player then hitboxOwners[hit] = player end

			if hit.Name:lower():find("blast") then
				playHitSound(base)
				HP.Value = 0
				onDestroyed()
				return
			end
			local set = touchingParts[building]
			if set then
				set[hit] = true
				playHitSound(base)
				startDamageLoop()
			end
		end)

		base.TouchEnded:Connect(function(hit)
			if isHitPart(hit) then return end
			local set = touchingParts[building]
			if set then set[hit] = nil end
			hitboxOwners[hit] = nil
		end)

		building.AncestryChanged:Connect(function(_, parent)
			if not parent then
				touchingParts[building] = nil
				buildingRefs[building] = nil
				destroyed[building] = nil
			end
		end)
	end

	local Map = workspace:WaitForChild("Map")
	for _, b in Map:GetChildren() do
		if b:IsA("Model") then
			setupBuilding(b)
			task.wait()
		end
	end
	Map.DescendantAdded:Connect(function(d)
		if d:IsA("Model") and d.Name:lower():find("building") then
			task.wait(0.1)
			setupBuilding(d)
		end
	end)

	workspace.DescendantAdded:Connect(function(d)
		if not d:IsA("BasePart") or not isValidDamager(d.Name) then return end
		task.defer(function()
			if not d.Parent then return end
			local lname = d.Name:lower()
			local isBlast = lname:find("blast") ~= nil

			local player = getPlayerFromHitbox(d)
			if player then hitboxOwners[d] = player end

			local pos, r = d.Position, maxAxis(d)
			for building, refs in liveRefs() do
				if (pos - refs.pos).Magnitude <= r + refs.radius then
					if isBlast then
						playHitSound(refs.base)
						refs.HP.Value = 0
						refs.onDestroyed()
					elseif touchingParts[building] then
						touchingParts[building][d] = true
						refs.startDamageLoop()
					end
				end
			end

			if isBlast then
				trackBlast(d)
			elseif lname:find("beam") or lname:find("hitbox") then
				startBeamCheck(d)
			end

			d.AncestryChanged:Connect(function(_, parent)
				if parent then return end
				for building in buildingRefs do
					local set = touchingParts[building]
					if set then set[d] = nil end
				end
				hitboxOwners[d] = nil
			end)
		end)
	end)

	local function scanCharacter(char)
		for _, d in char:GetDescendants() do
			if d:IsA("BasePart") and d.Name:lower():find("blast") then trackBlast(d) end
		end
	end
	local function hookPlayer(player)
		player.CharacterAdded:Connect(function(char)
			task.wait(0.5)
			scanCharacter(char)
		end)
		if player.Character then scanCharacter(player.Character) end
	end
	Players.PlayerAdded:Connect(hookPlayer)
	for _, p in Players:GetPlayers() do hookPlayer(p) end

	_G.DamageBuildingsInRadius = function(position, radius, attacker)
		for _, refs in liveRefs() do
			if (position - refs.pos).Magnitude <= radius + refs.radius then
				refs.damageBuilding(attacker)
			end
		end
	end
end

local function initCollisions()
	local INVISIBLE_THRESHOLD = 0.9

	local function fixPart(part)
		if part:IsA("BasePart") and part.CanCollide and part.Transparency >= INVISIBLE_THRESHOLD then
			part.CanCollide = false
		end
	end

	local function fixTree(root)
		fixPart(root)
		for _, d in root:GetDescendants() do fixPart(d) end
	end

	fixTree(workspace)

	workspace.DescendantAdded:Connect(function(d)
		task.defer(fixPart, d)
	end)

	while true do
		task.wait(30)
		local n = 0
		for _, d in workspace:GetDescendants() do
			fixPart(d)
			n += 1
			if n % 2000 == 0 then task.wait() end
		end
	end
end

function World.Init()
	if initialized then return end
	initialized = true
	task.spawn(initDayNight)
	task.spawn(initWindowLights)
	task.spawn(initRain)
	task.spawn(initBuilding)
	task.spawn(initCollisions)
	initDebrisCollision()
	task.spawn(initHolidayGround)
	task.spawn(initSky)
end

function World.IsRaining()
	return state.IsRaining
end

return World]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX10">
			<Properties>
				<string name="Name">ReplicatedStorage</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX11">
				<Properties>
					<string name="Name">BeamSystem</string>
					<ProtectedString name="Source"><![CDATA[local BeamSystem = {}
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")
local playerAims = {}
local playerShiftLock = {}
local activeBeams = {}
local beamGenerations = {}
local beamGenerationCounter = 0
local beamStartedSignal = nil
local beamEndedSignal = nil
local INTRO_TIME = 0.4
local OUTRO_TIME = 0.35
local AIM_FOLLOW_RATE = 22
local CLASH_FOLLOW_RATE = 6
local CLASH_TRANSITION_TIME = 0.7
local OVERPOWER_TIME = 0.8
local OVERPOWER_DAMAGE = 50
local BEAM_SLOW_FACTOR = 0.7
local BEAM_SLOW_LINGER = 0.35
local function easeOutCubic(t)
	return 1 - (1 - t) ^ 3
end
local function easeInOutQuad(t)
	if t < 0.5 then return 2 * t * t end
	return 1 - (-2 * t + 2) ^ 2 / 2
end
local function scaleSequence(seq, k)
	local points = {}
	for _, kp in ipairs(seq.Keypoints) do
		table.insert(points, NumberSequenceKeypoint.new(kp.Time, kp.Value * k, kp.Envelope * k))
	end
	return NumberSequence.new(points)
end
local function collectTemplateEmitters(beamEnds)
	local list = {}
	for _, beamEnd in ipairs(beamEnds) do
		for _, child in ipairs(beamEnd:GetChildren()) do
			if child:IsA("ParticleEmitter") and #list < 4 then
				table.insert(list, child)
			end
		end
	end
	return list
end
local function makeFallbackEmitter(color)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0)})
	emitter.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
	return emitter
end
local function makeFxEmitter(source, kind, power)
	power = power or 1
	local emitter = source:Clone() or makeFallbackEmitter(Color3.new(1, 1, 1))
	for _, child in ipairs(emitter:GetChildren()) do child:Destroy() end
	emitter.Enabled = false
	emitter.Rate = 0
	emitter.Acceleration = Vector3.new(0, 0, 0)
	emitter.VelocityInheritance = 0
	emitter.RotSpeed = NumberRange.new(0, 0)
	emitter.Rotation = NumberRange.new(0, 0)
	emitter.LockedToPart = false
	if kind == "ring" then
		emitter.Shape = Enum.ParticleEmitterShape.Disc
		emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		emitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.SpreadAngle = Vector2.new(0, 0)
		emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
		emitter.Speed = NumberRange.new(32 * power, 48 * power)
		emitter.Lifetime = NumberRange.new(0.4, 0.65)
		emitter.Drag = 0
		emitter.Size = scaleSequence(source.Size, 1.4 * power)
	else
		emitter.Shape = Enum.ParticleEmitterShape.Sphere
		emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
		emitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Orientation = Enum.ParticleOrientation.FacingCamera
		emitter.Speed = NumberRange.new(5 * power, 12 * power)
		emitter.Lifetime = NumberRange.new(0.25, 0.45)
		emitter.Drag = 2
		emitter.Size = scaleSequence(source.Size, 2.2 * power)
	end
	return emitter
end
local function restoreBeamTextures(list)
	if not list then return end
	for _, entry in ipairs(list) do
		if entry.beam and entry.beam.Parent then
			pcall(function() entry.beam.TextureSpeed = entry.base end)
		end
	end
end
local function spawnClashExplosion(position, sourcesA, sourcesB, colorA, colorB)
	local folder = Instance.new("Folder")
	folder.Name = "BeamClashExplosion"
	folder.Parent = Workspace
	Debris:AddItem(folder, 3)
	local anchor = Instance.new("Part")
	anchor.Name = "ExplosionAnchor"
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = folder
	local ringAtts = {}
	for _, rot in ipairs({CFrame.new(), CFrame.Angles(0, 0, math.pi / 2), CFrame.Angles(math.pi / 2, 0, 0)}) do
		local att = Instance.new("Attachment")
		att.CFrame = rot
		att.Parent = anchor
		table.insert(ringAtts, att)
	end
	local sources = {}
	for i = 1, math.min(#sourcesA, 3) do table.insert(sources, sourcesA[i]) end
	for i = 1, math.min(#sourcesB, 3) do table.insert(sources, sourcesB[i]) end
	if #sources == 0 then
		table.insert(sources, makeFallbackEmitter(colorA))
		table.insert(sources, makeFallbackEmitter(colorB))
	end
	local bursts = {}
	for _, source in ipairs(sources) do
		for _, att in ipairs(ringAtts) do
			local ring = makeFxEmitter(source, "ring", 1.6)
			ring.Lifetime = NumberRange.new(0.5, 0.9)
			ring.Parent = att
			table.insert(bursts, {emitter = ring, rate = 260})
		end
		local core = makeFxEmitter(source, "core", 2.4)
		core.Parent = anchor
		table.insert(bursts, {emitter = core, rate = 140})
	end
	local light = Instance.new("PointLight")
	light.Color = colorA:Lerp(colorB, 0.5)
	light.Range = 45
	light.Brightness = 6
	light.Parent = anchor
	for _, burst in ipairs(bursts) do
		burst.emitter.Rate = burst.rate
		burst.emitter.Enabled = true
	end
	TweenService:Create(light, TweenInfo.new(0.7), {Brightness = 0}):Play()
	task.delay(0.14, function()
		for _, burst in ipairs(bursts) do
			if burst.emitter.Parent then
				burst.emitter.Enabled = false
			end
		end
	end)
end
local slowedHumanoids = {}
local slowConnection = nil
local function releaseBeamSlow(humanoid)
	local data = slowedHumanoids[humanoid]
	if not data then return end
	slowedHumanoids[humanoid] = nil
	if humanoid.Parent then
		humanoid:SetAttribute("BeamSlowFactor", nil)
		if humanoid.WalkSpeed == data.applied then
			humanoid.WalkSpeed = data.base
		elseif humanoid:GetAttribute("Slowed") then
			humanoid.WalkSpeed = humanoid.WalkSpeed / data.factor
		end
	end
end
local function ensureSlowLoop()
	if slowConnection then return end
	slowConnection = game:GetService("RunService").Heartbeat:Connect(function()
		local now = os.clock()
		local any = false
		for humanoid, data in pairs(slowedHumanoids) do
			if not humanoid.Parent or humanoid.Health <= 0 or now >= data.expires then
				releaseBeamSlow(humanoid)
			else
				any = true
			end
		end
		if not any and slowConnection then
			slowConnection:Disconnect()
			slowConnection = nil
		end
	end)
end
function BeamSystem.ApplyBeamSlow(humanoid)
	if not humanoid or not humanoid.Parent then return end
	local data = slowedHumanoids[humanoid]
	if data then
		data.expires = os.clock() + BEAM_SLOW_LINGER
		return
	end
	local base = humanoid.WalkSpeed
	local applied = base * BEAM_SLOW_FACTOR
	slowedHumanoids[humanoid] = {base = base, applied = applied, factor = BEAM_SLOW_FACTOR, expires = os.clock() + BEAM_SLOW_LINGER}
	humanoid:SetAttribute("BeamSlowFactor", BEAM_SLOW_FACTOR)
	humanoid.WalkSpeed = applied
	ensureSlowLoop()
end
function BeamSystem.SetComm(comm)
	beamStartedSignal = comm.BeamStarted
	beamEndedSignal = comm.BeamEnded
end
Players.PlayerRemoving:Connect(function(player)
	if activeBeams[player] then
		pcall(BeamSystem.ForceCleanup, player)
	end
	activeBeams[player] = nil
	beamGenerations[player] = nil
	playerAims[player] = nil
	playerShiftLock[player] = nil
end)
local function cleanupStaleBeam(player)
	local gen = beamGenerations[player]
	activeBeams[player] = nil
	beamGenerations[player] = nil
	playerAims[player] = nil
	playerShiftLock[player] = nil
	if beamEndedSignal and player.Parent then
		beamEndedSignal:Fire(player, gen)
	end
end
local function findBeamAttachments(morphModel)
	local beamStarts = {}
	local beamEnds = {}
	for _, descendant in ipairs(morphModel:GetDescendants()) do
		if descendant:IsA("Attachment") then
			if descendant.Name == "BeamStart" then
				table.insert(beamStarts, descendant)
			elseif descendant.Name == "BeamEnd" then
				table.insert(beamEnds, descendant)
			end
		end
	end
	return beamStarts, beamEnds
end
local function enableBeams(beamStarts, enabled, beamNameFilter)
	for _, beamStart in ipairs(beamStarts) do
		for _, child in ipairs(beamStart:GetChildren()) do
			if child:IsA("Beam") then
				if beamNameFilter and not beamNameFilter[child.Name] then
				else
					if enabled then
						child.Transparency = NumberSequence.new(0.2)
					end
					child.Enabled = enabled
				end
			elseif child:IsA("Light") then
				child.Enabled = enabled
			end
		end
	end
end
local function enableParticles(beamEnds, enabled)
	for _, beamEnd in ipairs(beamEnds) do
		for _, child in ipairs(beamEnd:GetChildren()) do
			if child:IsA("ParticleEmitter") then
				child.Enabled = enabled
				if not enabled then
					child:Clear()
				end
			elseif child:IsA("Light") then
				child.Enabled = enabled
			end
		end
	end
end
function BeamSystem.ForceCleanup(player)
	local data = activeBeams[player]
	if not data then return end
	if data.beamEndOriginals then
		for beamEnd, original in pairs(data.beamEndOriginals) do
			if beamEnd and beamEnd.Parent then
				for _, child in ipairs(beamEnd:GetChildren()) do
					if child:IsA("ParticleEmitter") then
						child.Enabled = false
						child:Clear()
					elseif child:IsA("Light") then
						child.Enabled = false
					end
				end
				if original.parent and original.parent.Parent then
					beamEnd.CFrame = original.cframe
					beamEnd.Parent = original.parent
				else
					beamEnd.Parent = nil
				end
				beamEnd:SetAttribute("BeamEndOffset", nil)
			end
		end
	end
	restoreBeamTextures(data.beamTextureBases)
	if data.impactFolder and data.impactFolder.Parent then
		pcall(function() data.impactFolder:Destroy() end)
	end
	if data.hitbox and data.hitbox.Parent then
		pcall(function() data.hitbox:Destroy() end)
	end
	if data.sideHitboxes then
		for _, side in ipairs(data.sideHitboxes) do
			if side.hitbox and side.hitbox.Parent then
				pcall(function() side.hitbox:Destroy() end)
			end
		end
	end
	if data.character and data.character.Parent then
		local beamStarts, beamEnds = findBeamAttachments(data.character)
		pcall(function()
			if #beamStarts > 0 then enableBeams(beamStarts, false, nil) end
			if #beamEnds > 0 then enableParticles(beamEnds, false) end
		end)
	end
	cleanupStaleBeam(player)
end
local function createDPSScript(hitbox, player, character, duration)
	local dpsTemplate = ReplicatedStorage:FindFirstChild("DPSTemplate")
	if not dpsTemplate then
		warn("[BeamSystem] DPSTemplate not found in ReplicatedStorage!")
		return nil
	end
	local dpsScript = dpsTemplate:Clone()
	dpsScript.Name = "DPS"
	dpsScript.Enabled = false
	dpsScript:SetAttribute("Attacker", player.Name)
	dpsScript:SetAttribute("BeamDuration", duration)
	local beamDamage = 0
	local stats = character and character:FindFirstChild("Stats")
	if stats then
		local dmg2 = stats:FindFirstChild("DMG2")
		if dmg2 then
			beamDamage = dmg2.Value
		end
	end
	dpsScript:SetAttribute("BeamDamage", beamDamage)
	dpsScript.Parent = hitbox
	return dpsScript
end
local function evalColorSequence(seq, t)
	local keypoints = seq.Keypoints
	if not keypoints or #keypoints == 0 then return Color3.new(1, 1, 1) end
	if t <= keypoints[1].Time then return keypoints[1].Value end
	if t >= keypoints[#keypoints].Time then return keypoints[#keypoints].Value end
	for i = 1, #keypoints - 1 do
		local kp0 = keypoints[i]
		local kp1 = keypoints[i + 1]
		if t >= kp0.Time and t <= kp1.Time then
			local alpha = (t - kp0.Time) / (kp1.Time - kp0.Time)
			return kp0.Value:Lerp(kp1.Value, alpha)
		end
	end
	return keypoints[#keypoints].Value
end
local function getHeadPosition(character)
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head.Position
	end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	return hrp and hrp.Position or nil
end
function BeamSystem.ActivateBeam(config)
	local character = config.character
	local player = config.player
	local initialTargetPosition = config.initialTargetPosition
	local duration = config.duration or 6
	local beamNames = config.beamNames
	local beamNameFilter = nil
	if beamNames then
		beamNameFilter = {}
		for _, name in ipairs(beamNames) do
			beamNameFilter[name] = true
		end
	end
	if not character or not player then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	if activeBeams[player] then
		local prevData = activeBeams[player]
		local prevChar = prevData and prevData.character
		local prevHum = prevChar and prevChar:FindFirstChildOfClass("Humanoid")
		if prevChar and prevChar.Parent and prevChar:FindFirstChild("HumanoidRootPart")
			and (not prevHum or prevHum.Health > 0) then
			return
		end
		cleanupStaleBeam(player)
	end
	beamGenerationCounter = beamGenerationCounter + 1
	local myGeneration = beamGenerationCounter
	beamGenerations[player] = myGeneration
	activeBeams[player] = {character = character, hitbox = nil, dpsScript = nil, player = player, clashRequestedBy = nil, sideHitboxes = {}}
	character.AncestryChanged:Connect(function(_, parent)
		if not parent and activeBeams[player] and activeBeams[player].character == character then
			BeamSystem.ForceCleanup(player)
		end
	end)


	task.spawn(function()
		task.wait(duration + 2)
		if activeBeams[player] and activeBeams[player].character == character then
			BeamSystem.ForceCleanup(player)
		end
	end)	local beamStarts, beamEnds = findBeamAttachments(character)
	local primaryBeamStart = beamStarts[1]
	local hitbox = Instance.new("Part")
	hitbox.Name = "BeamHitbox"
	hitbox.Size = Vector3.new(6, 6, 6)
	hitbox.Anchored = true
	hitbox.CanCollide = false
	hitbox.CanTouch = false
	hitbox.CanQuery = false
	hitbox.Transparency = 1
	hitbox.Material = Enum.Material.Neon
	hitbox.Color = Color3.fromRGB(255, 255, 255)
	hitbox:SetAttribute("Attacker", player.Name)
	hitbox:SetAttribute("BeamMain", true)
	hitbox.Parent = Workspace
	local dpsScript = createDPSScript(hitbox, player, character, duration)
	activeBeams[player].hitbox = hitbox
	activeBeams[player].dpsScript = dpsScript
	local beamHitDebounce = {}
	local beamEndOriginals = {}
	local beamEndSpacing = 8
	local beamEndCleanupTemplate = ServerStorage:FindFirstChild("BeamEndCleanup")
	for _, beamEnd in ipairs(beamEnds) do
		local originalParent = beamEnd.Parent
		beamEndOriginals[beamEnd] = {
			parent = originalParent,
			cframe = beamEnd.CFrame
		}
		local origParentOV = Instance.new("ObjectValue")
		origParentOV.Name = "BeamOriginalParent"
		origParentOV.Value = originalParent
		origParentOV.Parent = beamEnd
		beamEnd:SetAttribute("BeamDuration", duration)
		if beamEndCleanupTemplate then
			local cleanupClone = beamEndCleanupTemplate:Clone()
			cleanupClone.Parent = beamEnd
		end
		beamEnd.Parent = hitbox
		local offset = Vector3.new(0, 0, 0)
		if originalParent then
			local parentName = originalParent.Name
			if parentName == "LHead" then
				offset = Vector3.new(-beamEndSpacing, 0, 0)
			elseif parentName == "RHead" or parentName == "RUmouth" then
				offset = Vector3.new(beamEndSpacing, 0, 0)
			end
		end
		beamEnd:SetAttribute("BeamEndOffset", offset)
		beamEnd.CFrame = CFrame.new(offset)
	end
	activeBeams[player].beamEndOriginals = beamEndOriginals
	local sideHitboxes = {}
	local NUM_SIDE_HITBOXES = 5
	for _, beamEnd in ipairs(beamEnds) do
		local offset = beamEnd:GetAttribute("BeamEndOffset")
		if offset and offset ~= Vector3.new(0, 0, 0) then
			for i = 1, NUM_SIDE_HITBOXES do
				local t = i / NUM_SIDE_HITBOXES
				local sideHitbox = Instance.new("Part")
				sideHitbox.Name = "BeamHitbox"
				sideHitbox.Size = Vector3.new(6, 6, 6)
				sideHitbox.Anchored = true
				sideHitbox.CanCollide = false
				sideHitbox.CanTouch = false
				sideHitbox.CanQuery = false
				sideHitbox.Transparency = 1
				sideHitbox.Material = Enum.Material.Neon
				sideHitbox.Color = Color3.fromRGB(255, 255, 255)
				sideHitbox:SetAttribute("Attacker", player.Name)
				sideHitbox.Parent = Workspace
				local sideDps = nil 
				table.insert(sideHitboxes, {hitbox = sideHitbox, dps = sideDps, offset = offset, t = t})
			end
		end
	end
	activeBeams[player].sideHitboxes = sideHitboxes
	local glowAttachments = {}
	local NUM_GLOW_LIGHTS = 6
	local success, err = pcall(function()
		if #beamStarts > 0 then
			enableBeams(beamStarts, true, beamNameFilter)
		end
		if #beamEnds > 0 then
			enableParticles(beamEnds, true)
		end
		local beamColorSeq = nil
		for _, beamStart in ipairs(beamStarts) do
			for _, child in ipairs(beamStart:GetChildren()) do
				if child:IsA("Beam") and child.Color then
					if not beamNameFilter or beamNameFilter[child.Name] then
						beamColorSeq = child.Color
						break
					end
				end
			end
			if beamColorSeq then break end
		end
		local fallbackColor = Color3.fromRGB(255, 255, 255)
		if beamColorSeq and #beamColorSeq.Keypoints > 0 then
			fallbackColor = beamColorSeq.Keypoints[1].Value
		end
		if primaryBeamStart then
			for i = 1, NUM_GLOW_LIGHTS do
				local att = Instance.new("Attachment")
				att.Name = "BeamGlowLight" .. i
				att.Parent = hrp
				local light = Instance.new("PointLight")
				light.Name = "GlowLight"
				if beamColorSeq then
					local t = i / (NUM_GLOW_LIGHTS + 1)
					light.Color = evalColorSequence(beamColorSeq, t)
				else
					light.Color = fallbackColor
				end
				light.Range = 32
			light.Brightness = 0.3
				light.Enabled = true
				light.Parent = att
				table.insert(glowAttachments, att)
			end
		end
		if beamStartedSignal then
			beamStartedSignal:Fire(player, myGeneration)
		end
		local currentTarget = initialTargetPosition
		if not currentTarget then
			currentTarget = primaryBeamStart.WorldPosition + primaryBeamStart.WorldCFrame.LookVector * 1000
		end
		playerAims[player] = currentTarget
		local beamIteration = 0
		local function orientHitbox(charPos, targetPos, placePos)
			placePos = placePos or targetPos
			local flatDir = Vector3.new(targetPos.X - charPos.X, 0, targetPos.Z - charPos.Z)
			if flatDir.Magnitude < 0.01 then
				return CFrame.new(placePos)
			end
			local lookCF = CFrame.lookAt(Vector3.new(charPos.X, 0, charPos.Z), Vector3.new(targetPos.X, 0, targetPos.Z))
			local rotation = lookCF - lookCF.Position
			return CFrame.new(placePos) * rotation
		end
		local function positionSideHitboxes(headPos, mainHitboxCF, sides, extent)
			local rotation = mainHitboxCF - mainHitboxCF.Position
			for _, side in ipairs(sides) do
				local endSidePos = (mainHitboxCF * CFrame.new(side.offset * extent)).Position
				local pos = headPos:Lerp(endSidePos, side.t)
				side.hitbox.CFrame = CFrame.new(pos) * rotation
			end
		end
		local beamEndOffsets = {}
		for _, beamEnd in ipairs(beamEnds) do
			local offset = beamEnd:GetAttribute("BeamEndOffset")
			if offset and offset ~= Vector3.new(0, 0, 0) then
				table.insert(beamEndOffsets, {att = beamEnd, offset = offset})
			end
		end
		local impactColor = fallbackColor
		if beamColorSeq and #beamColorSeq.Keypoints > 0 then
			impactColor = evalColorSequence(beamColorSeq, 1)
		end
		local impactFolder = Instance.new("Folder")
		impactFolder.Name = "BeamImpact"
		impactFolder.Parent = Workspace
		activeBeams[player].impactFolder = impactFolder
		activeBeams[player].impactColor = impactColor
		local templateEmitters = collectTemplateEmitters(beamEnds)
		activeBeams[player].templateEmitters = templateEmitters
		local ownSources = templateEmitters
		if #ownSources == 0 then
			ownSources = {makeFallbackEmitter(impactColor)}
		end
		local beamTextures = {}
		for _, beamStart in ipairs(beamStarts) do
			for _, child in ipairs(beamStart:GetChildren()) do
				if child:IsA("Beam") and (not beamNameFilter or beamNameFilter[child.Name]) then
					table.insert(beamTextures, {beam = child, base = child.TextureSpeed})
				end
			end
		end
		activeBeams[player].beamTextureBases = beamTextures
		local texBoost = 1
		local lastEndPos = nil
		local lastTexTime = tick()
		local impactAnchor = Instance.new("Part")
		impactAnchor.Name = "ImpactAnchor"
		impactAnchor.Size = Vector3.new(1, 1, 1)
		impactAnchor.Transparency = 1
		impactAnchor.Anchored = true
		impactAnchor.CanCollide = false
		impactAnchor.CanTouch = false
		impactAnchor.CanQuery = false
		impactAnchor.Parent = impactFolder
		local impactLight = Instance.new("PointLight")
		impactLight.Color = impactColor
		impactLight.Range = 24
		impactLight.Brightness = 0
		impactLight.Parent = impactAnchor
		local fxGroup = {}
		local fxKey = nil
		local function clearFx()
			for _, entry in ipairs(fxGroup) do
				entry.emitter:Destroy()
			end
			fxGroup = {}
			fxKey = nil
		end
		local function buildFx(key, sources)
			clearFx()
			fxKey = key
			for _, source in ipairs(sources) do
				local ring = makeFxEmitter(source, "ring", 1)
				ring.Parent = impactAnchor
				table.insert(fxGroup, {emitter = ring, rate = 55})
				local core = makeFxEmitter(source, "core", 1)
				core.Parent = impactAnchor
				table.insert(fxGroup, {emitter = core, rate = 22})
			end
		end
		local function setFxIntensity(intensity)
			local enabled = intensity > 0.05
			for _, entry in ipairs(fxGroup) do
				local rate = enabled and math.floor(entry.rate * intensity + 0.5) or 0
				if entry.emitter.Rate ~= rate then entry.emitter.Rate = rate end
				if entry.emitter.Enabled ~= enabled then entry.emitter.Enabled = enabled end
			end
		end
		local impactSurfaceOffset, impactSurfaceNormal = nil, Vector3.yAxis
		local impactParams = RaycastParams.new()
		impactParams.FilterType = Enum.RaycastFilterType.Exclude
		local function updateImpact(endPos, extent, now, clashInfo)
			if clashInfo and not clashInfo.lead then
				setFxIntensity(0)
				impactLight.Brightness = 0
				return
			end
			local key = "normal"
			local sources = ownSources
			if clashInfo then
				key = "clash" .. tostring(clashInfo.partnerData)
				sources = {}
				for _, src in ipairs(ownSources) do table.insert(sources, src) end
				local partnerSources = clashInfo.partnerSources
				if partnerSources and #partnerSources > 0 then
					for _, src in ipairs(partnerSources) do table.insert(sources, src) end
				else
					table.insert(sources, makeFallbackEmitter(clashInfo.partnerColor or impactColor))
				end
			end
			if key ~= fxKey then
				buildFx(key, sources)
			end
			if clashInfo then
				local axis = clashInfo.axis or Vector3.zAxis
				impactAnchor.CFrame = CFrame.lookAt(endPos, endPos + axis) * CFrame.Angles(-math.pi / 2, 0, 0)
				local mix = (math.sin(now * 9) + 1) / 2
				impactLight.Color = impactColor:Lerp(clashInfo.partnerColor or impactColor, mix)
				impactLight.Brightness = 3 * extent
				setFxIntensity(extent * 1.4)
			else
				if beamIteration % 2 == 0 or not impactSurfaceOffset then
					local filter = {character, impactFolder, hitbox}
					for _, plr in ipairs(Players:GetPlayers()) do
						if plr.Character then table.insert(filter, plr.Character) end
					end
					impactParams.FilterDescendantsInstances = filter
					local result = Workspace:Raycast(endPos + Vector3.new(0, 4, 0), Vector3.new(0, -14, 0), impactParams)
					if result and (result.Position - endPos).Magnitude <= 7 then
						impactSurfaceOffset = result.Position + result.Normal * 0.15 - endPos
						impactSurfaceNormal = result.Normal
					else
						impactSurfaceOffset = Vector3.zero
						impactSurfaceNormal = Vector3.yAxis
					end
				end
				local impactPos = endPos + impactSurfaceOffset
				impactAnchor.CFrame = CFrame.lookAt(impactPos, impactPos + impactSurfaceNormal) * CFrame.Angles(-math.pi / 2, 0, 0)
				impactLight.Color = impactColor
				impactLight.Brightness = 1.5 * extent
				setFxIntensity(extent)
			end
		end
		local startTime = tick()
		local currentClashPartner = nil
		local function isFacing(hrp, targetPos)
			local dir = targetPos - hrp.Position
			local horizDir = Vector3.new(dir.X, 0, dir.Z)
			if horizDir.Magnitude < 1 then return true end
			local look = hrp.CFrame.LookVector
			local horizLook = Vector3.new(look.X, 0, look.Z)
			return horizLook:Dot(horizDir.Unit) > 0
		end
		local charRadiusCache = {}
		local function getCharRadius(char)
			if charRadiusCache[char] then return charRadiusCache[char] end
			local ok, result = pcall(function()
				local _, size = char:GetBoundingBox()
				return math.max(size.X, size.Y, size.Z) / 2 + 5
			end)
			local radius = (ok and result) or 20
			charRadiusCache[char] = radius
			return radius
		end
		local function hitboxNearCharacter(hb, char)
			local charHRP = char:FindFirstChild("HumanoidRootPart")
			if not charHRP then return false end
			return (hb.Position - charHRP.Position).Magnitude < getCharRadius(char)
		end
		local smoothTip = currentTarget
		local lastFrameTime = tick()
		local wasClashing = false
		local clashTransitionUntil = 0
		local extent = 0
		local overpower = nil
		local lastClashData = nil
		local function renderFrame(ext, tip, clashing, now, clashInfo)
			local myHRP = character:FindFirstChild("HumanoidRootPart")
			if not myHRP then return end
			local startPos = getHeadPosition(character) or myHRP.Position
			local endPos = startPos:Lerp(tip, ext)
			local roundedExt = math.floor(ext * 100 + 0.5) / 100
			if hitbox:GetAttribute("BeamExtent") ~= roundedExt then
				hitbox:SetAttribute("BeamExtent", roundedExt)
			end
			if beamIteration % 2 == 0 and #beamTextures > 0 then
				local texDt = math.max(now - lastTexTime, 0.016)
				if lastEndPos then
					local speed = (endPos - lastEndPos).Magnitude / texDt
					local targetBoost = 1 + math.clamp(speed / 30, 0, 5)
					texBoost = texBoost + (targetBoost - texBoost) * 0.5
					for _, tex in ipairs(beamTextures) do
						local want
						if tex.base ~= 0 then
							want = tex.base * texBoost
						else
							want = (texBoost - 1) * 2
						end
						if tex.beam.Parent and math.abs(tex.beam.TextureSpeed - want) > 0.1 then
							tex.beam.TextureSpeed = want
						end
					end
				end
				lastEndPos = endPos
				lastTexTime = now
			end
			hitbox.CFrame = orientHitbox(clashing and startPos or myHRP.Position, tip, endPos)
			positionSideHitboxes(startPos, hitbox.CFrame, sideHitboxes, ext)
			for _, be in ipairs(beamEndOffsets) do
				be.att.CFrame = CFrame.new(be.offset * ext)
			end
			if beamIteration % 2 == 0 and #glowAttachments > 0 and primaryBeamStart and primaryBeamStart.Parent then
				local beamStartPos = primaryBeamStart.WorldPosition
				for i, att in ipairs(glowAttachments) do
					local t = i / (NUM_GLOW_LIGHTS + 1)
					att.WorldPosition = beamStartPos:Lerp(endPos, t)
					local light = att:FindFirstChildOfClass("PointLight")
					if light then light.Brightness = 0.3 * ext end
				end
			end
			updateImpact(endPos, ext, now, clashInfo)
		end
		renderFrame(0, smoothTip, false, tick())
		while tick() - startTime < duration or overpower do
			beamIteration += 1
			if not character.Parent or not character:FindFirstChild("HumanoidRootPart") then
				break
			end
			local myHRP = character:FindFirstChild("HumanoidRootPart")
			local myData = activeBeams[player]
			if not overpower and myData and myData.overpowerRequest then
				local req = myData.overpowerRequest
				myData.overpowerRequest = nil
				if req.character and req.character.Parent and req.hitbox and req.hitbox.Parent then
					overpower = {loser = req, t0 = tick(), startPoint = smoothTip}
					myData.overpowering = true
					myData.overpowerDone = false
					currentClashPartner = nil
					if dpsScript then dpsScript.Enabled = false end
					for _, side in ipairs(sideHitboxes) do
						if side.dps then side.dps.Enabled = false end
					end
				else
					myData.overpowerDone = true
				end
			end
			if overpower then
				local now = tick()
				local loser = overpower.loser
				local loserHead = loser.character and loser.character.Parent and getHeadPosition(loser.character)
				local finished = false
				if not loserHead or not (loser.hitbox and loser.hitbox.Parent) then
					finished = true
				else
					local t = math.clamp((now - overpower.t0) / OVERPOWER_TIME, 0, 1)
					local clashPoint = overpower.startPoint:Lerp(loserHead, easeInOutQuad(t))
					smoothTip = clashPoint
					myData.clashPoint = clashPoint
					myData.clashLead = true
					extent = easeOutCubic(math.clamp((now - startTime) / INTRO_TIME, 0, 1))
					hitbox:SetAttribute("IsClashing", true)
					local myHead = getHeadPosition(character) or myHRP.Position
					local toLoser = loserHead - myHead
					renderFrame(extent, clashPoint, true, now, {
						lead = true,
						partnerColor = loser.impactColor or impactColor,
						partnerData = loser,
						partnerSources = loser.templateEmitters,
						axis = toLoser.Magnitude > 0.01 and toLoser.Unit or Vector3.zAxis,
					})
					if t >= 1 then
						finished = true
						local loserHum = loser.character:FindFirstChildOfClass("Humanoid")
						if loserHum and loserHum.Health > 0 then
							local creator = loserHum:FindFirstChild("creator")
							if not creator then
								creator = Instance.new("ObjectValue")
								creator.Name = "creator"
								creator.Parent = loserHum
							end
							creator.Value = player
							loserHum:SetAttribute("LastDPSAttacker", player.UserId)
							loserHum:TakeDamage(OVERPOWER_DAMAGE)
						end
						spawnClashExplosion(loserHead, ownSources, loser.templateEmitters or {}, impactColor, loser.impactColor or impactColor)
					end
				end
				if finished then
					overpower = nil
					wasClashing = true
					clashTransitionUntil = now + CLASH_TRANSITION_TIME
					lastFrameTime = now
					if myData then
						myData.overpowering = false
						myData.overpowerDone = true
						myData.clashPoint = nil
					end
				end
				task.wait(0.03)
				continue
			end
			local clashPartner = nil
			if currentClashPartner then
				local partner = currentClashPartner
				local clashStillValid = false
				for _, otherData in pairs(activeBeams) do
					if otherData == partner and otherData.character and otherData.character.Parent
						and otherData.hitbox and otherData.hitbox.Parent and not otherData.ending then
						local partnerHRP = partner.character:FindFirstChild("HumanoidRootPart")
						if partnerHRP and myHRP then
							if isFacing(myHRP, partnerHRP.Position) and isFacing(partnerHRP, myHRP.Position) then
								clashStillValid = true
							end
						end
						break
					end
				end
				if clashStillValid then
					clashPartner = partner
				else
					currentClashPartner = nil
				end
			end
			if not clashPartner and myHRP and activeBeams[player].clashRequestedBy then
				local requester = activeBeams[player].clashRequestedBy
				activeBeams[player].clashRequestedBy = nil
				if requester and requester.character and requester.character.Parent
					and requester.hitbox and requester.hitbox.Parent and not requester.ending then
					local requesterHRP = requester.character:FindFirstChild("HumanoidRootPart")
					if requesterHRP then
						if isFacing(myHRP, requesterHRP.Position) and isFacing(requesterHRP, myHRP.Position) then
							clashPartner = requester
							currentClashPartner = requester
						end
					end
				end
			end
			if not clashPartner and myHRP then
				for otherPlayer, otherData in pairs(activeBeams) do
					if otherPlayer ~= player and otherData and otherData.hitbox and otherData.hitbox.Parent and not otherData.ending
						and otherData.character and otherData.character.Parent then
						local otherHRP = otherData.character:FindFirstChild("HumanoidRootPart")
						if otherHRP then
							if isFacing(myHRP, otherHRP.Position) and isFacing(otherHRP, myHRP.Position) then
								if hitboxNearCharacter(hitbox, otherData.character)
									and hitboxNearCharacter(otherData.hitbox, character) then
									clashPartner = otherData
									currentClashPartner = otherData
									otherData.clashRequestedBy = activeBeams[player]
									if otherData.dpsScript then
										otherData.dpsScript.Enabled = false
									end
									break
								end
							end
						end
					end
				end
			end
			lastClashData = clashPartner
			local now = tick()
			local dt = math.clamp(now - lastFrameTime, 0.001, 0.25)
			lastFrameTime = now
			extent = easeOutCubic(math.clamp((now - startTime) / INTRO_TIME, 0, 1))
			local isClashingNow = clashPartner ~= nil
			if isClashingNow ~= wasClashing then
				wasClashing = isClashingNow
				clashTransitionUntil = now + CLASH_TRANSITION_TIME
			end
			local desiredTip = nil
			local clashInfo = nil
			if clashPartner then
				hitbox:SetAttribute("IsClashing", true)
				local myHeadPos = getHeadPosition(character)
				local partnerHeadPos = getHeadPosition(clashPartner.character)
				if myHeadPos and partnerHeadPos then
					desiredTip = (myHeadPos + partnerHeadPos) / 2
					local toPartner = partnerHeadPos - myHeadPos
					local partnerUserId = clashPartner.player and clashPartner.player.UserId or 0
					local lead = player.UserId < partnerUserId
					if activeBeams[player] then activeBeams[player].clashLead = lead end
					clashInfo = {
						lead = lead,
						partnerColor = clashPartner.impactColor or impactColor,
						partnerData = clashPartner,
						partnerSources = clashPartner.templateEmitters,
						axis = toPartner.Magnitude > 0.01 and toPartner.Unit or Vector3.zAxis,
					}
				end
				for _, side in ipairs(sideHitboxes) do
					if side.dps and side.dps.Enabled then
						side.dps.Enabled = false
					end
				end
				if dpsScript and dpsScript.Enabled then
					dpsScript.Enabled = false
				end
			else
				hitbox:SetAttribute("IsClashing", false)
				local latestAim = playerAims[player]
				if latestAim then
					currentTarget = latestAim
				end
				desiredTip = currentTarget
				if extent >= 0.5 then
					if dpsScript and not dpsScript.Enabled then
						dpsScript.Enabled = true
					end
					for _, side in ipairs(sideHitboxes) do
						if side.dps and not side.dps.Enabled then
							side.dps.Enabled = true
						end
					end
				end
			end
			desiredTip = desiredTip or smoothTip
			local followRate = (isClashingNow or now < clashTransitionUntil) and CLASH_FOLLOW_RATE or AIM_FOLLOW_RATE
			smoothTip = smoothTip:Lerp(desiredTip, 1 - math.exp(-followRate * dt))
			renderFrame(extent, smoothTip, isClashingNow, now, clashInfo)
			if beamIteration % 3 == 0 then
				local ownerHum = character:FindFirstChildOfClass("Humanoid")
				if ownerHum and ownerHum.Health > 0 then
					local ownerHRP = character:FindFirstChild("HumanoidRootPart")
					local atkParams = OverlapParams.new()
					atkParams.FilterDescendantsInstances = {character}
					atkParams.FilterType = Enum.RaycastFilterType.Exclude
					local atkParts = workspace:GetPartsInPart(hitbox, atkParams)
					for _, atkPart in ipairs(atkParts) do
						if atkPart.Name == "AttackHitbox" or atkPart:GetAttribute("MeleeHit") then
							local attackerChar = atkPart.Parent
							local attackerPlayer = Players:GetPlayerFromCharacter(attackerChar)
							if attackerPlayer and attackerPlayer ~= player and not beamHitDebounce[attackerPlayer] then
								local attackerHRP = attackerChar:FindFirstChild("HumanoidRootPart")
								local withinRange = true
								if ownerHRP and attackerHRP then
									local dist = (ownerHRP.Position - attackerHRP.Position).Magnitude
									local maxCounterRange = getCharRadius(character) + getCharRadius(attackerChar)
									withinRange = dist <= maxCounterRange
								end
								if withinRange then
									beamHitDebounce[attackerPlayer] = true
									local dmg = 10
									local atkStats = attackerChar:FindFirstChild("Stats")
									if atkStats then
										for _, dmgName in ipairs({"DMG1", "DMG2", "DMG3"}) do
											local dmgVal = atkStats:FindFirstChild(dmgName)
											if dmgVal then
												dmg = dmgVal.Value
												break
											end
										end
									end
									local creator = ownerHum:FindFirstChild("creator")
									if not creator then
										creator = Instance.new("ObjectValue")
										creator.Name = "creator"
										creator.Parent = ownerHum
									end
									creator.Value = attackerPlayer
									ownerHum:TakeDamage(dmg)
									if _G.ShowIndicator then _G.ShowIndicator(attackerPlayer, dmg, 25, 0) end
									local leaderstats = attackerPlayer:FindFirstChild("leaderstats")
									if leaderstats then
										local gcells = leaderstats:FindFirstChild("GCells") or leaderstats:FindFirstChild("gcells")
										if gcells and gcells:IsA("IntValue") then
											if _G.GCellGuardAllow then _G.GCellGuardAllow(gcells, 25) end
											gcells.Value = gcells.Value + 25
										end
									end
									task.spawn(function()
										task.wait(0.5)
										beamHitDebounce[attackerPlayer] = nil
									end)
								end
							end
						end
					end
				end
			end
			task.wait(0.03)
		end
		if character.Parent and character:FindFirstChild("HumanoidRootPart") then
			local overpoweredBy = nil
			if lastClashData and lastClashData.character and lastClashData.character.Parent
				and lastClashData.hitbox and lastClashData.hitbox.Parent and not lastClashData.ending then
				overpoweredBy = lastClashData
				overpoweredBy.overpowerRequest = activeBeams[player]
			end
			if activeBeams[player] then activeBeams[player].ending = true end
			hitbox:SetAttribute("IsClashing", false)
			hitbox:SetAttribute("BeamEnding", true)
			if dpsScript then dpsScript.Enabled = false end
			for _, side in ipairs(sideHitboxes) do
				if side.dps then side.dps.Enabled = false end
			end
			if overpoweredBy then
				local winnerData = overpoweredBy
				local deadline = tick() + OVERPOWER_TIME + 1.5
				while character.Parent and character:FindFirstChild("HumanoidRootPart")
					and not winnerData.overpowerDone and winnerData.hitbox and winnerData.hitbox.Parent
					and tick() < deadline do
					beamIteration += 1
					local now = tick()
					local point = winnerData.clashPoint
					if point then
						smoothTip = point
						local myHead = getHeadPosition(character) or point
						local toPoint = point - myHead
						renderFrame(1, point, true, now, {
							lead = false,
							partnerColor = winnerData.impactColor or impactColor,
							partnerData = winnerData,
							partnerSources = winnerData.templateEmitters,
							axis = toPoint.Magnitude > 0.01 and toPoint.Unit or Vector3.zAxis,
						})
					end
					task.wait(0.03)
				end
			else
				local outroStart = tick()
				local retractTip = smoothTip
				while character.Parent and character:FindFirstChild("HumanoidRootPart") do
					beamIteration += 1
					local now = tick()
					local t = (now - outroStart) / OUTRO_TIME
					if t >= 1 then break end
					renderFrame(1 - easeInOutQuad(t), retractTip, false, now)
					task.wait(0.03)
				end
			end
		end
	end)
	pcall(function()
		if #beamStarts > 0 then
			enableBeams(beamStarts, false, beamNameFilter)
		end
		if #beamEnds > 0 then
			enableParticles(beamEnds, false)
		end
		for _, att in ipairs(glowAttachments) do
			pcall(function() att:Destroy() end)
		end
		if dpsScript then
			dpsScript.Enabled = false
		end
		for _, side in ipairs(sideHitboxes) do
			if side.dps then
				side.dps.Enabled = false
			end
		end
		for beamEnd, original in pairs(beamEndOriginals) do
			beamEnd.CFrame = original.cframe
			beamEnd.Parent = original.parent
			beamEnd:SetAttribute("BeamEndOffset", nil)
		end
	end)
	pcall(function()
		for _, side in ipairs(sideHitboxes) do
			pcall(function() side.hitbox:Destroy() end)
		end
		restoreBeamTextures(activeBeams[player] and activeBeams[player].beamTextureBases)
		local ib = activeBeams[player] and activeBeams[player].impactFolder
		if ib then ib:Destroy() end
		hitbox:Destroy()
	end)
	activeBeams[player] = nil
	beamGenerations[player] = nil
	playerAims[player] = nil
	playerShiftLock[player] = nil
	if beamEndedSignal then
		beamEndedSignal:Fire(player, myGeneration)
	end
	if not success then
		warn("[BeamSystem] Error during beam activation:", err)
	end
end
function BeamSystem.SetAim(player, targetPosition, isShiftLock)
	if typeof(targetPosition) == "Vector3" then
		playerAims[player] = targetPosition
		if isShiftLock ~= nil then
			playerShiftLock[player] = isShiftLock == true
		end
	end
end
return BeamSystem]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX12">
				<Properties>
					<string name="Name">DPSTemplate</string>
					<token name="RunContext">0</token>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local attackerName = script:GetAttribute("Attacker")
local BeamSystem = nil
task.spawn(function()
	local module = ReplicatedStorage:WaitForChild("BeamSystem", 10)
	if module then
		local ok, result = pcall(require, module)
		if ok then BeamSystem = result end
	end
end)
local hitDebounce = {}


local charRadiusCache = {}
local function getCharRadius(char)
	local cached = charRadiusCache[char]
	if cached then return cached end
	local ok, size = pcall(function()
		local _, s = char:GetBoundingBox()
		return s
	end)
	local radius = (ok and size) and math.max(size.X, size.Y, size.Z) / 2 or 30
	charRadiusCache[char] = radius
	return radius
end

local function awardGCells(attacker)
	local leaderstats = attacker:FindFirstChild("leaderstats")
	if leaderstats then
		local gcells = leaderstats:FindFirstChild("GCells") or leaderstats:FindFirstChild("gcells")
		if gcells and gcells:IsA("IntValue") then
			if _G.GCellGuardAllow then _G.GCellGuardAllow(gcells, 2) end
			gcells.Value = gcells.Value + 2
			if _G.ShowIndicator then _G.ShowIndicator(attacker, 0, 2, 0) end
		end
	end
end

local DAMAGE_INTERVAL = 0.1

local beamDuration = script:GetAttribute("BeamDuration") or 6
local beamDamage = script:GetAttribute("BeamDamage") or 0

local DAMAGE_AMOUNT
if beamDamage > 0 then
	local numTicks = beamDuration / DAMAGE_INTERVAL
	DAMAGE_AMOUNT = beamDamage / numTicks
else
	DAMAGE_AMOUNT = 6
end

local MAX_LIFETIME = beamDuration + 5
task.delay(MAX_LIFETIME, function()
	if script.Parent and script.Parent.Parent then
		script.Parent:Destroy()
	end
end)

task.spawn(function()
	while script.Parent and script.Parent.Parent do
		local hitbox = script.Parent
		if not hitbox:IsA("BasePart") then break end

		local attacker = Players:FindFirstChild(attackerName)
		if attacker then
			local attackerChar = attacker.Character
			local hitboxPos = hitbox.Position
			local hitRadius = hitbox.Size.Magnitude / 2

			
			
			for _, player in ipairs(Players:GetPlayers()) do
				local char = player.Character
				if char and char ~= attackerChar then
					if not hitDebounce[char] then
						local humanoid = char:FindFirstChildOfClass("Humanoid")
						if humanoid and humanoid.Health > 0 then
							local hrp = char:FindFirstChild("HumanoidRootPart")
							if hrp then
								local dist = (hitboxPos - hrp.Position).Magnitude
								local charRadius = getCharRadius(char)
								if dist <= hitRadius + charRadius then
									hitDebounce[char] = true

									humanoid:SetAttribute("LastDPSAttacker", attacker.UserId)
									humanoid.Health = humanoid.Health - DAMAGE_AMOUNT
									if _G.ShowIndicator then _G.ShowIndicator(attacker, DAMAGE_AMOUNT, 0, 0) end
									awardGCells(attacker)
									if BeamSystem and BeamSystem.ApplyBeamSlow then
										BeamSystem.ApplyBeamSlow(humanoid)
									end

									task.spawn(function()
										task.wait(DAMAGE_INTERVAL)
										hitDebounce[char] = nil
									end)
								end
							end
						end
					end
				end
				end
			end

		
		for char in pairs(charRadiusCache) do
			if not char.Parent then
				charRadiusCache[char] = nil
			end
		end

		task.wait(0.1)
	end
end)
]]></ProtectedString>
				</Properties>
