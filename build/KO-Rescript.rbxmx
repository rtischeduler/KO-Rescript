<roblox version="4">
	<Item class="Folder" referent="RBX1">
		<Properties>
			<string name="Name">KO-Rescript</string>
		</Properties>
		<Item class="Folder" referent="RBX2">
			<Properties>
				<string name="Name">ReplicatedStorage</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX3">
				<Properties>
					<string name="Name">CooldownManager</string>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

local CooldownManager = {}

local cooldowns = {}
local attackDurationEnd = 0

local COOLDOWN_DURATIONS = {
	Attack1 = 1, Attack2 = 2, Attack3 = 1, Attack4 = 1,
	Roar1 = 2, Roar2 = 2, Sprint = 0.5,
}

local ATTACK_DURATIONS = {
	Attack1 = 1, Attack2 = 5, Attack3 = 1, Attack4 = 1,
	Roar1 = 3, Roar2 = 3,
}

local COMBAT_ABILITIES = {
	Attack1 = true, Attack2 = true, Attack3 = true, Attack4 = true,
	Roar1 = true, Roar2 = true,
}

local NAME_MAP = {
	Attack = "Attack1", Attack1Event = "Attack1",
	Beam = "Attack2", Attack2Event = "Attack2",
	Attack3 = "Attack3", Attack3Event = "Attack3",
	Attack4 = "Attack4", Attack4Event = "Attack4",
	Roar1 = "Roar1", Roar1Event = "Roar1",
	Roar2 = "Roar2", Roar2Event = "Roar2",
	Sprint = "Sprint",
}

local REVERSE_NAME_MAP = {}
for eventName, canonicalName in pairs(NAME_MAP) do
	local list = REVERSE_NAME_MAP[canonicalName]
	if not list then
		list = {}
		REVERSE_NAME_MAP[canonicalName] = list
	end
	table.insert(list, eventName)
end

function CooldownManager.normalize(name)
	return NAME_MAP[name] or name
end

local function readAttribute(abilityName, attributeName)
	local ok, result = pcall(function()
		local player = Players.LocalPlayer
		local character = player and player.Character
		local charScripts = character and character:FindFirstChild("CharacterScripts")
		local names = REVERSE_NAME_MAP[abilityName]
		if not charScripts or not names then
			return nil
		end
		local containers = { charScripts }
		local animEvents = charScripts:FindFirstChild("AnimEvents")
		if animEvents then
			table.insert(containers, animEvents)
		end
		for _, container in ipairs(containers) do
			for _, eventName in ipairs(names) do
				local event = container:FindFirstChild(eventName)
				if event and event:IsA("RemoteEvent") then
					local value = event:GetAttribute(attributeName)
					if value ~= nil then
						return value
					end
				end
			end
		end
		return nil
	end)
	if ok then
		return result
	end
	return nil
end

function CooldownManager.isInAttackDuration()
	return os.clock() < attackDurationEnd
end

function CooldownManager.canUse(abilityName)
	abilityName = CooldownManager.normalize(abilityName)
	local endTime = cooldowns[abilityName]
	if endTime and os.clock() < endTime then
		return false
	end
	if COMBAT_ABILITIES[abilityName] and CooldownManager.isInAttackDuration() then
		return false
	end
	return true
end

function CooldownManager.start(abilityName, duration)
	abilityName = CooldownManager.normalize(abilityName)
	local actual = readAttribute(abilityName, "CooldownDuration") or duration or COOLDOWN_DURATIONS[abilityName] or 2
	cooldowns[abilityName] = os.clock() + actual
end

function CooldownManager.getRemaining(abilityName)
	abilityName = CooldownManager.normalize(abilityName)
	local endTime = cooldowns[abilityName]
	if endTime and os.clock() < endTime then
		return endTime - os.clock()
	end
	return 0
end

function CooldownManager.getAttackDuration(abilityName)
	abilityName = CooldownManager.normalize(abilityName)
	return readAttribute(abilityName, "AttackDuration") or ATTACK_DURATIONS[abilityName] or 1
end

function CooldownManager.startAttackDuration(abilityName)
	abilityName = CooldownManager.normalize(abilityName)
	if not COMBAT_ABILITIES[abilityName] then
		return
	end
	attackDurationEnd = os.clock() + CooldownManager.getAttackDuration(abilityName)
end

function CooldownManager.getDuration(abilityName)
	abilityName = CooldownManager.normalize(abilityName)
	return readAttribute(abilityName, "CooldownDuration") or COOLDOWN_DURATIONS[abilityName] or 2
end

function CooldownManager.reset()
	table.clear(cooldowns)
	attackDurationEnd = 0
end

return CooldownManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX4">
				<Properties>
					<string name="Name">ChargeManager</string>
					<ProtectedString name="Source"><![CDATA[local ChargeManager = {}

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local isClient = player ~= nil

local MAX_CHARGE = 100
local currentCharge = 100
local isFlying = false

local CHARGE_REQUIREMENTS = {
	Attack1 = 10,
	Attack2 = 30,
	Attack3 = 15,
	Attack4 = 10,
	Roar1 = 0,
	Roar2 = 0,
}

local NAME_MAP = {
	Attack = "Attack1", Attack1Event = "Attack1",
	Beam = "Attack2", Attack2Event = "Attack2",
	Attack3 = "Attack3", Attack3Event = "Attack3",
	Attack4 = "Attack4", Attack4Event = "Attack4",
	Roar1 = "Roar1", Roar1Event = "Roar1",
	Roar2 = "Roar2", Roar2Event = "Roar2",
}

local REVERSE_NAME_MAP = {}
for eventName, canonicalName in pairs(NAME_MAP) do
	REVERSE_NAME_MAP[canonicalName] = REVERSE_NAME_MAP[canonicalName] or {}
	table.insert(REVERSE_NAME_MAP[canonicalName], eventName)
end

local function normalize(name)
	return NAME_MAP[name] or name
end

local function getAttributeCharge(abilityName)
	if not player then return nil end
	local character = player.Character
	if not character then return nil end

	local charScripts = character:FindFirstChild("CharacterScripts")
	if not charScripts then return nil end

	local possibleNames = REVERSE_NAME_MAP[abilityName]
	if not possibleNames then return nil end

	for _, eventName in ipairs(possibleNames) do
		local event = charScripts:FindFirstChild(eventName)
		if event and event:IsA("RemoteEvent") then
			local attr = event:GetAttribute("Charge")
			if attr then return attr end
		end
	end

	local animEvents = charScripts:FindFirstChild("AnimEvents")
	if animEvents then
		for _, eventName in ipairs(possibleNames) do
			local event = animEvents:FindFirstChild(eventName)
			if event and event:IsA("RemoteEvent") then
				local attr = event:GetAttribute("Charge")
				if attr then return attr end
			end
		end
	end

	return nil
end

local function getChargeBar()
	if not player then return nil end
	local gui = player:FindFirstChild("PlayerGui")
	if not gui then return nil end
	local gameGui = gui:FindFirstChild("GameGui")
	if not gameGui then return nil end
	local mainFrame = gameGui:FindFirstChild("MainFrame")
	if not mainFrame then return nil end
	local interface = mainFrame:FindFirstChild("Interface")
	if not interface then return nil end
	local bars = interface:FindFirstChild("Bars")
	if not bars then return nil end
	return bars:FindFirstChild("ChargeBar")
end

local function getChargeStats()
	if not player then return nil end
	local gui = player:FindFirstChild("PlayerGui")
	if not gui then return nil end
	local gameGui = gui:FindFirstChild("GameGui")
	if not gameGui then return nil end
	local mainFrame = gameGui:FindFirstChild("MainFrame")
	if not mainFrame then return nil end
	local interface = mainFrame:FindFirstChild("Interface")
	if not interface then return nil end
	local stats = interface:FindFirstChild("Stats")
	if not stats then return nil end
	return stats:FindFirstChild("Charge")
end

local function updateUI()
	if not isClient then return end
	local chargeBar = getChargeBar()
	if chargeBar then
		local fill = chargeBar:FindFirstChild("Fill")
		local text = chargeBar:FindFirstChild("Text")
		local pct = math.clamp(currentCharge / MAX_CHARGE, 0, 1)
		if fill then
			fill.Size = UDim2.new(pct, 0, 1, 0)
		end
		if text then
			text.Text = "Charge: " .. tostring(math.floor(currentCharge)) .. "/" .. tostring(MAX_CHARGE)
		end
	end

	local chargeStats = getChargeStats()
	if chargeStats then
		local label = chargeStats:FindFirstChild("TextLabel")
		if label then
			label.Text = tostring(math.floor(currentCharge))
		end
	end
end


function ChargeManager.getCharge()
	return currentCharge
end

function ChargeManager.getMaxCharge()
	return MAX_CHARGE
end

function ChargeManager.getRequiredCharge(abilityName, remoteEvent)
	if remoteEvent and remoteEvent:IsA("RemoteEvent") then
		local attrCharge = remoteEvent:GetAttribute("Charge")
		if typeof(attrCharge) == "number" then
			return attrCharge
		end
	end
	abilityName = normalize(abilityName)
	local attrCharge = getAttributeCharge(abilityName)
	if attrCharge then
		return attrCharge
	end
	return CHARGE_REQUIREMENTS[abilityName] or 0
end

function ChargeManager.canUseCharge(abilityName, remoteEvent)
	local required = ChargeManager.getRequiredCharge(abilityName, remoteEvent)
	return currentCharge >= required
end

function ChargeManager.consumeCharge(abilityName, remoteEvent)
	local amount = ChargeManager.getRequiredCharge(abilityName, remoteEvent)
	if amount > 0 then
		currentCharge = math.max(0, currentCharge - amount)
		updateUI()
	end
end

function ChargeManager.setFlying(flying)
	isFlying = flying
end

function ChargeManager.drainCharge(amount)
	if amount > 0 then
		currentCharge = math.max(0, currentCharge - amount)
		updateUI()
	end
end

function ChargeManager.reset()
	currentCharge = MAX_CHARGE
	isFlying = false
	updateUI()
end

if isClient then
	task.spawn(function()
		while task.wait(0.2) do
			if not isFlying and currentCharge < MAX_CHARGE then
				currentCharge = math.min(currentCharge + 1, MAX_CHARGE)
			end
			updateUI()
		end
	end)

	updateUI()
end

return ChargeManager
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
</roblox>
