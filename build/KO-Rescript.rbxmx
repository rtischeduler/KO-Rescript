						<Item class="Folder" referent="RBX19">
							<Properties>
								<string name="Name">Backpack</string>
							</Properties>
							<Item class="LocalScript" referent="RBX20">
								<Properties>
									<string name="Name">BackpackScript</string>
									<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local player = Players.LocalPlayer

local backpack = script.Parent
local template = backpack:FindFirstChild("Template")

local TweenService = game:GetService("TweenService")
local CooldownManager = require(game:GetService("ReplicatedStorage"):WaitForChild("CooldownManager"))
local ChargeManager = require(game:GetService("ReplicatedStorage"):WaitForChild("ChargeManager"))
local UserInputService = game:GetService("UserInputService")
local isMobile = UserInputService.TouchEnabled

local function getDeviceSettings()
	if not UserInputService.TouchEnabled then

		return { buttonSize = 110, spacing = 14, backpackWidth = 800, backpackHeight = 130 }
	end

	return { buttonSize = 70, spacing = 8, backpackWidth = 500, backpackHeight = 90 }
end

local deviceSettings = getDeviceSettings()
local BUTTON_SIZE = deviceSettings.buttonSize
local SPACING = deviceSettings.spacing
local SCALE = BUTTON_SIZE / 80

backpack.Size = UDim2.new(0, deviceSettings.backpackWidth, 0, deviceSettings.backpackHeight)
backpack.Position = UDim2.new(0.5, -deviceSettings.backpackWidth / 2, 1, -deviceSettings.backpackHeight - 15)

local function scaleButtonChildren(button)
	local r = function(n) return math.round(n * SCALE) end

	local num = button:FindFirstChild("Num")
	if num then
		num.Size = UDim2.new(0, r(28), 0, r(9))
	end

	local title = button:FindFirstChild("Title")
	if title then
		if button.Name == "Sprint" then
			title.Size = UDim2.new(1, 0, 0, r(18))
			title.Position = UDim2.new(0, 0, 1, -r(18))
			title.TextScaled = true
		else
			title.Size = UDim2.new(0, r(69), 0, r(10))
			title.Position = UDim2.new(0, r(5), 0, r(66))
		end
	end

	local indicator = button:FindFirstChild("ActiveIndicator")
	if indicator then
		indicator.Size = UDim2.new(1, -r(4), 1, -r(4))
		indicator.Position = UDim2.new(0, r(2), 0, r(2))
	end

	local corner = button:FindFirstChild("UICorner")
	if corner then
		local originalRadius = (button.Name == "Sprint") and 4 or 7
		corner.CornerRadius = UDim.new(0, r(originalRadius))
	end
end

local sprintBtn = backpack:FindFirstChild("Sprint")
if sprintBtn then
	sprintBtn.Size = UDim2.new(0, BUTTON_SIZE, 0, BUTTON_SIZE)
	scaleButtonChildren(sprintBtn)
end
if template then
	template.Size = UDim2.new(0, BUTTON_SIZE, 0, BUTTON_SIZE)
	scaleButtonChildren(template)
end

local bars = backpack.Parent:FindFirstChild("Bars")
if bars then
	bars.Position = UDim2.new(0.5, -185, 1, -deviceSettings.backpackHeight - 40)
end

local activeButtons = {}

local slotToEvent = {}

local activeCooldowns = {}

local RunService = game:GetService("RunService")
local Knit = require(game:GetService("ReplicatedStorage"):WaitForChild("Knit"):WaitForChild("Knit"))
local BeamService = nil
local beamActive = false
local currentBeamGeneration = nil
local beamLockedYaw = nil
local beamDelayToken = nil
local beamStartTimeout = nil
local beamRotationConnection = nil
local currentScreenPos = nil
local activeTouches = {}
local beamPredictionConnection = nil
local beamPredictChar = nil
local beamPredictBeamStart = nil
local beamPredictHitbox = nil
local beamEndsReparented = false

local stopBeamRotation
local startBeamRotation

local SPRINT_IMAGE_NORMAL = "rbxassetid://85803878121852"
local SPRINT_IMAGE_FLYING = ""

local function getDisplayName(event)
	local attackName = event:GetAttribute("AttackName")
	if attackName and attackName ~= "" then
		return attackName
	end
	local name = event.Name
	if name == "Attack" or name == "Attack1Event" then return "Attack" end
	if name == "Beam" or name == "Attack2Event" then return "Beam" end
	if name == "Attack3" or name == "Attack3Event" then return "Attack 3" end
	if name == "Roar1" or name == "Roar1Event" then return "Roar 1" end
	if name == "Roar2" or name == "Roar2Event" then return "Roar 2" end
	return name
end

local function isAttackEvent(event)
	if not event:IsA("RemoteEvent") then return false end
	local attackName = event:GetAttribute("AttackName")
	if attackName then return true end
	local lower = string.lower(event.Name)
	return lower:find("attack") or lower:find("beam") or lower:find("roar")
end

local ORDER = {
	Attack = 1, Attack1Event = 1,
	Beam = 2, Attack2Event = 2,
	Attack3 = 3, Attack3Event = 3,
	Attack4 = 4, Attack4Event = 4,
	Roar1 = 5, Roar1Event = 5,
	Roar2 = 6, Roar2Event = 6,
}

local NUMBERS = {"ONE", "TWO", "THREE", "FOUR", "FIVE", "SIX"}

local function clearButtons()
	for _, child in ipairs(backpack:GetChildren()) do
		if child:IsA("ImageButton") and child.Name ~= "Template" and child.Name ~= "Sprint" then
			child.Parent = nil
		end
	end
end

local function getShiftLockState()
	return player:GetAttribute("ShiftLockEnabled") == true
end

local function isJoystickStart(position, gameProcessed)
	if gameProcessed then return true end
	local camera = workspace.CurrentCamera
	if not camera then return false end
	local viewport = camera.ViewportSize
	return position.X < viewport.X * 0.5
end

local function pickBestTouchPos()
	for input, data in pairs(activeTouches) do
		if not data.isJoystick then
			return data.pos
		end
	end
	return nil
end

UserInputService.InputChanged:Connect(function(input, gameProcessed)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		currentScreenPos = Vector2.new(input.Position.X, input.Position.Y)
	elseif input.UserInputType == Enum.UserInputType.Touch then
		local data = activeTouches[input]
		if data then
			data.pos = Vector2.new(input.Position.X, input.Position.Y)
			if not data.isJoystick then
				currentScreenPos = data.pos
			end
		end
	end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType == Enum.UserInputType.Touch then
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		local isJoystick = isJoystickStart(pos, gameProcessed)
		activeTouches[input] = {pos = pos, isJoystick = isJoystick}
		if not isJoystick then
			currentScreenPos = pos
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		currentScreenPos = Vector2.new(input.Position.X, input.Position.Y)
	end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
	if input.UserInputType == Enum.UserInputType.Touch then
		activeTouches[input] = nil
		local best = pickBestTouchPos()
		if best then
			currentScreenPos = best
		end
	end
end)

local function raycastFiltered(origin, direction, character)
	local excluded = {character}
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude

	local currentOrigin = origin
	local dirUnit = direction.Unit
	local remainingDist = direction.Magnitude

	for i = 1, 30 do
		params.FilterDescendantsInstances = excluded
		local result = workspace:Raycast(currentOrigin, dirUnit * remainingDist, params)
		if not result then return nil end

		local inst = result.Instance
		local isTransparent = inst:IsA("BasePart") and inst.Transparency >= 1
		local isWater = result.Material == Enum.Material.Water

		if isTransparent or isWater then
			local consumed = (result.Position - currentOrigin).Magnitude
			remainingDist = remainingDist - consumed
			if remainingDist <= 0.1 then return nil end
			currentOrigin = result.Position
			table.insert(excluded, inst)
		else
			return result
		end
	end
	return nil
end

local function getAimPosition(character)
	local camera = workspace.CurrentCamera
	if not camera then return nil end
	if not character then return nil end

	local isShiftLock = getShiftLockState()

	if isShiftLock then
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return nil end

		local camLook = camera.CFrame.LookVector
		local camPitch = math.asin(math.clamp(camLook.Y, -1, 1))

		local charLook = hrp.CFrame.LookVector
		local charYaw = math.atan2(-charLook.X, charLook.Z)

		local cosPitch = math.cos(camPitch)
		local direction = Vector3.new(
			-math.sin(charYaw) * cosPitch,
			math.sin(camPitch),
			math.cos(charYaw) * cosPitch
		).Unit

		local result = raycastFiltered(camera.CFrame.Position, direction * 1000, character)
		if result then
			return result.Position
		else
			return camera.CFrame.Position + direction * 1000
		end
	else
		local screenPos = nil

		if UserInputService.MouseEnabled then
			local mouseLocation = UserInputService:GetMouseLocation()
			screenPos = Vector2.new(mouseLocation.X, mouseLocation.Y)
		end

		if not screenPos then
			screenPos = currentScreenPos
		end

		local ray
		if screenPos then
			ray = camera:ScreenPointToRay(screenPos.X, screenPos.Y)
		else
			local viewport = camera.ViewportSize
			ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
		end

		local result = raycastFiltered(ray.Origin, ray.Direction * 1000, character)
		if result then
			return result.Position
		else
			return ray.Origin + ray.Direction * 1000
		end
	end
end

local function needsAimPosition(eventName)
	return eventName == "Beam" or eventName == "Attack2Event"
		or eventName == "Attack3" or eventName == "Attack3Event"
end

local function isBeamEvent(eventName)
	return eventName == "Beam" or eventName == "Attack2Event"
		or eventName == "Attack3" or eventName == "Attack3Event"
end

stopBeamRotation = function()
	if beamRotationConnection then
		beamRotationConnection:Disconnect()
		beamRotationConnection = nil
	end
	local character = player.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.AutoRotate = true
		end
	end
end

local PRED_INTRO_TIME = 0.4
local PRED_FOLLOW_RATE = 40
local PRED_SERVER_RATE = 14
local PRED_TRANSITION_RATE = 6
local PRED_TRANSITION_TIME = 0.7
local beamPredictStartTime = 0
local beamPredictTip = nil
local beamPredictEnd = nil
local beamPredictServerMode = false
local beamPredictTransitionUntil = 0
local beamPredictServerHitbox = nil
local beamPredictLastTime = 0

local function easeOutCubic(t)
	return 1 - (1 - t) ^ 3
end

local function getBeamHeadPosition(character)
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head.Position
	end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	return hrp and hrp.Position or nil
end

local function orientHitbox(charPos, targetPos, placePos)
	placePos = placePos or targetPos
	local flatDir = Vector3.new(targetPos.X - charPos.X, 0, targetPos.Z - charPos.Z)
	if flatDir.Magnitude < 0.01 then
		return CFrame.new(placePos)
	end
	local lookCF = CFrame.lookAt(Vector3.new(charPos.X, 0, charPos.Z), Vector3.new(targetPos.X, 0, targetPos.Z))
	local rotation = lookCF - lookCF.Position
	return CFrame.new(placePos) * rotation
end

local function findServerBeamHitbox()
	if beamPredictServerHitbox and beamPredictServerHitbox.Parent then
		return beamPredictServerHitbox
	end
	beamPredictServerHitbox = nil
	local playerName = player.Name
	for _, child in ipairs(workspace:GetChildren()) do
		if child:IsA("BasePart") and child.Name == "BeamHitbox" and child:GetAttribute("Attacker") == playerName
			and child:GetAttribute("BeamMain") then
			beamPredictServerHitbox = child
			return child
		end
	end
	return nil
end

local function startBeamPrediction()
	beamPredictChar = player.Character
	if not beamPredictChar then return end

	beamPredictBeamStart = nil
	for _, descendant in ipairs(beamPredictChar:GetDescendants()) do
		if descendant:IsA("Attachment") and descendant.Name == "BeamStart" then
			beamPredictBeamStart = descendant
			break
		end
	end

	if beamPredictionConnection then
		beamPredictionConnection:Disconnect()
	end

	if beamPredictHitbox then
		beamPredictHitbox:Destroy()
		beamPredictHitbox = nil
	end
	beamEndsReparented = false
	beamPredictServerHitbox = nil
	beamPredictServerMode = false
	beamPredictTransitionUntil = 0
	beamPredictStartTime = tick()
	beamPredictLastTime = beamPredictStartTime

	beamPredictHitbox = Instance.new("Part")
	beamPredictHitbox.Name = "BeamPredictionHitbox"
	beamPredictHitbox.Size = Vector3.new(6, 6, 6)
	beamPredictHitbox.Anchored = true
	beamPredictHitbox.CanCollide = false
	beamPredictHitbox.CanTouch = false
	beamPredictHitbox.CanQuery = false
	beamPredictHitbox.Transparency = 1
	beamPredictHitbox.Parent = beamPredictChar

	local charHRP = beamPredictChar:FindFirstChild("HumanoidRootPart")
	local startPos = getBeamHeadPosition(beamPredictChar) or (charHRP and charHRP.Position) or Vector3.new()
	beamPredictTip = getAimPosition(beamPredictChar)
	if not beamPredictTip and charHRP then
		beamPredictTip = charHRP.Position + charHRP.CFrame.LookVector * 50
	end
	beamPredictEnd = startPos
	beamPredictHitbox.CFrame = CFrame.new(startPos)

	beamPredictionConnection = RunService.RenderStepped:Connect(function()
		if not beamActive or not beamPredictChar or not beamPredictChar.Parent then return end
		local hrp = beamPredictChar:FindFirstChild("HumanoidRootPart")
		if not hrp or not beamPredictHitbox or not beamPredictHitbox.Parent then return end

		local now = tick()
		local dt = math.clamp(now - beamPredictLastTime, 0.001, 0.25)
		beamPredictLastTime = now

		local serverHitbox = findServerBeamHitbox()

		if not beamEndsReparented and serverHitbox then
			local reparentedAny = false
			for _, child in ipairs(serverHitbox:GetChildren()) do
				if child:IsA("Attachment") and child.Name == "BeamEnd" then
					child.Parent = beamPredictHitbox
					reparentedAny = true
				end
			end
			if reparentedAny then
				beamEndsReparented = true
			end
		end

		local startPos = getBeamHeadPosition(beamPredictChar) or hrp.Position
		local serverMode = serverHitbox ~= nil
			and (serverHitbox:GetAttribute("IsClashing") == true or serverHitbox:GetAttribute("BeamEnding") == true)

		if serverMode ~= beamPredictServerMode then
			beamPredictServerMode = serverMode
			beamPredictTransitionUntil = now + PRED_TRANSITION_TIME
			if not serverMode and beamPredictEnd then
				beamPredictTip = beamPredictEnd
			end
		end

		local extent
		local dirTarget
		if serverMode then
			extent = serverHitbox:GetAttribute("BeamExtent") or 1
			beamPredictEnd = beamPredictEnd:Lerp(serverHitbox.Position, 1 - math.exp(-PRED_SERVER_RATE * dt))
			beamPredictTip = beamPredictEnd
			dirTarget = beamPredictEnd
		else
			local aim = getAimPosition(beamPredictChar)
			if aim and beamPredictTip then
				local rate = now < beamPredictTransitionUntil and PRED_TRANSITION_RATE or PRED_FOLLOW_RATE
				beamPredictTip = beamPredictTip:Lerp(aim, 1 - math.exp(-rate * dt))
			end
			extent = easeOutCubic(math.clamp((now - beamPredictStartTime) / PRED_INTRO_TIME, 0, 1))
			beamPredictEnd = startPos:Lerp(beamPredictTip or startPos, extent)
			dirTarget = beamPredictTip or beamPredictEnd
		end

		beamPredictHitbox.CFrame = orientHitbox(serverMode and startPos or hrp.Position, dirTarget, beamPredictEnd)

		for _, child in ipairs(beamPredictHitbox:GetChildren()) do
			if child:IsA("Attachment") and child.Name == "BeamEnd" then
				local offset = child:GetAttribute("BeamEndOffset") or Vector3.new(0, 0, 0)
				child.CFrame = CFrame.new(offset * extent)
			end
		end

		if beamPredictBeamStart and beamPredictBeamStart.Parent then
			local beamStartPos = beamPredictBeamStart.WorldPosition
			for i = 1, 6 do
				local att = hrp:FindFirstChild("BeamGlowLight" .. i)
				if att then
					att.WorldPosition = beamStartPos:Lerp(beamPredictEnd, i / 7)
				end
			end
		end
	end)
end

local function cleanupBeamEndVisuals(beamEndAtt)
	for _, child in ipairs(beamEndAtt:GetChildren()) do
		if child:IsA("ParticleEmitter") then
			child.Enabled = false
			child:Clear()
		elseif child:IsA("Light") then
			child.Enabled = false
		end
	end
end

local function stopBeamPrediction()
	if beamPredictionConnection then
		beamPredictionConnection:Disconnect()
		beamPredictionConnection = nil
	end

	
	if beamPredictHitbox then
		for _, child in ipairs(beamPredictHitbox:GetChildren()) do
			if child:IsA("Attachment") and child.Name == "BeamEnd" then
				if beamPredictChar and beamPredictChar.Parent then
					local serverHitbox = findServerBeamHitbox()
					if serverHitbox and serverHitbox.Parent then
						child.Parent = serverHitbox
						local offset = child:GetAttribute("BeamEndOffset") or Vector3.new(0, 0, 0)
						child.CFrame = CFrame.new(offset)
					else
						child.Parent = nil
					end
				else
					child.Parent = nil
				end
			end
		end
		beamPredictHitbox:Destroy()
		beamPredictHitbox = nil
	end

	beamEndsReparented = false
	if beamPredictChar and beamPredictChar.Parent then
		for _, descendant in ipairs(beamPredictChar:GetDescendants()) do
			if descendant:IsA("Attachment") and descendant.Name == "BeamEnd" then
				cleanupBeamEndVisuals(descendant)
				descendant:SetAttribute("BeamEndOffset", nil)
			end
		end
	end
	beamPredictChar = nil
	beamPredictBeamStart = nil
	beamPredictServerHitbox = nil
	beamPredictTip = nil
	beamPredictEnd = nil
	beamPredictServerMode = false
end

startBeamRotation = function()
	stopBeamRotation()
	local character = player.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not hrp then return end

	if not getShiftLockState() then
		humanoid.AutoRotate = false
	end

	beamRotationConnection = RunService.RenderStepped:Connect(function()
		if not beamActive then return end
		if not character or not character.Parent then return end

		if getShiftLockState() then return end
		local currentHrp = character:FindFirstChild("HumanoidRootPart")
		if not currentHrp then return end
		local currentHum = character:FindFirstChildOfClass("Humanoid")
		if currentHum then
			currentHum.AutoRotate = false
		end
		local targetPos = getAimPosition(character)
		if not targetPos then return end
		local pos = currentHrp.Position
		local lookDir = Vector3.new(targetPos.X - pos.X, 0, targetPos.Z - pos.Z)
		if lookDir.Magnitude > 0.1 then
			local yaw = math.atan2(-lookDir.X, -lookDir.Z)
			currentHrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
		end
	end)
end


Knit.OnStart():andThen(function()
	BeamService = Knit.GetService("BeamService")

	BeamService.BeamStarted:Connect(function(generation)
		if beamStartTimeout then
			task.cancel(beamStartTimeout)
			beamStartTimeout = nil
		end
		currentBeamGeneration = generation

		if getShiftLockState() then
			local character = player.Character
			if character then
				local hrp = character:FindFirstChild("HumanoidRootPart")
				if hrp then
					local charLook = hrp.CFrame.LookVector
					beamLockedYaw = math.atan2(-charLook.X, charLook.Z)
				end
			end
		end
		beamActive = true
		startBeamRotation()
		startBeamPrediction()
	end)

	BeamService.BeamEnded:Connect(function(generation)
		if generation ~= nil and generation ~= currentBeamGeneration then return end
		currentBeamGeneration = nil
		beamActive = false
		beamLockedYaw = nil
		if beamStartTimeout then
			task.cancel(beamStartTimeout)
			beamStartTimeout = nil
		end
		if beamDelayToken then
			task.cancel(beamDelayToken)
			beamDelayToken = nil
		end
		stopBeamRotation()
		stopBeamPrediction()
	end)
end):catch(warn)


local function onCharacterDied(character)
	local hum = character:WaitForChild("Humanoid", 5)
	if hum then
		hum.Died:Connect(function()
			beamActive = false
			currentBeamGeneration = nil
			beamLockedYaw = nil
			if beamStartTimeout then
				task.cancel(beamStartTimeout)
				beamStartTimeout = nil
			end
			if beamDelayToken then
				task.cancel(beamDelayToken)
				beamDelayToken = nil
			end
			stopBeamRotation()
			stopBeamPrediction()
		end)
	end
end


task.spawn(function()
	local lastAim, lastLock = nil, nil
	while task.wait(0.05) do
		if beamActive and BeamService then
			local character = player.Character
			local targetPos = getAimPosition(character)
			if targetPos then
				local lock = getShiftLockState()
				if targetPos ~= lastAim or lock ~= lastLock then
					lastAim, lastLock = targetPos, lock
					BeamService.BeamAim:Fire(targetPos, lock)
				end
			end
		else
			lastAim, lastLock = nil, nil
		end
	end
end)


local PREDICTION_ANIM_MAP = {
	Attack = "Attack1", Attack1Event = "Attack1",
	Beam = "Attack2", Attack2Event = "Attack2",
	Attack3 = "Attack3", Attack3Event = "Attack3",
	Attack4 = "Attack4", Attack4Event = "Attack4",
	Roar1 = "Roar1", Roar1Event = "Roar1",
	Roar2 = "Roar2", Roar2Event = "Roar2",
}

local ROAR_EVENTS = {
	Roar1 = true, Roar1Event = true,
	Roar2 = true, Roar2Event = true,
}



local function silenceServerRoarSound(char, roarName)
	local targets = {}
	local head = char:FindFirstChild("Head")
	local torso = char:FindFirstChild("Torso")
	if head then table.insert(targets, head) end
	if torso then table.insert(targets, torso) end
	table.insert(targets, char)

	local connections = {}
	local TIMEOUT = 3

	local function checkAndSilence(child)
		if child:IsA("Sound") and child.Name == roarName and not child:GetAttribute("ClientPrediction") then
			child.Volume = 0
			child:Stop()
		end
	end

	for _, target in ipairs(targets) do
		
		for _, child in ipairs(target:GetChildren()) do
			checkAndSilence(child)
		end
		
		local conn = target.ChildAdded:Connect(checkAndSilence)
		table.insert(connections, conn)
	end

	
	task.delay(TIMEOUT, function()
		for _, conn in ipairs(connections) do
			conn:Disconnect()
		end
	end)
end

local function playClientPrediction(eventName, char)
	local animName = PREDICTION_ANIM_MAP[eventName]
	if not animName then return end

	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	local animator = humanoid:FindFirstChild("Animator")
	if not animator then return end

	local animationsFolder = char:FindFirstChild("Animations")
	if animationsFolder then
		local anim = animationsFolder:FindFirstChild(animName)
		if anim then
			local track = animator:LoadAnimation(anim)
			track.Looped = false
			track.Priority = Enum.AnimationPriority.Action
			track:Play()
		end
	end

	if ROAR_EVENTS[eventName] then
		local cs = char:FindFirstChild("CharacterScripts")
		if cs then
			local soundsFolder = cs:FindFirstChild("Sounds")
			if soundsFolder then
				local sound = soundsFolder:FindFirstChild(animName)
				if sound then
					local soundClone = sound:Clone()
					soundClone:SetAttribute("ClientPrediction", true)
					soundClone.Parent = char:FindFirstChild("Head") or char:FindFirstChild("Torso") or char
					soundClone:Play()
					local len = soundClone.TimeLength / soundClone.PlaybackSpeed
					task.spawn(function()
						task.wait(len > 0 and len or 5)
						soundClone:Destroy()
					end)
					
					silenceServerRoarSound(char, animName)
				end
			end
		end
	end
end

local function fireAbility(eventName)
	local button = activeButtons[eventName]
	if not button then return end

	local char = player.Character
	if not char then return end
	local cs = char:FindFirstChild("CharacterScripts")
	if not cs then return end

	local evt = cs:FindFirstChild(eventName)
	if not evt then
		local ae = cs:FindFirstChild("AnimEvents")
		if ae then
			evt = ae:FindFirstChild(eventName)
		end
	end
	if not evt then return end

	local cdDuration = CooldownManager.getDuration(eventName)
	if not CooldownManager.canUse(eventName) then
		return
	end
	if not ChargeManager.canUseCharge(eventName) then
		return
	end

	CooldownManager.start(eventName, cdDuration)
	ChargeManager.consumeCharge(eventName)

	playClientPrediction(eventName, char)

	if needsAimPosition(eventName) then
		local aimPos = getAimPosition(char)
		if aimPos then
			evt:FireServer(aimPos)
		else
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				evt:FireServer(hrp.Position + hrp.CFrame.LookVector * 1000)
			end
		end
	else
		evt:FireServer()
	end

	if isBeamEvent(eventName) then
		if beamStartTimeout then
			task.cancel(beamStartTimeout)
		end
		beamStartTimeout = task.delay(5, function()
			beamStartTimeout = nil
			beamActive = false
			currentBeamGeneration = nil
			beamLockedYaw = nil
			stopBeamRotation()
			stopBeamPrediction()
		end)
	end

	CooldownManager.startAttackDuration(eventName)

	local attackDuration = CooldownManager.getAttackDuration(eventName)
	local visualDuration = math.max(cdDuration, attackDuration)

	local charge = button:FindFirstChild("Charge")
	if charge then
		charge.Size = UDim2.new(1, 0, -1, 0)
		local tween = TweenService:Create(charge, TweenInfo.new(visualDuration, Enum.EasingStyle.Linear), {Size = UDim2.new(1, 0, 0, 0)})
		activeCooldowns[eventName] = true
		tween.Completed:Connect(function()
			activeCooldowns[eventName] = nil
		end)
		tween:Play()
	end

	for _, otherButton in ipairs(backpack:GetChildren()) do
		if otherButton:IsA("ImageButton") and otherButton.Name ~= "Template" and otherButton.Name ~= "Sprint" and otherButton ~= button then

			local otherRemaining = CooldownManager.getRemaining(otherButton.Name)
			local otherVisualDuration = math.max(otherRemaining, attackDuration)
			local otherCharge = otherButton:FindFirstChild("Charge")
			if otherCharge then
				otherCharge.Size = UDim2.new(1, 0, -1, 0)
				local otherTween = TweenService:Create(otherCharge, TweenInfo.new(otherVisualDuration, Enum.EasingStyle.Linear), {Size = UDim2.new(1, 0, 0, 0)})
				otherTween:Play()
			end
		end
	end
end

local function buildButtons(character)
	clearButtons()
	activeButtons = {}
	slotToEvent = {}

	backpack.Size = UDim2.new(0, deviceSettings.backpackWidth, 0, deviceSettings.backpackHeight)
	backpack.Position = UDim2.new(0.5, -deviceSettings.backpackWidth / 2, 1, -deviceSettings.backpackHeight - 15)
	local barsFrame = backpack.Parent:FindFirstChild("Bars")
	if barsFrame then
		barsFrame.Position = UDim2.new(0.5, -185, 1, -deviceSettings.backpackHeight - 40)
	end
	if template then
		template.Size = UDim2.new(0, BUTTON_SIZE, 0, BUTTON_SIZE)
		scaleButtonChildren(template)
	end

	local sprint = backpack:FindFirstChild("Sprint")

	local charScripts = character:FindFirstChild("CharacterScripts")
	if not charScripts then
		if sprint then sprint.Visible = false end
		return
	end

	if sprint then
		sprint.Size = UDim2.new(0, BUTTON_SIZE, 0, BUTTON_SIZE)
		scaleButtonChildren(sprint)
		sprint.Visible = true
		local canFly = character:FindFirstChild("canFly")
		local isFlying = canFly and canFly.Value == true
		if isFlying then
			sprint.Image = SPRINT_IMAGE_FLYING
		else
			sprint.Image = SPRINT_IMAGE_NORMAL
		end

		local sprintTitle = sprint:FindFirstChild("Title")
		if sprintTitle then
			sprintTitle.Text = isFlying and "Fly" or "Sprint"
		end
		local sprintNum = sprint:FindFirstChild("Num")
		if sprintNum then
			sprintNum.Text = "SHIFT"
		end
	end

	local events = {}
	local seenSlots = {}

	local function addEvent(child)
		if not isAttackEvent(child) then return end
		local slot = ORDER[child.Name] or 99
		local dedupKey = (slot == 99) and child.Name or tostring(slot)
		if seenSlots[dedupKey] then return end
		seenSlots[dedupKey] = true
		table.insert(events, child)
	end

	for _, child in ipairs(charScripts:GetChildren()) do
		addEvent(child)
	end

	local animEvents = charScripts:FindFirstChild("AnimEvents")
	if animEvents then
		for _, child in ipairs(animEvents:GetChildren()) do
			addEvent(child)
		end
	end

	table.sort(events, function(a, b)
		return (ORDER[a.Name] or 99) < (ORDER[b.Name] or 99)
	end)

	local sprintCount = (sprint and sprint.Visible) and 1 or 0
	local totalButtons = #events + sprintCount
	local totalWidth = totalButtons * BUTTON_SIZE + math.max(totalButtons - 1, 0) * SPACING
	local backpackWidth = backpack.Size.X.Offset
	local startX = (backpackWidth - totalWidth) / 2

	for i, event in ipairs(events) do
		if template then
			local button = template:Clone()
			button.Name = event.Name
			button.Size = UDim2.new(0, BUTTON_SIZE, 0, BUTTON_SIZE)
			button.Visible = true
			scaleButtonChildren(button)
			button.Parent = backpack
			activeButtons[event.Name] = button
			slotToEvent[ORDER[event.Name] or 99] = event.Name

			local attackImage = event:GetAttribute("AttackImage")
			if attackImage and attackImage ~= "" then
				button.Image = attackImage
			end

			local title = button:FindFirstChild("Title")
			if title then
				title.Text = getDisplayName(event)
			end

			local num = button:FindFirstChild("Num")
			if num then
				local eventName = event.Name
				if eventName == "Roar1" or eventName == "Roar1Event" then
					num.Text = "R"
				elseif eventName == "Roar2" or eventName == "Roar2Event" then
					num.Text = "T"
				else
					num.Text = NUMBERS[i] or tostring(i)
				end
			end

			button.Position = UDim2.new(0, startX + (i - 1) * (BUTTON_SIZE + SPACING), 0, 0)

			button.MouseButton1Click:Connect(function()
				fireAbility(event.Name)
			end)
		end
	end

	if sprint then
		sprint.Position = UDim2.new(0, startX + #events * (BUTTON_SIZE + SPACING), 0, 0)
	end

	return #events
end

local function onCharacterChanged(character)
	clearButtons()

	local connection
	connection = character.ChildAdded:Connect(function(child)
		if child.Name == "CharacterScripts" then
			connection:Disconnect()
			task.wait(0.2)
			buildButtons(character)

			child.ChildAdded:Connect(function(grandchild)
				if grandchild:IsA("RemoteEvent") then
					task.wait(0.1)
					buildButtons(character)
				end
			end)
			child.ChildRemoved:Connect(function()
				task.wait(0.1)
				buildButtons(character)
			end)
		end
	end)

	local existing = character:FindFirstChild("CharacterScripts")
	if existing then
		if connection then
			connection:Disconnect()
		end
		task.wait(0.2)
		buildButtons(character)

		existing.ChildAdded:Connect(function(child)
			if child:IsA("RemoteEvent") then
				task.wait(0.1)
				buildButtons(character)
			end
		end)
		existing.ChildRemoved:Connect(function()
			task.wait(0.1)
			buildButtons(character)
		end)
	end
end

local sprintActive = false

local function updateSprintVisual()
	local sprint = backpack:FindFirstChild("Sprint")
	if not sprint then return end
	local indicator = sprint:FindFirstChild("ActiveIndicator")
	if indicator then
		indicator.BackgroundTransparency = sprintActive and 0.5 or 1
	end
end

local function setSprintState(active)
	sprintActive = active
	updateSprintVisual()
end

local function getSprintRunningValue()
	local character = player.Character
	if not character then return nil end
	local control = character:FindFirstChild("Control")
	if not control then return nil end
	local runFolder = control:FindFirstChild("Run")
	if not runFolder then return nil end
	return runFolder:FindFirstChild("Running")
end

local function playSprintCooldownFill()
	local sprint = backpack:FindFirstChild("Sprint")
	if not sprint then return end
	local charge = sprint:FindFirstChild("Charge")
	if charge then
		charge.Size = UDim2.new(1, 0, -1, 0)
		local tween = TweenService:Create(charge, TweenInfo.new(0.5, Enum.EasingStyle.Linear), {Size = UDim2.new(1, 0, 0, 0)})
		tween:Play()
	end
end

local function doSprintToggle()
	if not CooldownManager.canUse("Sprint") then return end
	local runningValue = getSprintRunningValue()
	if not runningValue then return end
	CooldownManager.start("Sprint", 0.5)
	playSprintCooldownFill()
	runningValue.Value = not runningValue.Value
	setSprintState(runningValue.Value)
end

local function doSprintStart()
	if not CooldownManager.canUse("Sprint") then return end
	local runningValue = getSprintRunningValue()
	if not runningValue then return end
	CooldownManager.start("Sprint", 0.5)
	playSprintCooldownFill()
	runningValue.Value = true
	setSprintState(true)
end

local function doSprintStop()
	local runningValue = getSprintRunningValue()
	if not runningValue then return end
	runningValue.Value = false
	setSprintState(false)
end

local sprintButton = backpack:FindFirstChild("Sprint")
if sprintButton then
	sprintButton.MouseButton1Click:Connect(doSprintToggle)
end

local function watchRunningValue(character)
	task.spawn(function()
		local control = character:WaitForChild("Control", 10)
		if not control then return end
		local runFolder = control:WaitForChild("Run", 5)
		if not runFolder then return end
		local runningValue = runFolder:WaitForChild("Running", 5)
		if not runningValue then return end

		runningValue:GetPropertyChangedSignal("Value"):Connect(function()
			if character == player.Character then
				setSprintState(runningValue.Value)
			end
		end)
		setSprintState(runningValue.Value)
	end)
end

if player.Character then
	onCharacterChanged(player.Character)
	watchRunningValue(player.Character)
	onCharacterDied(player.Character)
end

player.CharacterAdded:Connect(function(character)
	beamActive = false
	currentBeamGeneration = nil
	beamLockedYaw = nil
	if beamStartTimeout then
		task.cancel(beamStartTimeout)
		beamStartTimeout = nil
	end
	if beamDelayToken then
		task.cancel(beamDelayToken)
		beamDelayToken = nil
	end
	stopBeamRotation()
	stopBeamPrediction()
	CooldownManager.reset()
	ChargeManager.reset()
	activeCooldowns = {}
	setSprintState(false)
	onCharacterChanged(character)
	watchRunningValue(character)
	onCharacterDied(character)
end)

local KEY_TO_SLOT = {
	[Enum.KeyCode.R] = 5,
	[Enum.KeyCode.T] = 6,
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
}

local GAMEPAD_TO_SLOT = {
	[Enum.KeyCode.ButtonY] = 2,
	[Enum.KeyCode.ButtonX] = 1,
	[Enum.KeyCode.ButtonB] = 3,
	[Enum.KeyCode.ButtonR1] = 4,
	[Enum.KeyCode.DPadLeft] = 5,
	[Enum.KeyCode.DPadRight] = 6,
}

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	local slot = KEY_TO_SLOT[input.KeyCode] or GAMEPAD_TO_SLOT[input.KeyCode]
	if slot then
		local eventName = slotToEvent[slot]
		if eventName then
			fireAbility(eventName)
		end
	end
end)


UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.ButtonL3 then
		doSprintToggle()
	end
end)

]]></ProtectedString>
								</Properties>
							</Item>
						</Item>
					</Item>
				</Item>
			</Item>
			<Item class="LocalScript" referent="RBX21">
				<Properties>
					<string name="Name">ClientHandler</string>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local GuiService = game:GetService("GuiService")
local StarterGui = game:GetService("StarterGui")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local function getCamera()
	return Workspace.CurrentCamera
end

local function waitForLocalPlayer()
	if player then return player end
	return Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
end

player = waitForLocalPlayer()

local function initDisableResetButton()
	task.wait(1)
	local success, err = pcall(function()
		StarterGui:SetCore("ResetButtonCallback", false)
	end)
	if not success then
		warn("Failed to disable reset button: " .. tostring(err))
	end
end

local function initOldCursor()
	local mouse = player:GetMouse()
	mouse.Icon = "http://www.roblox.com/asset/?id=7025168168"
end

local function initGamepassFriends()
	
end

local function initUnderwaterEffect()
	local blur = Lighting:FindFirstChild("UnderwaterBlur")
	local correction = Lighting:FindFirstChild("UnderwaterCorrection")

	if not blur or not correction then
		warn("UnderwaterEffect: UnderwaterBlur or UnderwaterCorrection not found in Lighting")
		return
	end

	local cachedOcean = nil
	RunService.RenderStepped:Connect(function()
		if not cachedOcean or not cachedOcean.Parent or cachedOcean.Parent ~= Workspace then
			cachedOcean = Workspace:FindFirstChild("Ocean")
		end
		local ocean = cachedOcean
		if ocean and ocean:IsA("BasePart") then
			local below = camera.CFrame.Position.Y < ocean.Position.Y
			if blur.Enabled ~= below then blur.Enabled = below end
			if correction.Enabled ~= below then correction.Enabled = below end
		end
	end)
end

local function initCameraToggle()
	local isConsole = GuiService:IsTenFootInterface()
	local maxZoomDistance = isConsole and 200 or 100
	local isHeadMode = false
	local currentHeadPart = nil
	local connections = {}

	local function findHeadPart(character)
		if not character then return nil end
		local fakeHead = character:FindFirstChild("FakeHead")
		if fakeHead and fakeHead:IsA("BasePart") then
			return fakeHead
		end
		local head = character:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			return head
		end
		local headPart = character:FindFirstChild("HeadPart")
		if headPart and headPart:IsA("BasePart") then
			return headPart
		end
		return nil
	end

	local function enforceMaxZoom()
		player.CameraMaxZoomDistance = maxZoomDistance
		player.CameraMinZoomDistance = 0.5
	end

	local function updateCameraSubject()
		if player:GetAttribute("MenuCameraActive") then return end
		local character = player.Character
		if not character then return end
		local cam = getCamera()
		if not cam then return end

		if isHeadMode then
			local headPart = findHeadPart(character)
			if headPart then
				currentHeadPart = headPart
				cam.CameraSubject = headPart
			else
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					cam.CameraSubject = humanoid
				end
				currentHeadPart = nil
			end
		else
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				cam.CameraSubject = humanoid
			end
			currentHeadPart = nil
		end
	end

	local function startHeadMonitor(character)
		if connections.headMonitor then
			connections.headMonitor:Disconnect()
		end
		connections.headMonitor = RunService.Heartbeat:Connect(function()
			if not isHeadMode then return end
			if player:GetAttribute("MenuCameraActive") then return end
			if not character or not character.Parent then return end
			if currentHeadPart and currentHeadPart.Parent then return end
			local newHeadPart = findHeadPart(character)
			if newHeadPart and newHeadPart ~= currentHeadPart then
				currentHeadPart = newHeadPart
				local cam = getCamera()
				if cam then
					cam.CameraSubject = newHeadPart
				end
			end
		end)
	end

	local function onCharacterAdded(character)
		enforceMaxZoom()
		updateCameraSubject()
		startHeadMonitor(character)
		character.ChildAdded:Connect(function(child)
			if isHeadMode and (child.Name == "FakeHead" or child.Name == "Head" or child.Name == "HeadPart") then
				if child:IsA("BasePart") and not player:GetAttribute("MenuCameraActive") then
					currentHeadPart = child
					local cam = getCamera()
					if cam then
						cam.CameraSubject = child
					end
				end
			end
			if child:IsA("Humanoid") then
				enforceMaxZoom()
			end
		end)
		character.ChildRemoved:Connect(function(child)
			if isHeadMode and child == currentHeadPart then
				task.wait(0.1)
				updateCameraSubject()
			end
		end)
	end


	player.CharacterAdded:Connect(onCharacterAdded)
	if player.Character then
		onCharacterAdded(player.Character)
	end

	RunService.Heartbeat:Connect(function()
		local detectedConsole = GuiService:IsTenFootInterface()
		if detectedConsole ~= isConsole then
			isConsole = detectedConsole
			maxZoomDistance = isConsole and 200 or 100
		end
		if player.CameraMaxZoomDistance ~= maxZoomDistance then
			player.CameraMaxZoomDistance = maxZoomDistance
		end
		if player.CameraMinZoomDistance ~= 0.5 then
			player.CameraMinZoomDistance = 0.5
		end
	end)
end

local function initShiftLock()
	local isMobile = UserInputService.TouchEnabled
	local isShiftLocked = false
	local renderConnection = nil
	local TARGET_OFFSET = Vector3.new(9.5, 1.5, 3.5)
	local OFFSET_RATE = 9
	local currentOffset = Vector3.new(0, 0, 0)
	local toggleTime = 0
	local function lerpAngle(a, b, t)
		local diff = (b - a + math.pi) % (2 * math.pi) - math.pi
		return a + diff * t
	end
	

	player:SetAttribute("ShiftLockEnabled", false)
	if not isMobile then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end

	local function getShiftLockButton()
		local gui = player:FindFirstChild("PlayerGui")
		if not gui then return nil end
		local gameGui = gui:FindFirstChild("GameGui")
		if not gameGui then return nil end
		local mainFrame = gameGui:FindFirstChild("MainFrame")
		if not mainFrame then return nil end
		local interface = mainFrame:FindFirstChild("Interface")
		if not interface then return nil end
		local mobile = interface:FindFirstChild("Mobile")
		if not mobile then return nil end
		return mobile:FindFirstChild("ShiftLock")
	end

	local function getCtrlLockButton()
		local gui = player:FindFirstChild("PlayerGui")
		if not gui then return nil end
		local gameGui = gui:FindFirstChild("GameGui")
		if not gameGui then return nil end
		local mainFrame = gameGui:FindFirstChild("MainFrame")
		if not mainFrame then return nil end
		local interface = mainFrame:FindFirstChild("Interface")
		if not interface then return nil end
		local buttons = interface:FindFirstChild("Buttons")
		if not buttons then return nil end
		return buttons:FindFirstChild("CtrlLock")
	end

	local function ensureRender()
		if renderConnection then return end
		renderConnection = RunService.RenderStepped:Connect(function(dt)
			dt = math.clamp(dt, 0, 0.1)
			local target = isShiftLocked and TARGET_OFFSET or Vector3.new(0, 0, 0)
			currentOffset = currentOffset:Lerp(target, 1 - math.exp(-OFFSET_RATE * dt))
			if isShiftLocked then
				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local hrp = character and character:FindFirstChild("HumanoidRootPart")
				if humanoid and hrp then
					humanoid.AutoRotate = false
					local lookVector = camera.CFrame.LookVector
					local targetYaw = math.atan2(-lookVector.X, -lookVector.Z)
					local currentLook = hrp.CFrame.LookVector
					local currentYaw = math.atan2(-currentLook.X, -currentLook.Z)
					local t = math.clamp((tick() - toggleTime) / 0.35, 0, 1)
					local rate = 8 + 72 * t * t
					local yaw = lerpAngle(currentYaw, targetYaw, 1 - math.exp(-rate * dt))
					hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, yaw, 0)
				end
			end
			if currentOffset.Magnitude > 0.01 then
				camera.CFrame = camera.CFrame * CFrame.new(currentOffset)
			elseif not isShiftLocked then
				currentOffset = Vector3.new(0, 0, 0)
				if renderConnection then
					renderConnection:Disconnect()
					renderConnection = nil
				end
			end
		end)
	end

	local function stopRotation()
		local character = player.Character
		if character then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.AutoRotate = true
			end
		end
	end

	local function startRotation()
		ensureRender()
	end

	local ctrlLockNormalImage = "rbxassetid://5044539836"
	local ctrlLockHoverImage = "rbxassetid://5044539486"

	local function updateCtrlLockVisuals()
		local button = getCtrlLockButton()
		if button then
			button.Image = isShiftLocked and ctrlLockHoverImage or ctrlLockNormalImage
		end
	end

	local function setShiftLock(enabled)
		isShiftLocked = enabled
		toggleTime = tick()
		player:SetAttribute("ShiftLockEnabled", enabled)
		if enabled then
			if not isMobile then
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			end
			startRotation()
		else
			if not isMobile then
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			end
			stopRotation()
		end
		updateCtrlLockVisuals()
	end

	local function connectMobileButton()
		local button = getShiftLockButton()
		if button then
			button.MouseButton1Click:Connect(function()
				setShiftLock(not isShiftLocked)
			end)
			return true
		end
		return false
	end

	local function connectCtrlLockButton()
		local button = getCtrlLockButton()
		if button then
			button.MouseButton1Click:Connect(function()
				setShiftLock(not isShiftLocked)
			end)
			return true
		end
		return false
	end

	if not isMobile then
		UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end
			if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
				setShiftLock(not isShiftLocked)
			end
		end)
	end

	player.CharacterAdded:Connect(function(character)
		task.wait(0.1)
		if isShiftLocked then
			startRotation()
		else
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.AutoRotate = true
			end
		end
	end)

	task.spawn(function()
		for i = 1, 20 do
			if connectMobileButton() then break end
			task.wait(0.5)
		end
	end)

	task.spawn(function()
		for i = 1, 20 do
			if connectCtrlLockButton() then break end
			task.wait(0.5)
		end
	end)

	if player.Character and isShiftLocked then
		startRotation()
	end
end

local function safeInit(name, func)
	local success, err = pcall(func)
	if not success then
		warn("ClientHandler: " .. name .. " failed: " .. tostring(err))
	end
end

task.spawn(function()
	safeInit("DisableResetButton", initDisableResetButton)
end)

task.spawn(function()
	safeInit("OldCursor", initOldCursor)
end)

task.spawn(function()
	safeInit("GamepassFriends", initGamepassFriends)
end)

task.spawn(function()
	safeInit("UnderwaterEffect", initUnderwaterEffect)
end)

task.spawn(function()
	safeInit("CameraToggle", initCameraToggle)
end)

task.spawn(function()
	safeInit("ShiftLock", initShiftLock)
end)

task.spawn(function()
	local CollectionService = game:GetService("CollectionService")
	local UserInputService = game:GetService("UserInputService")
	local okQuality, quality = pcall(function()
		return UserSettings().GameSettings.SavedQualityLevel.Value
	end)
	local lowEnd = UserInputService.TouchEnabled or (okQuality and quality > 0 and quality <= 4)
	local MAX_LIGHTS = lowEnd and 20 or 60
	local MAX_DISTANCE = lowEnd and 160 or 300
	local TAG = "BuildingGlowLight"
	local lights = {}
	local entries = {}

	local function add(light)
		if light:IsA("PointLight") then lights[light] = true end
	end

	for _, light in CollectionService:GetTagged(TAG) do add(light) end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(add)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(light)
		lights[light] = nil
	end)

	while true do
		task.wait(0.5)
		local cam = workspace.CurrentCamera
		if cam then
			local origin = cam.CFrame.Position
			table.clear(entries)
			for light in lights do
				local part = light.Parent
				if part and part:IsA("BasePart") then
					local d = (part.Position - origin).Magnitude
					if d <= MAX_DISTANCE then
						table.insert(entries, { light, d })
					elseif light.Enabled then
						light.Enabled = false
					end
				else
					lights[light] = nil
				end
			end
			table.sort(entries, function(a, b) return a[2] < b[2] end)
			for i, entry in entries do
				local on = i <= MAX_LIGHTS
				if entry[1].Enabled ~= on then entry[1].Enabled = on end
			end
		end
	end
end)
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX22">
			<Properties>
				<string name="Name">ServerScriptService</string>
			</Properties>
			<Item class="Folder" referent="RBX23">
				<Properties>
					<string name="Name">framework</string>
				</Properties>
				<Item class="Folder" referent="RBX24">
					<Properties>
						<string name="Name">modules</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX25">
						<Properties>
							<string name="Name">World</string>
							<ProtectedString name="Source"><![CDATA[local World = {}

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HolidayConfigs = require(ReplicatedStorage:WaitForChild("HolidayConfigs"))

local state = { IsRaining = false, IsSnowing = false }
local initialized = false
local windowApi = {}
local savedWindowState = setmetatable({}, { __mode = "k" })

local function lerp(a, b, t) return a + (b - a) * t end

local function rand(a, b) return a + math.random() * (b - a) end

local function shuffle(list)
	local copy = table.clone(list)
	for i = #copy, 2, -1 do
		local j = math.random(1, i)
		copy[i], copy[j] = copy[j], copy[i]
	end
	return copy
end

local function maxAxis(part)
	return math.max(part.Size.X, part.Size.Y, part.Size.Z) / 2
end

local function easeLinear(p) return p end
local function easeInOut(p)
	if p < 0.5 then return 2 * p * p end
	return 1 - (-2 * p + 2) ^ 2 / 2
end
local function easeCollapse(p) return p ^ 1.7 end
local function easeTilt(p) return p ^ 1.6 end

local function initDayNight()
	local DAY_LENGTH_MIN = 30
	local WEATHER_FADE = 10
	local START_MINUTES = 720
	local timeRatio = (24 * 60) / (math.max(DAY_LENGTH_MIN, 1) * 60)
	local t0 = os.clock()

	local DAY = {
		Brightness = 2, Ambient = Color3.new(0.5, 0.5, 0.5),
		OutdoorAmbient = Color3.new(0.25, 0.28, 0.21),
		ColorShift_Top = Color3.new(1, 0.75, 0.57),
		ColorShift_Bottom = Color3.new(0.15, 0.15, 0.2),
		FogColor = Color3.new(0.61, 0.67, 0.77), FogEnd = 5500,
		Density = 0.3, AtmColor = Color3.new(0.7, 0.75, 0.85), Haze = 2,
		Cloud = Color3.new(1, 1, 1),
	}
	local NIGHT = {
		Brightness = 1.2, Ambient = Color3.new(0.28, 0.32, 0.45),
		OutdoorAmbient = Color3.new(0.15, 0.18, 0.3),
		ColorShift_Top = Color3.new(0.12, 0.15, 0.28),
		ColorShift_Bottom = Color3.new(0.06, 0.07, 0.14),
		FogColor = Color3.new(0.18, 0.21, 0.3), FogEnd = 3000,
		Density = 0.4, AtmColor = Color3.new(0.1, 0.1, 0.18), Haze = 3,
		Cloud = Color3.new(0.12, 0.12, 0.16),
	}
	local RAIN = {
		FogEndMul = 0.4, DensityAdd = 0.15, HazeAdd = 1,
		FogColor = Color3.new(0.35, 0.37, 0.4),
		AtmColor = Color3.new(0.4, 0.42, 0.45),
		Cloud = Color3.new(0.15, 0.15, 0.18),
	}

	local SNOW = RAIN
	local DEFAULT = { Day = DAY, Night = NIGHT, Rain = RAIN }
	local lastCheck = -math.huge
	local baseDecay = nil
	local wxLevel, wxTable = 0, nil
	local lastWx = os.clock()

	local function rawDayFactor(m)
		if m >= 420 and m <= 1020 then return 1
		elseif m >= 1140 or m <= 300 then return 0
		elseif m < 420 then return (m - 300) / 120
		else return 1 - (m - 1020) / 120 end
	end

	local function dayFactor(m)
		local x = rawDayFactor(m)
		return x * x * (3 - 2 * x)
	end

	while true do
		local clock = os.clock()
		if clock - lastCheck >= 30 then
			lastCheck = clock
			local holiday = HolidayConfigs.getActive()
			local set = holiday and holiday.Lighting or DEFAULT
			DAY, NIGHT = set.Day or DEFAULT.Day, set.Night or DEFAULT.Night
			RAIN = set.Rain or DEFAULT.Rain
			SNOW = set.Snow or set.Rain or DEFAULT.Rain
		end

		local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
		local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")

		local minutes = (START_MINUTES + (os.clock() - t0) * timeRatio) % 1440
		Lighting:SetMinutesAfterMidnight(minutes)
		local t = dayFactor(minutes)

		Lighting.Brightness = lerp(NIGHT.Brightness, DAY.Brightness, t)
		Lighting.Ambient = NIGHT.Ambient:Lerp(DAY.Ambient, t)
		Lighting.OutdoorAmbient = NIGHT.OutdoorAmbient:Lerp(DAY.OutdoorAmbient, t)
		Lighting.ColorShift_Top = NIGHT.ColorShift_Top:Lerp(DAY.ColorShift_Top, t)
		Lighting.ColorShift_Bottom = NIGHT.ColorShift_Bottom:Lerp(DAY.ColorShift_Bottom, t)

		local fogEnd = lerp(NIGHT.FogEnd, DAY.FogEnd, t)
		local density = lerp(NIGHT.Density, DAY.Density, t)
		local haze = lerp(NIGHT.Haze, DAY.Haze, t)

		local target = (state.IsRaining or state.IsSnowing) and 1 or 0
		local active = state.IsRaining and RAIN or state.IsSnowing and SNOW or nil
		if active then wxTable = active end
		local maxStep = math.max(clock - lastWx, 0) / WEATHER_FADE
		lastWx = clock
		wxLevel += math.clamp(target - wxLevel, -maxStep, maxStep)
		if wxLevel <= 0 then wxTable = nil end
		local k = wxLevel * wxLevel * (3 - 2 * wxLevel)

		local fogColor = NIGHT.FogColor:Lerp(DAY.FogColor, t)
		local atmColor = NIGHT.AtmColor:Lerp(DAY.AtmColor, t)
		local cloudColor = NIGHT.Cloud:Lerp(DAY.Cloud, t)
		if wxTable and k > 0 then
			fogColor = fogColor:Lerp(wxTable.FogColor, k)
			atmColor = atmColor:Lerp(wxTable.AtmColor, k)
			cloudColor = cloudColor:Lerp(wxTable.Cloud, k)
			fogEnd *= lerp(1, wxTable.FogEndMul, k)
			density += wxTable.DensityAdd * k
			haze += wxTable.HazeAdd * k
		end
		Lighting.FogColor = fogColor
		Lighting.FogEnd = fogEnd
		if atmosphere then
			atmosphere.Density = density
			atmosphere.Color = atmColor
			atmosphere.Haze = haze
		end
		if clouds then clouds.Color = cloudColor end

		if atmosphere then
			if baseDecay == nil then baseDecay = atmosphere.Decay end
			atmosphere.Decay = DAY.AtmDecay and NIGHT.AtmDecay and NIGHT.AtmDecay:Lerp(DAY.AtmDecay, t) or baseDecay
		end

		task.wait(1 / 15)
	end
end

local function initWindowLights()
	local LIT = Color3.fromRGB(197, 166, 89)
	local DARK = Color3.new(0, 0, 0)

	local windowsOn = false
	local epoch = 0
	local saved = savedWindowState
	local lights = {}
	local buildings = {}
	local pool = {}
	local winToken = setmetatable({}, { __mode = "k" })
	local LIGHT_BRIGHTNESS = 1.6
	local LIGHT_RANGE = 30
	local LIGHTS_PER_FRAME = 3
	local TURN_ON_SPREAD = 6
	local TURN_OFF_SPREAD = 5
	local jobs, jobHead, jobTail = {}, 1, 0
	local pending = {}
	local function enqueue(fn)
		jobTail += 1
		jobs[jobTail] = fn
	end
	task.spawn(function()
		while true do
			local n = 0
			while jobHead <= jobTail and n < LIGHTS_PER_FRAME do
				local fn = jobs[jobHead]
				jobs[jobHead] = nil
				jobHead += 1
				n += 1
				pcall(fn)
			end
			task.wait()
		end
	end)

	local function owningBuilding(inst)
		local p = inst.Parent
		while p do
			if p:IsA("Model") and p.Name:find("Building") then return p end
			p = p.Parent
		end
	end

	local function register(inst)
		if inst:IsA("UnionOperation") and inst.Name:find("Windows") then
			local b = owningBuilding(inst)
			if b then
				buildings[b] = buildings[b] or {}
				if not table.find(buildings[b], inst) then
					table.insert(buildings[b], inst)
				end
			end
		end
	end

	for _, d in workspace:GetDescendants() do register(d) end
	workspace.DescendantAdded:Connect(register)
	workspace.DescendantRemoving:Connect(function(inst)
		saved[inst] = nil
		for b, list in buildings do
			local i = table.find(list, inst)
			if i then
				table.remove(list, i)
				if #list == 0 then buildings[b] = nil end
				break
			end
		end
	end)

	local function isDestroyed(building)
		local base = building:FindFirstChild("BuildingBase")
		return base and base:IsA("BasePart") and base.Material == Enum.Material.CorrodedMetal or false
	end

	local function windowsOf(building)
		local list = {}
		for _, d in building:GetDescendants() do
			if d:IsA("BasePart") and d.Name:lower():find("window", 1, true) then
				table.insert(list, d)
			end
		end
		return list
	end

	local function capture(window)
		if not saved[window] then
			saved[window] = { Material = window.Material, Color = window.Color }
		end
	end

	local colorCache = setmetatable({}, { __mode = "k" })
	local winBuilding = setmetatable({}, { __mode = "k" })
	local palette = nil

	local function buildingColor(building)
		if not palette or not building then return LIT end
		local c = colorCache[building]
		if not c then
			local base = building:FindFirstChild("BuildingBase")
			local p = base and base:IsA("BasePart") and base.Position or Vector3.zero
			local h = math.floor(math.abs(p.X * 7.13 + p.Z * 13.37 + p.Y * 3.1))
			c = palette[h % #palette + 1]
			colorCache[building] = c
		end
		return c
	end

	local function colorOf(window)
		local b = winBuilding[window]
		if not b then
			b = owningBuilding(window)
			winBuilding[window] = b
		end
		return buildingColor(b)
	end

	local function refreshPalette()
		local holiday = HolidayConfigs.getActive()
		local nextPalette = holiday and holiday.WindowColors or nil
		if nextPalette == palette then return end
		palette = nextPalette
		table.clear(colorCache)
		for base, light in lights do
			if light.Parent and base.Parent then light.Color = buildingColor(base.Parent) end
		end
	end

	local function setWindow(window, lit)
		if not window.Parent then return end
		capture(window)
		window.Material = Enum.Material.Neon
		window.Color = lit and colorOf(window) or DARK
	end

	local function restoreWindow(window)
		if not window.Parent then return end
		local s = saved[window]
		if s then
			window.Material, window.Color = s.Material, s.Color
		else
			window.Material, window.Color = Enum.Material.Glass, DARK
		end
	end

	local function flickerWindow(window, duration, final)
		if not window.Parent then return end
		capture(window)
		winToken[window] = (winToken[window] or 0) + 1
		local mine = winToken[window]
		task.spawn(function()
			local stop = os.clock() + duration
			local litColor = colorOf(window)
			while winToken[window] == mine and window.Parent and os.clock() < stop do
				window.Material = Enum.Material.Neon
				window.Color = math.random() < 0.5 and litColor or DARK
				task.wait(0.03 + math.random() * 0.09)
			end
			if winToken[window] ~= mine or not window.Parent then return end
			if final == "lit" then
				setWindow(window, true)
			elseif final == "dark" then
				setWindow(window, false)
			else
				restoreWindow(window)
			end
		end)
	end

	local function ensureLight(base)
		if lights[base] or pending[base] or not base.Parent then return end
		pending[base] = true
		enqueue(function()
			pending[base] = nil
			if lights[base] or not base.Parent or not windowsOn then return end
			local l = Instance.new("PointLight")
			l.Name = "BuildingGlowLight"
			l.Color = buildingColor(base.Parent)
			l.Brightness = LIGHT_BRIGHTNESS
			l.Range = LIGHT_RANGE
			l.Shadows = false
			CollectionService:AddTag(l, "BuildingGlowLight")
			l.Parent = base
			lights[base] = l
		end)
	end

	local function removeLight(base)
		local l = lights[base]
		if l then
			lights[base] = nil
			enqueue(function()
				if l.Parent then l:Destroy() end
			end)
		end
	end

	local function lightBuilding(building, windows, myEpoch)
		if epoch ~= myEpoch then return end
		local destroyed = isDestroyed(building)
		local base = building:FindFirstChild("BuildingBase")
		if not destroyed and base and base:IsA("BasePart") then ensureLight(base) end

		local function step(delay)
			task.wait(delay)
			return epoch == myEpoch
		end

		if not destroyed then
			for _, w in windows do
				if not step(math.random() * 0.3 + 0.8) then return end
				flickerWindow(w, 0.3 + math.random() * 0.6, "lit")
			end
		elseif #windows == 1 then
			if not step(math.random() * 0.3 + 8) then return end
			flickerWindow(windows[1], 0.3 + math.random() * 0.6, "dark")
		else
			for i, w in shuffle(windows) do
				if not step(math.random() * 0.3 + 0.8) then return end
				flickerWindow(w, 0.3 + math.random() * 0.6, i <= 2 and "lit" or "dark")
			end
		end
	end

	local function turnOn()
		if windowsOn then return end
		windowsOn = true
		refreshPalette()
		epoch += 1
		local myEpoch = epoch
		for building, windows in buildings do
			task.delay(math.random() * TURN_ON_SPREAD, lightBuilding, building, table.clone(windows), myEpoch)
		end
	end

	local function turnOff()
		if not windowsOn then return end
		windowsOn = false
		epoch += 1
		local stale = {}
		for base in lights do table.insert(stale, base) end
		for _, base in stale do removeLight(base) end
		pool = {}
		for _, windows in buildings do
			for _, w in windows do
				winToken[w] = (winToken[w] or 0) + 1
				task.delay(math.random() * TURN_OFF_SPREAD + 0.2, restoreWindow, w)
			end
		end
	end

	local function syncLights()
		local newPool = {}
		for building, windows in buildings do
			local base = building:FindFirstChild("BuildingBase")
			if base and base:IsA("BasePart") then
				if isDestroyed(building) then
					removeLight(base)
				else
					ensureLight(base)
					for _, w in windows do table.insert(newPool, { w, building }) end
				end
			end
		end
		pool = newPool
		for base in lights do
			if not base.Parent then removeLight(base) end
		end
	end

	windowApi.flickerBuilding = function(building, duration, ruined)
		local list = windowsOf(building)
		if #list == 0 then return end
		local darkCount = #list == 1 and 1 or math.random(1, math.min(#list, 3))
		for i, w in shuffle(list) do
			local final
			if ruined then
				if windowsOn then
					final = i <= 2 and "lit" or "dark"
				else
					final = i <= darkCount and "dark" or "restore"
				end
			else
				final = windowsOn and "lit" or "restore"
			end
			flickerWindow(w, duration * (0.7 + math.random() * 0.3), final)
		end
	end

	windowApi.resetBuilding = function(building)
		for _, w in windowsOf(building) do
			winToken[w] = (winToken[w] or 0) + 1
			if windowsOn then setWindow(w, true) else restoreWindow(w) end
		end
	end

	game:BindToClose(function()
		for _, windows in buildings do
			for _, w in windows do restoreWindow(w) end
		end
	end)

	refreshPalette()
	local lastNight, counter = nil, 0
	while true do
		refreshPalette()
		local m = Lighting:GetMinutesAfterMidnight()
		local night = m >= 1080 or m < 360
		if night ~= lastNight then
			lastNight = night
			if night then turnOn() else turnOff() end
		end
		if windowsOn then
			counter += 1
			if counter >= 3 then counter = 0 syncLights() end
			if #pool > 0 and math.random() < 0.6 then
				local pick = pool[math.random(1, #pool)]
				if pick[1].Parent and not isDestroyed(pick[2]) then
					flickerWindow(pick[1], 0.15 + math.random() * 0.45, "lit")
				end
			end
		end
		task.wait(1)
	end
end

local function initHolidayGround()
	local terrain = workspace.Terrain
	local terrainBase = terrain:GetMaterialColor(Enum.Material.Grass)
	local saved = setmetatable({}, { __mode = "k" })
	local activeColor, activeName = nil, nil

	local function tint(part)
		if activeColor and part ~= terrain and part:IsA("BasePart") and part.Material == Enum.Material.Grass and saved[part] == nil then
			saved[part] = part.Color
			part.Color = activeColor
		end
	end

	workspace.DescendantAdded:Connect(tint)

	local function sweep(color)
		local n = 0
		for _, d in workspace:GetDescendants() do
			if activeColor ~= color then return end
			tint(d)
			n += 1
			if n % 300 == 0 then task.wait() end
		end
	end

	local function clear()
		activeColor, activeName = nil, nil
		for part, c in saved do
			if part.Parent then part.Color = c end
			saved[part] = nil
		end
		terrain:SetMaterialColor(Enum.Material.Grass, terrainBase)
	end

	while true do
		local holiday = HolidayConfigs.getActive()
		local color = holiday and holiday.GroundColor or nil
		local name = color and holiday.Name or nil
		if name ~= activeName then
			if activeName then clear() end
			if color then
				activeColor, activeName = color, name
				terrain:SetMaterialColor(Enum.Material.Grass, color)
				task.spawn(sweep, color)
			end
		end
		task.wait(60)
	end
end

local function initRain()
	local rainySky = ReplicatedFirst:FindFirstChild("Rainy")
	local toggleRain = ReplicatedStorage:FindFirstChild("ToggleRain")
	local toggleSnow = ReplicatedStorage:FindFirstChild("ToggleSnow")

	while true do
		local weather = HolidayConfigs.getWeather()
		task.wait(math.random(weather.Gap[1], weather.Gap[2]))

		weather = HolidayConfigs.getWeather()
		local snow = weather.Kind == "Snow"
		local originalSky = Lighting:FindFirstChildOfClass("Sky")
		local clonedSky
		if snow then
			state.IsSnowing = true
			if toggleSnow then toggleSnow:FireAllClients(true) end
		else
			state.IsRaining = true
			if toggleRain then toggleRain:FireAllClients(true) end
			if rainySky then
				clonedSky = rainySky:Clone()
				clonedSky.Parent = Lighting
				if originalSky then originalSky.Parent = nil end
			end
		end

		task.wait(math.random(weather.Duration[1], weather.Duration[2]))

		if snow then
			state.IsSnowing = false
			if toggleSnow then toggleSnow:FireAllClients(false) end
		else
			state.IsRaining = false
			if toggleRain then toggleRain:FireAllClients(false) end
			if clonedSky then clonedSky:Destroy() end
			if originalSky then originalSky.Parent = Lighting end
		end
	end
end

local function initBuilding()
	local RUMBLE_TIME = 0.8
	local COLLAPSE_TIME = 2.6
	local RESPAWN_DELAY = 60
	local DEBRIS_CHUNKS = 12

	local touchingParts = {}
	local hitboxOwners = {}
	local destroyed = {}
	local buildingRefs = {}
	local beamLoops, blastLoops = {}, {}

	local DAMAGE_KEYWORDS = { "hitbox", "beam", "blast", "firebomb" }

	local function isValidDamager(name)
		name = name:lower()
		for _, k in DAMAGE_KEYWORDS do
			if name:find(k, 1, true) then return true end
		end
		return false
	end

	local function isHitPart(part)
		local cur = part.Parent
		while cur and cur ~= game do
			local n = cur.Name:lower()
			if n == "hitparts" or n == "hitparts2" then return true end
			cur = cur.Parent
		end
		return false
	end

	local function getPlayerFromHitbox(hit)
		local cur = hit.Parent
		while cur do
			if cur:FindFirstChildOfClass("Humanoid") then
				return Players:GetPlayerFromCharacter(cur)
			end
			cur = cur.Parent
		end
		local attacker = hit:GetAttribute("Attacker")
		if not attacker then
			local dps = hit:FindFirstChild("DPS")
			attacker = dps and dps:GetAttribute("Attacker")
		end
		return attacker and Players:FindFirstChild(attacker) or nil
	end

	local function playHitSound(base)
		local template = script:FindFirstChild("HitSound")
		if template and base and base.Parent then
			local s = template:Clone()
			s.Parent = base
			s:Play()
			Debris:AddItem(s, 5)
		end
	end

	local function reward(player, cells)
		if not player then return end
		local ls = player:FindFirstChild("leaderstats")
		local gcells = ls and (ls:FindFirstChild("GCells") or ls:FindFirstChild("gcells"))
		if gcells and gcells:IsA("IntValue") then
			if _G.GCellGuardAllow then _G.GCellGuardAllow(gcells, 3) end
			gcells.Value += cells
		end
		local char = player.Character
		local xp = char and char:FindFirstChild("AddXP")
		if xp and xp:IsA("BindableEvent") then xp:Fire(math.random(1, 3)) end
	end

	local function liveRefs()
		return coroutine.wrap(function()
			for building, refs in buildingRefs do
				if not destroyed[building] and refs.base and refs.base.Parent then
					coroutine.yield(building, refs)
				end
			end
		end)
	end

	local function startBlastCheck(blast)
		if blastLoops[blast] then return end
		blastLoops[blast] = true
		task.spawn(function()
			while blast.Parent and blast:GetAttribute("BlastActive") do
				local pos, r = blast.Position, maxAxis(blast)
				for _, refs in liveRefs() do
					if (pos - refs.pos).Magnitude <= r + refs.radius then
						playHitSound(refs.base)
						refs.HP.Value = 0
						refs.onDestroyed()
					end
				end
				task.wait(0.15)
			end
			blastLoops[blast] = nil
		end)
	end

	local function trackBlast(part)
		if part:GetAttribute("BlastTrackingSetup") then return end
		part:SetAttribute("BlastTrackingSetup", true)
		if part:GetAttribute("BlastActive") then startBlastCheck(part) end
		local conn = part:GetAttributeChangedSignal("BlastActive"):Connect(function()
			if part:GetAttribute("BlastActive") then startBlastCheck(part) end
		end)
		part.AncestryChanged:Connect(function(_, p)
			if not p then conn:Disconnect() end
		end)
	end

	local function startBeamCheck(hitbox)
		if beamLoops[hitbox] then return end
		beamLoops[hitbox] = true
		task.spawn(function()
			while hitbox.Parent do
				local pos, r = hitbox.Position, maxAxis(hitbox)
				for building, refs in liveRefs() do
					local set = touchingParts[building]
					if set then
						if (pos - refs.pos).Magnitude <= r + refs.radius then
							if not set[hitbox] then
								set[hitbox] = true
								playHitSound(refs.base)
								refs.startDamageLoop()
							end
						else
							set[hitbox] = nil
						end
					end
				end
				task.wait(0.15)
			end
			beamLoops[hitbox] = nil
		end)
	end

	local function setupBuilding(building)
		if not building.Name:lower():find("building") or buildingRefs[building] then return end

		local leftovers = {}
		for _, c in building:GetChildren() do
			if c:IsA("BasePart") and c.Name:lower():find("leftover") then
				table.insert(leftovers, c)
			end
		end
		local base = building:FindFirstChild("BuildingBase")
		local stats = building:FindFirstChild("Stats")
		local HP = stats and stats:FindFirstChild("HP")
		if #leftovers == 0 or not base or not HP then return end

		for _, l in leftovers do
			l.CanCollide, l.Transparency, l.Anchored = false, 1, true
		end
		for _, name in { "Fire", "Smoke" } do
			local e = base:FindFirstChild(name)
			if e and e:IsA("ParticleEmitter") then
				e.Enabled = false
				e.Parent = leftovers[1]
			end
		end

		local parts, original, origCFs = {}, {}, {}
		local minY = math.huge
		for _, d in building:GetDescendants() do
			if d:IsA("BasePart") and not d.Name:lower():find("leftover") then
				table.insert(parts, d)
				table.insert(origCFs, d.CFrame)
				original[d] = { Material = d.Material, Color = d.Color, CanCollide = d.CanCollide }
				minY = math.min(minY, d.Position.Y - d.Size.Y / 2)
				if d.Name:lower():find("window", 1, true) and not savedWindowState[d] then
					savedWindowState[d] = { Material = d.Material, Color = d.Color }
				end
			end
		end

		local basePos = base.Position
		local pivot = Vector3.new(basePos.X, minY, basePos.Z)
		local footW, footD = base.Size.X, base.Size.Z
		local shakeScale = math.clamp(maxAxis(base) / 25, 0.4, 2.5)
		local dustScale = math.clamp(math.max(footW, footD) / 8, 3, 14)

		local pose = { sink = 0, tx = 0, tz = 0 }
		local anim, jolt = nil, nil
		local rendering = false
		local seed = math.random() * 1000
		local cframes = table.create(#parts)

		local function apply(sx, sy, sz, rx, rz)
			local rot = CFrame.Angles(pose.tx + rx, 0, pose.tz + rz)
			local offset = CFrame.new(sx, sy - pose.sink, sz) * CFrame.new(pivot) * rot * CFrame.new(-pivot)
			for i = 1, #parts do cframes[i] = offset * origCFs[i] end
			pcall(workspace.BulkMoveTo, workspace, parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end

		local function render()
			if rendering then return end
			rendering = true
			task.spawn(function()
				while base.Parent do
					local now = os.clock()
					local amp = 0
					if anim then
						local p = math.clamp((now - anim.t0) / anim.dur, 0, 1)
						local e = anim.ease(p)
						local te = anim.tiltEase(p)
						pose.sink = lerp(anim.from.sink, anim.to.sink, e)
						pose.tx = lerp(anim.from.tx, anim.to.tx, te)
						pose.tz = lerp(anim.from.tz, anim.to.tz, te)
						amp = anim.amp * math.sin(math.pi * p ^ 0.6)
						if p >= 1 then anim = nil end
					end
					if jolt then
						local jp = (now - jolt.t0) / jolt.dur
						if jp >= 1 then
							jolt = nil
						else
							amp += jolt.amp * (1 - jp) ^ 2
						end
					end
					local sx, sy, sz, rx, rz = 0, 0, 0, 0, 0
					if amp > 0.001 then
						local t = now * 24
						local ts = amp * shakeScale
						sx = math.noise(t, seed, 0.5) * 2 * ts
						sy = math.noise(t, seed, 10.5) * ts
						sz = math.noise(t, seed, 20.5) * 2 * ts
						rx = math.noise(t, seed, 30.5) * 0.012 * amp
						rz = math.noise(t, seed, 40.5) * 0.012 * amp
					end
					apply(sx, sy, sz, rx, rz)
					if not anim and not jolt then break end
					task.wait(1 / 30)
				end
				rendering = false
			end)
		end

		local function startAnim(sink, tx, tz, dur, amp, ease, tiltEase)
			seed = math.random() * 1000
			anim = {
				from = { sink = pose.sink, tx = pose.tx, tz = pose.tz },
				to = { sink = sink, tx = tx, tz = tz },
				t0 = os.clock(), dur = dur, amp = amp,
				ease = ease, tiltEase = tiltEase or ease,
			}
			render()
		end

		local function addJolt(amp, dur)
			if jolt and jolt.amp * (1 - (os.clock() - jolt.t0) / jolt.dur) > amp then return end
			seed = math.random() * 1000
			jolt = { amp = amp, dur = dur, t0 = os.clock() }
			render()
		end

		local function dust(count, sources)
			for _ = 1, sources do
				local att = Instance.new("Attachment")
				att.Parent = workspace.Terrain
				att.WorldPosition = pivot + Vector3.new(rand(-footW / 2, footW / 2) * 0.8, 0.5, rand(-footD / 2, footD / 2) * 0.8)
				local e = Instance.new("ParticleEmitter")
				e.Texture = "rbxasset://textures/particles/smoke_main.dds"
				e.Rate = 0
				e.Lifetime = NumberRange.new(2, 4)
				e.Speed = NumberRange.new(8, 26)
				e.SpreadAngle = Vector2.new(75, 75)
				e.EmissionDirection = Enum.NormalId.Top
				e.Rotation = NumberRange.new(0, 360)
				e.RotSpeed = NumberRange.new(-40, 40)
				e.Drag = 2
				e.Acceleration = Vector3.new(0, 1.5, 0)
				e.Color = ColorSequence.new(Color3.fromRGB(155, 145, 130), Color3.fromRGB(105, 105, 105))
				e.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, dustScale * 0.4),
					NumberSequenceKeypoint.new(1, dustScale * 1.6),
				})
				e.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5),
					NumberSequenceKeypoint.new(0.6, 0.75),
					NumberSequenceKeypoint.new(1, 1),
				})
				e.Parent = att
				e:Emit(count)
				Debris:AddItem(att, 7)
			end
		end

		local function throwChunks(count)
			for _ = 1, count do
				local chunk = Instance.new("Part")
				chunk.Name = "CollapseChunk"
				chunk.Size = Vector3.new(rand(1, 3.5), rand(1, 3.5), rand(1, 3.5))
				chunk.Material = Enum.Material.CorrodedMetal
				chunk.Transparency = 0
				chunk.Color = base.Color
				chunk.CanTouch = false
				chunk.CanQuery = false
				chunk.CFrame = CFrame.new(pivot + Vector3.new(rand(-footW / 2, footW / 2), rand(2, 15), rand(-footD / 2, footD / 2)))
					* CFrame.Angles(rand(0, 6), rand(0, 6), rand(0, 6))
				chunk.Parent = workspace
				chunk.AssemblyLinearVelocity = Vector3.new(rand(-1, 1), rand(0.4, 1.2), rand(-1, 1)).Unit * rand(18, 45)
				chunk.AssemblyAngularVelocity = Vector3.new(rand(-8, 8), rand(-8, 8), rand(-8, 8))
				local life = rand(2.4, 3.4)
				task.delay(life - 1, function()
					if chunk.Parent then TweenService:Create(chunk, TweenInfo.new(1), { Transparency = 1 }):Play() end
				end)
				Debris:AddItem(chunk, life)
			end
		end

		local function setLeftoverEffects(on)
			for _, l in leftovers do
				for _, d in l:GetDescendants() do
					if d:IsA("ParticleEmitter") then d.Enabled = on end
				end
			end
		end

		local halfTriggered = false
		local lastFlicker = 0
		HP.Value = 100
		touchingParts[building] = {}

		local function respawn()
			if not base.Parent then return end
			anim, jolt = nil, nil
			pose.sink, pose.tx, pose.tz = 0, 0, 0
			apply(0, 0, 0, 0, 0)
			HP.Value = 100
			halfTriggered = false
			for _, l in leftovers do l.Transparency, l.CanCollide = 1, false end
			setLeftoverEffects(false)
			local sound = base:FindFirstChildOfClass("Sound")
			if sound then sound:Stop() end
			for _, p in parts do
				local o = original[p]
				p.Material, p.Color, p.CanCollide = o.Material, o.Color, o.CanCollide
			end
			destroyed[building] = nil
			if windowApi.resetBuilding then windowApi.resetBuilding(building) end
		end

		local function onDestroyed()
			if destroyed[building] then return end
			destroyed[building] = true

			for _, p in parts do p.Material, p.CanCollide = Enum.Material.CorrodedMetal, false end
			local sound = base:FindFirstChildOfClass("Sound")
			if sound then sound:Play() end

			startAnim(pose.sink, pose.tx, pose.tz, RUMBLE_TIME, 2.6, easeLinear)
			dust(20, 2)
			if windowApi.flickerBuilding then
				windowApi.flickerBuilding(building, RUMBLE_TIME + COLLAPSE_TIME, true)
			end

			task.delay(RUMBLE_TIME, function()
				if not base.Parent then return end
				for _, l in leftovers do l.Transparency, l.CanCollide = 0, false end
				setLeftoverEffects(true)

				local ang = math.rad(rand(10, 22))
				local dir = math.random() * math.pi * 2
				startAnim(base.Size.Y, ang * math.cos(dir), ang * math.sin(dir), COLLAPSE_TIME, 3.4, easeCollapse, easeTilt)
				dust(35, 4)
				task.spawn(function()
					local t0 = os.clock()
					while base.Parent and os.clock() - t0 < COLLAPSE_TIME do
						throwChunks(1)
						task.wait(COLLAPSE_TIME / DEBRIS_CHUNKS)
					end
				end)

				task.delay(COLLAPSE_TIME, function()
					if not base.Parent then return end
					dust(80, 5)
					addJolt(5, 0.9)
					task.delay(RESPAWN_DELAY, respawn)
				end)
			end)
		end

		local function halfCollapse()
			halfTriggered = true
			for _, p in parts do p.Material = Enum.Material.CorrodedMetal end
			local ang = math.rad(rand(3, 8))
			local dir = math.random() * math.pi * 2
			startAnim(base.Size.Y * rand(0.25, 0.75), ang * math.cos(dir), ang * math.sin(dir), 1.6, 1.8, easeInOut)
			dust(25, 2)
		end

		local function applyDamage(amount, rewardsByPlayer)
			if HP.Value <= 0 or destroyed[building] then return false end
			HP.Value -= amount
			if HP.Value <= 50 and not halfTriggered then halfCollapse() end
			addJolt(1 + (100 - math.max(HP.Value, 0)) / 60, 0.45)
			dust(6, 1)
			if windowApi.flickerBuilding and os.clock() - lastFlicker > 0.35 then
				lastFlicker = os.clock()
				windowApi.flickerBuilding(building, 0.45, false)
			end
			playHitSound(base)
			for player, cells in rewardsByPlayer do reward(player, cells) end
			if HP.Value <= 0 then
				HP.Value = 0
				onDestroyed()
			end
			return true
		end

		local damaging = false
		local function startDamageLoop()
			if damaging then return end
			damaging = true
			task.spawn(function()
				while true do
					local set = touchingParts[building]
					if not set or HP.Value <= 0 or destroyed[building] then break end

					local rewards, any = {}, false
					for hit in set do
						if not hit.Parent then
							set[hit] = nil
							hitboxOwners[hit] = nil
						else
							any = true
							local owner = hitboxOwners[hit]
							if owner then rewards[owner] = (rewards[owner] or 0) + 1 end
						end
					end
					if not any then break end

					applyDamage(20, rewards)
					task.wait(0.5)
				end
				damaging = false
			end)
		end

		buildingRefs[building] = {
			base = base, HP = HP,
			pos = base.Position, radius = maxAxis(base),
			startDamageLoop = startDamageLoop,
			onDestroyed = onDestroyed,
			damageBuilding = function(attacker)
				applyDamage(20, attacker and { [attacker] = 3 } or {})
			end,
		}

		base.Touched:Connect(function(hit)
			if not (isValidDamager(hit.Name) or isHitPart(hit)) then return end
			local player = getPlayerFromHitbox(hit)
			if player then hitboxOwners[hit] = player end

			if hit.Name:lower():find("blast") then
				playHitSound(base)
				HP.Value = 0
				onDestroyed()
				return
			end
			local set = touchingParts[building]
			if set then
				set[hit] = true
				playHitSound(base)
				startDamageLoop()
			end
		end)

		base.TouchEnded:Connect(function(hit)
			if isHitPart(hit) then return end
			local set = touchingParts[building]
			if set then set[hit] = nil end
			hitboxOwners[hit] = nil
		end)

		building.AncestryChanged:Connect(function(_, parent)
			if not parent then
				touchingParts[building] = nil
				buildingRefs[building] = nil
				destroyed[building] = nil
			end
		end)
	end

	local Map = workspace:WaitForChild("Map")
	for _, b in Map:GetChildren() do
		if b:IsA("Model") then
			setupBuilding(b)
			task.wait()
		end
	end
	Map.DescendantAdded:Connect(function(d)
		if d:IsA("Model") and d.Name:lower():find("building") then
			task.wait(0.1)
			setupBuilding(d)
		end
	end)

	workspace.DescendantAdded:Connect(function(d)
		if not d:IsA("BasePart") or not isValidDamager(d.Name) then return end
		task.defer(function()
			if not d.Parent then return end
			local lname = d.Name:lower()
			local isBlast = lname:find("blast") ~= nil

			local player = getPlayerFromHitbox(d)
			if player then hitboxOwners[d] = player end

			local pos, r = d.Position, maxAxis(d)
			for building, refs in liveRefs() do
				if (pos - refs.pos).Magnitude <= r + refs.radius then
					if isBlast then
						playHitSound(refs.base)
						refs.HP.Value = 0
						refs.onDestroyed()
					elseif touchingParts[building] then
						touchingParts[building][d] = true
						refs.startDamageLoop()
					end
				end
			end

			if isBlast then
				trackBlast(d)
			elseif lname:find("beam") or lname:find("hitbox") then
				startBeamCheck(d)
			end

			d.AncestryChanged:Connect(function(_, parent)
				if parent then return end
				for building in buildingRefs do
					local set = touchingParts[building]
					if set then set[d] = nil end
				end
				hitboxOwners[d] = nil
			end)
		end)
	end)

	local function scanCharacter(char)
		for _, d in char:GetDescendants() do
			if d:IsA("BasePart") and d.Name:lower():find("blast") then trackBlast(d) end
		end
	end
	local function hookPlayer(player)
		player.CharacterAdded:Connect(function(char)
			task.wait(0.5)
			scanCharacter(char)
		end)
		if player.Character then scanCharacter(player.Character) end
	end
	Players.PlayerAdded:Connect(hookPlayer)
	for _, p in Players:GetPlayers() do hookPlayer(p) end

	_G.DamageBuildingsInRadius = function(position, radius, attacker)
		for _, refs in liveRefs() do
			if (position - refs.pos).Magnitude <= radius + refs.radius then
				refs.damageBuilding(attacker)
			end
		end
	end
end

local function initCollisions()
	local INVISIBLE_THRESHOLD = 0.9

	local function fixPart(part)
		if part:IsA("BasePart") and part.CanCollide and part.Transparency >= INVISIBLE_THRESHOLD then
			part.CanCollide = false
		end
	end

	local function fixTree(root)
		fixPart(root)
		for _, d in root:GetDescendants() do fixPart(d) end
	end

	fixTree(workspace)

	workspace.DescendantAdded:Connect(function(d)
		task.defer(fixPart, d)
	end)

	while true do
		task.wait(30)
		local n = 0
		for _, d in workspace:GetDescendants() do
			fixPart(d)
			n += 1
			if n % 2000 == 0 then task.wait() end
		end
	end
end

function World.Init()
	if initialized then return end
	initialized = true
	task.spawn(initDayNight)
	task.spawn(initWindowLights)
	task.spawn(initRain)
	task.spawn(initBuilding)
	task.spawn(initCollisions)
	task.spawn(initHolidayGround)
end

function World.IsRaining()
	return state.IsRaining
end

return World]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
