		KeyPrefix = "Player_",
		RemoteName = "GetSettingsData",
		DefaultFov = 70,
		MinFov = 70,
		MaxFov = 120,
		DataStoreAttempts = 3,
		RemoteWaitTimeout = 60,
	},

	LegacyModules = { "Character", "Combat", "Data", "World" },
}
]]></ProtectedString>
